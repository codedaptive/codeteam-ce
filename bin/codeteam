#!/usr/bin/env python3
"""codeteam: run any git repo as a team of standing sessions.

Setup
  codeteam init      MANIFEST (--lanes A,B | --all-lanes) [--dry-run]
  codeteam launch    MANIFEST [orc | staff | all | NAME ...] [--dry-run]
  codeteam status    MANIFEST
  codeteam trust     MANIFEST                  mark every launch folder trusted in ~/.claude.json
  codeteam roles     MANIFEST                  re-render every role file
  codeteam repin     MANIFEST PIN [--ref REF]  move a pin branch to REF's tip
  codeteam sleep     MANIFEST NAME             clean, then stop one session (it goes dark)
  codeteam teardown  MANIFEST [--dry-run]

Talking
  codeteam say       MANIFEST CHANNEL FROM TYPE TO TEXT...
  codeteam watch     MANIFEST NAME             wait for new lines for NAME, print them, exit
  codeteam link-guides MANIFEST                make CLAUDE.md -> AGENTS.md in each finished lane
                     CHANNEL: general | a lane | an assistant | link:<team>

Features (a name chosen by the orchestrator; it travels with the work)
  codeteam unit      MANIFEST LANE FEATURE              worker worktree for FEATURE, off the lane
  codeteam squash    MANIFEST LANE FEATURE -m MESSAGE   worker -> lane
  codeteam push-up   MANIFEST LANE -f FEATURE -m MESSAGE  lane -> exchange (lab: -> base); refused if it
                             changes a path outside the lane's walls
  codeteam pull-down MANIFEST LANE [-f FEATURE]         exchange -> lane, or lane -> worker
  codeteam ready     MANIFEST NAME STEP FEATURE...      post READY for integrate or promote
  codeteam integrate MANIFEST -m MESSAGE FEATURE...     exchange -> integration
  codeteam promote   MANIFEST -m MESSAGE                integration -> base
  codeteam discard   MANIFEST                           undo the last integrate
  codeteam approve   MANIFEST FEATURE                   tell the lanes FEATURE's worktrees can go
  codeteam retire    MANIFEST LANE FEATURE              remove an approved worker worktree
  codeteam backup    MANIFEST LANE [-f FEATURE]         push a lane or worker branch to origin

Verifier run copies
  codeteam snapshot  MANIFEST LANE REF [--name NAME]  run copy at REF, on branch snap/<lane>/<name>
  codeteam drop      MANIFEST LANE NAME

Branches: one line. Every tier is cut from the tier above it.
  factory  base -> integration -> exchange -> lane/<lane> -> unit/<lane>/<feature>
  lab      base -> lane/<lane> -> unit/<lane>/<feature>
Work moves up one tier at a time, squashed and naming its feature. Updates
come down the same line by merge. Every branch except base is backed up to
origin when codeteam moves it; the base is pushed by whoever ships it.
Every worktree is on a branch: codeteam makes no detached checkouts.

Layout (everything under $CODETEAM_WORKSPACE, default ~/codeteam-work; no dot folders of codeteam's own):
  <worktree_root>/
    design/        <repo>-<base>/ (the base checkout, `repo`), <Session>/ledger, scratchpad
    integration/   <repo>-<base>-integration/, <Session>/ledger, scratchpad   (factory)
    exchange/      <repo>-integration-exchange/, <Session>/ledger, scratchpad (factory)
    workcrews/<Lane>/  <repo>-<parent>-<Lane>/, <repo>-<Lane>-<feature>/, ledger/, scratchpad/
    <pin>/         <repo>-<ref>-pin/ on branch pin/<team>, and a `current` link
    team/          general.log, sessions.json, roles/, launch/, claude/
  $CODETEAM_WORKSPACE/team-links/   channels between team orchestrators
The orchestrator and the designer work in the base checkout and may work in
every tree below it. Worktree folders are named <REPO>-<PARENT>-<WORKTREE>.
Every scratchpad/ is excluded from Time Machine when it is created.

Functions marked LIFTED come from an earlier tool, the wormhole. Their comments
record bugs that were already paid for; keep them.
"""
import argparse
import collections
import contextlib
import fnmatch
import json
import os
import re
import shutil
import shlex
import subprocess
import sys
import tempfile
import threading
import time
# cron runs with a bare PATH: lsof (in /usr/sbin) and git-lfs (in /opt/homebrew/bin) must still resolve. Homebrew
# comes first so every tool codeteam starts, the gate included, gets Homebrew's python3 (3.11+) and git.
os.environ["PATH"] = "/opt/homebrew/bin:/usr/local/bin:/usr/sbin:/usr/bin:/bin:/sbin:" + os.environ.get("PATH", "")
import uuid
from datetime import datetime
from pathlib import Path

# Git over SSH never hangs a loop: a connection that does not open in 20 s, or goes silent for a minute, fails
# (2026-10-29: after a reboot, an ls-remote opened before the network was up hung two teams' loops
# for five minutes). Only set when nobody chose their own.
# A hard cap as well (2026-11-03): after the machine moved to a remote network, five loops' `ls-remote` sat in ssh for
# 2 h 14 min, keepalives notwithstanding (stuck before the session was up), and every team went deaf. No git ssh
# call from codeteam lives past 5 minutes; backups retry hourly.
# Forced, not setdefault (2026-11-04): the herdr server's environment still carried the old value from before the
# cap, every pane inherited it, and five loops hung again at a passphrase prompt. Anyone's own value without
# BatchMode is replaced too: a loop must never wait at a prompt.
_ssh = os.environ.get("GIT_SSH_COMMAND", "")
if "BatchMode=yes" not in _ssh or "timeout" not in _ssh:
    os.environ["GIT_SSH_COMMAND"] = ("/usr/bin/timeout 300 ssh -o ConnectTimeout=20 -o ServerAliveInterval=15 "
                                     "-o ServerAliveCountMax=4 -o BatchMode=yes")
# The ssh agent: a herdr pane's SSH_AUTH_SOCK is herdr's forward of the attached terminal's agent, which goes dead
# ("herdr.sock.unavailable") when no terminal is attached, and ssh then falls back to the locked key file. Use the
# Mac's own agent (launchd's, which holds the key through the keychain) whenever the herdr one is in place.
if "herdr" in os.environ.get("SSH_AUTH_SOCK", ""):
    try:
        _sock = subprocess.run(["launchctl", "getenv", "SSH_AUTH_SOCK"], capture_output=True, text=True,
                               timeout=5).stdout.strip()
        if _sock:
            os.environ["SSH_AUTH_SOCK"] = _sock
    except Exception:
        pass

if sys.version_info < (3, 11):
    # Sessions often get the system Python 3.9 first on PATH. Re-run under the
    # first Python 3.11+ found, so `codeteam ...` works from any shell.
    import shutil as _sh
    for _cand in (os.environ.get("CODETEAM_PYTHON") or "python3", "python3.14", "python3.13", "python3.12", "python3.11",
                  "/usr/local/bin/python3"):
        _exe = _sh.which(_cand) or (_cand if Path(_cand).is_file() else None)
        if _exe and os.path.realpath(_exe) != os.path.realpath(sys.executable):
            _ok = subprocess.run([_exe, "-c", "import sys; sys.exit(sys.version_info < (3, 11))"]).returncode == 0
            if _ok:
                os.execv(_exe, [_exe, __file__, *sys.argv[1:]])
    sys.exit("codeteam needs Python 3.11+ (tomllib), and none was found")
import tomllib

TOOL_DIR = Path(__file__).resolve().parent.parent
# Where team folders, bare repositories (.repos/) and team-links/ live.
WORKSPACE = Path(os.environ.get("CODETEAM_WORKSPACE") or Path.home() / "codeteam-work")
# The human who owns the teams, as a message sender and spec author.
OWNER = os.environ.get("CODETEAM_OWNER") or "Owner"
TOOL = TOOL_DIR / "bin" / "codeteam"
ROLES_DIR = TOOL_DIR / "roles"
MCP_FILE = TOOL_DIR / "mcp.json"     # MCP servers every session gets
# Environment every team's sessions get unless the manifest's [env] says otherwise (a repair for
# all teams). CLAUDE_CODE_FORK_SUBAGENT=0: a subagent's own Agent calls run in the foreground, so a lead is
# never stranded waiting on a background child (10-28: one team's leads got 160 async children without it).
SESSION_ENV_DEFAULTS = {"CLAUDE_CODE_FORK_SUBAGENT": "0",
                        # 2026-11-02: a build or test waiting its turn in the build queue must not be killed by the
                        # Bash tool's 10-minute default; 30 minutes covers the queue plus the run.
                        "BASH_DEFAULT_TIMEOUT_MS": "1800000", "BASH_MAX_TIMEOUT_MS": "3600000",
                        # 2026-11-04: render fullscreen whatever happened before. Claude Code turns fullscreen off
                        # machine-wide after two sessions crash before their first 10 s (the overload of 11-03/04
                        # did that), and every later session came up in the classic renderer; this is honoured
                        # regardless and isn't counted.
                        "CLAUDE_CODE_NO_FLICKER": "1"}
WINDOWS_FILE = Path(os.environ.get("CODETEAM_WINDOWS", TOOL_DIR / "windows.toml"))
# claude-home, when installed, is a local launcher (for example one that routes models through a
# local proxy); sessions use it when it is there.
_HOME_LAUNCHER = Path.home() / ".local/bin/claude-home"
CLAUDE_BIN = (os.environ.get("CODETEAM_CLAUDE_BIN")
              or (str(_HOME_LAUNCHER) if _HOME_LAUNCHER.exists() else None)
              or shutil.which("claude") or str(Path.home() / ".local/bin/claude"))
# tmux: sessions run as tabs inside one tmux session per window group (windows.toml),
# on codeteam's own tmux server, so the user's own tmux sessions are never touched.
TMUX = shutil.which("tmux") or "/opt/homebrew/bin/tmux"
TMUX_SOCKET = os.environ.get("CODETEAM_TMUX_SOCKET", "codeteam-ui")
CLAUDE_ENTRIES = ("agents", "skills", "rules", "hooks", "commands", "settings.json")
MESSAGE_TYPES = ("REQUEST", "ANSWER", "NOTE", "STATUS", "BUG", "PUSHED", "DONE", "RULING", "READY")

# LIFTED (micro-wormhole.py): Terminal app for launching sessions.
# Was Ghostty, switched to Terminal.app due to surface-allocator OOM
# bug in Ghostty 1.3.1 (Discussion #10712) causing repeated launch
# failures. Terminal.app has no such issue.
TERMINAL_APP = "Terminal"


def say_line(msg):
    print(f"  {msg}")


def warn(msg):
    print(f"  WARN: {msg}")


# ---------------------------------------------------------------- git

def _git_env() -> dict:
    """LIFTED (wormhole/validation.py): environment for git subprocesses,
    with git-lfs reachable.

    A repo that configures LFS hooks broke this way. The wormhole is launched from a shell
    whose PATH lacks /opt/homebrew/bin, so post-checkout and post-commit
    error on every replayed commit and the operation fails -- reported
    generically as "conflicts". That sent three approved tasks round the
    revalidation loop repeatedly.

    Of /opt/homebrew/bin and /usr/local/bin, those that are directories and
    are not on PATH are missing. With /opt/homebrew/bin already on PATH, the
    missing ones go right after its first occurrence; otherwise they are
    prepended as one block in that order, so Homebrew comes first.
    A directory already on PATH never moves, and
    nothing is added twice.
    """
    env = dict(os.environ)
    parts = env.get("PATH", "").split(":")
    missing = [d for d in ("/opt/homebrew/bin", "/usr/local/bin")
               if Path(d).is_dir() and d not in parts]
    if not missing:
        return env
    if "/opt/homebrew/bin" in parts:
        at = parts.index("/opt/homebrew/bin") + 1
        env["PATH"] = ":".join(parts[:at] + missing + parts[at:])
    else:
        env["PATH"] = ":".join(missing) + ":" + env.get("PATH", "")
    return env


def git(repo, *args, check=True):
    r = subprocess.run(["git", "-C", str(repo), *map(str, args)],
                       capture_output=True, text=True, env=_git_env())
    if check and r.returncode != 0:
        sys.exit(f"git {' '.join(map(str, args))} failed in {repo}:\n{r.stderr.strip()}")
    return r


def out(repo, *args) -> str:
    return git(repo, *args).stdout.strip()


def clean_git_locks(repo: Path):
    """LIFTED (micro-wormhole.py clean_git_locks): stale index.lock and
    HEAD.lock left by a crashed git process block every later command.
    Adapted: called only on worktrees codeteam created, and only locks
    older than five minutes are removed, so a running command keeps its lock.
    """
    gd = Path(out(repo, "rev-parse", "--absolute-git-dir"))
    for name in ("index.lock", "HEAD.lock"):
        p = gd / name
        if p.exists() and time.time() - p.stat().st_mtime > 300:
            p.unlink()
            say_line(f"cleaned stale lock {p}")


def common_dir(path) -> Path:
    return Path(out(path, "rev-parse", "--path-format=absolute", "--git-common-dir"))


def branch_exists(repo, name) -> bool:
    return git(repo, "rev-parse", "--verify", "--quiet",
               f"refs/heads/{name}", check=False).returncode == 0


def ref_exists(repo, ref) -> bool:
    return git(repo, "rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}",
               check=False).returncode == 0


def is_dirty(wt) -> bool:
    return bool(git(wt, "status", "--porcelain", "--untracked-files=no").stdout.strip())


def checkout_of(repo, branch):
    """The worktree that has `branch` checked out, or None.

    LIFTED lesson (_resolve_merge_workdir): a branch checked out in another
    worktree can only be moved inside that worktree; moving the ref from
    outside leaves that worktree's files and index behind the branch.
    """
    path = None
    for line in out(repo, "worktree", "list", "--porcelain").splitlines():
        if line.startswith("worktree "):
            path = line[9:]
        elif line == f"branch refs/heads/{branch}":
            return Path(path)
    return None


def move_branch(repo, branch, new, old):
    """Advance `branch` from `old` to `new` (new must descend from old)."""
    co = checkout_of(repo, branch)
    if co:
        r = git(co, "merge", "--ff-only", "-q", new, check=False)
        if r.returncode:
            sys.exit(f"{branch} is checked out at {co} and could not fast-forward:\n"
                     f"{r.stderr.strip()}\nNothing was changed.")
    else:
        git(repo, "update-ref", f"refs/heads/{branch}", new, old)


def commit_tree(repo, tree, parents, message) -> str:
    args = ["commit-tree", tree]
    for p in parents:
        args += ["-p", p]
    args += ["-m", message]
    return out(repo, *args)


def short(ref: str) -> str:
    """The parent part of a worktree folder name: develop/1.1.x -> develop."""
    return ref.split("/")[0]


def flat(ref: str) -> str:
    """A whole branch name as a folder part: develop/1.1.x -> develop_1.1.x."""
    return ref.replace("/", "_")


def head_branch(wt) -> str:
    """The branch a worktree is on, or "" when it is detached."""
    r = git(wt, "symbolic-ref", "-q", "--short", "HEAD", check=False)
    return r.stdout.strip() if r.returncode == 0 else ""


def repo_name_of(repo) -> str:
    """The repo's own name: from its origin remote when it has one
    (git@host:org/acme-ee-tools.git -> acme-ee-tools), so renaming the folder a
    clone sits in never renames worktrees. Without a remote: acme-ee for
    .repos/acme-ee.git, the folder name for a normal clone."""
    url = git(repo, "remote", "get-url", "origin", check=False).stdout.strip()
    if url:
        return url.rstrip("/").split("/")[-1].split(":")[-1].removesuffix(".git")
    cd = common_dir(repo)
    return cd.parent.name if cd.name == ".git" else cd.name.removesuffix(".git")


# ---------------------------------------------------------------- manifest

class Team:
    def __init__(self, manifest):
        self.manifest = Path(manifest).expanduser().resolve()
        m = tomllib.loads(self.manifest.read_text())
        self.m = m
        for key in ("product", "repo", "base"):
            if key not in m:
                sys.exit(f"manifest {self.manifest} is missing '{key}'")
        self.product = m["product"]
        self.title = self.product[:1].upper() + self.product[1:]
        # The base checkout: a clone or worktree on `base`, in design/.
        self.repo = Path(m["repo"]).expanduser()
        self.base = m["base"]
        self.mode = m.get("mode", "factory")
        if self.mode not in ("factory", "lab", "studio"):
            sys.exit(f"mode must be 'factory', 'lab' or 'studio', not '{self.mode}'")
        if self.mode == "studio":
            sys.exit("studio teams (one external expert) are not built yet; "
                     "run the agent as an external assistant of the team it serves")
        self.exchange = m.get("exchange", "exchange")
        self.integration = m.get("integration", "integration")
        self.root = Path(m.get("worktree_root", str(WORKSPACE / f"{self.product}-team"))).expanduser()
        src = m.get("claude_source", "")
        self.claude_source = Path(src).expanduser() if src else None
        self.orc_agent = m.get("orc_agent", "")
        self.lane_agent = m.get("lane_agent", "")
        # The model is always passed explicitly. --model wins over an agent
        # file's pinned model (verified 2026-10-13), and nothing is left to
        # user settings, which isolation removes.
        self.model = m.get("model", "")
        self.orc_model = m.get("orc_model", self.model)
        self.lane_model = m.get("lane_model", self.model)
        self.effort = m.get("effort", "")
        self.lane_coder = m.get("lane_coder", "bilby-mid")
        # Effort for zone coordinators; defaults to the team's effort.
        self.lane_effort = m.get("lane_effort", self.effort)
        # Command run in the source worktree before squash, push-up or promote moves a
        # branch; {target} is the branch. Empty: no gate.
        self.gate = m.get("gate", "")
        # [lane_class.<name>] tables: model, effort and coder for a named set of lanes.
        self.lane_classes = m.get("lane_class", {})
        default_mode = m.get("permission_mode", "")
        # Lanes stay inside their worktree. The orchestrator routes across
        # worktrees. Each assistant sets its own mode in the manifest.
        self.lane_permission_mode = m.get("lane_permission_mode", default_mode)
        self.orc_permission_mode = m.get("orc_permission_mode", default_mode)
        self.prefix = m.get("lane_branch_prefix", "lane/")
        self.lane_specs = m.get("lanes", [])
        self.pilot = m.get("pilot", [])
        # Assistants are standing sessions. Each works in one tier's checkout:
        # design (the base checkout), integration or exchange; several may
        # share a checkout, and each has its own records folder in that tier.
        self.assistants = {a["name"]: a for a in m.get("assistants", [])}
        tiers = ("design",) if self.lab else ("design", "integration", "exchange")
        for n, a in self.assistants.items():
            if a.get("external"):
                if not a.get("home", a.get("worktree")):
                    sys.exit(f"external assistant {n} needs `home`")
            elif a.get("tier") not in tiers and not a.get("home"):
                sys.exit(f"assistant {n}: tier must be one of {', '.join(tiers)}, or set `home`")
            elif a.get("tier") and a.get("home"):
                sys.exit(f"assistant {n}: set `tier` or `home`, not both")
        # external = true: the assistant keeps its own long-lived session in its
        # own home. codeteam gives it a channel and a role file, and never
        # launches, sleeps or stops it.
        # home without external (2026-10-27, Backporter): a standing session codeteam runs like any
        # other, working in its own home instead of a tier's checkout; its records live in the
        # design tier beside the orchestrator's.
        self.builder = m.get("builder", "")      # assistant that runs integrate/promote
        self.guard = m.get("guard", "")          # assistant that reviews each push-up
        # guard_per = "feature": the guard reviews a feature once, when the
        # orchestrator names it ready, instead of every push-up.
        self.guard_per = m.get("guard_per", "push")
        # isolate: sessions load only project settings and no MCP servers,
        # so they cannot reach the user's own MCP servers or user plugins.
        self.isolate = m.get("isolate", False)
        # local_only: branches cannot be pushed implicitly, and every role
        # prompt says the team works locally. No backups are pushed.
        self.local_only = m.get("local_only", False)
        # backup: codeteam pushes every branch it moves (never the base) to origin.
        self.backup = m.get("backup", True) and not self.local_only
        # Environment exported in every launch script. Values may use ~
        # and {home} (this team's runtime home).
        self.env = m.get("env", {})
        # Other teams whose orchestrators share a channel with this one.
        self.links = m.get("links", [])
        # The rulings register, inside the repo.
        self.rulings = m.get("rulings", "docs/RULINGS.md")
        # start_lanes_in_batches = N: launch starts the orchestrator and staff;
        # the orchestrator's first task starts the lanes N at a time.
        self.batch = int(m.get("start_lanes_in_batches", 0))
        # Run in a lane's worktree before its session goes dark.
        self.sleep_clean = m.get("sleep_clean", "")
        # Read-only checkouts of other repos, e.g. a library for a benchmark lab.
        # Each lives in <root>/<name>/<repo>-<ref>-pin on branch pin/<product>,
        # with a stable `current` link.
        self.pins = {x["name"]: x for x in m.get("pins", [])}
        # Links made inside every session folder, e.g. benchmark-work -> {root}/benchmark-work,
        # for tools that look for data beside the checkout they run from.
        self.session_links = m.get("session_links", {})
        # Terminal profiles for launch windows: the orchestrator and assistants
        # (leadership) and the lanes (workcrew).
        self.profiles = {"leadership": m.get("leadership_profile", ""),
                         "workcrew": m.get("workcrew_profile", "")}
        # Links made beside the base checkout, in design/.
        self.root_links = m.get("root_links", {})
        # Everything lives under the team folder in the workspace.
        self.home = self.root / "team"
        self.links_dir = self.root.parent / "team-links"
        self.team_file = self.home / "team.json"
        self.sessions_file = self.home / "sessions.json"
        self.general = self.home / "general.log"
        self._repo_name = m.get("repo_name", "")

    @property
    def lab(self):
        return self.mode == "lab"

    @property
    def target(self):
        """The branch lanes push up to and pull down from."""
        return self.base if self.lab else self.exchange

    def designers(self):
        return [n for n, a in self.assistants.items() if a.get("role") == "designer"]

    def spec_authors(self):
        return [OWNER, *self.designers(), self.orc_name()]

    def lane_class_of(self, lane):
        """(model, effort, coder) for a lane: its lane_class when listed, else the team's."""
        for c in self.lane_classes.values():
            if lane in c.get("lanes", []):
                return (c.get("model", self.lane_model), c.get("effort", self.effort),
                        c.get("coder", self.lane_coder))
        return (self.lane_model, self.lane_effort, self.lane_coder)

    def compact_window_of(self, name):
        """The auto-compact window a manifest sets for a session (orc_compact_window,
        an assistant's compact_window, else compact_window), or None: then codeteam
        sets none and Claude Code's own default applies (2026-10-25: the 200k
        default made the models dumber; the 1M-window models compact at about 967k)."""
        default = self.m.get("compact_window")
        if name == "orc":
            v = self.m.get("orc_compact_window", default)
        elif name in self.assistants:
            v = self.assistants[name].get("compact_window", default)
        else:
            v = default
        return int(v) if v else None

    def effort_of(self, name):
        if name == "orc":
            return self.effort
        if name in self.assistants:
            return self.assistants[name].get("effort", self.effort)
        return self.lane_class_of(name)[1]

    def managed(self, name):
        return not self.assistants.get(name, {}).get("external", False)

    def staff(self):
        """The orchestrator and the managed assistants."""
        return ["orc", *[a for a in self.assistants if self.managed(a)]]

    def orc_name(self):
        return f"Orc-{self.title}"

    def display(self, name):
        return self.orc_name() if name == "orc" else name

    @property
    def repo_name(self):
        if not self._repo_name:
            self._repo_name = repo_name_of(self.repo)
        return self._repo_name

    # ---- tiers: one checkout each, shared by the sessions working in it
    def tiers(self):
        return ["design"] if self.lab else ["design", "integration", "exchange"]

    def tier_dir(self, tier):
        return self.root / tier

    def tier_wt(self, tier):
        if tier == "design":
            return self.repo
        if tier == "integration":
            return self.tier_dir(tier) / f"{self.repo_name}-{short(self.base)}-integration"
        if tier == "exchange":
            return self.tier_dir(tier) / f"{self.repo_name}-{short(self.integration)}-exchange"
        sys.exit(f"unknown tier {tier}")

    def tier_branch(self, tier):
        return {"design": self.base, "integration": self.integration, "exchange": self.exchange}[tier]

    def design_wt_expected(self):
        return self.tier_dir("design") / f"{self.repo_name}-{flat(self.base)}"

    def int_wt(self):
        return self.tier_wt("integration")

    def ex_wt(self):
        return self.tier_wt("exchange")

    def tier_of(self, name):
        if name == "orc":
            return "design"
        a = self.assistants.get(name)
        if a and self.managed(name):
            return a.get("tier")       # None for an assistant with its own home
        return None

    def lane_dir(self, lane):
        return self.root / "workcrews" / lane

    def assistant_home(self, name):
        a = self.assistants[name]
        return Path(a.get("home", a.get("worktree", ""))).expanduser()

    def assistant_cwd(self, name) -> Path:
        if not self.managed(name) or not self.tier_of(name):
            return self.assistant_home(name)
        if (self.m.get("land") or {}).get("enabled") and self.tier_of(name) in ("exchange", "integration"):
            return self.session_dir(name)      # v5: those checkouts are retired; Kong reads diffs by command
        return self.tier_wt(self.tier_of(name))

    def session_dir(self, name):
        """The folder holding a session's ledger/ and scratchpad/."""
        tier = self.tier_of(name)
        if tier:
            return self.tier_dir(tier) / self.display(name)
        if name in self.assistants and self.managed(name):
            return self.tier_dir("design") / self.display(name)     # own home: records beside the leaders'
        if name in self.assistants:
            return self.assistant_home(name)
        return self.lane_dir(name)

    def ledger(self, name):
        return self.session_dir(name) / "ledger"

    def scratchpad(self, name):
        return self.session_dir(name) / "scratchpad"

    def lane_channel(self, lane):
        return self.lane_dir(lane) / "ledger" / "channel.log"

    def assistant_channel(self, name):
        if not self.managed(name) or not self.tier_of(name):
            return self.home / f"{name}.log"
        return self.ledger(name) / "channel.log"

    def inbox(self, name):
        """Where messages for a session land, one file each. An external
        assistant's inbox lives in team/, not in its own home."""
        if name in self.assistants and not self.managed(name):
            return self.home / "inboxes" / name
        return self.ledger(name) / "inbox"

    def seen_file(self, name):
        if name in self.assistants and not self.managed(name):
            return self.home / f"{name}.seen.json"
        return self.ledger(name) / "seen.json"

    def expand(self, value: str) -> str:
        v = str(value).replace("{root}", str(self.root)).replace("{home}", str(self.home))
        return str(Path(v).expanduser()) if v.startswith("~") else v

    def pin_dir(self, name):
        return self.root / name

    def pin_branch(self):
        return f"pin/{self.product}"

    def pin_path(self, name, ref=None):
        x = self.pins[name]
        repo = Path(x["repo"]).expanduser()
        return self.pin_dir(name) / f"{repo_name_of(repo)}-{short(ref or x['ref'])}-pin"

    def unit_branch(self, lane, feature):
        return f"unit/{lane}/{feature}"

    def unit_wt(self, lane, feature):
        return self.lane_dir(lane) / f"{self.repo_name}-{lane}-{feature}"

    def link_channel(self, other):
        """A channel shared with another team's orchestrator, or with another
        team's external assistant listed in `links` by name (e.g. Backporter)."""
        return self.links_dir / ("--".join(sorted([self.product, other])) + ".log")

    def assistant_links(self, name):
        """Teams an assistant of this team talks to directly: its `links`."""
        return self.assistants.get(name, {}).get("links", [])

    def assistant_link_channel(self, name, team):
        return self.links_dir / ("--".join(sorted([name, team])) + ".log")

    def cmd(self, verb):
        return f"{TOOL} {verb} {self.manifest}"

    def profile_of(self, name):
        return self.profiles["leadership" if name in self.staff() else "workcrew"]

    def restart_file(self):
        return self.root / "restart-orchestrator.command"


def load_json(p: Path, default):
    return json.loads(p.read_text()) if p.exists() else default


def save_json(p: Path, data):
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
    tmp.replace(p)


def tool_version(name: str) -> str:
    """'<first line of `name --version`> (<path>)' for the tool as resolved under this process's PATH (the PATH
    the gate runs under); 'missing' when it is not on PATH, 'unknown (<path>)' when it will not report a version.
    Never raises: push-up calls it after the branch has already moved on exchange."""
    path = shutil.which(name)
    if path is None:
        return "missing"
    try:
        r = subprocess.run([path, "--version"], capture_output=True, text=True, errors="replace",
                           timeout=10)
    except (OSError, subprocess.SubprocessError):
        return f"unknown ({path})"
    lines = (r.stdout.strip() or r.stderr.strip()).splitlines()
    if r.returncode != 0 or not lines:
        return f"unknown ({path})"
    return f"{lines[0].strip()} ({path})"


_TEAM_LOCK = None


def release_team_lock():
    """Release the team lock load_team(write=True) took, after the caller has saved."""
    global _TEAM_LOCK
    if _TEAM_LOCK is not None:
        _TEAM_LOCK.close()
        _TEAM_LOCK = None


def load_team(t, write=False):
    """Read team.json. With write=True, first take the team lock and hold it until
    this command exits, so two commands never overwrite each other's changes."""
    global _TEAM_LOCK
    if write and _TEAM_LOCK is None and t.team_file.parent.exists():
        import fcntl
        _TEAM_LOCK = open(t.team_file.with_suffix(".lock"), "a")
        fcntl.flock(_TEAM_LOCK, fcntl.LOCK_EX)
    team = load_json(t.team_file, None)
    if not team:
        sys.exit(f"no team at {t.home}; run codeteam init first")
    return team


def resolve_base(t: Team) -> str:
    if branch_exists(t.repo, t.base):
        return t.base
    if ref_exists(t.repo, f"origin/{t.base}"):
        # LIFTED fallback idea (create_worktree): use the other side when one is missing.
        return f"origin/{t.base}"
    sys.exit(f"base branch '{t.base}' not found locally or on origin in {t.repo}")


def discover_lanes(t: Team, base_ref: str) -> dict:
    """Lane name -> lane record.

    Lane kinds in the manifest:
      glob = "packages/kits/*"           one directory lane per match
      path = "benchmark-ee"              one directory lane
      name = "training", path = "."      a function lane: whole repo, walls = its job
      name = "tooling", path = ".", owns = ["tools", "Makefile"]   whole repo, walls = these paths
      name = "harness", repo = "...", ref = "..."   pinned to another repo's ref
    Optional on any: role (default "owner"), job, guide (default <path>/AGENTS.md),
    workdir (a folder outside the repo where the session starts, such as a data
    folder; code changes still go through the lane's worktree).
    """
    lanes = {}

    def add(name, rec):
        if name in lanes and lanes[name]["path"] != rec["path"]:
            sys.exit(f"lane name clash '{name}': {lanes[name]['path']} and {rec['path']}")
        lanes[name] = rec

    def record(spec, name, path):
        guide = spec.get("guide") or (f"docs/lanes/{name}.md" if path == "." else f"{path}/AGENTS.md")
        return {"path": path, "role": spec.get("role", "owner"),
                "job": spec.get("job", ""), "guide": guide,
                "repo": spec.get("repo", ""), "ref": spec.get("ref", ""),
                "workdir": spec.get("workdir", ""), "owns": spec.get("owns", []), "test": spec.get("test", "")}

    for spec in t.lane_specs:
        if spec.get("repo"):
            repo = Path(spec["repo"]).expanduser()
            name = spec.get("name") or sys.exit(f"pinned lane needs a name: {spec}")
            ref = spec.get("ref") or sys.exit(f"pinned lane '{name}' needs a ref")
            if not ref_exists(repo, ref):
                warn(f"lane '{name}': ref {ref} not found in {repo}; skipped")
                continue
            add(name, record(spec, name, spec.get("path", ".")))
        elif "glob" in spec:
            g = spec["glob"].strip("/")
            parent, pattern = g.rsplit("/", 1) if "/" in g else ("", g)
            ref = f"{base_ref}:{parent}" if parent else base_ref
            r = git(t.repo, "ls-tree", "-d", "--name-only", ref, check=False)
            if r.returncode:
                warn(f"lane glob '{g}': '{parent}' is not in {base_ref}; skipped")
                continue
            for name in r.stdout.split():
                if fnmatch.fnmatch(name, pattern):
                    add(name, record(spec, name, f"{parent}/{name}" if parent else name))
        elif "path" in spec:
            p = spec["path"].strip("/") or "."
            name = spec.get("name") or Path(p).name
            if p != "." and git(t.repo, "cat-file", "-e", f"{base_ref}:{p}", check=False).returncode:
                warn(f"lane path '{p}' is not in {base_ref}; skipped")
                continue
            for x in spec.get("owns", []):
                if git(t.repo, "cat-file", "-e", f"{base_ref}:{x}", check=False).returncode:
                    warn(f"lane '{name}': owned path '{x}' is not in {base_ref}")
            add(name, record(spec, name, p))
    return dict(sorted(lanes.items()))


def lane_repo(t, rec) -> Path:
    return Path(rec["repo"]).expanduser() if rec.get("repo") else t.repo


def lane_branch(t, name, rec) -> str:
    """lane/<lane>; a lane pinned to another repo's ref works on pin/<product>/<lane>."""
    return f"pin/{t.product}/{name}" if rec.get("ref") else t.prefix + name


def lane_wt(t, name, rec) -> Path:
    """<repo>-<parent>-<lane>, inside workcrews/<lane>/."""
    if rec.get("ref"):
        return t.lane_dir(name) / f"{repo_name_of(lane_repo(t, rec))}-{short(rec['ref'])}-{name}"
    return t.lane_dir(name) / f"{t.repo_name}-{short(t.target)}-{name}"


def _zone_folder_lane(t, rec) -> bool:
    return landing(t) and not rec.get("ref")


def lane_cwd(t, name, rec) -> Path:
    if _zone_folder_lane(t, rec):
        return t.lane_dir(name)      # v5: no standing worktree; work order trees come from integration
    if rec.get("workdir"):
        return Path(rec["workdir"]).expanduser()
    wt = lane_wt(t, name, rec)
    return wt if rec["path"] == "." else wt / rec["path"]


def lane_ledger_dir(t, name, rec) -> Path:
    """Use the zone folder for v5 lanes without a ref, which have no standing worktree; otherwise use the lane worktree."""
    return t.lane_dir(name) if _zone_folder_lane(t, rec) else lane_wt(t, name, rec)


# ---------------------------------------------------------------- worktrees

def remember(team, key, value):
    team.setdefault(key, [])
    if value not in team[key]:
        team[key].append(value)


def guard_push(t, branch):
    if t.local_only:
        # Implicit `git push` on this branch goes to a remote that does not
        # exist and fails. Scoped to this branch; teardown removes it.
        git(t.repo, "config", f"branch.{branch}.pushRemote", "codeteam-no-push")


def ensure_branch(t, team, name, start):
    if branch_exists(t.repo, name):
        if git(t.repo, "merge-base", "--is-ancestor", start, name, check=False).returncode:
            warn(f"branch {name} does not descend from {start}")
        say_line(f"branch {name}: kept")
        return
    git(t.repo, "branch", name, start)
    remember(team, "created_branches", {"name": name, "repo": str(t.repo)})
    guard_push(t, name)
    say_line(f"branch {name}: created from {start}")


def ensure_worktree(t, team, path: Path, branch, start=None, repo=None) -> bool:
    """LIFTED (create_worktree): an existing worktree is reused, never
    recreated. Adapted: the path must belong to the repository, and a
    repo-wide prune runs only when git reports stale metadata for this
    exact path -- other worktrees in flight are left alone.

    Every worktree is on a branch. An existing branch is checked out; a new
    one is cut from `start`."""
    repo = repo or t.repo
    if path.exists():
        if common_dir(path) != common_dir(repo):
            sys.exit(f"{path} exists and is not a worktree of {repo}")
        clean_git_locks(path)
        if head_branch(path) != branch:
            warn(f"{path} is on '{head_branch(path) or 'no branch'}', not {branch}")
        say_line(f"worktree {path.name}: reused")
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    new_branch = None
    if branch_exists(repo, branch):
        args = ["worktree", "add", path, branch]
    else:
        args = ["worktree", "add", "-b", branch, path, start]
        new_branch = branch
    r = git(repo, *args, check=False)
    if r.returncode and "missing but" in r.stderr:
        git(repo, "worktree", "prune")          # LIFTED: prune before add
        r = git(repo, *args, check=False)
    if r.returncode:
        sys.exit(f"git {' '.join(map(str, args))} failed:\n{r.stderr.strip()}")
    remember(team, "created_worktrees", {"path": str(path), "repo": str(repo)})
    if new_branch:
        remember(team, "created_branches", {"name": new_branch, "repo": str(repo)})
        if repo == t.repo:
            guard_push(t, new_branch)
    say_line(f"worktree {path.name}: created on {branch}")
    return True


def _codegraph_exe():
    """The codegraph CLI: CODETEAM_CODEGRAPH when set and non-empty, else the first codegraph on PATH. The override
    exists because this file puts /opt/homebrew/bin first on PATH (above), so a test cannot shadow codegraph with a
    PATH stub; it is the same pattern as CODETEAM_CLAUDE_JSON and CODETEAM_WINDOWS."""
    return os.environ.get("CODETEAM_CODEGRAPH") or shutil.which("codegraph")


def pin_codegraph(path: Path):
    """Pin a standing worktree (a tier checkout or a lane's standing worktree) in CodeGraph, so the
    MCP servers that open it never idle-release it or evict it from their project cache (request
    worktrees stay unpinned). `codeteam init` calls it only for a worktree it has just
    created: the go-live step pinned the ones that already existed. Best effort: with no codegraph
    CLI, a CLI that cannot be started, or a failed pin, init carries on with a warning."""
    exe = _codegraph_exe()
    if not exe:
        warn(f"worktree {path.name}: not pinned in CodeGraph (no codegraph on PATH)")
        return
    try:
        r = subprocess.run([exe, "project", "pin", str(path)], capture_output=True, text=True,
                           env=dict(os.environ, DO_NOT_TRACK="1"))
    except OSError as e:
        warn(f"worktree {path.name}: codegraph could not be started to pin it: {e}")
        return
    if r.returncode:
        warn(f"worktree {path.name}: codegraph project pin failed: {(r.stderr or r.stdout).strip()}")
    else:
        say_line(f"worktree {path.name}: pinned in CodeGraph")
    seed_codegraph(path)


def seed_codegraph(path: Path):
    """Give a worktree a CodeGraph index now, seeded from its nearest sibling that has one (bin/codeteam-seed-index,
    about a second). CodeGraph seeds only on the first query in a worktree, and skips a pinned project that has no
    index, so most of one team's lane worktrees never had one. Best effort."""
    tool = TOOL_DIR / "bin" / "codeteam-seed-index"
    try:
        r = subprocess.run([str(tool), str(path)], capture_output=True, text=True, timeout=120,
                           env=dict(os.environ, DO_NOT_TRACK="1"))
        say_line((r.stdout or r.stderr).strip() or f"worktree {path.name}: codegraph seed rc {r.returncode}")
    except (OSError, subprocess.TimeoutExpired) as e:
        warn(f"worktree {path.name}: codegraph seed: {e}")


def unregister_codegraph(scopes, dry_run=False):
    """Unregister from CodeGraph every registered root that is, or lies under, one of the folders in scopes.
    The roots come from `project list --json` and each is removed exactly as listed, never a scope path blindly:
    CodeGraph resolves an unindexed path up to an indexed ancestor, so a blind remove could unregister a parent
    project. `project remove` does that resolution too, so a listed root with no index of its own under a
    registered, indexed folder outside the scopes would still unregister that folder; no team layout today puts a
    team's worktrees under one. Paths are compared resolved, since macOS /tmp and /var are symlinks. `project remove` deletes
    nothing on disk. With dry_run the list (read only) says what would go. Best effort: with no CLI, a CLI that
    cannot be started, a list that fails or is not JSON, or a failed remove, teardown carries on with a warning."""
    exe = _codegraph_exe()
    if not exe:
        warn("CodeGraph: roots not unregistered (no codegraph on PATH)")
        return
    env = dict(os.environ, DO_NOT_TRACK="1")

    def run(*args):
        try:
            r = subprocess.run([exe, "project", *args], capture_output=True, text=True, env=env)
        except OSError as e:
            warn(f"CodeGraph: codegraph could not be started: {e}")
            return None
        if r.returncode:
            warn(f"CodeGraph: codegraph project {args[0]} failed: {(r.stderr or r.stdout).strip()}")
            return None
        return r

    listed = run("list", "--json")
    if not listed:
        return
    try:
        entries = json.loads(listed.stdout)
    except ValueError:
        warn("CodeGraph: codegraph project list --json did not print JSON; roots not unregistered")
        return
    folders = [Path(s).resolve() for s in scopes]
    for root in [e["root"] for e in entries if isinstance(e, dict) and "root" in e]:
        if not any(Path(root).resolve().is_relative_to(f) for f in folders):
            continue
        if dry_run:
            say_line(f"would unregister {root} from CodeGraph")
        elif run("remove", root):
            say_line(f"CodeGraph: unregistered {root}")


def backup(t, *branches):
    """Push each branch to origin as a backup. The base is never pushed here:
    the base is shipped by the session that owns shipping."""
    if not t.backup:
        return
    if git(t.repo, "remote", "get-url", "origin", check=False).returncode:
        return
    for b in branches:
        if b == t.base:
            continue
        r = git(t.repo, "push", "-q", "--force", "origin", f"refs/heads/{b}:refs/heads/{b}", check=False)
        if r.returncode:
            warn(f"backup push of {b} failed: {r.stderr.strip()[-200:]}")


def link(dst: Path, src: Path, quiet=False) -> bool:
    """Make dst a symlink to src. True when it made or replaced the link; False when it was already
    right or a real file or folder is in place (that one is left alone, and warned about unless quiet)."""
    if dst.is_symlink():
        if Path(os.readlink(dst)) == src:
            return False
        dst.unlink()
    elif dst.exists():
        if not quiet:
            warn(f"{dst} is a real file or folder; left in place")
        return False
    dst.symlink_to(src)
    return True


SKILLS_MARK = "# codeteam: team skills linked into a tracked .claude/skills"


def link_team_skills(tree, skills_home):
    """When the repo tracks its own .claude/skills (a fork that keeps upstream's own skills), the team's
    skills cannot be one link over the folder: each is linked into it by name, a name already there is left alone,
    and each link is kept out of git by the repo's info/exclude. A link git would still see (a .gitignore of the
    repo's un-ignores it) is removed again, never left to be committed. Returns (linked, refused) names. Never raises
    (2026-11-09: one team's sessions and work order trees had none of the team's skills)."""
    linked, refused = [], []
    try:
        d = Path(tree) / ".claude" / "skills"
        home = Path(skills_home)
        if not d.is_dir() or d.is_symlink() or not home.is_dir():
            return linked, refused
        names = [p.name for p in sorted(home.iterdir()) if p.is_dir() and not p.name.startswith(".")]
        todo = [n for n in names if not (d / n).exists() and not (d / n).is_symlink()]
        if not todo:
            return linked, refused
        gd = subprocess.run(["git", "-C", str(tree), "rev-parse", "--path-format=absolute", "--git-common-dir"],
                            capture_output=True, text=True, timeout=10).stdout.strip()
        if not gd:
            return linked, refused
        ex = Path(gd) / "info" / "exclude"
        ex.parent.mkdir(parents=True, exist_ok=True)
        text = ex.read_text() if ex.exists() else ""
        want = [f"/.claude/skills/{n}" for n in names if f"/.claude/skills/{n}\n" not in text]
        if want:
            if SKILLS_MARK not in text:
                text = text.rstrip("\n") + ("\n" if text.strip() else "") + SKILLS_MARK + "\n"
            ex.write_text(text + "".join(w + "\n" for w in want))
        for n in todo:
            (d / n).symlink_to(home / n)
            r = subprocess.run(["git", "-C", str(tree), "check-ignore", "-q", f".claude/skills/{n}"], timeout=10)
            if r.returncode == 0:
                linked.append(n)
            else:
                (d / n).unlink()
                refused.append(n)
    except (OSError, subprocess.SubprocessError):
        pass
    return linked, refused


def ours(claude_dir: Path) -> bool:
    """A .claude folder codeteam made: it carries a .gitignore of `*`."""
    gi = claude_dir / ".gitignore"
    return gi.exists() and gi.read_text().strip() == "*"


def foreign_claude(d: Path) -> bool:
    """A .claude folder that holds another product's own files: it exists, is not one codeteam made, and has
    a real file or folder (not a link) among CLAUDE_ENTRIES. An own-home assistant's home can be another
    product's checkout with its own agents/, hooks/ and skills/; a home codeteam linked by hand holds only
    links, so it is not foreign and gets relinked."""
    if not d.exists() or ours(d):
        return False
    return any((d / e).exists() and not (d / e).is_symlink() for e in CLAUDE_ENTRIES)


def provision_claude(t, launch_dir: Path, memory_dir: Path, quiet=False) -> bool:
    """LIFTED idea (_provision_claude_dir):

    .claude/ is gitignored, so a fresh worktree checks out NONE of it --
    no settings.json, and critically no hooks/ scripts. A worktree must
    have that tree provided explicitly or every hook referenced by
    settings.json ENOENTs and the write-scope / push gates run as silent
    no-ops.

    Adapted: entries link to the codeteam home, never to the product's
    base checkout. A checkout's own .claude (the base checkout's) is left
    exactly as it is.

    Safe to run again: init, unit (a unit's worktree) and every render (relink_claude) run it, so a session
    folder picks up entries added to the claude home later. True when anything changed (the folder,
    the .gitignore, a link or the memory folder was made or replaced). quiet is the render's pass: it
    says nothing about the base checkout's kept .claude, nor about a real file left in place.
    """
    d = launch_dir / ".claude"
    changed = False
    # Only the base checkout keeps its own .claude untouched. A worktree codeteam
    # made can track files under .claude (PROJECT.md); it still gets the links.
    if launch_dir.resolve() == t.repo.resolve() and d.exists() and not ours(d):
        linked, refused = link_team_skills(launch_dir, t.home / "claude" / "skills")
        if refused:
            warn(f"{d}/skills: team skills not linked, the repo's .claude/.gitignore would show them: {', '.join(refused)}")
        if not quiet:
            say_line(f"{launch_dir.name}: its own .claude kept" + (f"; team skills linked: {len(linked)}" if linked else ""))
        return bool(linked)
    if not d.exists():
        d.mkdir(parents=True)
        changed = True
    # Keep this folder out of `git status` without touching the shared
    # repo's info/exclude, which every other worktree reads.
    gi = d / ".gitignore"
    if not gi.exists():
        gi.write_text("*\n")
        changed = True
    for e in CLAUDE_ENTRIES:
        src = t.home / "claude" / e
        if e == "skills" and (d / e).is_dir() and not (d / e).is_symlink():
            linked, refused = link_team_skills(launch_dir, src)     # the repo tracks .claude/skills: link by name
            if refused:
                warn(f"{d}/skills: team skills not linked, a .gitignore would show them: {', '.join(refused)}")
            changed |= bool(linked)
            continue
        if src.exists():
            changed |= link(d / e, src, quiet)
    if not memory_dir.exists():
        memory_dir.mkdir(parents=True)
        changed = True
    changed |= link(d / "agent-memory", memory_dir, quiet)
    return changed


def relink_claude(t, team):
    """Quietly provision eligible session folders so renders pick up entries added to the claude home.
    Missing folders are skipped except v5 session folders: managed exchange- or integration-tier assistants'
    folders on a land-enabled team. Init makes those only for the assistants it sees, so render creates one
    for an assistant added after init; it creates no worktrees.
    Print one line naming folders whose provisioning changed something, or none when nothing changed.
    On an OSError creating a folder or provisioning .claude, warn with the .claude path and error and continue.

    Order, the first of a folder wins: tier checkouts (design, then integration and exchange for non-lab
    teams); managed assistants in manifest order, using their own homes unless those hold another product's
    .claude, or their v5 session folders when different from their tier checkout; then lane start folders.
    Init's own provisioning loops skip own-home assistants. External assistants are never touched."""
    seen, changed = set(), []

    def run(d: Path, memory: Path, *, create=False):
        if (not create and not d.is_dir()) or d.resolve() in seen:
            return
        seen.add(d.resolve())
        # A folder that cannot be created or provisioned must not abort the render: v2's scheduler reload
        # renders through here and would drop the manifest change. Warn and go on; the folder stays in seen
        # and is not counted as changed, even if provisioning changed something before the error.
        try:
            if create and not d.exists():
                d.mkdir(parents=True)
            if provision_claude(t, d, memory, quiet=True):
                changed.append(d.name)
        except OSError as e:
            warn(f"claude links: could not update {d / '.claude'}: {e}")

    for tier in t.tiers():
        run(t.tier_wt(tier), t.tier_dir(tier) / "agent-memory")
    for n in t.assistants:
        if t.managed(n) and not t.tier_of(n):
            home = t.assistant_home(n)
            if not foreign_claude(home / ".claude"):
                run(home, t.ledger(n) / "memory")
        elif t.managed(n) and t.assistant_cwd(n) != t.tier_wt(t.tier_of(n)):
            # v5: exchange and integration staff work in their session folder (those checkouts are retired)
            run(t.assistant_cwd(n), t.tier_dir(t.tier_of(n)) / "agent-memory", create=True)
    for n, r in team["lanes"].items():
        run(lane_cwd(t, n, r), t.ledger(n) / "memory")
    if changed:
        say_line("claude links: updated in " + ", ".join(changed))


def make_session_folders(t, name, channel=True):
    """ledger/ (medium term, backed up) and scratchpad/ (short term, excluded
    from Time Machine) for one session."""
    led = t.ledger(name)
    (led / "reports").mkdir(parents=True, exist_ok=True)
    (led / "memory").mkdir(parents=True, exist_ok=True)
    for f, title in (("todo.md", "Todo"), ("issues.md", "Issues")):
        if not (led / f).exists():
            (led / f).write_text(f"# {title}\n\n## Open\n\n## Closed\n")
    if channel:
        (led / "channel.log").touch()
    sp = t.scratchpad(name)
    if not sp.exists():
        sp.mkdir(parents=True)
        r = subprocess.run(["tmutil", "addexclusion", str(sp)], capture_output=True, text=True)
        if r.returncode:
            warn(f"Time Machine exclusion failed for {sp}: {r.stderr.strip()}")


def seed_claude_home(t):
    dst = t.home / "claude"
    if dst.exists():
        say_line("claude home: kept")
        return
    dst.mkdir(parents=True)
    if not t.claude_source or not t.claude_source.exists():
        warn("no claude_source; claude home starts empty")
        return
    for e in CLAUDE_ENTRIES:
        src = t.claude_source / e
        if src.is_dir():
            shutil.copytree(src, dst / e, symlinks=False)
        elif src.is_file():
            shutil.copy2(src, dst / e)
    say_line(f"claude home: seeded from {t.claude_source}")


# ---------------------------------------------------------------- roles

def coord_name(lane):
    """Lane sessions are coordinators; the team has one orchestrator."""
    return f"Coord-{lane}"


def render(template: str, values: dict) -> str:
    for k, v in values.items():
        template = template.replace("{{" + k + "}}", str(v))
    return template


def common_values(t):
    return {
        "product": t.product, "title": t.title, "orc": t.orc_name(), "manifest": t.manifest,
        "base": t.base, "exchange": t.exchange, "integration": t.integration,
        "general": t.general, "channels": t.root / "workcrews",
        "say": t.cmd("say"), "types": ", ".join(MESSAGE_TYPES),
        "repo": t.repo, "design_wt": t.repo,
        "integration_worktree": "" if t.lab else t.int_wt(),
        "exchange_worktree": "" if t.lab else t.ex_wt(),
        "push_up": t.cmd("push-up"), "pull_down": t.cmd("pull-down"),
        "land": f"{TOOL_DIR / 'bin' / 'codeteam-land'} {t.manifest}",
        "unit": t.cmd("unit"), "squash": t.cmd("squash"), "ready": t.cmd("ready"),
        "integrate": t.cmd("integrate"), "promote": t.cmd("promote"),
        "discard": t.cmd("discard"), "approve": t.cmd("approve"), "retire": t.cmd("retire"), "accept": t.cmd("accept"), "remove_worktree": t.cmd("remove-worktree"),
        "backup_cmd": t.cmd("backup"), "snapshot": t.cmd("snapshot"),
        "drop": t.cmd("drop"), "status": t.cmd("status"),
        "builder": t.builder or t.orc_name(), "guard": t.guard or t.orc_name(),
        "guard_ledger": str(t.ledger(t.guard)) if t.guard else "",
        "launch": t.cmd("launch"), "sleep_cmd": t.cmd("sleep"), "watch": t.cmd("watch"), "cmd_await": t.cmd("await"),
        "link_guides": t.cmd("link-guides"),
        "spec_authors": ", ".join(t.spec_authors()),
        "designer": (t.designers() or [t.orc_name()])[0],
        "designer_channel": (t.assistant_channel(t.designers()[0]) if t.designers() else t.general),
        "rulings": t.rulings, "deciders": ", ".join(deciders(t)),
        "questions": t.home / "questions.md",
        "question": f"{TOOL_DIR / 'bin' / 'codeteam-question'} {t.manifest}",
        "settled": t.home / "settled.md",
        "open_route": (f"send it to {t.designers()[0]} as a REQUEST on `{t.assistant_channel(t.designers()[0])}`, with the "
                       "coordinator's checks, your own and your recommendation" if t.designers() else
                       f"add one line to `{t.home / 'questions.md'}`, oldest first, starting `- `, with a short id, the "
                       "question, your recommendation and `checked:` naming what was checked; the status bar shows the "
                       "user the oldest one"),
        "status_file": t.home / "status.md",
        "target": t.target, "branch_rows": branch_rows(t),
        # Keep landing-only text out of non-landing teams' rendered roles.
        "landing_note": (
            "\n\nOn a team that lands with codeteam-land (branch flow v5.4, `docs/SPEC-branch-flow-v5.4.md` in the codeteam checkout): "
            f"`{t.base}` holds proven code and moves only at Stage 7, by fast-forward; "
            f"`{t.integration}` is a copy of `{t.base}`, fast-forwarded right after it moves, and every work order "
            f"tree is cut from it; `{landing_branch(t)}` holds work that has landed and is not yet proven, and moves "
            "only at Stage 4. Kong reviews each work order before it lands (Stage 3) and sends findings back to "
            "its zone's coordinator. Stage 7 promotes on test results only and tells only the coordinators whose "
            "open work orders the promote reaches. Only the landing tool moves the three; nobody commits on them "
            "directly." if landing(t) else ""),
        "dev_target": landing_branch(t) if landing(t) else t.integration,
        "review_note": (f" and asks {t.guard} to review it" if t.guard and t.guard_per == "push" else ""),
        # The harness rule: every team but codeteam, whose product is the harness.
        # The process rule: process is team codeteam's, everywhere, and comes to
        # the owner through it. codeteam's own orchestrator gets the other half: bring each request to the owner first.
        # With no team codeteam (no teams/codeteam.toml in this checkout), process requests go to the owner directly.
        "harness_rule": (PROCESS_RULE_CODETEAM if t.product == "codeteam" else PROCESS_RULE.format(
            orc=t.orc_name(), say=f"{TOOL_DIR / 'v2' / 'bin' / 'codeteam2'} say {TOOL_DIR / 'teams' / 'codeteam.toml'} general")
            if (TOOL_DIR / "teams" / "codeteam.toml").exists() else PROCESS_RULE_OWNER.format(orc=t.orc_name())),
        "backup_note": ("Every branch codeteam moves is pushed to origin as a backup; "
                        f"`{t.base}` is pushed by whoever ships it." if t.backup else
                        "This team keeps its branches local."),
    }


PROCESS_RULE = (
    "## Your work, and what is not yours\n\n"
    "Your work is this team's product. How work is built, tested, gated, committed, pushed and landed is process, and "
    "process is team codeteam's: the harness (codeteam, the agent catalog, role and agent files, `.claude` settings, "
    "rules and hooks, herdr) and also any process machinery inside your repo (git hooks, gate and push-check scripts, "
    "test-runner wrappers, Makefile guard targets). Never build or change process yourself, and never write a ruling "
    "that adds a mechanical check. When something in the process is slow, wrong or missing, {orc} sends team codeteam "
    "one REQUEST with the problem, the evidence and what it costs: `{say} {orc} REQUEST Orc-Codeteam \"<text>\"`. "
    "Team codeteam brings it to the owner, who decides. Lanes tell {orc}; then carry on with the product.")

PROCESS_RULE_OWNER = (
    "## Your work, and what is not yours\n\n"
    "Your work is this team's product. How work is built, tested, gated, committed, pushed and landed is process: the "
    "harness (codeteam, the agent catalog, role and agent files, `.claude` settings, rules and hooks, herdr) and also "
    "any process machinery inside your repo (git hooks, gate and push-check scripts, test-runner wrappers, Makefile "
    "guard targets). Never build or change process yourself, and never write a ruling that adds a mechanical check. "
    "When something in the process is slow, wrong or missing, {orc} tells the owner once, with the problem, the "
    "evidence and what it costs; the owner decides. Lanes tell {orc}; then carry on with the product.")

PROCESS_RULE_CODETEAM = (
    "## Requests from other teams\n\n"
    "Other teams' orchestrators send you process requests (build, test, gate, commit, push, landing). Each one goes "
    "to the owner for a decision before any work: put it to them with the problem, the evidence, the cost and your "
    "recommendation. Never implement one they have not approved, and never let a team build process in its own repo.")


def deciders(t):
    """The sessions whose READY a move up needs."""
    return [t.orc_name(), *[x for x in (t.builder, t.guard) if x]]


# codeteam posts nothing to `all`. v2 prompts every awake staff
# session with a message to `all`, so each post names only the sessions that act on it.

def ready_recipients(t, sender):
    """A READY goes to the other deciders. When the orchestrator is the only decider
    that list is empty and TO cannot be, so it names the orchestrator; deliver() never
    delivers to the sender, so nobody is prompted."""
    return ",".join(x for x in deciders(t) if x != sender) or t.orc_name()


def tier_recipient(t):
    """Who hears that integration or the base branch moved, or that an integrate was
    discarded: the guard, or the orchestrator when the team has none."""
    return t.guard or t.orc_name()


def base_recipients(t):
    """Who hears that the base branch moved: tier_recipient(t), and each managed
    backporter, whose role ships the base when that PUSHED lands on General. An
    external backporter is told on its own channel instead (cmd_promote)."""
    ships = [x for x, a in t.assistants.items()
             if t.managed(x) and a.get("role", x).lower() == "backporter"]
    return ",".join([tier_recipient(t), *ships])


def branch_rows(t, lane_branch="Lane branches"):
    if landing(t):
        return (f"| `{t.base}` | Proven code; moved only by Stage 7, by fast-forward. |\n"
                f"| `{t.integration}` | A copy of `{t.base}`, fast-forwarded to it right after it moves; "
                "every work order tree is cut from it. |\n"
                f"| `{landing_branch(t)}` | Work that has landed and is not yet proven; moved only by Stage 4. |\n"
                f"| Work order tree | One work order, cut from `{t.integration}`, moved by its agent. |")
    if t.lab:
        return (f"| `{t.base}` | Default branch; the shipping code. Lanes squash their work onto it. |\n"
                f"| {lane_branch} | One per lane, cut from `{t.base}` |\n"
                f"| `unit/<lane>/<feature>` | One per worker and feature, cut from its lane |")
    return (f"| `{t.base}` | Default branch; the shipping code |\n"
            f"| `{t.integration}` | Cut from `{t.base}`; where the house is put in order |\n"
            f"| `{t.exchange}` | Cut from `{t.integration}`; where lanes trade work; often red |\n"
            f"| {lane_branch} | One per lane, cut from `{t.exchange}` |\n"
            f"| `unit/<lane>/<feature>` | One per worker and feature, cut from its lane |")


def landing(t):
    """The team lands with codeteam-land (branch flow v5.4)."""
    return bool((t.m.get("land") or {}).get("enabled"))


def landing_branch(t: Team) -> str:
    return (t.m.get("land") or {}).get("landing", "landing")


LAND_ORC_BULLETS = (
    "- Work lands one work order at a time through `{land} queue-run` (v5.4): before it lands, the tool checks it "
    "(Stage 2: the whole-repo type check, every zone the change reaches, the repo's gates) and Kong reviews the "
    "work order's own commits (Stage 3; a work order the tool makes itself skips review, by the tool's record). "
    "Findings go back to the zone's coordinator and nothing lands; reviewed "
    "work orders are merged onto the landing branch (Stage 4). You do not sequence or hold landings unless you "
    "choose to (`land-next`, `land-hold`).\n"
    "- A zone that needs another zone's change asks you; you send it to the owning zone as a work order. When "
    "Stage 7 promotes it, the waiting zone is told and pulls it. No zone ever takes another's unfinished work.")


def landing_promotion(t):
    L = f"codeteam-land {t.manifest}"
    return (f"Every change reaches `{landing_branch(t)}` only through the landing tool, and `{t.base}` only by "
            f"promotion (spec v5.4). `{t.integration}` is a copy of `{t.base}` that work order trees are cut from.\n\n"
            f"1. Queue and order: `{L} queue`, `{L} land-next <wo>`, `{L} land-hold <wo>`.\n"
            f"2. A work order that bounces with call sites in other zones (an interface change): open a work order in "
            f"each affected zone for its part, and have the set queued together: `{L} land <wo> --with <wo2> ...`.\n"
            "3. Before landing: Stage 2 checks the work order in its own tree; Kong reviews the work order's own "
            "commits (Stage 3). On teams with Perkins, Perkins reviews it too if it changes files matching the globs "
            "in `[land].security_paths`; with no list, Perkins reviews nothing before landing. Work orders the "
            "landing tool makes itself skip review, identified by the tool's own record and commit trailer, not "
            "their name. Findings go back to the zone's coordinator, the tree is kept and nothing lands. Stage 4 "
            f"merges reviewed work orders onto `{landing_branch(t)}` one at a time.\n"
            f"4. After landing: overlapping landings are rechecked (Stage 5), and `{L} validate-run` validates the "
            f"newest `{landing_branch(t)}` commit whose rechecks are all finished, on the build box (Stage 6). A "
            "recheck failure or a newly failing validation test opens a fix work order for its zone; nothing is "
            "reverted for it. Nagatha's rounds after landing write tests; their findings open work orders and never "
            "hold promotion.\n"
            f"5. Promote: Stage 7 fast-forwards `{t.base}` to the newest `{landing_branch(t)}` commit C where Stage 6 "
            "passed and every recheck or validation failure at or before C was fixed at or before C (by ancestry). "
            f"Test results only, no findings list. Then it fast-forwards `{t.integration}` to `{t.base}`, tells only "
            "the coordinators of open work orders whose zone, or a direct dependency of it, changed between the old "
            f"and new `{t.integration}`, and restarts what the promote changed. `{L} promote [HASH]` runs Stage 7 "
            "now under the same conditions; it refuses with its reason and has no override.\n"
            f"6. Your own edits and the designer's (docs, rulings, specs) land like any change: `{L} wo-cut orc <name>`, "
            f"edit and commit in that tree, `{L} land <name>`. Nobody commits on `{t.base}`, `{t.integration}` or "
            f"`{landing_branch(t)}` directly; the guard refuses it.\n"
            f"7. Move-over, once per team (not lab teams): `{L} migrate-v54` renames the old `{t.integration}` "
            f"branch to `{landing_branch(t)}` by pointer, installs the hook, sets `{t.integration}` to `{t.base}`, "
            f"queues one recheck of every zone at `{landing_branch(t)}`'s tip and asks Kong for one backlog review per "
            f"zone that changed between `{t.base}` and that tip. From then on, Stages 6 and 7 take only that tip or commits after it.")


def promotion_text(t):
    if landing(t):
        return landing_promotion(t)
    if t.lab:
        return (f"This team is a lab. Lanes squash each feature straight onto `{t.base}` with "
                "push-up; there is no integration step. You name the features, coordinate "
                "requests between lanes and keep linked teams informed.")
    who = " and ".join(deciders(t))
    return (f"Work moves up as named features. You choose each feature's name and give it to "
            f"the lanes with the work.\n\n"
            f"1. When a set of features on `{t.exchange}` is settled, post a REQUEST naming the set "
            f"on General addressed to {','.join(x for x in (t.builder, t.guard) if x) or 'yourself'}.\n"
            f"2. Each of {who} posts READY when satisfied: "
            f"`{t.cmd('ready')} <you> integrate <feature> ...`.\n"
            f"3. {t.builder or 'You'} runs `{t.cmd('integrate')} -m \"<summary>\" <feature> ...`, "
            f"which squashes the set onto `{t.integration}`.\n"
            f"4. When `{t.integration}` is settled, the same three post READY for `promote`, and "
            f"{t.builder or 'you'} runs `{t.cmd('promote')} -m \"<summary>\"`.\n"
            f"5. When a feature is on `{t.integration}` and working, approve it: "
            f"`{t.cmd('approve')} <feature>`. Its lanes then remove its worker worktrees.")


def folders_section(t, team, name):
    """The 'Your folders' and 'Housekeeping' sections for one session's role file."""
    led, sp = t.ledger(name), t.scratchpad(name)
    rows = []
    tier = t.tier_of(name)
    if not tier and name in t.assistants:
        rows.append((t.assistant_home(name), "Your checkout: your own home."))
    elif tier and landing(t) and tier in ("exchange", "integration"):
        rows.append((t.session_dir(name), "Your folder. There is no exchange or integration checkout (spec v5): "
                                          "read a work order's diff with the command its REQUEST gives."))
    elif tier:
        others = [t.display(x) for x in t.staff() if x != name and t.tier_of(x) == tier]
        shared = f" Shared with {', '.join(others)}." if others else ""
        rows.append((t.tier_wt(tier), f"Your checkout, on `{t.tier_branch(tier)}`.{shared}"))
        if tier == "design" and (name == "orc" or t.assistants.get(name, {}).get("role") == "designer") and landing(t):
            rows.append((t.root / "wo", "Every work order tree; yours to read, and `orc` ones to work in"))
        elif tier == "design" and (name == "orc" or t.assistants.get(name, {}).get("role") == "designer"):
            for low in t.tiers()[1:]:
                rows.append((t.tier_wt(low), f"The `{t.tier_branch(low)}` checkout; yours to work in when needed"))
            rows.append((t.root / "workcrews", "Every lane and worker checkout; yours to work in when needed"))
    elif landing(t) and not team["lanes"][name].get("ref"):
        rows.append((t.root / "wo" / name, "Your work order trees, one per work order, cut from "
                                            f"`{t.integration}` by codeteam when a lead starts; deleted when it lands."))
    else:
        r = team["lanes"][name]
        rows.append((lane_wt(t, name, r), f"Your lane worktree on `{lane_branch(t, name, r)}`. "
                                          "Features squash into it; push-up runs here."))
        if not r.get("ref"):
            rows.append((t.unit_wt(name, "<feature>"),
                         f"Worker worktrees, one per feature, on `unit/{name}/<feature>`. "
                         f"Create each with `{t.cmd('unit')} {name} <feature>`."))
        if r.get("workdir"):
            rows.append((Path(r["workdir"]).expanduser(), "Your data folder, outside git"))
    for lname, target in t.session_links.items():
        rows.append((t.session_dir(name) / lname, f"Link to `{t.expand(target)}`"))
    rows.append((led, "Medium-term records: `channel.log`, `todo.md`, `issues.md`, `reports/`, `memory/`"))
    rows.append((sp, "Temporary files. `TMPDIR` points here. Excluded from Time Machine."))
    table = "\n".join(f"| `{p_}` | {u} |" for p_, u in rows)
    steps = []
    if name in team["lanes"] and not team["lanes"][name].get("ref") and not landing(t):
        steps.append(f"When {t.orc_name()} approves a feature, remove its worker worktree with "
                     f"`{t.cmd('retire')} {name} <feature>`.")
    steps += [f"Empty `{sp}`.",
              "Move finished items in `todo.md` and `issues.md` under `## Closed`, with the date.",
              f"Move reports for promoted work into `{led / 'reports' / 'archive'}`."]
    steps_txt = "\n".join(f"{i}. {x}" for i, x in enumerate(steps, 1))
    return ("\n## Your folders\n\nWork only in these folders.\n\n| Folder | Use |\n|---|---|\n"
            f"{table}\n\n## Housekeeping\n\nAfter each {'landing' if landing(t) else 'push-up'} or finished job, "
            f"no message about it:\n\n{steps_txt}\n")


SETTLED_HEADER = """# Settled by spec

Decisions the specs, rulings and house rules already settle, so nobody asks the user. One entry per
decision, numbered S-1, S-2, ... and never renumbered. The orchestrator writes an entry when it
confirms or amends a coordinator's recommendation; the designer writes one when a question it was
sent turns out settled. Check this file before asking.

Entry form:

    ## S-<n>. <the decision, one line>
    - Date / asker / decided by: <date> / <session> / <who> (confirmed | amended)
    - Question: <one line>
    - Answer: <one or two lines>
    - Settled by: <doc:line (section)>, <ruling number>
    - Gap: none | <doc section, sent to its owner>
"""


def sync_lanes(t, team):
    """team.json's lanes follow the manifest (2026-11-08: one team's team.json kept src/ and tests/ after its
    manifest moved to crates/, and the guard, which reads team.json, refused every lane). Every render: each lane
    already in team.json gets the manifest's path, owns, job, test, role and guide; lanes are never added or removed
    here (init chooses them). Written under the team lock, and only when something changed."""
    try:
        found = discover_lanes(t, t.base)
    except SystemExit:
        return
    keys = ("path", "owns", "job", "test", "role", "guide")
    changed = [n for n, r in team.get("lanes", {}).items()
               if n in found and any((r.get(k) or None) != (found[n].get(k) or None) for k in keys)]
    if not changed:
        return
    import fcntl
    with open(t.team_file.with_suffix(".lock"), "a") as lk:
        if _TEAM_LOCK is None:
            fcntl.flock(lk, fcntl.LOCK_EX)
        disk = load_json(t.team_file, None) or team
        for n in changed:
            for k in keys:
                disk["lanes"][n][k] = found[n].get(k)
                team["lanes"][n][k] = found[n].get(k)
        save_json(t.team_file, disk)
    say_line("lanes: team.json follows the manifest for " + ", ".join(changed))


def render_roles(t, team):
    sync_lanes(t, team)
    outd = t.home / "roles"
    outd.mkdir(parents=True, exist_ok=True)
    if not (t.home / "settled.md").exists():   # the settled-by-spec ledger (the user, 2026-10-24)
        (t.home / "settled.md").write_text(SETTLED_HEADER)
    lanes = team["lanes"]
    common = common_values(t)
    rows = "\n".join(
        f"| `{n}` | {r['role']} | `{r['path']}` | {r['job'] or '-'} | `{t.lane_channel(n)}` |"
        for n, r in lanes.items())
    arows = "\n".join(
        f"| `{n}` | {a.get('job', '')} | `{t.assistant_cwd(n)}` | `{t.assistant_channel(n)}` |"
        for n, a in t.assistants.items()) or "| - | - | - | - |"
    lrows = "\n".join(f"| `{o}` | `{t.link_channel(o)}` |" for o in t.links) or "| - | - |"
    orc = render((ROLES_DIR / "orchestrator.md").read_text(), {
        **common, "lane_rows": rows, "assistant_rows": arows, "link_rows": lrows,
        "promotion": promotion_text(t), "cwd": t.repo,
        "start_lanes": (
            f"4. Start the lanes {t.batch} at a time: run `{t.cmd('launch')} <lane>` for the next "
            f"{t.batch} lanes in the table, wait until each of them posts DONE on its channel, "
            f"then start the next {t.batch}.\n5. When every lane has posted DONE, report the set to the user."
            if t.batch else "4. Wait for each lane's DONE on its first task, and report the set to the user.")})
    if landing(t):
        orc = re.sub(r"- `push-up` runs the gate.*?\n- A lane that needs another lane's push runs `await`; codeteam wakes it\. You do not relay pushes\.",
                     LAND_ORC_BULLETS.format(land=f"codeteam-land {t.manifest}").replace("\\", "\\\\"), orc, flags=re.S)
        orc = orc.replace(f"- When every push of a feature is on `{t.exchange}`, one REQUEST to {t.guard or t.orc_name()} naming "
                          "the feature and its lanes.\n", "")
    (outd / "orc.md").write_text(orc)
    for n, a in t.assistants.items():
        tpl = ROLES_DIR / "assistants" / f"{a.get('role', n).lower()}.md"
        if landing(t) and (ROLES_DIR / "assistants" / f"{a.get('role', n).lower()}-land.md").exists():
            tpl = ROLES_DIR / "assistants" / f"{a.get('role', n).lower()}-land.md"
        if not tpl.exists():
            tpl = ROLES_DIR / "assistant.md"
        tier = t.tier_of(n)
        extra = ""
        if landing(t) and a.get("role") == "designer":
            L = f"codeteam-land {t.manifest}"
            extra = (f"\n\n## Committing (spec v5)\n\nYour documents land like any change: `{L} wo-cut orc <name>`, "
                     f"edit and commit in that tree, `{L} land <name>`. Nobody commits on `{t.base}` or "
                     f"`{t.integration}` directly; the guard refuses it.\n")
        (outd / f"{n}.md").write_text(render(tpl.read_text(), {
            **common, "name": n, "job": a.get("job", ""),
            "cwd": t.assistant_cwd(n), "channel": t.assistant_channel(n),
            "assistant_link_rows": "\n".join(
                f"| `{o}` | `{t.assistant_link_channel(n, o)}` | `{t.cmd('say')} link:{o} {n} <TYPE> <TO> <text>` |"
                for o in t.assistant_links(n)) or "| - | - | - |",
            "branch": t.tier_branch(tier) if tier else "its own"}) + extra)
    for n, r in lanes.items():
        role = r["role"]
        tpl = ROLES_DIR / ("lane-owner.md" if role == "owner" else f"{role}.md")
        if landing(t) and not r.get("ref"):
            tpl = ROLES_DIR / "zone-land.md"        # v5: every lane, zone or owner, lands the same way
        if not tpl.exists():
            sys.exit(f"lane '{n}': no role template {tpl}")
        pinned = bool(r.get("ref"))
        walls = (f"Files under `{r['path']}`" if r["path"] != "." else
                 "Your job, above. You share the repository with other function lanes.")
        if r["path"] == ".":   # whole-repo lanes are walled off from what other lanes own (zone guard)
            theirs = [f"`{x}` ({o})" for o, ro in team["lanes"].items() if o != n
                      for x in ([ro["path"]] if ro.get("path") not in ("", ".") else []) + list(ro.get("owns") or [])]
            if theirs:
                walls += (" Never edit what other lanes own: " + ", ".join(theirs) + "." if len(theirs) <= 8 else
                          f" Never edit what other lanes own: every other lane's folder and owned files ({len(theirs)}).")
        if r.get("owns"):
            walls = ((f"Files under `{r['path']}`, and these: " if r["path"] != "." else "These paths: ")
                     + ", ".join(f"`{x}`" for x in r["owns"]))
        if pinned:
            walls = f"Read-only checkout of `{lane_repo(t, r)}` at `{r['ref']}`"
        (outd / f"{n}.md").write_text(render(tpl.read_text(), {
            **common, "lane": n, "lane_path": r["path"],
            "job": r["job"] or f"Own `{r['path']}`: its code, tests and documents.",
            "walls": walls, "guide": r["guide"],
            "worktree": lane_wt(t, n, r), "cwd": lane_cwd(t, n, r),
            "workdir_note": (f"Your session starts in `{lane_cwd(t, n, r)}`, a data folder outside git. "
                             f"Make code changes in your worktree `{lane_wt(t, n, r)}`."
                             if r.get("workdir") else ""),
            "coord": coord_name(n), "sleep_cmd": t.cmd("sleep"), "ledger": str(t.ledger(n)),
            "coder": t.lane_class_of(n)[2],
            "lane_branch": lane_branch(t, n, r),
            "unit_wt": t.unit_wt(n, "<feature>"),
            "branch_rows": branch_rows(t, f"`{t.prefix + n}` (yours)"),
            "lane_channel": t.lane_channel(n)}))
    for n in [*t.staff(), *lanes]:
        f = outd / ("orc.md" if n == "orc" else f"{n}.md")
        f.write_text(f.read_text() + folders_section(t, team, n))
    if t.local_only:
        note = ("\n## Test mode\n\nThis team is a test of codeteam. Keep all work local: "
                f"commit and merge on local branches only. `{t.base}` stands in for the "
                "default branch.\n")
        for f in outd.glob("*.md"):
            f.write_text(f.read_text() + note)
    say_line(f"roles: rendered for orc, {len(t.assistants)} assistants, {len(lanes)} lanes")
    relink_claude(t, team)     # last: the loop's reload and `codeteam2 up` render through here, so this is where old session folders get new claude-home entries


# ---------------------------------------------------------------- init

def cmd_init(t: Team, args):
    git(t.repo, "rev-parse", "--git-dir")
    if head_branch(t.repo) != t.base:
        sys.exit(f"{t.repo} must be the checkout of {t.base}; it is on "
                 f"'{head_branch(t.repo) or 'no branch'}'")
    if t.repo != t.design_wt_expected():
        warn(f"the base checkout is {t.repo}; the layout puts it at {t.design_wt_expected()}")
    team = load_json(t.team_file, {"product": t.product, "lanes": {}})
    base_ref = t.base
    found = discover_lanes(t, base_ref)
    if args.all_lanes:
        chosen = found
    else:
        names = [x.strip() for x in args.lanes.split(",")] if args.lanes else t.pilot
        if not names and not found:
            names = []          # a team with no lanes yet (its designer works them out)
        elif not names:
            print(f"Discovered {len(found)} lanes: {', '.join(found)}")
            sys.exit("Choose lanes with --lanes A,B, a 'pilot' list in the manifest, or --all-lanes.")
        unknown = [n for n in names if n not in found]
        if unknown:
            sys.exit(f"unknown lanes: {', '.join(unknown)}\nknown: {', '.join(found)}")
        chosen = {n: found[n] for n in names}

    print(f"codeteam init {t.product} ({t.mode}): repo {t.repo_name}, base {base_ref}")
    print(f"  lanes ({len(chosen)}): {', '.join(chosen)}")
    print(f"  assistants: {', '.join(t.assistants) or 'none'}; links: {', '.join(t.links) or 'none'}")
    print(f"  team folder: {t.root}")
    if args.dry_run:
        print("  dry run: nothing changed")
        return

    for sub in ("roles", "launch"):
        (t.home / sub).mkdir(parents=True, exist_ok=True)
    t.general.touch()
    seed_claude_home(t)
    team["lanes"].update(chosen)
    team["updated"] = datetime.now().isoformat(timespec="seconds")
    save_json(t.team_file, team)

    # The branch line: base -> integration -> exchange (factory only).
    if not t.lab:
        ensure_branch(t, team, t.integration, t.base)
        ensure_branch(t, team, t.exchange, t.integration)
        for wt, branch in ((t.int_wt(), t.integration), (t.ex_wt(), t.exchange)):
            if ensure_worktree(t, team, wt, branch=branch):
                pin_codegraph(wt)
        backup(t, t.integration, t.exchange)

    # Tiers: one checkout each; each staff session gets its records folder there.
    for tier in t.tiers():
        provision_claude(t, t.tier_wt(tier), t.tier_dir(tier) / "agent-memory")
    for n in t.staff():
        make_session_folders(t, n, channel=(n != "orc"))     # the orchestrator's channel is general.log
    for n in t.assistants:
        if not t.managed(n):
            if not t.assistant_home(n).exists():
                warn(f"assistant {n}: {t.assistant_home(n)} does not exist")
            t.assistant_channel(n).touch()
            say_line(f"assistant {n}: external; channel {t.assistant_channel(n)}")

    # workcrews/
    for n, r in team["lanes"].items():
        wt = lane_wt(t, n, r)
        if ensure_worktree(t, team, wt, branch=lane_branch(t, n, r),
                           start=r["ref"] if r.get("ref") else t.target, repo=lane_repo(t, r)):
            pin_codegraph(wt)
        cwd = lane_cwd(t, n, r)
        if r.get("workdir") and not cwd.exists():
            sys.exit(f"lane '{n}': workdir {cwd} does not exist")
        make_session_folders(t, n)
        provision_claude(t, cwd, t.ledger(n) / "memory")
        save_json(t.team_file, team)

    for name, x in t.pins.items():
        rec = team.setdefault("pins", {}).get(name)
        path = Path(rec["path"]) if rec else t.pin_path(name)
        ensure_worktree(t, team, path, branch=t.pin_branch(), start=x["ref"],
                        repo=Path(x["repo"]).expanduser())
        team["pins"][name] = {"path": str(path), "ref": rec["ref"] if rec else x["ref"]}
        link(t.pin_dir(name) / "current", path)
        say_line(f"pin {name}: {path.name} on {t.pin_branch()} (current)")

    # root_links sit beside the base checkout, for tracked links like `packages -> ../packages`,
    # and beside every other worktree codeteam makes: exchange, integration, each lane's
    # worktree and its requests/ (a team's packages reach `../../<pin>`, 2026-10-24).
    beside = [t.repo.parent]
    if not t.lab:
        beside += [t.ex_wt().parent, t.int_wt().parent]
    for n, r in team["lanes"].items():
        beside += [lane_wt(t, n, r).parent, lane_wt(t, n, r).parent / "requests"]
    for lname, target in t.root_links.items():
        for d in dict.fromkeys(beside):
            d.mkdir(parents=True, exist_ok=True)
            link(d / lname, Path(t.expand(target)))
    for n in [*t.staff(), *team["lanes"]]:
        for lname, target in t.session_links.items():
            link(t.session_dir(n) / lname, Path(t.expand(target)))

    for o in t.links:
        t.link_channel(o).parent.mkdir(parents=True, exist_ok=True)
        t.link_channel(o).touch()
    for a in t.assistants:
        for o in t.assistant_links(a):
            t.assistant_link_channel(a, o).parent.mkdir(parents=True, exist_ok=True)
            t.assistant_link_channel(a, o).touch()

    sessions = load_json(t.sessions_file, {})
    for n in [*t.staff(), *team["lanes"]]:
        sessions.setdefault(n, {"id": str(uuid.uuid4())})
    save_json(t.sessions_file, sessions)
    save_json(t.team_file, team)
    render_roles(t, team)
    write_restart_file(t)
    ok, _ = trust_folders(launch_dirs(t, team))
    say_line(f"trusted {ok} launch folders in ~/.claude.json")
    print(f"done. Next: codeteam launch {t.manifest} all")


# ---------------------------------------------------------------- trust

def launch_dirs(t, team):
    dirs = [t.repo if n == "orc" else t.assistant_cwd(n) for n in t.staff()]
    dirs += [lane_cwd(t, n, r) for n, r in team["lanes"].items()]
    return sorted({str(d) for d in dirs})


def trust_folders(paths):
    """Mark folders as trusted in ~/.claude.json, so a session started there
    opens without the "trust this folder" prompt. Running sessions also write
    that file, so this merges into a fresh read, writes atomically, and checks
    the flags stuck; it retries a few times if a session wrote over them."""
    # CODETEAM_CLAUDE_JSON lets the test suite use its own file.
    cfg_path = Path(os.environ.get("CODETEAM_CLAUDE_JSON", Path.home() / ".claude.json"))
    for attempt in range(5):
        cfg = json.loads(cfg_path.read_text())
        projects = cfg.setdefault("projects", {})
        missing = [x for x in paths if not projects.get(x, {}).get("hasTrustDialogAccepted")]
        if not missing:
            return len(paths), attempt
        for x in missing:
            entry = projects.setdefault(x, {})
            entry["hasTrustDialogAccepted"] = True
            entry.setdefault("hasCompletedProjectOnboarding", True)
        tmp = cfg_path.with_name(cfg_path.name + ".codeteam-tmp")
        tmp.write_text(json.dumps(cfg, indent=2))
        tmp.replace(cfg_path)
        time.sleep(1.5)
    cfg = json.loads(cfg_path.read_text())
    still = [x for x in paths if not cfg.get("projects", {}).get(x, {}).get("hasTrustDialogAccepted")]
    if still:
        warn(f"{len(still)} folders still untrusted after retries")
    return len(paths) - len(still), 5


def cmd_trust(t: Team, args):
    team = load_team(t)
    ok, tries = trust_folders(launch_dirs(t, team))
    print(f"{t.product}: {ok} launch folders trusted")


# ---------------------------------------------------------------- launch

# LIFTED (micro-wormhole.py): minimum seconds between terminal launches.
# Ghostty 1.3.1's surface allocator returned error.OutOfMemory under rapid
# window creation, and the failure was invisible because Popen returned
# successfully. Terminal.app replaced Ghostty; the pacing stays because it
# costs seconds and the failure it prevents is silent.
TERMINAL_LAUNCH_MIN_INTERVAL_SECONDS = 10
_terminal_launch_lock = threading.Lock()
_last_terminal_launch = 0.0


def reserve_terminal_launch_slot(stamp: Path = None):
    """LIFTED: block until enough time has passed since the last launch,
    then claim the next slot. The lock is held while sleeping so pacing
    stays monotonic across concurrent callers.

    Adapted: the orchestrator wakes lanes one command at a time, so the
    last launch time is also kept in a stamp file under an flock, which
    paces launches across separate codeteam processes."""
    global _last_terminal_launch
    with _terminal_launch_lock:
        if stamp is None:
            wait = TERMINAL_LAUNCH_MIN_INTERVAL_SECONDS - (time.monotonic() - _last_terminal_launch)
            if _last_terminal_launch and wait > 0:
                time.sleep(wait)
            _last_terminal_launch = time.monotonic()
            return
        import fcntl
        stamp.parent.mkdir(parents=True, exist_ok=True)
        with open(stamp, "a+") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            f.seek(0)
            try:
                last = float(f.read().strip() or 0)
            except ValueError:
                last = 0.0
            wait = TERMINAL_LAUNCH_MIN_INTERVAL_SECONDS - (time.time() - last)
            if wait > 0:
                time.sleep(wait)
            f.seek(0)
            f.truncate()
            f.write(str(time.time()))


def transcript_exists(sid) -> bool:
    return any((Path.home() / ".claude" / "projects").glob(f"*/{sid}.jsonl"))


def session_live(sid) -> bool:
    return subprocess.run(["pgrep", "-f", sid], capture_output=True).returncode == 0


def launch_target(t, team, name):
    """-> (cwd, display name, agent, role file, permission mode, model)"""
    roles = t.home / "roles"
    if name == "orc":
        return (t.repo, t.orc_name(), t.orc_agent, roles / "orc.md",
                t.orc_permission_mode, t.orc_model)
    if name in t.assistants:
        a = t.assistants[name]
        return (t.assistant_cwd(name), name, a.get("agent", ""), roles / f"{name}.md",
                a.get("permission_mode", t.lane_permission_mode), a.get("model", t.model))
    r = team["lanes"][name]
    # The lane session is its class's coder: it writes the code and uses subagents.
    return (lane_cwd(t, name, r), coord_name(name), t.lane_class_of(name)[2], roles / f"{name}.md",
            t.lane_permission_mode, t.lane_class_of(name)[0])


AUTO_MODE_ENVIRONMENT = [
    "Organization: the owner's own software. Primary use: software development by a team "
    "of Claude Code sessions run by codeteam on this Mac.",
    f"Source control: the local bare repositories under {WORKSPACE}/.repos/ and their worktrees "
    f"under {WORKSPACE}/team-*/, and those repositories' own remotes. All are "
    "private and trusted.",
    f"Org-specific CLIs: {TOOL_DIR}/bin/codeteam is the team's own workflow tool. "
    "Its unit, squash, pull-down, push-up, ready, retire, backup, say, watch and await commands are "
    "the routine steps a lane is told to run by its role file. In `codeteam push-up ... -f NAME`, "
    "-f means --feature, not force.",
    "Additional context: the branches exchange, integration and lane/* are shared by design: every "
    "lane pushes its reviewed features to exchange with codeteam push-up. Squash-merging a "
    "worktree-* branch into the lane's own worktree, committing, and pushing it up is the normal "
    "accept step after the reviewers (Adams, Kong) pass it. Work recovered from "
    f"{TOOL_DIR}/saved/ bundles is this repository's own earlier work, saved by the owner.",
]


def compaction_point(t, window):
    """Where a session compacts, for the zone guard's handoff point: the window, scaled by the team's
    CLAUDE_AUTOCOMPACT_PCT_OVERRIDE when its [env] sets one (e.g. 52 to compact at 52% of 1M)."""
    try:
        pct = float((getattr(t, "env", None) or {}).get("CLAUDE_AUTOCOMPACT_PCT_OVERRIDE", ""))
    except ValueError:
        return window
    return int(window * pct / 100) if 0 < pct < 100 else window


def default_ctx_window(model):
    """The context window Claude Code uses for a session when codeteam sets no
    autoCompactWindow (2026-10-25). The zone guard prompts the handoff at 70% of it.
    Claude models (Sonnet 5+, Opus 4.7+, Haiku 5.5, Fable) have a native 1M window and
    compact at about 967k. A model ID Claude Code doesn't recognize, such as gpt-*
    through a local proxy, is assumed to have 200k until CLAUDE_CODE_MAX_CONTEXT_TOKENS
    says otherwise."""
    m = (model or "").lower()
    if not m or m.startswith(("claude-", "sonnet", "opus", "haiku", "fable")):
        return 1000000
    return 200000


def write_launch_script(t, name, cwd, display, agent, role, mode, model, sid, resume, recover=False) -> Path:
    flags = []
    if agent:
        flags += ["--agent", agent]
    if model:
        flags += ["--model", model]
    if t.effort_of(name):
        flags += ["--effort", t.effort_of(name)]
    if mode:
        flags += ["--permission-mode", mode]
    if t.isolate:
        # Verified 2026-10-13: these two flags take a session from 130 MCP
        # tools (the user's own MCP servers, user plugins) to none.
        flags += ["--setting-sources", "project,local", "--strict-mcp-config"]
    # Auto memory is per repository, shared by every worktree; each session
    # gets its own in its ledger instead.
    settings = {"autoMemoryDirectory": str(t.ledger(name) / "memory" / "auto"),
                # isolation: worktree cuts request worktrees from the session's own head
                "worktree": {"baseRef": "head"},
                # Metrics plus the oldest open question for the user.
                "statusLine": {"type": "command",
                               "command": f"'{TOOL_DIR / 'bin' / 'codeteam-statusline'}' '{t.home / 'questions.md'}'"}}
    # Auto-compaction: Claude Code's default unless the manifest sets a window
    # (2026-10-25). Subagents inherit this window; their agent file can only lower it.
    if t.compact_window_of(name):
        settings["autoCompactWindow"] = t.compact_window_of(name)
    # Prompt cache: every codeteam-launched session (orchestrator, designer, staff,
    # zone coordinators) is long-running and wakes on mail, so it gets the 1-hour
    # cache; subagents keep Claude Code's 5-minute default.
    # A manifest can set session_cache_ttl = "5m" to turn this off.
    settings["promptCacheTtl"] = t.m.get("session_cache_ttl", "1h")
    # Auto mode's classifier blocked lanes' normal accept step (squash, then
    # push-up to exchange) several times (2026-10-24). It reads autoMode only from
    # user settings or --settings, so each session is told here what the team's
    # infrastructure and workflow are. Prose, read by the classifier.
    settings["autoMode"] = {"environment": ["$defaults"] + AUTO_MODE_ENVIRONMENT}
    if display in os.environ.get("CODETEAM_RC_OFF", "").split(","):
        settings["remoteControlAtStartup"] = False
    flags += ["--settings", json.dumps(settings)]
    if MCP_FILE.exists():
        flags += ["--mcp-config", str(MCP_FILE)]
    # A lane reads its whole lane folder (worktrees, ledger, scratchpad); the
    # orchestrator and staff read the whole team folder.
    team_lanes = load_json(t.team_file, {}).get("lanes", {})
    flags += ["--add-dir", str(t.lane_dir(name) if name in team_lanes else t.root)]
    flags += ["--name", display, "--append-system-prompt-file", str(role)]
    if resume:
        # A resumed session needs a prompt, or it opens and waits for typing.
        flags += ["--resume", sid, f"You have been woken. Run `{t.cmd('watch')} {name} --now`: "
                  "it prints the messages waiting in your inbox. Carry out the requests in them, as your role file directs, then end your turn."]
    elif recover:
        flags += ["--session-id", sid,
                  f"You are starting fresh. Run /recover-from-compact to pick up your handoff "
                  f"(a copy is in {t.ledger(name) / 'reports' / 'handoff.md'}). Then run "
                  f"`{t.cmd('watch')} {name} --now` and carry out the requests it prints, as your role file directs. "
                  f"When the work is done or waiting on others, end your turn."]
    else:
        flags += ["--session-id", sid, "Start your first task."]
    # shlex.quote: a flag may hold an apostrophe (the autoMode prose does).
    cmd = " ".join(shlex.quote(str(f)) for f in [CLAUDE_BIN, *flags])
    env = "".join(f"export {k}='{t.expand(v)}'\n" for k, v in {**SESSION_ENV_DEFAULTS, **t.env}.items())
    env += f"mkdir -p '{t.scratchpad(name)}' '{t.ledger(name) / 'memory' / 'auto'}'\n"
    env += f"export TMPDIR='{t.scratchpad(name)}/'\n"
    # Sessions start from a login bash whose PATH puts the system Python 3.9
    # first; tools here need a current Python, Homebrew's.
    env += 'export PATH="/opt/homebrew/bin:$HOME/.local/bin:$PATH"\n'
    # Claude Code's own temp files (it appends /claude-<uid>/).
    env += f"export CLAUDE_CODE_TMPDIR='{t.scratchpad(name)}'\n"
    # Each session commits under its own name (Coord-<lane>, Nagatha, Orc-Acme),
    # so a commit shows which session made it. Email stays from git config.
    env += f"export GIT_AUTHOR_NAME='{display}'\nexport GIT_COMMITTER_NAME='{display}'\n"
    env += f"export CODETEAM_SESSION='{name}'\n"
    env += f"export CODETEAM_HOME='{TOOL_DIR}'\n"
    # For the zone guard's hooks: the manifest to post with, the window to measure against.
    env += f"export CODETEAM_MANIFEST='{t.manifest}'\n"
    # A model ID Claude Code doesn't recognize (gpt-* through a local proxy) is assumed to
    # have 200k, which also caps every subagent the session spawns. A manifest's
    # gpt_context_tokens sets the real window for those sessions (2026-10-25).
    gpt_ctx = t.m.get("gpt_context_tokens")
    if gpt_ctx and str(model or "").lower().startswith("gpt-"):
        env += f"export CLAUDE_CODE_MAX_CONTEXT_TOKENS='{int(gpt_ctx)}'\n"
    ctx_window = t.compact_window_of(name) or (int(gpt_ctx) if gpt_ctx and str(model or "").lower().startswith("gpt-") else default_ctx_window(model))
    ctx_window = compaction_point(t, ctx_window)
    env += f"export CODETEAM_CTX_WINDOW='{ctx_window}'\n"
    # The model and effort the session launched with, for the effort-mode hook (2026-10-31).
    env += f"export CODETEAM_MODEL='{model or ''}'\n"
    env += f"export CODETEAM_EFFORT='{t.effort_of(name) or ''}'\n"
    env += f'export PATH="{TOOL_DIR}/bin:$PATH"\n'
    if name in team_lanes:
        env += f"export CODETEAM_ZONE='{team_lanes[name].get('path', '')}'\n"
        if team_lanes[name].get("test"):   # the lane's own zone-test command (zone.mk's ZONE_TEST)
            env += f"export ZONE_TEST={shlex.quote(team_lanes[name]['test'])}\n"
        if team_lanes[name].get("owns"):   # more folders or files the lane owns (the zone guard reads them)
            env += f"export CODETEAM_OWNS='{':'.join(team_lanes[name]['owns'])}'\n"
        env += f"export CODETEAM_EXCHANGE='{t.ex_wt()}'\n"
        env += f"export CODETEAM_SWT='{lane_wt(t, name, team_lanes[name])}'\n"
        # GNU make reads MAKEFILES before the repo Makefile, so zone-test,
        # zone-test-status and warm work in every worktree of the repo.
        env += f"export MAKEFILES='{TOOL_DIR}/zone/zone.mk'\n"
    script = t.home / "launch" / f"{name}.sh"
    # LIFTED (launch_bilby): login shell; stale settings.local.json removed;
    # the window stays open on a non-zero exit so the user can read the error.
    script.write_text(
        "#!/bin/bash -l\n"
        f"cd '{cwd}' || {{ echo 'missing {cwd}'; read -n 1; exit 1; }}\n"
        "# A stale settings.local.json is removed only from a .claude codeteam made.\n"
        "[ \"$(cat .claude/.gitignore 2>/dev/null)\" = '*' ] && rm -f .claude/settings.local.json\n"
        f"{env}"
        "# Record the session's PID (the claude child of this script) for the idle tick.\n"
        f"( sleep 3; {t.cmd('procreg')} {name} --parent $$ >/dev/null 2>&1 ) &\n"
        f"{cmd}\n"
        "EXIT_CODE=$?\n"
        "# 0 = exited; 143 = stopped by `codeteam sleep` (SIGTERM). Both are clean.\n"
        "if [ $EXIT_CODE -ne 0 ] && [ $EXIT_CODE -ne 143 ]; then\n"
        f"  echo \"{display} exited with error ($EXIT_CODE). Press any key to close.\"\n"
        "  read -n 1\n"
        "fi\n")
    script.chmod(0o755)
    return script


def cmd_launch(t: Team, args):
    team = load_team(t)
    # Every launch starts from the current role templates.
    render_roles(t, team)
    sessions = load_json(t.sessions_file, {})
    targets = args.targets or ["all"]
    if "all" in targets:
        targets = [*t.staff(), *team["lanes"]]
    if "staff" in targets:
        targets = t.staff()
    for n in targets:
        if n in t.assistants and not t.managed(n):
            sys.exit(f"{n} is external: it runs its own session. Its role file is "
                     f"{t.home / 'roles' / (n + '.md')}")
    for n in targets:
        if n != "orc" and n not in team["lanes"] and n not in t.assistants:
            sys.exit(f"unknown target '{n}'. Assistants: {', '.join(t.assistants)}. "
                     f"Lanes: {', '.join(team['lanes'])}")
    if args.here and len(targets) != 1:
        sys.exit("--here runs exactly one session")
    for n in targets:
        cwd, display, agent, role, mode, model = launch_target(t, team, n)
        sid = sessions[n]["id"]
        if session_live(sid):
            say_line(f"{display}: already running")
            continue
        # The registry's recorded process counts too: a session started
        # fresh carries an id sessions.json may not hold.
        reg_e = load_json(registry_file(t), {}).get(n, {})
        if reg_e.get("state") == "awake" and _rt().alive(reg_e.get("pid")):
            say_line(f"{display}: already running (pid {reg_e.get('pid')})")
            continue
        # A session started seconds ago may not show as a process yet.
        started = t.home / "launch" / f"{n}.started"
        if started.exists() and time.time() - started.stat().st_mtime < 120 and not args.dry_run:
            say_line(f"{display}: started less than two minutes ago; left alone")
            continue
        had = transcript_exists(sid)
        resume = had and args.resume
        if had and not resume and not args.dry_run:
            # Fresh by default: a new session reads its role, guide and handoff
            # instead of reloading a long history.
            sessions[n].setdefault("previous", []).append(sid)
            sid = str(uuid.uuid4())
            sessions[n]["id"] = sid
            save_json(t.sessions_file, sessions)
        script = write_launch_script(t, n, cwd, display, agent, role, mode, model, sid, resume,
                                     recover=had and not resume)
        how = "resume" if resume else ("fresh" if had else "new")
        group = window_for(t, team, n)
        profile = t.profile_of(n)
        if group and windows_mode() == "terminal":
            profile, group = group[1] or profile, None
        if args.dry_run:
            where = (f" in tmux {group[0]} ({group[1]})" if group else
                     (f" in {profile}" if profile else ""))
            say_line(f"{display}: would launch ({how}) {script}{where}")
            continue
        if group:
            gname, gprofile = group
            tmux_add(gname, display, script)
            started.touch()
            if args.here:
                if gprofile:
                    osa(f'tell application "{TERMINAL_APP}" to set current settings of selected tab of '
                        f'front window to settings set "{gprofile}"')
                say_line(f"{display}: started in tmux {gname}; attaching here")
                os.execv(TMUX, [TMUX, "-L", TMUX_SOCKET, "attach", "-t", f"={gname}"])
            if not tmux_attached(gname) and not os.environ.get("CODETEAM_NO_TERMINAL"):
                reserve_terminal_launch_slot(t.home / "launch" / "last-launch")
                open_terminal(f"exec '{TMUX}' -L {TMUX_SOCKET} attach -t '={gname}'", gprofile)
            say_line(f"{display}: launched ({how}) as a tab in {gname}")
            continue
        if args.here:
            # Run in this window (the double-clicked restart file).
            started.touch()
            if profile:
                osa(f'tell application "{TERMINAL_APP}" to set current settings of selected tab of '
                    f'front window to settings set "{profile}"')
            say_line(f"{display}: starting here ({how})")
            os.execv("/bin/bash", ["/bin/bash", "-l", str(script)])
        reserve_terminal_launch_slot(t.home / "launch" / "last-launch")
        open_terminal(f"/bin/bash -l '{script}'; exit", profile, script, title=display)
        started.touch()
        say_line(f"{display}: launched ({how})" + (f" in {profile}" if profile else ""))


def osa(script) -> bool:
    return subprocess.run(["osascript", "-e", script], capture_output=True).returncode == 0


def windows_mode():
    """windows.toml `mode`: "terminal" (a Terminal window per session, in its
    group's profile) or "tmux" (a tab per session in its group's tmux session)."""
    if not WINDOWS_FILE.exists():
        return "tmux"
    return tomllib.loads(WINDOWS_FILE.read_text()).get("mode", "tmux")


def window_for(t, team, name):
    """(tmux session, profile) for a session listed in windows.toml, else None."""
    if not WINDOWS_FILE.exists():
        return None
    keys = {f"{t.product}:{name}"}
    if name in team["lanes"]:
        keys.add(f"{t.product}:lanes")
    for w in tomllib.loads(WINDOWS_FILE.read_text()).get("window", []):
        if keys & set(w.get("members", [])):
            return w["name"], w.get("profile", "")
    return None


def tmux(*a):
    return subprocess.run([TMUX, "-L", TMUX_SOCKET, *a], capture_output=True, text=True)


def tmux_setup():
    """Server-wide: clickable tabs and scrolling, and a mouse selection (or Enter
    in copy mode) copies to the macOS clipboard, so text copies like any window."""
    tmux("set-option", "-g", "mouse", "on")
    for table in ("copy-mode", "copy-mode-vi"):
        tmux("bind-key", "-T", table, "MouseDragEnd1Pane", "send-keys", "-X", "copy-pipe-and-cancel", "pbcopy")
        tmux("bind-key", "-T", table, "Enter", "send-keys", "-X", "copy-pipe-and-cancel", "pbcopy")


def tmux_attached(session) -> bool:
    return bool(tmux("list-clients", "-t", f"={session}").stdout.strip())


def tmux_add(session, tab, script):
    """Run the launch script as a tab named `tab` in tmux session `session`."""
    cmd = f"/bin/bash -l '{script}'"
    if tmux("has-session", "-t", f"={session}").returncode == 0:
        r = tmux("new-window", "-d", "-t", f"={session}:", "-n", tab, cmd)
    elif tmux("list-sessions").returncode != 0 and sys.platform == "darwin":
        # macOS runs a process started from a background context (cron, an
        # agent's shell) at a lower scheduling priority, and every pane inherits
        # the tmux server's. Start the server from Terminal so the sessions get
        # the same priority as a Terminal window.
        args = " ".join(shlex.quote(x) for x in
                        [TMUX, "-L", TMUX_SOCKET, "new-session", "-d", "-s", session, "-n", tab,
                         "-x", "220", "-y", "60", cmd])
        osa(f'tell application "{TERMINAL_APP}" to do script "{args.replace(chr(34), chr(92) + chr(34))}; exit"')
        for _ in range(40):
            if tmux("has-session", "-t", f"={session}").returncode == 0:
                break
            time.sleep(0.25)
        r = tmux("has-session", "-t", f"={session}")
        if r.returncode == 0:
            tmux_setup()
    else:
        r = tmux("new-session", "-d", "-s", session, "-n", tab, "-x", "220", "-y", "60", cmd)
        if r.returncode == 0:
            tmux_setup()
    if r.returncode:
        sys.exit(f"tmux could not start {tab} in {session}: {r.stderr.strip()}")
    # Keep the tab named after the session, whatever title the program sets.
    tmux("set-option", "-w", "-t", f"={session}:{tab}", "automatic-rename", "off")
    tmux("set-option", "-w", "-t", f"={session}:{tab}", "allow-rename", "off")


def open_terminal(cmd: str, profile: str, script: Path = None, title: str = ""):
    """A new Terminal window running `cmd`, in the given profile.
    Falls back to a plain window if Terminal cannot be scripted."""
    if profile:
        ok = osa(f'''tell application "{TERMINAL_APP}"
            set t to do script "{cmd}"
            set current settings of t to settings set "{profile}"
            {f'set custom title of t to "{title}"' if title else ""}
            activate
        end tell''')
        if ok:
            return
        warn(f"Terminal could not be scripted for profile {profile}; opening a plain window")
    if script is None:
        osa(f'tell application "{TERMINAL_APP}" to do script "{cmd}"')
        return
    subprocess.Popen(["open", "-a", TERMINAL_APP, str(script)],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def write_restart_file(t):
    """A file the user double-clicks in Finder to bring the orchestrator back after a
    restart. Terminal opens .command files; it runs the orchestrator in that window."""
    f = t.restart_file()
    f.write_text("#!/bin/bash\n"
                 f"# Restarts {t.orc_name()} in this window. Then tell it: bring the team up.\n"
                 f"exec '{TOOL}' launch '{t.manifest}' orc --here\n")
    f.chmod(0o755)


# ---------------------------------------------------------------- status

def detached_worktrees(t, team):
    """Every worktree codeteam knows of that is not on a branch."""
    paths = [t.repo, *[Path(w["path"] if isinstance(w, dict) else w)
                       for w in team.get("created_worktrees", [])]]
    return [p_ for p_ in paths if p_.exists() and not head_branch(p_)]


def cmd_status(t: Team, args):
    team = load_team(t)
    sessions = load_json(t.sessions_file, {})
    if t.lab:
        print(f"{t.product} (lab): lanes push straight to {t.base}")
    else:
        def ahead(lo, hi):
            return git(t.repo, "rev-list", "--count", f"{lo}..{hi}", check=False).stdout.strip() or "?"
        print(f"{t.product}: {t.integration} is {ahead(t.base, t.integration)} ahead of {t.base}; "
              f"{t.exchange} is {ahead(t.integration, t.exchange)} ahead of {t.integration}")
    for f, rec in team.get("features", {}).items():
        print(f"feature {f}: {rec.get('state', 'lanes')}; lanes {', '.join(rec.get('lanes', [])) or '-'}"
              + ("; approved" if rec.get("approved") else ""))
    for name, rec in team.get("pins", {}).items():
        pth = Path(rec["path"])
        head = out(pth, "rev-parse", "--short", "HEAD") if pth.exists() else "missing"
        print(f"pin {name}: {pth.name} at {head} ({rec['ref']})")
    for d in detached_worktrees(t, team):
        print(f"DETACHED: {d} is not on a branch")
    print(f"{'session':<24}{'state':<13}{'vs ' + t.target:<13}{'dirty':<7}last message")
    for n in ["orc", *t.assistants, *team["lanes"]]:
        cwd, display, *_ = launch_target(t, team, n)
        sid = sessions.get(n, {}).get("id", "")
        state = "external" if not t.managed(n) else (
            "running" if sid and session_live(sid) else (
                "resumable" if sid and transcript_exists(sid) else "not started"))
        if not cwd.exists():
            print(f"{display:<24}{'no folder':<13}")
            continue
        where = lane_wt(t, n, team["lanes"][n]) if n in team["lanes"] else cwd
        is_git = git(where, "rev-parse", "--git-dir", check=False).returncode == 0
        dirty = len(git(where, "status", "--porcelain", check=False).stdout.splitlines()) if is_git else "-"
        rel = "-"
        if n in team["lanes"] and not team["lanes"][n].get("ref"):
            lr = git(where, "rev-list", "--left-right", "--count",
                     f"{t.target}...HEAD", check=False).stdout.split()
            if len(lr) == 2:
                rel = f"-{lr[0]} +{lr[1]}"
        ch = (t.general if n == "orc" else
              t.assistant_channel(n) if n in t.assistants else t.lane_channel(n))
        lines = ch.read_text().splitlines() if ch.exists() else []
        last = lines[-1][:16] if lines else "-"
        print(f"{display:<24}{state:<13}{rel:<13}{dirty!s:<7}{last}")


# ---------------------------------------------------------------- say

def chan_key(t, team, path: Path) -> str:
    """The channel a record log belongs to."""
    if path == t.general:
        return "general"
    for n in team["lanes"]:
        if path == t.lane_channel(n):
            return f"lane:{n}"
    for a in t.assistants:
        if path == t.assistant_channel(a):
            return f"assistant:{a}"
        for o in t.assistant_links(a):
            if path == t.assistant_link_channel(a, o):
                return f"alink:{a}:{o}"
    for o in t.links:
        if path == t.link_channel(o):
            return f"link:{o}"
    return "other"


def session_of(t, team, word):
    """The session a name refers to: orc, a lane or an assistant."""
    w = word.strip()
    if w in ("orc", t.orc_name()):
        return "orc"
    if w in team["lanes"]:
        return w
    if w.startswith("Coord-") and w[6:] in team["lanes"]:
        return w[6:]
    if w in t.assistants:
        return w
    return None


def peer_inbox(t, other):
    """The inbox of another team's orchestrator, or of another team's external
    assistant, found among the manifests beside this one."""
    for m in sorted(t.manifest.parent.glob("*.toml")):
        if m == t.manifest:
            continue
        try:
            o = Team(m)
        except SystemExit:
            continue
        if o.product == other:
            return o.inbox("orc")
        if other in o.assistants:            # an external assistant, or one with its own home
            return o.inbox(other)
    return None


def drop(box: Path, msg: dict):
    """One message, one file; written aside and renamed in, so a reader never
    sees half a message."""
    box.mkdir(parents=True, exist_ok=True)
    name = f"{time.time_ns()}-{os.getpid()}-{msg['from']}".replace("/", "_").replace(" ", "_")
    tmp = box / f"{name}.tmp"
    tmp.write_text(json.dumps(msg))
    tmp.rename(box / f"{name}.json")


def deliver(t, team, chan, sender, kind, to, text):
    """Copy a message into the inbox of each session it concerns.
    general: the orchestrator always; sessions named in TO; for TO=all, every
    staff session (held: it does not wake them). lane:/assistant: channels: the
    owner and the orchestrator. Links: the other side. Never the sender."""
    msg = {"time": f"{datetime.now():%Y-%m-%d %H:%M}", "team": t.product, "chan": chan,
           "from": sender, "type": kind, "to": to, "text": text}
    boxes = set()
    keys = set()
    if chan == "general":
        keys.add("orc")
        if to.strip() == "all":
            keys |= set(t.staff()) | set(t.assistants)
        else:
            keys |= {k for w in to.split(",") if (k := session_of(t, team, w))}
    elif chan.startswith("lane:"):
        keys |= {"orc", chan[5:]}
    elif chan.startswith("assistant:"):
        keys |= {"orc", chan[10:]}
    elif chan.startswith("link:") or chan.startswith("alink:"):
        other = chan.split(":")[-1]
        box = peer_inbox(t, other)
        if box:
            boxes.add(box)
    keys.discard(session_of(t, team, sender))
    boxes |= {t.inbox(k) for k in keys}
    for b in boxes:
        drop(b, msg)


def post(t, channel_path: Path, sender, kind, to, text):
    """Record the message in the channel's log (the team's record) and deliver
    it to the inboxes of the sessions it concerns."""
    line = f"{datetime.now():%Y-%m-%d %H:%M} | {sender} | {kind} {to} | {text}\n"
    channel_path.parent.mkdir(parents=True, exist_ok=True)
    with channel_path.open("a") as f:      # one small append per message
        f.write(line)
    team = load_json(t.team_file, None)
    if team:
        deliver(t, team, chan_key(t, team, channel_path), sender, kind, to, text)
    return line


def cmd_say(t: Team, args):
    team = load_team(t)
    kind = args.type.upper()
    if kind not in MESSAGE_TYPES:
        sys.exit(f"type must be one of {', '.join(MESSAGE_TYPES)}")
    c = args.channel
    if c == "general":
        ch = t.general
    elif c in team["lanes"]:
        ch = t.lane_channel(c)
    elif c in t.assistants:
        ch = t.assistant_channel(c)
    elif c.startswith("link:") and c[5:] in t.assistant_links(args.sender):
        # An assistant with its own link posts there, not on the orchestrators' link.
        ch = t.assistant_link_channel(args.sender, c[5:])
    elif c.startswith("link:") and c[5:] in t.links:
        ch = t.link_channel(c[5:])
    else:
        sys.exit(f"channel must be 'general', an assistant ({', '.join(t.assistants)}), "
                 f"a lane, or link:<team> ({', '.join(t.links) or 'no links'})")
    print(post(t, ch, args.sender, kind, args.to, " ".join(args.text).replace("\n", " ")), end="")


# ---------------------------------------------------------------- guides

def cmd_link_guides(t: Team, args):
    """In each lane whose guide is AGENTS.md and has no CLAUDE.md, add
    CLAUDE.md -> AGENTS.md and commit it on the lane branch under the lane's
    name. Lanes in auto mode are refused this step as self-modification."""
    team = load_team(t)
    for n, r in team["lanes"].items():
        if r.get("ref") or not r["guide"].endswith("AGENTS.md"):
            continue
        wt = lane_wt(t, n, r)
        guide = wt / r["guide"]
        link_path = guide.with_name("CLAUDE.md")
        if not guide.exists():
            say_line(f"{n}: no guide yet")
            continue
        if link_path.exists() or link_path.is_symlink():
            say_line(f"{n}: CLAUDE.md already present")
            continue
        if is_dirty(wt):
            say_line(f"{n}: worktree has uncommitted changes; skipped")
            continue
        link_path.symlink_to("AGENTS.md")
        env = dict(_git_env(), GIT_AUTHOR_NAME=coord_name(n), GIT_COMMITTER_NAME=coord_name(n))
        rel = str(link_path.relative_to(wt))
        subprocess.run(["git", "-C", str(wt), "add", rel], env=env, check=True)
        subprocess.run(["git", "-C", str(wt), "commit", "-q", "-m",
                        f"docs({n}): CLAUDE.md links to the lane guide"], env=env, check=True)
        say_line(f"{n}: CLAUDE.md linked and committed")


# ---------------------------------------------------------------- watch

def watch_channels(t, team, name):
    if name == "orc":
        chans = [t.general, *[t.lane_channel(n) for n in team["lanes"]],
                 *[t.assistant_channel(a) for a in t.assistants], *[t.link_channel(o) for o in t.links]]
    elif name in t.assistants:
        chans = [t.assistant_channel(name), t.general,
                 *[t.assistant_link_channel(name, o) for o in t.assistant_links(name)]]
    else:
        chans = [t.lane_channel(name), t.general]
    return [c for c in chans if c.exists()]


def own_names(t, name):
    if name == "orc":
        return {t.orc_name(), "orc"}
    return {name, coord_name(name)}


def cmd_roles(t: Team, args):
    """Re-render every session's role file from the templates. Sessions read
    the new text at their next start or when told to re-read it. Also provisions eligible existing
    folders' .claude and creates missing managed assistants' v5 session folders (relink_claude)."""
    render_roles(t, load_team(t))


def addressed_to(line, names) -> bool:
    """True when a channel line's TO field names one of `names`.
    Line format: `date | from | TYPE to[,to...] | text`."""
    parts = [x.strip() for x in line.split("|")]
    if len(parts) < 3:
        return False
    head = parts[2].split(None, 1)
    return len(head) == 2 and bool(names & {x.strip() for x in head[1].split(",")})


def _pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def _owning_session():
    """The Claude Code process this watch runs under (nearest ancestor), or None."""
    pid = os.getppid()
    for _ in range(8):
        r = subprocess.run(["ps", "-o", "ppid=,command=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
        if not r:
            return None
        ppid, _, cmd = r.partition(" ")
        if "/.local/bin/claude" in cmd or cmd.strip().endswith("/claude") or " claude " in f" {cmd} ":
            return pid
        if not ppid.strip().isdigit() or int(ppid) <= 1:
            return None
        pid = int(ppid)
    return None


def cmd_watch(t: Team, args):
    """Wait until a message for this session lands in its inbox, print the
    messages addressed to it, and exit. Run it in the background and again after
    each wake. Waiting costs nothing: no tokens until it prints.

    The background watch shows a message once and leaves it unread (CW1): the
    role text then runs `watch --now`, which prints everything waiting and files
    it as read. Messages already shown are remembered in the inbox's .notified,
    so a re-armed watch does not wake again on them.

    A session wakes for messages addressed to it by name, and for anything on
    its own channel addressed to it. Other messages it receives (General lines
    for all, status chatter) wait and print with its next wake. --also TEXT also
    wakes it on a General line containing TEXT."""
    team = load_team(t)
    n = args.name
    if n != "orc" and n not in team["lanes"] and n not in t.assistants:
        sys.exit(f"unknown session '{n}'")
    box = t.inbox(n)
    read = box / "read"
    mine = own_names(t, n)
    seen_f = box / ".notified"
    def seen():
        try:
            return set(seen_f.read_text().split())
        except OSError:
            return set()
    gstart = len(t.general.read_text(errors="ignore").splitlines()) if args.also and t.general.exists() else 0
    end = time.time() + args.timeout
    owner = None if args.now else _owning_session()
    while True:
        if owner and not _pid_alive(owner):
            return          # its session is gone (sleep, kill, crash): an orphan watch helps nobody
        items, wake = [], False
        shown = seen() if not args.now else set()
        for f in sorted(box.glob("*.json")) if box.exists() else []:
            try:
                m = json.loads(f.read_text())
            except (OSError, ValueError):
                continue
            items.append((f, m))
            if mine & {x.strip() for x in m.get("to", "").split(",")} and f.name not in shown:
                wake = True
        hits = []
        if args.also and t.general.exists():
            hits = [x for x in t.general.read_text(errors="ignore").splitlines()[gstart:]
                    if any(a in x for a in args.also)]
            wake = wake or bool(hits)
        if args.now and not (items or hits):
            print("nothing waiting")
            return
        if wake and not args.now:
            # Show the new ones and leave everything unread for `watch --now`.
            new = [(f, m) for f, m in items if mine & {x.strip() for x in m.get("to", "").split(",")} and f.name not in shown]
            for f, m in new:
                print(f"{m['chan']}: {m['time']} | {m['from']} | {m['type']} {m['to']} | {m['text']}")
            with seen_f.open("a") as fh:
                fh.write("".join(f.name + "\n" for f, _ in new))
            for x in hits:
                print(f"general: {x}")
            print(f"(left unread: run `{t.cmd('watch')} {n} --now` to take them)")
            return
        if args.now:
            # Only messages addressed to this session reach its context.
            # Broadcasts and status chatter are filed as read; the channel
            # logs keep them.
            read.mkdir(parents=True, exist_ok=True)
            other = 0
            for f, m in items:
                if mine & {x.strip() for x in m.get("to", "").split(",")}:
                    print(f"{m['chan']}: {m['time']} | {m['from']} | {m['type']} {m['to']} | {m['text']}")
                else:
                    other += 1
                f.rename(read / f.name)
            left = seen() - {f.name for f, _ in items}
            try:
                seen_f.write_text("".join(x + "\n" for x in sorted(left)))
            except OSError:
                pass
            if other and not hits and not any(mine & {x.strip() for x in m.get("to", "").split(",")} for _, m in items):
                print("nothing for you")
            for x in hits:
                print(f"general: {x}")
            return
        if args.timeout and time.time() >= end:
            print(f"nothing for you in {args.timeout // 60} minutes; run watch again")
            return
        time.sleep(3)


def cmd_rotate(t: Team, args):
    """Like syslog: read messages older than --hours (default 24) go into a
    .tgz in each inbox's archive/ folder. Run hourly from cron."""
    import tarfile
    team = load_team(t)
    names = [*t.staff(), *team["lanes"], *[a for a in t.assistants if not t.managed(a)]]
    cutoff = time.time() - args.hours * 3600
    total = 0
    for k in names:
        rd = t.inbox(k) / "read"
        old = [f for f in rd.glob("*.json") if f.stat().st_mtime < cutoff] if rd.exists() else []
        if not old:
            continue
        arc = t.inbox(k) / "archive"
        arc.mkdir(parents=True, exist_ok=True)
        tgz = arc / f"read-{datetime.now():%Y%m%d-%H%M%S}.tgz"
        with tarfile.open(tgz, "w:gz") as tf:
            for f in old:
                tf.add(f, arcname=f.name)
        for f in old:
            f.unlink()
        total += len(old)
    print(f"{t.product}: archived {total} read messages")


# ---------------------------------------------------------------- doors

def lane_worktree(t, team, lane):
    if lane not in team["lanes"]:
        sys.exit(f"unknown lane '{lane}'")
    if team["lanes"][lane].get("ref"):
        sys.exit(f"lane '{lane}' is pinned to a ref; it has no branch to move")
    wt = lane_wt(t, lane, team["lanes"][lane])
    if head_branch(wt) != t.prefix + lane:
        sys.exit(f"{wt} is not on {t.prefix + lane}")
    return wt


def unit_worktree(t, team, lane, feature):
    lane_worktree(t, team, lane)
    wt = t.unit_wt(lane, feature)
    if not wt.exists():
        sys.exit(f"no worker worktree for feature '{feature}' in lane {lane}; "
                 f"create it with `{t.cmd('unit')} {lane} {feature}`")
    if head_branch(wt) != t.unit_branch(lane, feature):
        sys.exit(f"{wt} is not on {t.unit_branch(lane, feature)}")
    return wt


def tier_worktree(t, tier):
    if t.lab:
        sys.exit(f"lab teams have no {tier} step; lanes push straight to {t.base}")
    wt = t.tier_wt(tier)
    if head_branch(wt) != t.tier_branch(tier):
        sys.exit(f"{wt} is not on {t.tier_branch(tier)}")
    return wt


def require_clean(wt):
    if is_dirty(wt):
        sys.exit(f"{wt} has uncommitted changes; commit them first")


def require_record(t, wt, lane):
    """With push_needs_record set, a push needs a green test record
    for exactly the tree it pushes. The lane's record for its tree before pulling
    exchange in does not count: after the merge, it re-runs the tests post-flight
    chose, on the merged tree, and that run's record is what lets the push through."""
    env = dict(os.environ, **{k: t.expand(v) for k, v in t.env.items()})
    r = subprocess.run([str(TOOL_DIR / "bin" / "zone-tool"), "covered"], cwd=wt, env=env,
                       capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"push-up refused: {(r.stdout or r.stderr).strip()}\n"
                 f"Run the tests post-flight chose on this tree (make zone-test-one DIR=<pkg> ...), "
                 f"then push again. A change with no tests to run: push-up {lane} ... --untested '<why>'.")


def originals(repo, rng):
    revs = rng if isinstance(rng, (list, tuple)) else [rng]
    return out(repo, "log", "--reverse", "--format=%h %s", *revs)


def push_range(wt, tgt, lane):
    """The lane commits a push-up squashes: those since the lane's last push-up, not every lane commit
    exchange lacks. A push-up's squash leaves no ancestry back to the lane, so `tgt..HEAD` reached the
    lane's whole history (once: 37 old Request/Worktree trailers
    and a Squashes list going back to the lane's start). The last push point is the lane's merge of its
    own latest squash on tgt (push-up merges tgt into the lane right after)."""
    last = ""
    for rec in out(wt, "log", tgt, "-50", "--format=%H%x00%B%x01", "--fixed-strings", "--grep", f"Lane: {lane}").split("\x01"):
        sha, _, body = rec.strip().partition("\x00")
        if sha and re.search(rf"^Lane:[ \t]*{re.escape(lane)}[ \t]*$", body, re.M):
            last = sha
            break
    if last:
        path = out(wt, "rev-list", "--first-parent", "--ancestry-path", "--reverse", f"{last}..HEAD").split()
        if path:
            return [f"^{path[0]}", "HEAD", f"^{tgt}"]
    return [f"{tgt}..HEAD"]


# Trailers codeteam writes itself, which a squash never carries: the squash's own (Feature, Lane, Untested,
# Squashes) and accept's working records (Request, Worktree). Everything a
# lane wrote, such as push-checks' reasons, is carried.
OWN_TRAILERS = {"feature", "features", "lane", "untested", "squashes", "request", "worktree"}


def carried_trailers(repo, rng):
    """The git trailers of the commits in rng, in order, without duplicates (same key and value), less
    the ones codeteam writes on a squash. A squash keeps them, so a lane's reasons (push-checks'
    Interface-unchanged, Port-tests, Removal-minor) reach the commit Kong reviews."""
    revs = rng if isinstance(rng, (list, tuple)) else [rng]
    raw = git(repo, "log", "--reverse", "-z", "--format=%(trailers:unfold,only)", *revs, check=False).stdout
    seen, lines = set(), []
    for block in raw.split("\0"):
        for line in block.splitlines():
            key, sep, val = line.partition(":")
            key, val = key.strip(), val.strip()
            if not sep or not key or not val or " " in key or key.lower() in OWN_TRAILERS:
                continue
            if (key.lower(), val) not in seen:
                seen.add((key.lower(), val))
                lines.append(f"{key}: {val}")
    return lines


def squash_message(subject, body_lines, trailers):
    """A squash's message: the subject, the `Squashes:` list in the body, and a last paragraph of
    trailers only, so git (and push-checks, through %(trailers)) reads every one (with the list
    in that paragraph, git read no trailers at all)."""
    return f"{subject}\n\nSquashes:\n{body_lines}\n\n" + "\n".join(trailers) + "\n"


FEATURE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


def check_feature(f):
    if not FEATURE_RE.match(f):
        sys.exit(f"feature name '{f}': use letters, digits, dot, dash and underscore")
    return f


def feature_rec(team, f):
    return team.setdefault("features", {}).setdefault(f, {"state": "lanes", "lanes": [], "exchange": []})


def squash_onto(t, src_wt, branch, msg):
    """One commit on top of `branch` with the tree of src_wt's HEAD, which must
    already contain `branch`. Moves `branch` (inside its own checkout when it has
    one) and returns the new commit."""
    if git(src_wt, "merge-base", "--is-ancestor", branch, "HEAD", check=False).returncode:
        return None
    old = out(t.repo, "rev-parse", branch)
    tree = out(src_wt, "rev-parse", "HEAD^{tree}")
    if tree == out(t.repo, "rev-parse", f"{old}^{{tree}}"):
        sys.exit(f"nothing to move: the files already match {branch}")
    if t.gate:
        # commit-tree runs no hook, so the team's gates judge what lands here (HK2).
        # After the pull-down check above, so the source's current gate scripts run.
        cmd = t.gate.format(target=branch)
        r = subprocess.run(cmd, shell=True, cwd=src_wt, capture_output=True, text=True)
        if r.returncode:
            tail = "\n".join((r.stdout + r.stderr).strip().splitlines()[-15:])
            sys.exit(f"gates refused the move to {branch} (`{cmd}` exit {r.returncode}):\n{tail}")
    new = commit_tree(t.repo, tree, [old], msg)
    move_branch(t.repo, branch, new, old)
    return new


def merge_into(t, tier_or_wt, src):
    """Merge `src` into a checkout; on conflict abort and report."""
    wt = tier_or_wt
    r = git(wt, "merge", "--no-edit", "-q", src, check=False)
    if r.returncode:
        files = out(wt, "diff", "--name-only", "--diff-filter=U")
        git(wt, "merge", "--abort", check=False)
        warn(f"merging {src} into {head_branch(wt)} has conflicts in: {files or r.stderr.strip()}; "
             f"{head_branch(wt)} left as it was")
        return False
    return True


# ---- workers

def cmd_unit(t: Team, args):
    """A worker worktree for one feature, cut from the lane branch."""
    team = load_team(t, write=True)
    f = check_feature(args.feature)
    lane_worktree(t, team, args.lane)
    wt = t.unit_wt(args.lane, f)
    import contextlib
    with contextlib.redirect_stdout(sys.stderr):    # stdout carries only the path
        ensure_worktree(t, team, wt, branch=t.unit_branch(args.lane, f), start=t.prefix + args.lane)
        provision_claude(t, wt, t.ledger(args.lane) / "memory")
    rec = feature_rec(team, f)
    if args.lane not in rec["lanes"]:
        rec["lanes"].append(args.lane)
    save_json(t.team_file, team)
    print(wt)


def cmd_squash(t: Team, args):
    """Squash a worker's feature into one commit on its lane."""
    team = load_team(t)
    f = check_feature(args.feature)
    uw = unit_worktree(t, team, args.lane, f)
    lw = lane_worktree(t, team, args.lane)
    require_clean(uw)
    lb, ub = t.prefix + args.lane, t.unit_branch(args.lane, f)
    body = originals(uw, f"{lb}..HEAD")
    new = squash_onto(t, uw, lb, squash_message(args.message, body, [f"Feature: {f}", f"Lane: {args.lane}",
                                                                   *carried_trailers(uw, f"{lb}..HEAD")]))
    if new is None:
        sys.exit(f"{lb} has moved since this worker last pulled. Run:\n  "
                 f"{t.cmd('pull-down')} {args.lane} -f {f}")
    git(uw, "merge", "--no-edit", "-q", lb)       # same files: keeps the worker in step
    backup(t, lb, ub)
    print(f"squashed {f} into {lb} as {new[:10]} ({lw.name})")


def cmd_backup(t: Team, args):
    team = load_team(t)
    lane_worktree(t, team, args.lane)
    branches = [t.unit_branch(args.lane, args.feature)] if args.feature else [t.prefix + args.lane]
    if not t.backup:
        sys.exit("this team keeps its branches local")
    backup(t, *branches)
    print(f"backed up {', '.join(branches)}")


# ---- lanes

def warm_exchange(t, lane):
    """After a zone's work lands on exchange, build that zone there in the background
    (BUILD-REBUILD 2.3, 2026-10-23): `make warm-build` compiles its tests through the caches
    in the exchange worktree, so the Swift compile cache holds the newest exchange code and
    exchange's cargo-target (the folder new worktrees copy) is current before any zone needs
    them. Mechanical, no agent; output in <team>/warm-exchange.log. Never blocks the push."""
    team = load_team(t)
    zone = team["lanes"].get(lane, {}).get("path", "")
    if not zone or zone == "." or str(t.env.get("CODETEAM_SWIFT_XCODE", "")) != "1":
        return
    ex = t.ex_wt()
    if not Path(ex).is_dir():
        return
    env = dict(os.environ, **{k: t.expand(v) for k, v in t.env.items()}, CODETEAM_ZONE=zone,
               MAKEFILES=str(TOOL_DIR / "zone" / "zone.mk"), CODETEAM_HOME=str(TOOL_DIR))
    log = open(t.home / "warm-exchange.log", "a")
    log.write(f"\n== {time.strftime('%Y-%m-%d %H:%M:%S')} {lane} ({zone})\n"); log.flush()
    subprocess.Popen(["nice", "-n", "10", "make", "--no-print-directory", "warm-build"], cwd=ex, env=env,
                     stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)
    say_line(f"{lane}: warming exchange ({zone}) in the background")


def changed_paths(wt, tgt) -> list[str]:
    """Every path the lane's work changes against `tgt`: what HEAD differs by from the merge base.
    --no-renames: a rename is listed as its deletion and its addition, so both names are checked.
    -z: the names exactly as git records them (no quoting, no stripping). Fails closed: a push whose
    paths cannot be listed is refused, never let through unchecked."""
    mb = git(wt, "merge-base", tgt, "HEAD", check=False)
    base = mb.stdout.strip()
    if mb.returncode or not base:
        sys.exit(f"push-up refused: could not list the changed paths (git merge-base {tgt} HEAD failed in {wt}). Nothing was pushed.")
    r = git(wt, "diff", "--no-renames", "--no-ext-diff", "--no-relative", "--name-only", "-z", base, "HEAD", check=False)
    if r.returncode:
        sys.exit(f"push-up refused: could not list the changed paths (git diff {base} HEAD failed in {wt}). Nothing was pushed.")
    return [p for p in r.stdout.split("\0") if p]


def walls_refusals(team_file, lanes, lane, paths, manifest=None) -> list[tuple[str, str]]:
    """The (path, owner) pairs among `paths` that `lane` may not change, in order.
    The rule is share/claude-hooks/lane_walls.py, the one zone-guard.py uses; this keeps no list of
    owned paths. The lane's facts are the ones the launch script gives the guard: its zone path,
    its owns and team/team.json, plus the team manifest's top-level orchestrator_owns, which
    refused_by gives the orchestrator for every lane. Fails closed when lane_walls cannot be imported."""
    hooks = str(TOOL_DIR / "share" / "claude-hooks")
    if hooks not in sys.path:
        sys.path.append(hooks)
    try:
        import lane_walls
    except Exception as e:
        sys.exit(f"push-up refused: lane_walls unavailable at {hooks} ({e}). "
                 "The walls check cannot run, so nothing was pushed.")
    rec = lanes[lane]
    walls = lane_walls.load_walls(lane=lane, zone=rec.get("path", ""), owns=rec.get("owns") or [],
                                  team_json=team_file, codeteam_home=TOOL_DIR, manifest=manifest)
    return [(p, owner) for p in paths if (owner := lane_walls.refused_by(p, walls)) is not None]


def refuse_if_landing(t: Team, what: str, then: str | None = None) -> None:
    """Refuse this command when [land] is enabled; branch flow v5 uses codeteam-land instead
    (spec v5 §10). An optional message replaces the default land instruction."""
    if (t.m.get("land") or {}).get("enabled"):
        if then is None:
            then = f"Queue a finished work order with: codeteam-land {t.manifest} land <work order>"
        sys.exit(f"{what} is off for this team: it lands with codeteam-land (spec v5). {then}")


def cmd_push_up(t: Team, args):
    """Squash the lane's work for one feature into one commit on exchange (lab: base).
    First the walls check: a lane that changes a path outside its walls is refused
    whole, --untested or not, with each path and its owner, before anything is written or posted."""
    refuse_if_landing(t, "push-up")
    team = load_team(t, write=True)
    f = check_feature(args.feature)
    wt = lane_worktree(t, team, args.lane)
    require_clean(wt)
    tgt = t.target
    if out(wt, "rev-list", "--count", f"{tgt}..HEAD") == "0":
        sys.exit(f"nothing to push: the lane has no commits beyond {tgt}")
    refused = walls_refusals(t.team_file, team["lanes"], args.lane, changed_paths(wt, tgt),
                             manifest=t.manifest)
    if refused:
        import lane_walls
        orc = t.orc_name()
        lines = [f"  {p}: {f'orchestrator ({orc})' if o == lane_walls.ORCHESTRATOR else o}" for p, o in refused]
        sys.exit("\n".join([f"push-up refused: lane {args.lane} changes paths outside its walls:", *lines,
                            "Nothing was pushed. Take those changes off the lane (there is no override). A change another "
                            f"lane or the orchestrator owns goes to {orc} as one NOTE naming the files."]))
    if t.m.get("push_needs_record") and not args.untested:
        require_record(t, wt, args.lane)
    prior = team.get("features", {}).get(f)
    if prior and prior.get("state") != "lanes" and not t.lab:
        # CW2: a commit filed under a feature that has moved on is invisible to
        # integrate, register and promote, and sticks on exchange.
        sys.exit(f"feature {f} has moved on to {prior['state']}; push this work under a new feature name")
    rng = push_range(wt, tgt, args.lane)
    body = originals(wt, rng)
    untested = [f"Untested: {' '.join(args.untested.split())}"] if args.untested else []
    new = squash_onto(t, wt, tgt, squash_message(args.message, body, [f"Feature: {f}", f"Lane: {args.lane}", *untested,
                                                                       *carried_trailers(wt, rng)]))
    if new is None:
        sys.exit(f"{tgt} has moved since your last pull-down. Run:\n  {t.cmd('pull-down')} {args.lane}")
    git(wt, "merge", "--no-edit", "-q", tgt)      # same files: keeps the lane in step
    backup(t, t.prefix + args.lane, tgt)
    rec = feature_rec(team, f)
    if args.lane not in rec["lanes"]:
        rec["lanes"].append(args.lane)
    rec["exchange"].append(new)
    # The python3 and git the gate ran with are part of the record, so a Homebrew upgrade shows up as a
    # change in the record, not as a failure.
    rec.setdefault("tool_versions", []).append({"commit": new, "python3": tool_version("python3"),
                                                "git": tool_version("git")})
    if t.lab:
        rec["state"] = t.base
    save_json(t.team_file, team)
    sha = new[:10]
    post(t, t.lane_channel(args.lane), coord_name(args.lane), "PUSHED", t.orc_name(),
         f"{sha} feature {f}: {args.message}")
    post(t, t.general, coord_name(args.lane), "PUSHED", t.orc_name(),
         f"{args.lane} pushed feature {f} to {tgt} as {sha}; lanes waiting on it run pull-down")
    tell_waiting_lanes(t, team, f, coord_name(args.lane))
    if t.guard and t.guard in t.assistants and t.guard_per == "push":
        post(t, t.assistant_channel(t.guard), coord_name(args.lane), "REQUEST", t.guard,
             f"review {sha} on {t.exchange}: lane {args.lane}, feature {f}: {args.message}")
    # The pushed work is accepted on exchange: its request worktrees go now, not at the hourly sweep.
    subprocess.Popen([sys.executable, os.path.realpath(__file__), "sweep-accepted", str(t.manifest), "--lane", args.lane],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    warm_exchange(t, args.lane)
    print(f"pushed feature {f} to {tgt} as {sha}")


def cmd_sweep_accepted(t: Team, args):
    """One at a time per team (2026-11-04): every push-up and approve starts one in the background, and an
    `xargs codeteam approve` over a set of features started 220 at once (load 416, herdr unreachable). A sweep
    that finds one running leaves a mark and exits; the running one sweeps again while a mark is there."""
    if args.dry_run:
        sweep_landed_worktrees(t, load_team(t), True, only_lane=args.lane)
        return
    import fcntl
    lock_path = registry_file(t).parent / "sweep-accepted.lock"
    again = registry_file(t).parent / "sweep-accepted.again"
    fd = open(lock_path, "a")
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        again.touch()
        return
    while True:
        again.unlink(missing_ok=True)
        sweep_landed_worktrees(t, load_team(t), False, only_lane="")
        if not again.exists():
            break


def cmd_pull_down(t: Team, args):
    """exchange (lab: base) -> lane; or, with -f, lane -> worker."""
    refuse_if_landing(t, "pull-down")
    team = load_team(t)
    if args.feature:
        wt = unit_worktree(t, team, args.lane, check_feature(args.feature))
        src = t.prefix + args.lane
    else:
        wt = lane_worktree(t, team, args.lane)
        src = t.target
    require_clean(wt)
    r = git(wt, "merge", "--no-edit", "-q", src, check=False)
    if r.returncode:
        files = out(wt, "diff", "--name-only", "--diff-filter=U")
        sys.exit(f"merge of {src} has conflicts in:\n{files}\n"
                 "Resolve them and commit, or run `git merge --abort`.")
    print(f"{head_branch(wt)} is up to date with {src}")


# ---- moving up: READY from every decider, for the exact set and source tip

def ready_text(step, features, tip):
    return f"{step} {','.join(sorted(features))} @{tip[:10]}"


def ready_names(t, step, features, tip):
    want = ready_text(step, features, tip)
    have = set()
    for line in (t.general.read_text().splitlines() if t.general.exists() else []):
        parts = [x.strip() for x in line.split("|")]
        if len(parts) >= 4 and parts[2].startswith("READY") and parts[3] == want:
            have.add(parts[1])
    return have


def require_ready(t, step, features, tip):
    missing = [d for d in deciders(t) if d not in ready_names(t, step, features, tip)]
    if missing:
        sys.exit(f"waiting for READY from {', '.join(missing)} for `{ready_text(step, features, tip)}`.\n"
                 f"Each posts: {t.cmd('ready')} <name> {step} {' '.join(sorted(features))}")


def step_source(t, step):
    return {"integrate": t.exchange, "promote": t.integration}[step]


FEATURE_TRAILER = re.compile(r"^Feature: *(\S+)", re.M)
FEATURE_SUBJECT = re.compile(r"\(feature ([A-Za-z0-9][A-Za-z0-9._-]*)\)")
LANE_TRAILER = re.compile(r"^Lane: *(\S+)", re.M)


def cmd_register(t: Team, args):
    """Record exchange commits under a feature. With no commits, record every
    commit beyond integration that names its feature (a Feature: line, or
    "(feature NAME)" in the subject) and is not yet recorded."""
    team = load_team(t, write=True)
    recs = team.setdefault("features", {})
    have = {c for r in recs.values() for c in r["exchange"]}
    pending = out(t.repo, "rev-list", "--reverse", f"{t.integration}..{t.exchange}").split()
    if args.commits:
        if not args.feature:
            sys.exit("name the feature with -f")
        todo = []
        for c in args.commits:
            full = out(t.repo, "rev-parse", "--verify", f"{c}^{{commit}}")
            if full not in pending:
                sys.exit(f"{c} is not on {t.exchange} beyond {t.integration}")
            todo.append((full, check_feature(args.feature)))
    else:
        todo = []
        for c in pending:
            body = out(t.repo, "log", "-1", "--format=%B", c)
            m = FEATURE_TRAILER.search(body) or FEATURE_SUBJECT.search(body.splitlines()[0] if body else "")
            if m and FEATURE_RE.match(m.group(1)):
                todo.append((c, m.group(1)))
    done = []
    for c, f in todo:
        if c in have:
            continue
        rec = feature_rec(team, f)
        if rec["state"] != "lanes":
            sys.exit(f"feature '{f}' is already on {rec['state']}; give {c[:10]} a new feature name")
        body = out(t.repo, "log", "-1", "--format=%B", c)
        lm = LANE_TRAILER.search(body)
        who = args.lane or (lm.group(1) if lm else out(t.repo, "log", "-1", "--format=%an", c))
        if who not in rec["lanes"]:
            rec["lanes"].append(who)
        rec["exchange"].append(c)
        have.add(c)
        done.append(f"{c[:10]} {f}")
    save_json(t.team_file, team)
    if done:
        backup(t, t.exchange)
    print("\n".join(f"registered {d}" for d in done) if done else "nothing to register")


def cmd_ready(t: Team, args):
    team = load_team(t)
    if t.lab:
        sys.exit("lab teams have no integrate or promote step")
    who = t.display(args.name) if args.name == "orc" else args.name
    if who not in deciders(t):
        sys.exit(f"READY comes from {', '.join(deciders(t))}")
    feats = [check_feature(x) for x in args.features]
    unknown = [x for x in feats if x not in team.get("features", {})]
    if unknown:
        sys.exit(f"unknown features: {', '.join(unknown)}")
    tip = out(t.repo, "rev-parse", step_source(t, args.step))
    print(post(t, t.general, who, "READY", ready_recipients(t, who), ready_text(args.step, feats, tip)), end="")


def cmd_integrate(t: Team, args):
    """Squash a settled set of features from exchange into one commit on integration."""
    refuse_if_landing(t, "integrate")
    team = load_team(t, write=True)
    iw, ew = tier_worktree(t, "integration"), tier_worktree(t, "exchange")
    require_clean(iw)
    feats = [check_feature(x) for x in args.features]
    recs = team.get("features", {})
    for x in feats:
        if x not in recs:
            sys.exit(f"unknown feature '{x}'")
        if recs[x]["state"] != "lanes":
            sys.exit(f"feature '{x}' is already on {recs[x]['state']}")
    require_ready(t, "integrate", feats, out(t.repo, "rev-parse", t.exchange))
    order = out(t.repo, "rev-list", "--reverse", f"{t.integration}..{t.exchange}").split()
    # A feature's commits not yet taken: an earlier --picks integrate may have taken some.
    left = {x: [c for c in recs[x]["exchange"] if c not in set(recs[x].get("integrated", []))] for x in feats}
    wanted = {c for x in feats for c in left[x]}
    if args.picks:
        picks = read_picks(t, args.picks)
        stray = [p for p in picks if p not in wanted or p not in order]
        if stray:
            sys.exit(f"{len(stray)} pick(s) are not commits of {', '.join(feats)} still on {t.exchange} "
                     f"beyond {t.integration}: {' '.join(p[:10] for p in stray[:10])}"
                     f"{' ...' if len(stray) > 10 else ''}")
        empty = [x for x in feats if not set(left[x]) & set(picks)]
        if empty:
            sys.exit(f"no picks for {', '.join(empty)}; leave it out of this set")
        wanted = set(picks)
    commits = [c for c in order if c in wanted]
    if not commits:
        sys.exit("none of these features' commits are on exchange beyond integration")
    taken = {x: [c for c in left[x] if c in wanted] for x in feats}
    held = {x: [c for c in left[x] if c not in wanted] for x in feats}
    partial = [x for x in feats if held[x]]
    old = out(iw, "rev-parse", "HEAD")
    for c in commits:
        r = git(iw, "cherry-pick", "--no-commit", c, check=False)
        if r.returncode:
            files = out(iw, "diff", "--name-only", "--diff-filter=U")
            git(iw, "cherry-pick", "--abort", check=False)
            git(iw, "reset", "-q", "--hard", old)
            sys.exit(f"commit {c[:10]} does not apply on {t.integration}.\n"
                     f"Conflicts: {files or r.stderr.strip()}\n{t.integration} was left as it was.")
    lines = "\n".join(out(t.repo, "log", "-1", "--format=%h %s", c) for c in commits)
    msg = f"{args.message}\n\nFeatures: {', '.join(feats)}\nSquashes:\n{lines}"
    if partial:
        later = "\n".join(out(t.repo, "log", "-1", "--format=%h %s", c) for x in partial for c in held[x])
        msg += f"\nPartly integrated: {', '.join(partial)}\nHeld back for a later set:\n{later}"
    r = git(iw, "commit", "-q", "--allow-empty", "-m", msg, check=False)
    if r.returncode:
        git(iw, "reset", "-q", "--hard", old)
        sys.exit(f"commit on {t.integration} failed:\n{r.stderr.strip()}")
    new = out(iw, "rev-parse", "HEAD")
    team["last_integrate"] = {"before": old, "commit": new, "features": feats, "taken": taken}
    for x in feats:
        if held[x]:
            # Stays on exchange with the rest still to come; its next set takes only those.
            recs[x]["integrated"] = [*recs[x].get("integrated", []), *taken[x]]
        else:
            recs[x]["state"] = t.integration
            recs[x].pop("integrated", None)
    save_json(t.team_file, team)
    down = merge_into(t, ew, t.integration)
    backup(t, t.integration, t.exchange)
    post(t, t.general, t.builder or t.orc_name(), "PUSHED", tier_recipient(t),
         f"{t.integration} {new[:10]} features {', '.join(feats)}: {args.message}"
         + (f" (partly: {', '.join(f'{x}, {len(held[x])} held back' for x in partial)})" if partial else "")
         + ("" if down else f" ({t.exchange} did not take it: conflicts)"))
    print(f"integrated {', '.join(feats)} as {new[:10]} on {t.integration}")


def read_picks(t, path):
    """The commits a --picks file names, one per line (the first word; # starts a
    comment), resolved to full ids."""
    try:
        words = [ln.split("#", 1)[0].split() for ln in Path(path).read_text().splitlines()]
    except OSError as e:
        sys.exit(f"--picks: {e}")
    picks = []
    for w in words:
        if not w:
            continue
        r = git(t.repo, "rev-parse", "--verify", "-q", f"{w[0]}^{{commit}}", check=False)
        if r.returncode:
            sys.exit(f"--picks: {w[0]} is not a commit")
        c = r.stdout.strip()
        if c not in picks:
            picks.append(c)
    if not picks:
        sys.exit(f"--picks: {path} names no commits")
    return picks


def cmd_promote(t: Team, args):
    """Squash integration into one commit on base; merge it down the line. Refuse landing-enabled teams."""
    refuse_if_landing(t, "promote",
                      f"Promote with: codeteam-land {t.manifest} promote (Stage 7 now: it takes the newest landing commit "
                      "that passed Stage 6, with every test failure at or before it fixed at or before it)")
    team = load_team(t, write=True)
    iw, ew = tier_worktree(t, "integration"), tier_worktree(t, "exchange")
    require_clean(iw)
    recs = team.get("features", {})
    feats = sorted(x for x, r in recs.items() if r["state"] == t.integration)
    if not feats:
        sys.exit(f"no features on {t.integration} waiting for {t.base}")
    tip = out(t.repo, "rev-parse", t.integration)
    require_ready(t, "promote", feats, tip)
    body = originals(t.repo, f"{t.base}..{t.integration}")
    new = squash_onto(t, iw, t.base, f"{args.message}\n\nFeatures: {', '.join(feats)}\nPromotes:\n{body}")
    if new is None:
        sys.exit(f"{t.base} has moved; merge it into {t.integration} first "
                 f"(git merge {t.base} in {iw})")
    for x in feats:
        recs[x]["state"] = t.base
    team["last_integrate"] = {}
    save_json(t.team_file, team)
    merge_into(t, iw, t.base)
    merge_into(t, ew, t.integration)
    backup(t, t.integration, t.exchange)
    post(t, t.general, t.builder or t.orc_name(), "PUSHED", base_recipients(t),
         f"{t.base} {new[:10]} features {', '.join(feats)}: {args.message}. "
         f"Ready to ship. Lanes run pull-down.")
    for x, a in t.assistants.items():
        # Designers get no automatic message, external or not.
        if not t.managed(x) and a.get("role") != "designer":
            post(t, t.assistant_channel(x), t.builder or t.orc_name(), "PUSHED", x,
                 f"{t.base} moved to {new[:10]} (features {', '.join(feats)}); ready to ship")
    print(f"promoted {', '.join(feats)} to {t.base} as {new[:10]}")


def cmd_discard(t: Team, args):
    """Undo the last integrate: integration goes back to where it was."""
    team = load_team(t, write=True)
    iw = tier_worktree(t, "integration")
    last = team.get("last_integrate") or {}
    if not last:
        sys.exit("nothing to discard")
    if out(iw, "rev-parse", "HEAD") != last["commit"]:
        sys.exit(f"{t.integration} has moved since the last integrate; nothing was changed")
    require_clean(iw)
    git(iw, "reset", "-q", "--hard", last["before"])
    for x in last["features"]:
        rec = team["features"][x]
        took = set(last.get("taken", {}).get(x, rec["exchange"]))
        if rec["state"] == t.integration:
            # Completed by this integrate: what earlier sets took stays taken.
            rec["state"] = "lanes"
            earlier = [c for c in rec["exchange"] if c not in took]
            if earlier:
                rec["integrated"] = earlier
        else:
            rec["integrated"] = [c for c in rec.get("integrated", []) if c not in took]
            if not rec["integrated"]:
                rec.pop("integrated", None)
    team["last_integrate"] = {}
    save_json(t.team_file, team)
    backup(t, t.integration)
    post(t, t.general, t.builder or t.orc_name(), "NOTE", tier_recipient(t),
         f"{t.integration} discarded {last['commit'][:10]} (features {', '.join(last['features'])})")
    print(f"{t.integration} back at {last['before'][:10]}")


# ---- approval and retirement

def cmd_approve(t: Team, args):
    team = load_team(t, write=True)
    f = check_feature(args.feature)
    rec = team.get("features", {}).get(f)
    if not rec:
        sys.exit(f"unknown feature '{f}'")
    if not t.lab and rec["state"] == "lanes":
        sys.exit(f"feature '{f}' is not on {t.integration} yet")
    rec["approved"] = True
    save_json(t.team_file, team)
    # The sweep retires approved features' worktrees itself; start it now.
    subprocess.Popen([sys.executable, os.path.realpath(__file__), "sweep-accepted", str(t.manifest)],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    print(f"feature {f} approved; its worktrees are being retired")


def cmd_retire(t: Team, args):
    team = load_team(t, write=True)
    f = check_feature(args.feature)
    rec = team.get("features", {}).get(f)
    if not rec or not rec.get("approved"):
        sys.exit(f"feature '{f}' is not approved; its worktrees stay")
    wt, b = t.unit_wt(args.lane, f), t.unit_branch(args.lane, f)
    if wt.exists():
        r = git(t.repo, "worktree", "remove", wt, check=False)
        if r.returncode:
            sys.exit(f"{wt} was left in place: {r.stderr.strip()}")
    git(t.repo, "branch", "-D", b, check=False)
    if t.backup and git(t.repo, "remote", "get-url", "origin", check=False).returncode == 0:
        git(t.repo, "push", "-q", "origin", "--delete", b, check=False)
    team["created_worktrees"] = [w for w in team.get("created_worktrees", [])
                                 if (w["path"] if isinstance(w, dict) else w) != str(wt)]
    save_json(t.team_file, team)
    print(f"retired {wt.name}")


def _worktree_of(t, branch):
    """The path of the worktree that has `branch` checked out, else None."""
    path = None
    for l in git(t.repo, "worktree", "list", "--porcelain").stdout.splitlines():
        if l.startswith("worktree "):
            path = l.split(" ", 1)[1]
        elif l == f"branch refs/heads/{branch}":
            return Path(path)
    return None


def _in_lane(t, lb, branch, wid):
    """The branch's work is on lane branch lb: its tip is in lb, a squash with the trailer
    `Worktree: <wid>` is in lb, or lb holds the branch's version of every file it changed."""
    tip = out(t.repo, "rev-parse", f"refs/heads/{branch}")
    if git(t.repo, "merge-base", "--is-ancestor", tip, lb, check=False).returncode == 0:
        return True
    trailers = out(t.repo, "log", lb, "--since=60.days", "--format=%(trailers:key=Worktree,valueonly)").split()
    if wid in trailers:
        return True
    base = git(t.repo, "merge-base", lb, tip, check=False).stdout.strip()
    if not base:
        return False
    names = lambda a, b: set(out(t.repo, "diff", "--name-only", "--no-renames", a, b).splitlines())
    changed = names(base, tip)
    return not changed or not (changed & names(lb, tip))


def unit_provenance(lw, branch):
    """The Agent/Model/Effort trailers that share/claude-hooks/provenance.py put on the branch's unit
    commits, each distinct set once, so the squash keeps who wrote the request."""
    log = out(lw, "log", f"HEAD..refs/heads/{branch}", "--no-merges",
              "--format=%x00%(trailers:key=Agent,key=Model,key=Effort,unfold)")
    seen, lines = set(), []
    for rec in log.split("\0"):
        cur = {}
        for l in rec.splitlines() + ["Agent: "]:
            k, _, v = l.partition(": ")
            if k == "Agent" and cur.get("Agent"):
                key = (cur["Agent"], cur.get("Model", "unknown"), cur.get("Effort", "unknown"))
                if key not in seen:
                    seen.add(key); lines += [f"Agent: {key[0]}", f"Model: {key[1]}", f"Effort: {key[2]}"]
                cur = {}
            if k in ("Agent", "Model", "Effort") and v.strip():
                cur[k] = v.strip()
    return "".join(l + "\n" for l in lines)


def cmd_accept(t: Team, args):
    """A lane's accept step (2026-10-24): squash a finished request worktree's branch into the
    lane's standing worktree and commit it with the trailers `Request: <feature>` and
    `Worktree: <id>`. Lanes ran this as plain git, and auto mode's classifier refused it;
    as a codeteam command it is pre-approved."""
    team = load_team(t)
    f = check_feature(args.feature)
    lw = lane_worktree(t, team, args.lane)
    b = args.branch
    if git(t.repo, "rev-parse", "--verify", "-q", f"refs/heads/{b}", check=False).returncode:
        sys.exit(f"no branch '{b}'")
    wid = b.removeprefix("worktree-")
    if git(lw, "status", "--porcelain", "--untracked-files=no").stdout.strip():
        sys.exit(f"{lw} has uncommitted changes; commit them first (or, if they are this squash "
                 f"already staged, run `{t.cmd('accept')} {args.lane} {b} -f {f} -m ... --staged`)")
    if not args.staged:
        r = git(lw, "merge", "--squash", b, check=False)
        if r.returncode:
            git(lw, "reset", "-q", "--merge", check=False)
            sys.exit(f"{b} does not squash cleanly onto {t.prefix + args.lane}; nothing changed.\n"
                     f"{(r.stdout + r.stderr).strip()[-600:]}\nMerge the lane into the lead's branch, "
                     f"settle the conflicts there, then accept again.")
    if not git(lw, "diff", "--cached", "--name-only").stdout.strip():
        sys.exit(f"nothing to accept: {b} is already on {t.prefix + args.lane}")
    body = (args.body.strip() + "\n\n") if args.body else ""
    msg = f"{args.message.strip()}\n\n{body}Request: {f}\nWorktree: {wid}\n{unit_provenance(lw, b)}"
    with tempfile.NamedTemporaryFile("w", delete=False, suffix=".msg") as fh:
        fh.write(msg)
    try:
        git(lw, "commit", "-q", "-F", fh.name)
    finally:
        os.unlink(fh.name)
    # Earlier leads of this request whose branch this lead merged in (Continuing a request): their work is
    # in this squash, so their branches go now, here and on GitHub.
    tip = out(t.repo, "rev-parse", f"refs/heads/{b}")
    carried = []
    for name in out(t.repo, "for-each-ref", "--format=%(refname:short)", "refs/heads/worktree-*").split():
        if name != b and git(t.repo, "merge-base", "--is-ancestor", f"refs/heads/{name}", tip, check=False).returncode == 0:
            carried.append(name.removeprefix("worktree-"))
    if carried:
        drop_request_branches(t, carried, f"carried into {b}", False)
    print(f"accepted {b} into {t.prefix + args.lane} as {out(lw, 'rev-parse', '--short=10', 'HEAD')} "
          f"(Request: {f}, Worktree: {wid}). Next: `{t.cmd('push-up')} {args.lane} -f {f} -m ...`, "
          f"then `{t.cmd('remove-worktree')} {args.lane} {b}`.")


def cmd_remove_worktree(t: Team, args):
    """Remove a finished request worktree and delete its branch, once its work is on the lane
    (tip, Worktree trailer or content). Refuses otherwise: the work stays."""
    team = load_team(t)
    lw = lane_worktree(t, team, args.lane)
    lb, b = t.prefix + args.lane, args.branch
    if not b.startswith("worktree-"):
        sys.exit(f"only request worktree branches (worktree-*) are removed this way, not '{b}'")
    if git(t.repo, "rev-parse", "--verify", "-q", f"refs/heads/{b}", check=False).returncode:
        sys.exit(f"no branch '{b}'")
    if not _in_lane(t, lb, b, b.removeprefix("worktree-")):
        sup = getattr(args, "superseded_by", "")
        landed_sup = sup and git(t.repo, "merge-base", "--is-ancestor", sup, lb, check=False).returncode == 0
        if not landed_sup:
            sys.exit(f"{b} has work that is not on {lb}; it stays. Accept it first: "
                     f"`{t.cmd('accept')} {args.lane} {b} -f <feature> -m ...`, or, if a later lead redid this "
                     f"work and that is on {lb}: `{t.cmd('remove-worktree')} {args.lane} {b} --superseded-by <its commit on {lb}>`")
        say_line(f"{b}: superseded by {sup}, which is on {lb}")
    wt = _worktree_of(t, b)
    if wt and wt.exists():
        if wt.resolve() == Path(lw).resolve():
            sys.exit(f"{b} is checked out in the lane's own worktree; not removing it")
        if git(wt, "status", "--porcelain", "--untracked-files=no").stdout.strip():
            sys.exit(f"{wt} has uncommitted changes; they stay, and so does the worktree")
        r = git(t.repo, "worktree", "remove", "--force", wt, check=False)   # --force: untracked build output only
        if r.returncode:
            sys.exit(f"{wt} was left in place: {r.stderr.strip()}")
    git(t.repo, "worktree", "prune", check=False)
    git(t.repo, "branch", "-D", b)
    if t.backup and git(t.repo, "remote", "get-url", "origin", check=False).returncode == 0:
        git(t.repo, "push", "-q", "origin", "--delete", b, check=False)
    print(f"removed {wt or '(no worktree)'} and branch {b}")


# ---------------------------------------------------------------- snapshots

def cmd_snapshot(t: Team, args):
    """A disposable run copy at REF inside the lane's folder:
    workcrews/<lane>/<repo>-<ref>-<name>, on branch snap/<lane>/<name>."""
    team = load_team(t, write=True)
    if args.lane not in team["lanes"]:
        sys.exit(f"unknown lane '{args.lane}'")
    ref = args.ref
    if not ref_exists(t.repo, ref):
        sys.exit(f"ref {ref} not found")
    name = args.name or f"run{datetime.now():%m%d%H%M%S}"
    path = t.lane_dir(args.lane) / f"{t.repo_name}-{short(ref)}-{name}"
    import contextlib
    with contextlib.redirect_stdout(sys.stderr):    # stdout carries only the path
        ensure_worktree(t, team, path, branch=f"snap/{args.lane}/{name}", start=ref)
    team.setdefault("snapshots", {})[f"{args.lane}/{name}"] = str(path)
    save_json(t.team_file, team)
    print(path)


def cmd_drop(t: Team, args):
    team = load_team(t, write=True)
    path = team.get("snapshots", {}).pop(f"{args.lane}/{args.name}", None)
    if not path:
        sys.exit(f"no snapshot '{args.name}' in lane {args.lane}")
    git(t.repo, "worktree", "remove", "--force", path, check=False)
    git(t.repo, "branch", "-D", f"snap/{args.lane}/{args.name}", check=False)
    team["created_branches"] = [b for b in team.get("created_branches", [])
                                if (b["name"] if isinstance(b, dict) else b) != f"snap/{args.lane}/{args.name}"]
    team["created_worktrees"] = [w for w in team.get("created_worktrees", [])
                                 if (w["path"] if isinstance(w, dict) else w) != path]
    save_json(t.team_file, team)
    print(f"dropped {path}")


# ---------------------------------------------------------------- pins

def cmd_repin(t: Team, args):
    """Move the pin branch to the current tip of REF (default: its ref).
    A new ref gets a new folder named for it; `current` follows."""
    team = load_team(t, write=True)
    if args.pin not in t.pins:
        sys.exit(f"unknown pin '{args.pin}'. Pins: {', '.join(t.pins) or 'none'}")
    x = t.pins[args.pin]
    repo = Path(x["repo"]).expanduser()
    rec = team.get("pins", {}).get(args.pin)
    if not rec:
        sys.exit("pin not created yet; run init")
    ref = args.ref or rec["ref"]
    if not ref_exists(repo, ref):
        sys.exit(f"ref {ref} not found in {repo}")
    old = Path(rec["path"])
    new = t.pin_path(args.pin, ref)
    if old.exists() and is_dirty(old):
        sys.exit(f"{old} has local changes; a pin stays read-only")
    if new != old and old.exists():
        git(repo, "worktree", "remove", old)
        team["created_worktrees"] = [w for w in team.get("created_worktrees", [])
                                     if (w["path"] if isinstance(w, dict) else w) != str(old)]
    if not new.exists():
        ensure_worktree(t, team, new, branch=t.pin_branch(), start=ref, repo=repo)
    if head_branch(new) != t.pin_branch():
        sys.exit(f"{new} is not on {t.pin_branch()}")
    git(new, "reset", "-q", "--hard", ref)
    link(t.pin_dir(args.pin) / "current", new)
    team["pins"][args.pin] = {"path": str(new), "ref": ref}
    save_json(t.team_file, team)
    print(f"{args.pin}: {new.name} on {t.pin_branch()} at {out(new, 'rev-parse', '--short', 'HEAD')} ({ref})")


# ---------------------------------------------------------------- sleep

def waiting_files(t, n):
    """Inbox files addressed to n by name."""
    box, mine, found = t.inbox(n), own_names(t, n), []
    for f in sorted(box.glob("*.json")) if box.exists() else []:
        try:
            m = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if mine & {x.strip() for x in m.get("to", "").split(",")}:
            found.append(f)
    return found


def tab_of(t, team, n):
    return coord_name(n) if n in team["lanes"] else t.display(n)


def live_tabs():
    """{tab name: tmux target} for every tab in the codeteam tmux server."""
    r = tmux("list-windows", "-a", "-F", "#{session_name}\t#{window_index}\t#{window_name}\t#{pane_dead}")
    tabs = {}
    for line in r.stdout.splitlines():
        sess, idx, name, dead = line.split("\t")
        if dead != "1":
            tabs[name] = f"={sess}:{idx}"
    return tabs


def watcher_running(t, n) -> bool:
    """True when a `watch` for session n is running (read-only process scan)."""
    out = subprocess.run(["ps", "-axo", "args="], capture_output=True, text=True).stdout
    return any(f" watch {t.manifest} {n}" in f" {line} " and "--now" not in line for line in out.splitlines())


def cmd_nudge(t: Team, args):
    """Run by cron each minute; spends no tokens. For each session with a tab,
    when a message addressed to it has landed since its last nudge, type one
    line into its tab telling it to read its inbox.
    Retired: typed lines land in the user's own typing. Sessions read mail
    through their own watcher."""
    return
    team = load_team(t)
    tabs = live_tabs()
    for n in [*t.staff(), *team["lanes"]]:
        tab = tab_of(t, team, n)
        if tab not in tabs and windows_mode() == "terminal":
            sid = load_json(t.sessions_file, {}).get(n, {}).get("id", "")
            if sid and session_live(sid):
                tabs[tab] = "terminal"
        if tab not in tabs:
            continue
        if watcher_running(t, n):
            continue  # its own watcher wakes it; the nudge is the fallback
        files = waiting_files(t, n)
        mark = t.inbox(n) / "nudged.txt"
        done = set(mark.read_text().split()) if mark.exists() else set()
        new = [f.name for f in files if f.name not in done]
        if not new:
            continue
        line = f"Messages waiting: run `{t.cmd('watch')} {n} --now` and carry out the requests it prints, as your role file directs."
        if tabs[tab] == "terminal":
            esc = line.replace("\\", "\\\\").replace('"', '\\"')
            osa(f'''tell application "{TERMINAL_APP}"
                repeat with w in windows
                    repeat with x in tabs of w
                        if custom title of x is "{tab}" or custom title of x ends with " {tab}" then do script "{esc}" in x
                    end repeat
                end repeat
            end tell''')
        else:
            # Claude Code reads keys that arrive in one burst as a paste, where
            # Enter is a newline. Type the line, pause, then send Enter alone.
            # A nudge line already near the bottom of the pane is one that
            # did not submit: send Enter for it instead of typing another.
            pane = tmux("capture-pane", "-p", "-t", tabs[tab]).stdout
            bottom = "\n".join(pane.rstrip().splitlines()[-8:])
            if "Messages waiting: run" not in bottom:
                tmux("send-keys", "-t", tabs[tab], "-l", line)
                time.sleep(0.5)
            tmux("send-keys", "-t", tabs[tab], "Enter")
        mark.write_text("\n".join(sorted({f.name for f in files})) + "\n")
        say_line(f"{tab}: nudged ({len(new)} new)")


def await_file(t, lane):
    return t.ledger(lane) / "awaits.txt"


def awaited(t: Team, n: str) -> set[str]:
    """Read features recorded by cmd_await and cleared by tell_waiting_lanes; missing or unreadable means none."""
    try:
        return set(await_file(t, n).read_text().split())
    except OSError:
        return set()


def cmd_await(t: Team, args):
    """Record that a lane waits for a feature; push-up of that feature sends
    the lane a NOTE, and the nudge wakes it."""
    team = load_team(t)
    if args.lane not in team["lanes"]:
        sys.exit(f"unknown lane '{args.lane}'")
    f = check_feature(args.feature)
    p = await_file(t, args.lane)
    have = set(p.read_text().split()) if p.exists() else set()
    have.add(f)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text("\n".join(sorted(have)) + "\n")
    print(f"{args.lane} waits for feature {f}; you are told when it is pushed")


def tell_waiting_lanes(t, team, feature, by):
    for lane in team["lanes"]:
        p = await_file(t, lane)
        if not p.exists():
            continue
        have = set(p.read_text().split())
        if feature in have:
            post(t, t.lane_channel(lane), by, "NOTE", coord_name(lane),
                 f"feature {feature} is on {t.target}: run pull-down")
            have.discard(feature)
            p.write_text("".join(f"{x}\n" for x in sorted(have)))


def waiting_for(t, n):
    """Messages in n's inbox addressed to n by name: work it has not seen."""
    box, mine, found = t.inbox(n), own_names(t, n), []
    for f in sorted(box.glob("*.json")) if box.exists() else []:
        try:
            m = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if mine & {x.strip() for x in m.get("to", "").split(",")}:
            found.append(m)
    return found


def cmd_sleep(t: Team, args):
    """Clean a session's worktree, then stop the session. It goes dark;
    `launch` resumes it later where it left off."""
    team = load_team(t)
    sessions = load_json(t.sessions_file, {})
    n = args.name
    if n != "orc" and n not in team["lanes"] and n not in t.assistants:
        sys.exit(f"unknown session '{n}'")
    if not t.managed(n):
        sys.exit(f"{n} is external; codeteam leaves its session alone")
    sid = sessions.get(n, {}).get("id", "")
    held = waiting_for(t, n)
    if held and not args.force:
        first = held[0]
        sys.exit(f"{n} has {len(held)} message(s) waiting, first from {first.get('from')} "
                 f"({first.get('type')}): not sleeping. Read them with "
                 f"`{t.cmd('watch')} {n} --now`. (--force sleeps anyway.)")
    if n in team["lanes"] and t.sleep_clean and not team["lanes"][n].get("ref"):
        wt = lane_wt(t, n, team["lanes"][n])
        r = subprocess.run(t.sleep_clean, shell=True, cwd=wt, capture_output=True, text=True,
                           env=_git_env())
        say_line(f"{n}: `{t.sleep_clean}` " + ("done" if r.returncode == 0 else
                 f"failed ({r.returncode}): {(r.stderr or r.stdout).strip()[-300:]}"))
    e = load_json(registry_file(t), {}).get(n)
    if e and e.get("pid") and _rt().alive(e["pid"]):
        with registry_txn(t) as reg:
            gone = _rt().precise_kill(n, reg[n])
            if gone:
                reg[n].update(state="asleep", pid=None, asleep_since=time.time(), slept_by="sleep")
        say_line(f"{n}: dark" if gone else f"{n}: STILL RUNNING (see registry)")
    elif sid and session_live(sid):
        say_line(f"{n}: running but not in the registry; stop it by hand (no pattern kill)")
    elif os.environ.get("CODETEAM_SESSION") == n:
        # A lane in auto mode cannot see its own process, so it cannot stop
        # itself. Its build output is cleaned; the orchestrator stops it.
        ch = t.lane_channel(n) if n in team["lanes"] else (
            t.assistant_channel(n) if n in t.assistants else t.general)
        post(t, ch, n, "NOTE", t.orc_name(), f"ready to sleep: run `{t.cmd('sleep')} {n}`")
        say_line(f"{n}: cleaned; asked {t.orc_name()} to stop this session")
    else:
        say_line(f"{n}: already dark")


# ---------------------------------------------------------------- runtime
# Hourly idle tick, minutely wake, worktree sweep, PID registry. Spends no
# tokens: cron runs them. Process helpers come from bin/codeteam-rt.

_RT = None


def _rt():
    # load_module() is gone in Python 3.15 (Homebrew moved python3 to it 2026-10-21
    # 17:43); from then every _rt() call failed, procreg included, so no pid was recorded.
    global _RT
    if _RT is None:
        import importlib.util
        from importlib.machinery import SourceFileLoader
        path = str(TOOL_DIR / "bin" / "codeteam-rt")
        spec = importlib.util.spec_from_loader("codeteam_rt", SourceFileLoader("codeteam_rt", path))
        _RT = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(_RT)
    return _RT


IDLE_SENDER = "codeteam"
COMPACT_AFTER_H = float(os.environ.get("CT_COMPACT_HOURS", "3"))
EXIT_AFTER_H = float(os.environ.get("CT_EXIT_HOURS", "6"))


def registry_file(t):
    return t.home / "registry.json"


@contextlib.contextmanager
def registry_txn(t):
    """Read, change and save the registry under one lock. A read held across slow
    work (make warm, an /exit wait) and saved afterwards erased the pids procreg
    recorded meanwhile (2026-10-21: nine lanes left at "launching" with no pid)."""
    import fcntl
    f = open(registry_file(t).parent / "registry.lock", "a")
    try:
        fcntl.flock(f, fcntl.LOCK_EX)
        reg = load_json(registry_file(t), {})
        yield reg
        save_json(registry_file(t), reg)
    finally:
        f.close()


def launched_claude(t, n):
    """PID of the claude child of session n's launch script, or None."""
    rt = _rt()
    script = str(t.home / "launch" / f"{n}.sh")
    for parent in subprocess.run(["pgrep", "-f", script], capture_output=True, text=True).stdout.split():
        for pid in subprocess.run(["pgrep", "-P", parent], capture_output=True, text=True).stdout.split():
            if "claude" in rt.proc_command(int(pid)):
                return int(pid)
    return None


LAUNCH_GRACE_MIN = 10


def settle_launching(t, team):
    """A "launching" entry: awake with its pid once its claude runs; asleep again if
    nothing came up within LAUNCH_GRACE_MIN, so wake can try once more."""
    for n, e in sorted(load_json(registry_file(t), {}).items()):
        if e.get("state") != "launching":
            continue
        pid = launched_claude(t, n)
        with registry_txn(t) as reg:
            cur = reg.get(n, {})
            if cur.get("state") != "launching":
                continue
            if pid:
                cwd = launch_target(t, team, n)[0]
                sid = load_json(t.sessions_file, {}).get(n, {}).get("id", "")
                cur.update(state="awake", pid=pid, cwd=os.path.realpath(cwd), launched_at=time.time(), sid=sid,
                           transcript=str(transcript_of(os.path.realpath(cwd), sid)), launching_since=None)
                say_line(f"{n}: launching -> awake, pid {pid}")
            elif time.time() - (cur.get("launching_since") or 0) > LAUNCH_GRACE_MIN * 60:
                cur.update(state="asleep", pid=None, asleep_since=time.time(), slept_by="launch never came up",
                           launching_since=None)
                say_line(f"{n}: launching -> asleep (no session came up)")


def transcript_of(cwd, sid):
    import re as _re
    slug = _re.sub(r"[^A-Za-z0-9]", "-", str(cwd))
    return Path.home() / ".claude" / "projects" / slug / f"{sid}.jsonl"


def cmd_procreg(t: Team, args):
    """Run by the launch script: record the PID of its claude child."""
    rt = _rt()
    child = None
    for _ in range(20):
        r = subprocess.run(["pgrep", "-P", str(args.parent)], capture_output=True, text=True)
        for pid in r.stdout.split():
            if "claude" in rt.proc_command(int(pid)):
                child = int(pid)
        if child:
            break
        time.sleep(1)
    if not child:
        sys.exit(f"{args.name}: no claude child of {args.parent}")
    team = load_team(t)
    cwd = launch_target(t, team, args.name)[0]
    sid = load_json(t.sessions_file, {}).get(args.name, {}).get("id", "")
    with registry_txn(t) as reg:
        reg[args.name] = {"state": "awake", "pid": child, "cwd": os.path.realpath(cwd),
                          "launched_at": time.time(), "sid": sid,
                          "transcript": str(transcript_of(os.path.realpath(cwd), sid))}
    say_line(f"{args.name}: pid {child}")


def session_channel(t, team, n):
    if n in team["lanes"]:
        return t.lane_channel(n)
    if n in t.assistants:
        return t.assistant_channel(n)
    return t.general


def last_activity(t, n, e):
    times = [e.get("launched_at", 0), e.get("activity_floor", 0)]
    read = t.inbox(n) / "read"
    for f in read.glob("*.json") if read.exists() else []:
        try:
            if json.loads(f.read_text()).get("from") != IDLE_SENDER:
                times.append(f.stat().st_mtime)
        except (OSError, ValueError):
            continue
    return max(times)


def typed_off(t, n):
    """Orc and the designer are the user's own sessions: nothing types into them."""
    return n == "orc" or t.assistants.get(n, {}).get("role") == "designer"


def type_into(t, team, n, line):
    """Type one line into a session's tab or Terminal window, then Enter.
    Orc and the designer are never typed into; the user types there."""
    if typed_off(t, n):
        return False
    tab = tab_of(t, team, n)
    tabs = live_tabs()
    if tab in tabs:
        tmux("send-keys", "-t", tabs[tab], "-l", line)
        time.sleep(0.5)
        tmux("send-keys", "-t", tabs[tab], "Enter")
        return True
    esc = line.replace("\\", "\\\\").replace('"', '\\"')
    return osa(f'''tell application "{TERMINAL_APP}"
        repeat with w in windows
            repeat with x in tabs of w
                if custom title of x is "{tab}" or custom title of x ends with " {tab}" then do script "{esc}" in x
            end repeat
        end repeat
    end tell''')


def press_enter(t, team, n):
    """Enter in a session's tmux tab; never in Orc or the designer."""
    if typed_off(t, n):
        return False
    tabs = live_tabs()
    tab = tab_of(t, team, n)
    if tab in tabs:
        tmux("send-keys", "-t", tabs[tab], "Enter")
        return True
    return False


def idle_reply(t, team, n, since):
    """'idle', 'busy' or '' from the session's ANSWER to codeteam after `since`."""
    ch = session_channel(t, team, n)
    if not ch.exists():
        return ""
    for line in reversed(ch.read_text(errors="ignore").splitlines()[-200:]):
        parts = [x.strip() for x in line.split("|")]
        if len(parts) < 4:
            continue
        try:
            when = datetime.strptime(parts[0], "%Y-%m-%d %H:%M").timestamp()
        except ValueError:
            continue
        if when < since - 60:
            break
        if parts[1] in own_names(t, n) and IDLE_SENDER in parts[2]:
            text = parts[3].lower()
            return "busy" if "busy" in text else "idle" if "idle" in text else ""
    return ""


def put_to_sleep(t, team, n, e, how):
    if n in team["lanes"] and t.sleep_clean and not team["lanes"][n].get("ref"):
        r = subprocess.run(t.sleep_clean, shell=True, cwd=lane_wt(t, n, team["lanes"][n]),
                           capture_output=True, text=True, env=_git_env())
        say_line(f"{n}: `{t.sleep_clean}` exit {r.returncode}")
    e.update(state="asleep", pid=None, pending_exit=None, asleep_since=time.time(), slept_by=how)
    say_line(f"{n}: asleep ({how})")


PATROL_IDLE_MIN = 20       # a coordinator quiet this long with open work is idle with work
PATROL_DEAD_MIN = 60       # minimum quiet age for a judged worktree to count as dead, if nobody is inside


def _order_age_min(t, n, name, now):
    """Minutes since lane n's work order `name` was last written, or None when it is missing or unreadable."""
    try:
        return (now - (t.ledger(n) / "orders" / f"{name}.md").stat().st_mtime) / 60
    except OSError:
        return None


# In a v5 team, a ledger row whose stage starts with one of these words waits on something outside the lane (a
# decision, a promote, a landing). Nothing clears such a wait by itself there (no push-up await), and what ends it
# reaches the lane as mail, which stages the row again (2026-11-12: a 'blocked-guard' row was a
# DEAD LEAD, and so IDLE WITH WORK, every patrol round while it waited for the owner). A row whose lead has handed back
# ('handed-back', 'accepted') waits on its coordinator, not on a lead (e.g. a --with set member waiting for
# the rest of its set); a coordinator idle on it is STALLED WORK ORDER's to report.
WAIT_STAGE = re.compile(r"(blocked|waits|waiting|held|handed|accepted)\b", re.I)


def _landing_holds(t, tree: Path) -> bool:
    """v5: the landing tool holds the work order this tree belongs to, so no lead is at work in it: queued for
    landing, held (wo-hold), landed or retired, or sent back by a landing conflict (<wo>.bounce.txt) with nothing done
    in the tree since. The bounce file is never removed, so a tree that moved after it is judged as usual: a lead
    resolving the conflict that then dies is still a DEAD LEAD (a set bounced at Stage 4 waits for a
    promote, and its members were DEAD LEAD every round)."""
    if not getattr(t, "root", None):
        return False
    d = Path(t.root) / "land" / "wo"
    wo = tree.name
    if (d / f"{wo}.landed.json").exists() or (d / f"{wo}.retired.json").exists():
        return True
    rec = load_json(d / f"{wo}.json", None)
    if not isinstance(rec, dict):
        return False
    if rec.get("queued") or rec.get("held"):
        return True
    try:
        return (d / f"{wo}.bounce.txt").stat().st_mtime >= _last_activity(tree)
    except OSError:
        return False


def lane_work(t, n, r, now):
    """The lane's ledger rows, split: (rows, active, dead, parked, queued). active also holds a
    past-queued row with no worktree whose order is under a day old. A non-queued row with
    an awaited feature as a [A-Za-z0-9._-]+ stage token is skipped before worktree judgment:
    it is neither active, dead, parked nor queued. Both patrols use these classifications.
    Once push-up clears the feature, the row is judged by its worktree and order. In a v5 team
    a row whose stage starts with a WAIT_STAGE word is skipped the same way, and so is a row whose work order the
    landing tool holds (_landing_holds)."""
    rows = []
    led = lane_ledger_dir(t, n, r) / ".ledger.md"
    if led.exists():
        for line in led.read_text(errors="ignore").splitlines():
            parts = [x.strip() for x in line.split("·")]
            if len(parts) == 3:
                rows.append(parts)
    active, dead, parked = [], [], 0
    waits = awaited(t, n)
    v5 = landing(t)
    for name, stage, wts in rows:
        if stage == "queued":
            continue
        if waits.intersection(re.findall(r"[A-Za-z0-9._-]+", stage)) or (v5 and WAIT_STAGE.match(stage)):
            continue
        ps = _lead_paths(t, n, [w for w in wts.split(",") if w and w != "-"])
        if not ps:
            # No worktree to judge, so never a DEAD LEAD. A lead just started is open work: active keeps
            # done_quiet_min at None (so swap_out will not /exit the lane for its slot), keeps the patrol's
            # IDLE WITH WORK quiet, and counts toward SERIAL's running leads. The order's mtime says when
            # it was written, not that the lead is alive, so a lead that died soon after starting counts
            # as active until its order is a day old. No order (missing, or named differently from the
            # row): parked, as for an old row nobody closed.
            age = _order_age_min(t, n, name, now)
            if age is not None and age < 24 * 60:
                active.append(name)
            else:
                parked += 1
            continue
        if v5 and any(_landing_holds(t, x) for x in ps):
            continue
        ages = [(now - _last_activity(x)) / 60 for x in ps]
        if any(_someone_inside(x) for x in ps) or any(a < PATROL_DEAD_MIN for a in ages):
            active.append(name)
        elif ages and min(ages) < 24 * 60:
            dead.append(name)          # went quiet in the last day: a lead that died
        else:
            parked += 1                # an old row nobody closed
    queued = [x[0] for x in rows if x[1] == "queued"]
    return rows, active, dead, parked, queued


def transcript_quiet_min(e, now):
    tr = e.get("transcript")
    return (now - Path(tr).stat().st_mtime) / 60 if tr and Path(tr).exists() else None


SWAP_IDLE_MIN = float(os.environ.get("CT_SWAP_IDLE_MIN", PATROL_IDLE_MIN))


def done_quiet_min(t, team, n, e, now):
    """Minutes a lane has been done and quiet, or None while it has anything to do:
    a running or died lead, queued work, unread mail, or activity in the last
    SWAP_IDLE_MIN minutes. Await-matching rows do not block sleep; once the other conditions
    are met, push-up's NOTE can wake the lane when the feature is ready."""
    if n not in team["lanes"] or e.get("state") != "awake" or e.get("pending_exit"):
        return None
    if not _rt().alive(e.get("pid")) or waiting_files(t, n):
        return None
    _, active, dead, _, queued = lane_work(t, n, team["lanes"][n], now)
    if active or dead or queued:
        return None
    quiet = min(x for x in [(now - last_activity(t, n, e)) / 60, transcript_quiet_min(e, now)]
                if x is not None)
    return quiet if quiet >= SWAP_IDLE_MIN else None


def oldest_waiting(t, n):
    """mtime of the oldest message waiting for n: the line is first come, first served."""
    times = []
    for f in waiting_files(t, n):
        try:
            times.append(f.stat().st_mtime)
        except OSError:
            pass
    return min(times) if times else None


def swap_out(t, team, n, now):
    """/exit a done lane to free its slot; True once it is asleep. Never a kill:
    a lane that does not leave keeps its slot and the tick's idle rules apply."""
    reg = load_json(registry_file(t), {})
    e = reg.get(n, {})
    if done_quiet_min(t, team, n, e, now) is None:
        return False
    rt = _rt()
    if type_into(t, team, n, "/exit") and not rt.wait_gone(e["pid"], 3):
        press_enter(t, team, n)
    if not rt.wait_gone(e["pid"], 15):
        say_line(f"{n}: did not exit for the lane cap; left awake")
        return False
    with registry_txn(t) as fresh:
        if fresh.get(n, {}).get("launched_at") == e.get("launched_at"):
            put_to_sleep(t, team, n, fresh[n], "lane cap swap")
    return True


def _lead_paths(t, n, ids):
    """Worktree paths for the lead ids on a ledger row (lane requests/ first, then the store)."""
    out = []
    for i in ids:
        i = i if i.startswith("agent-") or "/" in i else f"agent-{i}"
        for cand in (Path(i), t.lane_dir(n) / "requests" / i, Path(t.repo) / ".claude" / "worktrees" / i):
            if cand.is_dir():
                out.append(cand); break
    return out


def cmd_patrol(t: Team, args):
    """Cron, every 30 minutes. Find what Orc would otherwise learn only by asking:
    coordinators idle with open work, leads that died, and lanes running one
    request at a time with more queued. Posts one REQUEST to the orchestrator
    when there is something new to act on; silent otherwise."""
    team = load_team(t); reg = load_json(registry_file(t), {}); now = time.time()
    flags = []
    for n, r in sorted(team["lanes"].items()):
        e = reg.get(n, {})
        rows, active, dead, parked, queued = lane_work(t, n, r, now)
        if not rows:
            continue
        quiet = transcript_quiet_min(e, now)
        awake = e.get("state") == "awake" and _rt().alive(e.get("pid"))
        if awake and quiet is not None and quiet >= PATROL_IDLE_MIN and not active and (queued or dead):
            flags.append(f"{n}: IDLE WITH WORK, quiet {quiet:.0f} min, {len(queued)} queued ({', '.join(queued[:3])})")
        for d in dead:
            flags.append(f"{n}: DEAD LEAD on {d}, its worktree untouched {PATROL_DEAD_MIN}+ min and nothing running in it")
        if awake and len(queued) >= 2 and len(active) <= 1 and not (quiet is not None and quiet >= PATROL_IDLE_MIN):
            flags.append(f"{n}: SERIAL, {len(active)} lead running and {len(queued)} queued ({', '.join(queued[:4])})")
        if parked:
            flags.append(f"{n}: {parked} ledger row(s) past queued with no live lead for a day or more; close or requeue them")
        if not awake and queued and not waiting_files(t, n):
            flags.append(f"{n}: ASLEEP WITH WORK, {len(queued)} queued and nothing in its inbox to wake it")
    # The branch rule: leftovers are reported the day they appear.
    try:
        el, er, um, *_ = branch_leftovers(t, team)
        if el or er or um:
            flags.append(f"BRANCHES: {len(el)} here and {len(er)} on GitHub outside the rule, {len(um)} not mirrored "
                         f"(codeteam branch-audit lists them): " + ", ".join((el + er + um)[:6]))
    except Exception as e:   # a patrol must not fail on the audit
        say_line(f"patrol: branch audit skipped ({type(e).__name__}: {e})")
    mark = t.home / "patrol-last.json"
    prev = set(load_json(mark, []))
    new = [f for f in flags if f not in prev]
    if args.dry_run:
        # A dry run must not move the marker, or the next real patrol skips these lines.
        print("\n".join(flags) or "nothing to act on"); return
    save_json(mark, flags)
    if not new:
        return
    text = ("PATROL: act on each line. IDLE WITH WORK or ASLEEP WITH WORK: send that lane its next queued request "
            "(sleep it first if it predates current settings). DEAD LEAD: tell the lane its lead is gone and to start a new "
            "one from the lead's worktree and the order. SERIAL: tell the lane which queued requests touch different "
            "files and can run as parallel leads. BRANCHES: find whose they are; finished work's branches go "
            "(here and on GitHub), live work's get pushed. Lines: " + " | ".join(new))
    post(t, t.general, IDLE_SENDER, "REQUEST", t.orc_name(), text)
    print(f"patrol: posted {len(new)} new line(s) to {t.orc_name()}")


def cmd_tick(t: Team, args):
    """Cron, hourly. 3 h idle: /compact. 6 h idle: /exit; if it stays, ask;
    then a precise kill of the one recorded PID. Asleep sessions are cleaned."""
    rt = _rt()
    lock = cron_lock(t)
    team = load_team(t)
    reg = load_json(registry_file(t), {})
    now = time.time()
    for n, e in sorted(reg.items()):
        if e.get("state") != "awake" or not t.managed(n):
            continue
        if not rt.alive(e.get("pid")):
            put_to_sleep(t, team, n, e, "process ended")
            continue
        idle_h = (now - last_activity(t, n, e)) / 3600
        if e.get("pending_exit"):
            answer = idle_reply(t, team, n, e["pending_exit"])
            if answer == "busy":
                e.update(pending_exit=None, activity_floor=now)
                say_line(f"{n}: busy; idle reset")
            elif rt.precise_kill(n, e):
                put_to_sleep(t, team, n, e, f"kill after idle check ({answer or 'no answer'})")
            continue
        if idle_h >= EXIT_AFTER_H:
            say_line(f"{n}: idle {idle_h:.1f} h, /exit")
            if type_into(t, team, n, "/exit") and not rt.wait_gone(e["pid"], 3):
                # Running background shells (the watcher) open an exit menu;
                # its first choice, "Exit and stop tasks", is selected.
                press_enter(t, team, n)
            if rt.wait_gone(e["pid"], 15):
                put_to_sleep(t, team, n, e, "/exit")
            else:
                post(t, session_channel(t, team, n), IDLE_SENDER, "REQUEST", n,
                     f"Idle check: reply `{t.cmd('say')} {n} {n} ANSWER {IDLE_SENDER} idle` "
                     f"or `... busy`.")
                e["pending_exit"] = now
            continue
        if idle_h >= COMPACT_AFTER_H:
            tried = e.get("compact_try")
            if tried and tried > last_activity(t, n, e):
                count = rt.compact_count(e)
                if count is not None and count > e.get("compact_count_at_try", 0):
                    e["compacted_at"] = tried
                    continue
                if count is None:
                    continue
                e["compact_fail"] = e.get("compact_fail", 0) + 1
            e["compact_count_at_try"] = rt.compact_count(e) or 0
            e["compact_try"] = now
            say_line(f"{n}: idle {idle_h:.1f} h, /compact")
            type_into(t, team, n, "/compact")
    # Merge, not overwrite: keep any entry relaunched while this tick ran.
    with registry_txn(t) as fresh:
        for n, e in reg.items():
            if n not in fresh or fresh[n].get("launched_at") == e.get("launched_at"):
                fresh[n] = e


# ---------------------------------------------------------------- API-error resume
# A session whose last turn ended on an API error (a 429 from the proxy: "all credentials
# ... cooling down", an overload) sits at its prompt for good: nothing in Claude Code
# retries it, and it has no mail to be woken for (lanes never resumed after
# hitting API limits). Each wake looks for those and types a resume line, with backoff
# (5, 10, 20, 40, 60 min) and at most API_RESUME_PER_RUN sessions per run, so a cooled-down
# pool is not hit by every session at once.
API_RESUME_PER_RUN = int(os.environ.get("CT_API_RESUME_PER_RUN", "3"))
API_RESUME_LINE = ("codeteam: your last request was refused by the API ({err}), and it has had time to cool down. "
                   "Carry on with the work in progress where it stopped. If it is refused again, end your turn; "
                   "codeteam tries again later.")


def api_error_stall(transcript, tail_bytes=262144):
    """(error, epoch) when the transcript's last user/assistant entry is an API error, else None."""
    try:
        with open(transcript, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - tail_bytes))
            lines = f.read().decode("utf-8", "ignore").splitlines()
    except OSError:
        return None
    for line in reversed(lines):
        if '"type":"user"' not in line and '"type":"assistant"' not in line \
                and '"type": "user"' not in line and '"type": "assistant"' not in line:
            continue
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if d.get("type") not in ("user", "assistant"):
            continue
        if d.get("type") == "assistant" and d.get("isApiErrorMessage"):
            ts = d.get("timestamp", "")
            try:
                when = datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
            except ValueError:
                when = time.time()
            return (d.get("error") or "api error", when)
        return None
    return None


def resume_api_stalled(t, team, reg, now=None, dry_run=False):
    now = now or time.time()
    statef = registry_file(t).parent / "api-resume.json"
    st = load_json(statef, {})
    due = []
    for n, e in reg.items():
        if n not in team["lanes"] and n not in t.staff():
            continue
        if e.get("state") != "awake" or not _rt().alive(e.get("pid")) or not e.get("transcript"):
            continue
        stall = api_error_stall(e["transcript"])
        rec = st.get(n, {})
        if not stall:
            st.pop(n, None)
            continue
        err, when = stall
        if rec.get("err_at") != when:
            rec = {"err_at": when, "attempts": 0, "last_try": 0}
        wait = min(60, 5 * 2 ** rec["attempts"]) * 60
        if now - max(when, rec["last_try"]) >= wait:
            due.append((when, n, err, rec))
        st[n] = rec
    for when, n, err, rec in sorted(due)[:API_RESUME_PER_RUN]:
        if typed_off(t, n):
            if not rec.get("told"):
                say_line(f"{t.display(n)}: stalled on an API error ({err}) since "
                         f"{datetime.fromtimestamp(when):%H:%M}; codeteam never types into it, so it waits for you")
                rec["told"] = True
            continue
        if dry_run:
            say_line(f"{t.display(n)}: would resume after an API error ({err})")
            continue
        if type_into(t, team, n, API_RESUME_LINE.format(err=err)):
            rec.update({"attempts": rec["attempts"] + 1, "last_try": now})
            say_line(f"{t.display(n)}: resumed after an API error ({err}), try {rec['attempts']}")
    if not dry_run:
        save_json(statef, st)


def cmd_wake(t: Team, args):
    """Cron, each minute. An asleep session with a message waiting: make warm
    in its worktree, then a fresh launch. A HALTED file beside the registry
    keeps the whole team down: mail waits in the inboxes until it is removed."""
    halted = registry_file(t).parent / "HALTED"
    if halted.exists():
        return
    # One wake at a time. Launches are paced, so a run can outlast the minute;
    # a second wake reading the registry meanwhile saw lanes the first had not
    # reached yet as asleep and launched them again (2026-10-20: several packages),
    # and its stale save erased the pids launch recorded.
    lock = cron_lock(t, wait=False)
    if lock is None:
        return
    team = load_team(t)
    settle_launching(t, team)
    resume_api_stalled(t, team, load_json(registry_file(t), {}), dry_run=getattr(args, "plan", False))
    # A cap on lanes awake at once: 40 lanes waking together drove the load average
    # to 270 (2026-10-22). team/max-awake-lanes (a number) overrides max_awake_lanes
    # in the manifest; none means no cap. Staff are never capped.
    cap = t.m.get("max_awake_lanes")
    capf = registry_file(t).parent / "max-awake-lanes"
    if capf.exists():
        try:
            cap = int(capf.read_text().split()[0])
        except (ValueError, IndexError):
            pass
    # First come, first served: the lane whose oldest message has waited longest goes
    # first (it was alphabetical). At the cap, the done lane quiet longest is put to
    # sleep to make room; a lane with a lead, queued work or mail is never moved.
    now = time.time()
    order = []
    for n in load_json(registry_file(t), {}):
        w = oldest_waiting(t, n)
        if w is not None:
            order.append((w, n))
    plan = getattr(args, "plan", False)
    for _, n in sorted(order):
        # Fresh read per lane: launch writes the registry.
        reg = load_json(registry_file(t), {})
        e = reg.get(n, {})
        if e.get("state") != "asleep" or not t.managed(n) or not waiting_files(t, n):
            continue
        # team/held/<name>: the owner keeps this session asleep (quota); its mail waits.
        if (registry_file(t).parent / "held" / n).exists():
            if plan:
                print(f"held {n}: team/held/{n}")
            continue
        if cap is not None and n in team["lanes"]:
            awake = sum(1 for k, x in reg.items() if k in team["lanes"] and
                        (x.get("state") == "launching" or (x.get("state") == "awake" and _rt().alive(x.get("pid")))))
            if awake >= int(cap):
                done = sorted(((q, k) for k, x in reg.items()
                               if (q := done_quiet_min(t, team, k, x, now)) is not None), reverse=True)
                if not done:
                    if plan:
                        print(f"wait {n}: cap {cap} full, no lane done")
                    continue
                if plan:
                    print(f"swap: sleep {done[0][1]} (done, quiet {done[0][0]:.0f} min), wake {n}")
                    continue
                if not swap_out(t, team, done[0][1], now):
                    continue
                say_line(f"{n}: woken in the slot of {done[0][1]} (lane cap {cap})")
        if plan:
            print(f"wake {n}")
            continue
        cwd = launch_target(t, team, n)[0]
        if n in team["lanes"]:
            r = subprocess.run(["make", "warm"], cwd=cwd, capture_output=True, text=True)
            say_line(f"{n}: make warm exit {r.returncode}")
        with registry_txn(t) as reg:
            if reg.get(n, {}).get("state") != "asleep":
                continue
            reg[n].update(state="launching", launching_since=time.time())
        subprocess.run(f"{t.cmd('launch')} {n}", shell=True)


def cmd_compact_now(t: Team, args):
    """Run by the zone guard's Stop hook once a session has written its handoff
    (/prepare-for-compact ends with "Ready. Run /compact now."): type /compact into
    its tab, wait until the compaction lands in its transcript, then type the line
    that has it recover and carry on. A session never compacts itself, and an
    automatic compaction at 100% would cut it off with no handoff."""
    team = load_team(t)
    n = args.session
    tr = Path(args.transcript) if args.transcript else None

    def boundaries():
        try:
            return tr.read_text(errors="ignore").count('"compact_boundary"') if tr else 0
        except OSError:
            return 0
    time.sleep(3)          # let the turn that posted the handoff end
    before = boundaries()
    if not type_into(t, team, n, "/compact"):
        say_line(f"{n}: compact-now could not type into its tab")
        return
    say_line(f"{n}: /compact after its handoff")
    end = time.time() + 1200
    while time.time() < end:
        time.sleep(10)
        if boundaries() > before:
            break
    else:
        say_line(f"{n}: no compaction seen in 20 min; resume line not typed")
        return
    time.sleep(5)
    type_into(t, team, n, "Compaction done. Do steps 1-3 of .claude/commands/recover-from-compact.md, then carry "
                          f"on with your work: run `{t.cmd('watch')} {n} --now` and do what it prints.")
    say_line(f"{n}: resumed after /compact")


def cmd_branch_audit(t: Team, args):
    """Branches that the branch rule does not allow, here and on GitHub. The rule:
    GitHub mirrors the machine, and when work is idle the only branches are stable/1.0.x,
    develop/1.1.x, exchange, integration, one lane/<lane> per lane, the pins other teams
    check out (pin/*), and work in progress. Work in progress here means a branch that a
    worktree has checked out, or a name matching the manifest's `branch_allow` globs.
    Lists, never deletes; exits 1 when there is anything to clean up."""
    extra_local, extra_remote, unmirrored, nlocal, nremote, nallowed = branch_leftovers(t, load_team(t))
    print(f"branches: {nlocal} here, {nremote} on GitHub; allowed by the rule: {nallowed} here")
    for title, items in (("here, not allowed", extra_local), ("on GitHub, not allowed", extra_remote),
                         ("allowed but GitHub differs (or lacks it)", unmirrored)):
        if items:
            print(f"{title}: {len(items)}")
            for b in items[:60]:
                print(f"  {b}")
            if len(items) > 60:
                print(f"  ... and {len(items) - 60} more")
    if not (extra_local or extra_remote or unmirrored):
        print("clean: only the allowed branches, and GitHub matches")
        return 0
    return 1


def kept_branches(t, team):
    """The team's permanent branches under the branch rule: its base, exchange and
    integration (factory teams), landing (non-lab landing teams, v5.4), local lane branches,
    and the manifest's `branch_keep` (e.g. stable/1.0.x).
    A local landing branch whose name starts with the lane prefix also enters
    sweep_landed_branches' squash-trailer search: work on landing has landed.
    """
    keep = {t.base, *t.m.get("branch_keep", [])}
    if not t.lab:
        keep |= {t.exchange, t.integration}
        if landing(t):
            keep.add(landing_branch(t))
    keep |= {lane_branch(t, n, r) for n, r in team["lanes"].items() if not r.get("ref")}
    return keep


def branch_leftovers(t, team):
    """(here not allowed, GitHub not allowed, allowed but not mirrored, counts) for branch-audit
    and patrol."""
    import fnmatch
    repo = str(t.repo)
    def lines(*a):
        r = subprocess.run(["git", "-C", repo, *a], capture_output=True, text=True)
        return [l for l in r.stdout.splitlines() if l]
    keep = kept_branches(t, team)
    allow = ["pin/*", *t.m.get("branch_allow", [])]
    checked_out = {l.split(" ", 1)[1].replace("refs/heads/", "") for l in lines("worktree", "list", "--porcelain")
                   if l.startswith("branch ")}
    local = {l.split()[1]: l.split()[0] for l in lines("for-each-ref", "--format=%(objectname) %(refname:short)", "refs/heads")}
    remote = {}
    for l in lines("ls-remote", "--heads", "origin"):
        sha, ref = l.split()
        remote[ref.replace("refs/heads/", "")] = sha
    ok = lambda b: b in keep or b in checked_out or any(fnmatch.fnmatch(b, g) for g in allow)
    extra_local = sorted(b for b in local if not ok(b))
    extra_remote = sorted(b for b in remote if not ok(b))
    unmirrored = sorted(b for b in local if ok(b) and b not in checked_out - keep and remote.get(b) != local[b])
    return extra_local, extra_remote, unmirrored, len(local), len(remote), sum(1 for b in local if ok(b))


# Branch kinds codeteam itself makes, and so may delete once their work has landed:
# a request lead's worktree-<name> (the WorktreeCreate hook), a feature's unit/<lane>/<f>, and a v5.4 work order's
# wo/<zone>/<wo> (codeteam-land cuts it, and the loop's backup mirrors it to GitHub; landing and wo-retire delete only
# the local branch).
# Every other branch outside the rule (release lines, snap/*, pin/*, hand-made ones) is only
# reported (patrol, branch-audit); a person decides.
SWEEP_BRANCH_KINDS = ("worktree-*", "unit/*", "wo/*")


def sweep_landed_branches(t: Team, team, dry_run: bool) -> int:
    """The branch rule: no leftover branches when work is done, here or on GitHub.
    Deletes a codeteam-made branch (SWEEP_BRANCH_KINDS) that no worktree has checked out once
    its work has landed: its tip is in a kept branch (kept_branches), or, for worktree-<id>, a
    squash with the trailer `Worktree: <id>` is in a lane or exchange (last 60 days), or, for
    unit/<lane>/<f>, its lane or the team's target holds the branch's version of every file it
    changed (a squash). Its GitHub copy goes too when
    that copy has landed as well. A branch whose work has not landed stays.
    A wo/<zone>/<wo> branch is judged by the landing tool's record of <wo> (wo_landed), not by walking every kept
    branch: one team's sweep over 228 such GitHub copies took over ten minutes that way."""
    import fnmatch
    repo = str(t.repo)
    def git_lines(*a):
        r = subprocess.run(["git", "-C", repo, *a], capture_output=True, text=True)
        return [l for l in r.stdout.splitlines() if l] if r.returncode == 0 else []
    local = {l.split()[1]: l.split()[0] for l in git_lines("for-each-ref", "--format=%(objectname) %(refname:short)", "refs/heads")}
    keep = [b for b in sorted(kept_branches(t, team)) if b in local]
    # A copy of landing kept before a history rewrite is landed work too, as codeteam-land's landed_refs says: a
    # branch made before a trailer rewrite of landing holds the old hashes, which only the archive keeps.
    archives = git_lines("for-each-ref", "--format=%(refname)", "refs/archive/landing*")
    checked_out = {l.split(" ", 1)[1].replace("refs/heads/", "") for l in git_lines("worktree", "list", "--porcelain")
                   if l.startswith("branch ")}
    github = t.backup and subprocess.run(["git", "-C", repo, "remote", "get-url", "origin"],
                                         capture_output=True).returncode == 0
    remote = {}
    if github:
        for l in git_lines("ls-remote", "--heads", "origin"):
            sha, ref = l.split()
            remote[ref.replace("refs/heads/", "")] = sha
    ours = lambda b: any(fnmatch.fnmatch(b, g) for g in SWEEP_BRANCH_KINDS) and b not in checked_out and b not in keep
    merged = set()
    for k in keep:
        merged.update(git_lines("for-each-ref", f"--merged={k}", "--format=%(refname:short)", "refs/heads"))
    squashed = set()
    lane_refs = [k for k in keep if k.startswith(t.prefix) or k == t.target]
    if lane_refs:
        squashed = set(" ".join(git_lines("log", *lane_refs, "--since=60.days",
                                          "--format=%(trailers:key=Worktree,valueonly)")).split())

    def content_in(sha, k):
        """Every file the branch changed since it left k holds the branch's version in k:
        the branch was squashed into k (how units land in their lane)."""
        base = subprocess.run(["git", "-C", repo, "merge-base", k, sha], capture_output=True, text=True).stdout.strip()
        if not base:
            return False
        names = lambda a, b: set(subprocess.run(["git", "-C", repo, "diff", "--name-only", "--no-renames", a, b],
                                                capture_output=True, text=True).stdout.split("\n")) - {""}
        changed = names(base, sha)
        return not changed or not (changed & names(k, sha))

    wo_dir = Path(t.root) / "land" / "wo" if landing(t) and getattr(t, "root", None) else None
    landing_ref = landing_branch(t) if landing(t) and landing_branch(t) in local else t.base

    def ok(*a):
        return subprocess.run(["git", "-C", repo, *a], capture_output=True).returncode == 0

    retired = {}               # a retired wo/* branch -> its archive ref, pushed to GitHub before the branch goes there

    def clean_merge(c):
        """c merges two parents and its tree is exactly git's merge of them: no hand edit, no conflict resolved."""
        parents = (git_lines("rev-list", "--parents", "-n1", c) or [""])[0].split()[1:]
        if len(parents) != 2:
            return False
        r = subprocess.run(["git", "-C", repo, "merge-tree", "--write-tree", *parents], capture_output=True, text=True)
        tree = (r.stdout.splitlines() or [""])[0]
        return r.returncode == 0 and tree == (git_lines("rev-parse", f"{c}^{{tree}}") or [None])[0]

    def wo_landed(name, sha):
        """A work order branch has landed or been retired, by the landing tool's own record of it. Landed
        (<wo>.landed.json): the tip is the recorded tip, an older state of it, or on an archived landing (a copy made
        before a rewrite of the landing chain); or every commit outside the tip, landing and the archives is a clean
        merge (integration merged in after it landed); or, for a copy rebased since, every commit of its own has its
        patch in the recorded tip (`git cherry <tip>`, the work order's own range) or, failing that, on landing. A copy
        that predates a rewrite with no archive kept walks the whole old chain in `git cherry` (about 17 s
        each), once: it goes on its first sweep.
        Retired (<wo>.retired.json): wo-retire kept the tip under refs/archive/wo/<wo>, and this tip is that or an older
        state of it. No record: the generic test."""
        wo = name.rsplit("/", 1)[-1]
        if not ok("cat-file", "-e", f"{sha}^{{commit}}"):
            return False       # GitHub holds a commit this repo lacks: never delete it unseen
        rec = load_json(wo_dir / f"{wo}.landed.json", None)
        if isinstance(rec, dict) and rec.get("tip"):
            if sha == rec["tip"] or any(ok("merge-base", "--is-ancestor", sha, k) for k in (rec["tip"], *archives)):
                return True
            # Integration merged in after it landed: every commit outside the recorded tip, landing and the archived
            # landings is a merge whose tree is git's own merge of its parents, so it holds nothing of its own. Landing
            # squashes a work order, so `git cherry landing` never matches its commits one by one.
            own = git_lines("rev-list", sha, "--not", rec["tip"], landing_ref, *archives)
            if own and len(own) <= 50 and all(clean_merge(c) for c in own):
                return True
            return any(r.returncode == 0 and not any(l.startswith("+") for l in r.stdout.splitlines())
                       for r in (subprocess.run(["git", "-C", repo, "cherry", up, sha], capture_output=True, text=True)
                                 for up in (rec["tip"], landing_ref)))
        if (wo_dir / f"{wo}.retired.json").exists():
            archive = f"refs/archive/wo/{wo}"
            if not ok("merge-base", "--is-ancestor", sha, archive):
                return False
            retired[name] = archive
            return True
        return None

    def landed(name, sha):
        if wo_dir and name.startswith("wo/"):
            verdict = wo_landed(name, sha)
            if verdict is not None:
                return verdict
        if name.startswith("worktree-") and name.removeprefix("worktree-") in squashed:
            return True
        if local.get(name) == sha and name in merged:
            return True
        if subprocess.run(["git", "-C", repo, "cat-file", "-e", f"{sha}^{{commit}}"], capture_output=True).returncode:
            return False       # GitHub holds a commit this repo lacks: never delete it unseen
        if any(subprocess.run(["git", "-C", repo, "merge-base", "--is-ancestor", sha, k]).returncode == 0
               for k in (*keep, *archives)):
            return True
        if name.startswith("unit/"):
            parts = name.split("/")
            homes = [k for k in (t.prefix + parts[1] if len(parts) > 2 else "", t.target) if k in keep]
            return any(content_in(sha, k) for k in homes)
        return False
    n = 0
    for b in sorted(set(local) | set(remote)):
        if not ours(b):
            continue
        go_local = b in local and landed(b, local[b])
        go_remote = b in remote and landed(b, remote[b])
        if b in local and not go_local:
            continue           # not landed here: the work stays, and so does its GitHub copy
        if not (go_local or go_remote):
            continue
        where = " and ".join(w for w, on in (("here", go_local), ("GitHub", go_remote)) if on)
        if go_remote and b in retired:
            # The backup mirrors branches only, so a retired work order's GitHub branch is its one copy off this
            # machine: its archive ref goes to GitHub first, and the branch stays there if that push fails.
            where += f"; {retired[b]} kept on GitHub"
            if not dry_run and not ok("push", "-q", "origin", f"{retired[b]}:{retired[b]}"):
                say_line(f"kept {b} on GitHub: pushing {retired[b]} there failed")
                if not go_local:
                    continue
                go_remote, where = False, "here"
        if dry_run:
            say_line(f"would delete landed branch {b} ({where})"); n += 1; continue
        if go_local:
            subprocess.run(["git", "-C", repo, "branch", "-D", b], capture_output=True)
        if go_remote:
            subprocess.run(["git", "-C", repo, "push", "-q", "origin", "--delete", b], capture_output=True)
        say_line(f"deleted landed branch {b} ({where})"); n += 1
    return n


def cmd_sweep_branches(t: Team, args):
    n = sweep_landed_branches(t, load_team(t), args.dry_run)
    print(f"{n} landed branch{'es' if n != 1 else ''} {'would be ' if args.dry_run else ''}deleted")


def cron_lock(t, wait=True):
    """The lock wake and tick share, so neither saves a stale registry over the
    other. Held until the process exits. With wait=False, None when it is held."""
    import fcntl
    f = open(registry_file(t).parent / "cron.lock", "a")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
    except BlockingIOError:
        f.close()
        return None
    return f


SCRATCH_AGE_HOURS = 6


def newest_mtime(path: Path) -> float:
    """Newest modification time in a file or tree, links not followed."""
    newest = path.lstat().st_mtime
    if path.is_dir() and not path.is_symlink():
        for root, dirs, files in os.walk(path, followlinks=False):
            for f in dirs + files:
                try:
                    newest = max(newest, os.lstat(os.path.join(root, f)).st_mtime)
                except FileNotFoundError:
                    pass
    return newest


def remove_inside(base: Path, entry: Path, dry_run: bool) -> bool:
    """Remove `entry` only when it sits inside `base` after resolving the parent;
    a link is removed as a link, never followed."""
    base_r = base.resolve()
    if entry.parent.resolve() != base_r:
        return False
    if dry_run:
        return True
    if entry.is_dir() and not entry.is_symlink():
        shutil.rmtree(entry, ignore_errors=True)
    else:
        entry.unlink(missing_ok=True)
    return True


def _lane_process(t, n) -> bool:
    """A claude process launched for session n. Every launch, v1's or v2's, passes the session's role
    file to claude, so a process holding it is that session. The launch script alone is not enough: it
    execs claude, and v2's scripts live in team/v2/launch (2026-10-29: under v2 every running lane read
    as asleep here and its scratchpad was emptied each hour)."""
    script = t.home / "launch" / f"{n}.sh"
    role = t.home / "roles" / f"{n}.md"
    return any(subprocess.run(["pgrep", "-f", "--", str(x)], capture_output=True).returncode == 0
               for x in (script, f"--append-system-prompt-file {role}"))


def sweep_scratchpads(t: Team, team, dry_run: bool):
    """Empty scratchpads: all of it for a session that is asleep; for a running
    one, only entries untouched for SCRATCH_AGE_HOURS hours."""
    reg = load_json(registry_file(t), {})
    sessions = load_json(t.sessions_file, {})
    cutoff = time.time() - SCRATCH_AGE_HOURS * 3600
    for n in [*team["lanes"], *t.assistants]:
        pad = t.scratchpad(n)
        if not pad.is_dir() or pad.is_symlink():
            continue
        # Asleep only when the registry says so and no process of the session runs: a
        # launch whose pid was never recorded is live (2026-10-21: nine lanes at
        # "launching" had their temp folders emptied under them).
        e = reg.get(n, {})
        sid = sessions.get(n, {}).get("id", "")
        asleep = (e.get("state") == "asleep" and not _rt().alive(e.get("pid"))
                  and not (sid and session_live(sid)) and not _lane_process(t, n))
        gone = 0
        for entry in pad.iterdir():
            try:
                if (asleep or newest_mtime(entry) < cutoff) and remove_inside(pad, entry, dry_run):
                    gone += 1
            except FileNotFoundError:
                continue
        if gone:
            say_line(f"{n}: scratchpad {'would clear' if dry_run else 'cleared'} {gone} entr{'y' if gone == 1 else 'ies'}")


def sweep_orphan_worktrees(t: Team, team, dry_run: bool):
    """Remove folders in a lane's directory that were worktrees git has already
    unregistered: a .git file whose gitdir no longer exists."""
    for n in team["lanes"]:
        d = t.lane_dir(n)
        if not d.is_dir():
            continue
        for entry in d.iterdir():
            g = entry / ".git"
            if entry.is_symlink() or not entry.is_dir() or not g.is_file():
                continue
            line = g.read_text().strip()
            if not line.startswith("gitdir:"):
                continue
            if Path(line.split(":", 1)[1].strip()).exists():
                continue
            if remove_inside(d, entry, dry_run):
                say_line(f"{n}: {'would remove' if dry_run else 'removed'} unregistered worktree folder {entry.name}")


# The landing tool's TMPDIR (codeteam-land team_env: <worktree_root>/land/tmp) keeps whatever its test runs leave behind.
# An entry untouched for a day goes (once 9,065 folders, 2.1 GB, the oldest two days old,
# on one team alone). Lock files stay however old: a build tool may hold one there (SwiftPM's per-build-folder locks).
LAND_TMP_AGE_HOURS = 24


def sweep_land_tmp(t: Team, dry_run: bool):
    """Remove the entries of <worktree_root>/land/tmp untouched for LAND_TMP_AGE_HOURS, lock files excepted."""
    tmp = t.root / "land" / "tmp"
    if not tmp.is_dir() or tmp.is_symlink():
        return
    cutoff = time.time() - LAND_TMP_AGE_HOURS * 3600
    gone = 0
    for entry in tmp.iterdir():
        if entry.name.endswith(".lock"):
            continue
        try:
            if newest_mtime(entry) < cutoff and remove_inside(tmp, entry, dry_run):
                gone += 1
        except FileNotFoundError:
            continue
    if gone:
        say_line(f"land/tmp: {'would clear' if dry_run else 'cleared'} {gone} entr{'y' if gone == 1 else 'ies'} "
                 f"untouched for {LAND_TMP_AGE_HOURS} h")


BUILD_DIRS = ("cargo-target", ".build")
BUILD_IDLE_HOURS = 6
# Request and unit worktrees' build output goes after 2 h idle (2026-11-05: one team's 12 request worktrees held
# 10-14 GB each, 220 GB in all, with incremental builds on). Standing worktrees keep theirs: warm clones it.
REQUEST_BUILD_IDLE_HOURS = 2


def _worktrees(repo: Path):
    trees, cur = [], {}
    out = subprocess.run(["git", "-C", str(repo), "worktree", "list", "--porcelain"],
                         capture_output=True, text=True).stdout
    for line in out.splitlines() + [""]:
        if not line:
            if cur:
                trees.append(cur)
            cur = {}
        else:
            k, _, v = line.partition(" ")
            cur[k] = v or True
    return trees


_CWDS = None


def _unit_open(team, branch) -> bool:
    """A unit worktree's branch (unit/<lane>/<feature>) whose feature is not approved: its work is still
    going on, maybe by a lead that is a subagent of the coordinator. Such a process's working directory is
    the coordinator's, so _someone_inside cannot see it, and a unit cut from the lane tip has no commit of
    its own until the lead's first one, so it looks landed (CW3 again, tooling 2026-10-28). Only approval
    (retire_approved) or `codeteam retire` removes it."""
    if not branch.startswith("unit/"):
        return False
    f = branch.rsplit("/", 1)[-1]
    return not team.get("features", {}).get(f, {}).get("approved")


def _someone_inside(path: Path) -> bool:
    """A process whose working directory is in this worktree."""
    global _CWDS
    if _CWDS is None:
        out = subprocess.run(["lsof", "-a", "-d", "cwd", "-Fn"], capture_output=True, text=True).stdout
        _CWDS = [l[1:] for l in out.splitlines() if l.startswith("n")]
    root = str(path.resolve())
    return any(c == root or c.startswith(root + "/") for c in _CWDS)


def _last_activity(path: Path) -> float:
    """Newest of: the HEAD commit, any uncommitted file, and the build folders
    two levels down (a build adds files there)."""
    times = [0.0]
    # Its .git file is written when the worktree is made: a new worktree on an old
    # commit is new, not idle (2026-10-21: three just-made lead worktrees swept).
    try:
        times.append((path / ".git").lstat().st_mtime)
    except OSError:
        pass
    r = subprocess.run(["git", "-C", str(path), "log", "-1", "--format=%ct"], capture_output=True, text=True)
    if r.stdout.strip().isdigit():
        times.append(float(r.stdout.strip()))
    st = subprocess.run(["git", "-C", str(path), "status", "--porcelain", "--untracked-files=normal"],
                        capture_output=True, text=True).stdout
    for line in st.splitlines()[:500]:
        f = path / line[3:].split(" -> ")[-1].strip('"')
        try:
            times.append(f.lstat().st_mtime)
        except OSError:
            pass
    for d in _build_dirs(path):
        for x in [d, *d.iterdir()]:
            try:
                times.append(x.lstat().st_mtime)
                if x.is_dir() and not x.is_symlink():
                    times += [y.lstat().st_mtime for y in x.iterdir()]
            except OSError:
                pass
    return max(times)


def _build_dirs(path: Path):
    for name in BUILD_DIRS:
        for d in [path / name, *path.glob(f"*/*/{name}"), *path.glob(f"*/*/*/{name}"), *path.glob(f"*/{name}")]:
            if d.is_dir() and not d.is_symlink():
                yield d


def _landed(repo: str, head: str, targets) -> str | None:
    """The first target that already holds this commit's own change since it branched, or None.
    Squash-safe: the change counts as landed when its diff reverse-applies cleanly onto the
    target's tree, so it needs no trailer and no ancestry."""
    g = lambda *a, **k: subprocess.run(["git", "-C", repo, *a], capture_output=True, **k)
    for name, ref in targets:
        mb = g("merge-base", head, ref, text=True).stdout.strip()
        if not mb:
            continue
        diff = g("diff", "--binary", mb, head).stdout
        if not diff.strip():
            return name                      # nothing of its own beyond the target
        with tempfile.NamedTemporaryFile() as idx:
            env = {**os.environ, "GIT_INDEX_FILE": idx.name}
            if subprocess.run(["git", "-C", repo, "read-tree", ref], env=env, capture_output=True).returncode:
                continue
            if subprocess.run(["git", "-C", repo, "apply", "--cached", "--check", "-R", "-"],
                              input=diff, env=env, capture_output=True).returncode == 0:
                return name
    return None


def _has_own_change(repo: str, head: str, targets) -> bool:
    """True when head carries a diff of its own beyond some target's merge-base."""
    for _, ref in targets:
        mb = subprocess.run(["git", "-C", repo, "merge-base", head, ref], capture_output=True, text=True).stdout.strip()
        if mb and mb != head:
            return True
    return False


def sweep_landed_worktrees(t: Team, team, dry_run: bool, only_lane: str = ""):
    """The design: standing worktrees stay; every other worktree goes once its work is
    accepted on exchange; work not yet accepted stays. Accepted is judged by content (the
    worktree's own diff reverse-applies onto exchange, integration or base), because a
    squash leaves neither ancestry nor, always, a trailer. Removed only when clean
    (untracked included), unlocked and nobody inside; branches are kept. A gauntlet's two
    sides go together once either side is accepted. only_lane: just that lane's worktrees."""
    repo = str(t.repo)
    standing = {str(lane_wt(t, n, r).resolve()): n for n, r in team["lanes"].items()}
    lane_dirs = {str(t.lane_dir(n).resolve()): n for n in team["lanes"]}
    lane_paths = sorted(((r.get("path") or "").rstrip("/"), n) for n, r in team["lanes"].items() if r.get("path") not in (None, "", "."))
    tiers = [(x, x) for x in (t.exchange, t.integration, t.base) if x and
             subprocess.run(["git", "-C", repo, "rev-parse", "-q", "--verify", x], capture_output=True).returncode == 0]
    trees = [tr for tr in _worktrees(t.repo) if not tr.get("bare")]
    def lane_of(rp, head):
        lane = next((n for d, n in lane_dirs.items() if rp.startswith(d + "/")), None)
        if lane:
            return lane
        files = subprocess.run(["git", "-C", repo, "diff", "--name-only", f"{head}~1", head],
                               capture_output=True, text=True).stdout.split()
        hits = collections.Counter(n for f in files for lp, n in lane_paths if lp and f.startswith(lp + "/"))
        return hits.most_common(1)[0][0] if hits else None
    def lane_head(n):
        return subprocess.run(["git", "-C", str(lane_wt(t, n, team["lanes"][n])), "rev-parse", "HEAD"],
                              capture_output=True, text=True).stdout.strip()
    land_trees = set()
    if landing(t):              # v5: a registered work order tree goes when it lands (codeteam-land), not here
        for f in (t.root / "land" / "wo").glob("*.json"):
            try:
                land_trees.add(str(Path(json.loads(f.read_text())["tree"]).resolve()))
            except (OSError, ValueError, KeyError):
                pass
    def removable(tr):
        path = Path(tr.get("worktree", "")); rp = str(path.resolve()) if path.is_dir() else ""
        if not rp or rp in standing or rp in land_trees or tr.get("locked"):
            return None
        branch = str(tr.get("branch", "")).removeprefix("refs/heads/")
        if branch.startswith(("snap/", "pin/", "lane/")):
            return None
        if _unit_open(team, branch):
            return None
        if not (rp.startswith(tuple(d + "/" for d in lane_dirs)) or "/.claude/worktrees/" in rp):
            return None
        if subprocess.run(["git", "-C", rp, "status", "--porcelain"], capture_output=True, text=True).stdout.strip():
            return None
        if _someone_inside(path):
            return None
        return path, rp, branch, tr.get("HEAD", "")
    removed = retire_approved(t, team, dry_run, only_lane)
    cands = [c for c in map(removable, trees) if c]
    gauntlet = collections.defaultdict(list)
    for path, rp, branch, head in cands:
        m = re.match(r"stream/(.+)/[ab]$", branch)
        if m:
            gauntlet[m[1]].append((path, rp, branch, head))
            continue
        if only_lane and lane_of(rp, head) != only_lane:
            continue
        where = _landed(repo, head, tiers)
        # A worktree with no commit of its own looks landed; when it is new, it is a lead
        # that has not started. "Its own" is measured against its lane's standing worktree:
        # cut from a lane head whose squashed work is already on exchange, its diff from
        # exchange is the lane's, not its own (CW3, SynapseKit 2026-10-22 18:57).
        # Such a worktree goes only once idle BUILD_IDLE_HOURS.
        lane = lane_of(rp, head)
        lh = lane_head(lane) if lane else ""
        beyond_lane = not (lh and subprocess.run(["git", "-C", repo, "merge-base", "--is-ancestor", head, lh]).returncode == 0)
        no_own = not beyond_lane or not _has_own_change(repo, head, tiers)
        if where and no_own and _last_activity(path) > time.time() - BUILD_IDLE_HOURS * 3600:
            continue
        if where:
            removed += _remove_wt(t, rp, f"accepted on {where}", dry_run)
    for slug, sides in gauntlet.items():
        if only_lane and not any(lane_of(sd[1], sd[3]) == only_lane for sd in sides):
            continue
        if any(_landed(repo, side[3], tiers) for side in sides):
            for s in sides:
                removed += _remove_wt(t, s[1], f"gauntlet {slug} decided", dry_run, drop_branch=True, branch=s[2])
    removed += sweep_closed_requests(t, team, dry_run, only_lane, tiers)
    removed += drop_approved_request_branches(t, team, dry_run, only_lane)
    say_line(f"accepted-worktree sweep{' ' + only_lane if only_lane else ''}: {'would remove' if dry_run else 'removed'} {removed}")


def sweep_closed_requests(t, team, dry_run, only_lane, tiers) -> int:
    """A closed request whose squash (trailer Request: <name>) is accepted on exchange:
    every worktree its ledger row recorded goes, with its branch. These are the failed
    attempts, superseded leads and gauntlet losers, which will never be accepted."""
    repo = str(t.repo); removed = 0
    by_id = {}
    for tr in _worktrees(t.repo):
        w = tr.get("worktree", "")
        by_id[Path(w).name] = tr; by_id[w] = tr
    for n, r in team["lanes"].items():
        if only_lane and n != only_lane:
            continue
        swt = lane_wt(t, n, r)
        f = lane_ledger_dir(t, n, r) / ".ledger-closed"
        if not f.exists():
            continue
        keep = []
        for line in f.read_text().splitlines():
            parts = [x.strip() for x in line.split("·")]
            if len(parts) != 3:
                continue
            req, wts = parts[0], [w for w in parts[1].split(",") if w and w != "-"]
            sq = subprocess.run(["git", "-C", str(swt), "log", "--format=%H", f"--grep=^Request: {re.escape(req)}$", "-1"],
                                capture_output=True, text=True).stdout.strip()
            if not sq or not _landed(repo, sq, tiers):
                keep.append(line); continue
            left = False
            for w in wts:
                tr = by_id.get(w) or by_id.get(w if w.startswith("agent-") else f"agent-{w}")
                if not tr:
                    continue
                path = tr.get("worktree", "")
                if str(Path(path).resolve()) == str(swt.resolve()) or _someone_inside(Path(path)):
                    left = True; continue
                removed += _remove_wt(t, path, f"{n} request {req} accepted", dry_run, drop_branch=True,
                                      branch=str(tr.get("branch", "")).removeprefix("refs/heads/"))
            # Their branches go too, here and on GitHub, even where the worktree is already gone
            # (superseded leads' branches were left behind on both sides).
            removed += drop_request_branches(t, wts, f"{n} request {req} accepted", dry_run)
            if left or dry_run:
                keep.append(line)
        if not dry_run:
            f.write_text("".join(x + "\n" for x in keep))
    return removed


def _request_branch(w):
    """The branch of a request worktree recorded on a ledger row (an id, agent-<id>, or a path)."""
    i = Path(w).name if "/" in w else w
    return "worktree-" + (i if i.startswith("agent-") else f"agent-{i}")


_REMOTE_HEADS = {}


def _remote_heads(t):
    """origin's branches -> sha, read once per run; {} when backup is off or there is no origin."""
    key = str(t.repo)
    if key not in _REMOTE_HEADS:
        heads = {}
        if t.backup and git(t.repo, "remote", "get-url", "origin", check=False).returncode == 0:
            r = git(t.repo, "ls-remote", "--heads", "origin", check=False)
            for l in r.stdout.splitlines():
                sha, ref = l.split()
                heads[ref.replace("refs/heads/", "")] = sha
        _REMOTE_HEADS[key] = heads
    return _REMOTE_HEADS[key]


def drop_request_branches(t, ids, why, dry_run) -> int:
    """Delete the branches of a request's recorded worktrees, here and on GitHub: superseded leads and
    failed attempts of a request that has landed, or of a feature that is approved.
    A branch still checked out in a worktree is left for that worktree's own sweep. A GitHub
    copy goes only when this repo holds its commit: unseen work is never deleted."""
    repo = str(t.repo)
    checked_out = {l.split(" ", 1)[1].replace("refs/heads/", "")
                   for l in git(t.repo, "worktree", "list", "--porcelain", check=False).stdout.splitlines()
                   if l.startswith("branch ")}
    remote = _remote_heads(t)
    n = 0
    for w in ids:
        b = _request_branch(w)
        if b in checked_out:
            continue
        here = git(t.repo, "rev-parse", "-q", "--verify", f"refs/heads/{b}", check=False).returncode == 0
        there = b in remote and git(t.repo, "cat-file", "-e", f"{remote[b]}^{{commit}}", check=False).returncode == 0
        if not (here or there):
            continue
        where = " and ".join(x for x, on in (("here", here), ("GitHub", there)) if on)
        if dry_run:
            say_line(f"  would delete {b} ({where}; {why})"); n += 1; continue
        if here:
            git(t.repo, "branch", "-D", b, check=False)
        if there:
            if git(t.repo, "push", "-q", "origin", "--delete", b, check=False).returncode == 0:
                remote.pop(b, None)
        say_line(f"  deleted {b} ({where}; {why})"); n += 1
    return n


def _ledger_rows_for(t, team, feature):
    """(lane, worktree ids) from every lane ledger row, open or closed, named after the feature."""
    out_ = []
    for n, r in team["lanes"].items():
        for name, col in ((".ledger.md", 2), (".ledger-closed", 1)):
            f = lane_ledger_dir(t, n, r) / name
            if not f.exists():
                continue
            for line in f.read_text(errors="ignore").splitlines():
                parts = [x.strip() for x in line.split("·")]
                if len(parts) == 3 and parts[0] == feature:
                    out_.append((n, [w for w in parts[col].split(",") if w and w != "-"]))
    return out_


def drop_approved_request_branches(t, team, dry_run, only_lane="") -> int:
    """For request leads: once a feature is approved, every request worktree branch its lanes'
    ledgers recorded for it goes, here and on GitHub, superseded attempts included. Once per feature."""
    n = 0; done = []
    for f, rec in team.get("features", {}).items():
        if not rec.get("approved") or rec.get("request_branches_dropped"):
            continue
        for lane, ids in _ledger_rows_for(t, team, f):
            if only_lane and lane != only_lane:
                continue
            n += drop_request_branches(t, ids, f"feature {f} approved", dry_run)
        if not dry_run and not only_lane:
            done.append(f)
    if done:
        with_lock = load_team(t, write=True)
        for f in done:
            if f in with_lock.get("features", {}):
                with_lock["features"][f]["request_branches_dropped"] = True
        save_json(t.team_file, with_lock)
        release_team_lock()
    return n


def retire_approved(t, team, dry_run, only_lane="") -> int:
    """What `codeteam retire` does, for every approved feature, so no lane has to:
    approval is the orchestrator's ruling that the work is done. Removes the unit
    worktree and branch (and its origin backup), once per feature. A worktree with
    uncommitted files, or a process inside, is left and reported."""
    n = 0; changed = False
    for f, rec in team.get("features", {}).items():
        if not rec.get("approved") or rec.get("retired"):
            continue
        done = True
        for lane in rec.get("lanes", []):
            if only_lane and lane != only_lane:
                done = False; continue
            wt, b = t.unit_wt(lane, f), t.unit_branch(lane, f)
            has_b = subprocess.run(["git", "-C", str(t.repo), "rev-parse", "-q", "--verify", f"refs/heads/{b}"],
                                   capture_output=True).returncode == 0
            if not wt.exists() and not has_b:
                continue
            if wt.exists() and _someone_inside(wt):
                say_line(f"  {lane}: {wt.name} left, a process is inside"); done = False; continue
            if dry_run:
                say_line(f"  would retire {lane} {f}"); n += 1; continue
            if wt.exists():
                r = subprocess.run(["git", "-C", str(t.repo), "worktree", "remove", str(wt)], capture_output=True, text=True)
                if r.returncode:
                    say_line(f"  {lane}: {wt.name} left: {r.stderr.strip()[:100]}"); done = False; continue
            subprocess.run(["git", "-C", str(t.repo), "branch", "-D", b], capture_output=True)
            if t.backup and has_b:
                subprocess.run(["git", "-C", str(t.repo), "push", "-q", "origin", "--delete", b], capture_output=True)
            team["created_worktrees"] = [w for w in team.get("created_worktrees", [])
                                         if (w["path"] if isinstance(w, dict) else w) != str(wt)]
            say_line(f"  retired {lane} {f}"); n += 1
        if done and not dry_run:
            rec["retired"] = True; changed = True
    if changed:
        with_lock = load_team(t, write=True)
        for f, rec in team.get("features", {}).items():
            if rec.get("retired") and f in with_lock.get("features", {}):
                with_lock["features"][f]["retired"] = True
        with_lock["created_worktrees"] = team.get("created_worktrees", with_lock.get("created_worktrees", []))
        save_json(t.team_file, with_lock)
        # Give the team lock back now: the sweep that called this runs for minutes to hours
        # after it, and holding the lock blocked every promote and push-up meanwhile
        # (2026-10-23 05:30-07:30, set G's promote waited behind a sweep-accepted).
        release_team_lock()
    return n


def _remove_wt(t, rp, why, dry_run, drop_branch=False, branch="") -> int:
    """drop_branch: work that will never be accepted (failed attempts, gauntlet losers):
    the worktree goes even with uncommitted files, and so does its branch."""
    if dry_run:
        say_line(f"  would remove {Path(rp).name} ({why}{'; with branch' if drop_branch else ''})")
        return 1
    for d in _build_dirs(Path(rp)):
        shutil.rmtree(d, ignore_errors=True)
    cmd = ["git", "-C", str(t.repo), "worktree", "remove", *(["--force", "--force"] if drop_branch else []), rp]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode == 0:
        if drop_branch and branch:
            subprocess.run(["git", "-C", str(t.repo), "branch", "-D", branch], capture_output=True)
        say_line(f"  removed {Path(rp).name} ({why}; {'branch deleted' if drop_branch else 'branch kept'})")
        return 1
    say_line(f"  left {Path(rp).name}: {r.stderr.strip()[:120]}")
    return 0


def sweep_builds_and_units(t: Team, team, dry_run: bool, builds_only: bool = False):
    """Remove unit worktrees idle for BUILD_IDLE_HOURS whose branch is in their
    lane's standing worktree, and build output in request, unit and v5.4 work order trees idle for
    REQUEST_BUILD_IDLE_HOURS. Standing worktrees, snapshots and worktrees a process is working in are left as they are."""
    standing = {str(lane_wt(t, n, r).resolve()): n for n, r in team["lanes"].items()}
    lane_dirs = {str(t.lane_dir(n).resolve()): n for n in team["lanes"]}
    # codeteam-land's work order trees, <worktree_root>/wo/<zone>/<wo>: v5.4's request worktrees. Only their build
    # output goes (2026-11-11: 66 trees held 189 GB and the disk filled; the sweep had skipped them).
    wo_root = str((t.root / "wo").resolve()) + "/"
    cutoff = time.time() - BUILD_IDLE_HOURS * 3600
    for tr in _worktrees(t.repo):
        path = Path(tr.get("worktree", ""))
        if not path.is_dir() or str(path.resolve()) in standing or tr.get("bare"):
            continue
        # A lead's worktree stays locked while the session that spawned it runs,
        # long after the lead returns; it keeps its files, and idle build output goes.
        locked = bool(tr.get("locked"))
        branch = str(tr.get("branch", "")).removeprefix("refs/heads/")
        if branch.startswith(("snap/", "pin/")):
            continue
        rp = str(path.resolve())
        lane = next((n for d, n in lane_dirs.items() if rp.startswith(d + "/")), None)
        work_order = rp.startswith(wo_root)
        if not lane and not work_order and "/.claude/worktrees/" not in rp:
            continue        # a worktree outside the team's folders belongs to someone else
        try:
            if _someone_inside(path):
                continue
            # A unit worktree in a lane folder whose branch is in the lane's standing worktree.
            if not builds_only and lane and branch and not locked and "/.claude/worktrees/" not in rp and not _unit_open(team, branch):
                swt = str(lane_wt(t, lane, team["lanes"][lane]))
                merged = subprocess.run(["git", "-C", swt, "merge-base", "--is-ancestor", branch, "HEAD"]).returncode == 0
                clean = not subprocess.run(["git", "-C", rp, "status", "--porcelain", "--untracked-files=no"],
                                           capture_output=True, text=True).stdout.strip()
                if merged and clean and _last_activity(path) < cutoff:
                    if dry_run:
                        say_line(f"{lane}: would remove merged unit worktree {path.name}")
                        continue
                    for d in _build_dirs(path):
                        shutil.rmtree(d, ignore_errors=True)
                    r = subprocess.run(["git", "-C", str(t.repo), "worktree", "remove", "--force", rp],
                                       capture_output=True, text=True)
                    if r.returncode == 0:
                        subprocess.run(["git", "-C", str(t.repo), "branch", "-D", branch], capture_output=True)
                        say_line(f"{lane}: removed merged unit worktree {path.name}")
                    continue
            # Build output in an idle worktree.
            if _last_activity(path) < time.time() - REQUEST_BUILD_IDLE_HOURS * 3600:
                for d in _build_dirs(path):
                    say_line(f"{lane or ('work order' if work_order else 'request')}: "
                             f"{'would clear' if dry_run else 'cleared'} {d.relative_to(path)} in {path.name}")
                    if not dry_run:
                        shutil.rmtree(d, ignore_errors=True)
        except (OSError, ValueError):
            continue


def tm_exclude_team(t: Team) -> None:
    """Keep the team's land trees and its trees' build output out of Time Machine. A tree's build
    output is made after the tree is cut, and zone-clean deletes it with its mark, so the hourly sweep marks what
    exists; share/codeteam_tm.py says why."""
    sys.path.insert(0, str(TOOL_DIR / "share"))
    import codeteam_tm
    codeteam_tm.exclude_team(t.root, t.repo)


def cmd_sweep(t: Team, args):
    """Cron, hourly. Remove request worktrees whose squash (Worktree: trailer)
    is in a standing worktree, and unnamed ones that hold no work. A worktree
    an open ledger row names stays until its squash lands. Each one left is
    posted once, to the lane whose ledger names it, or to the orchestrator."""
    team = load_team(t)
    gitc = lambda cwd, *a: subprocess.run(["git", "-C", cwd, *a], capture_output=True, text=True)
    lanes = {n: str(lane_wt(t, n, r)) for n, r in team["lanes"].items() if not r.get("ref")}
    ledgers = {}
    for n in lanes:
        f = lane_ledger_dir(t, n, team["lanes"][n]) / ".ledger.md"
        ledgers[n] = f.read_text() if f.exists() else ""
    trees, cur = [], {}
    for line in gitc(str(t.repo), "worktree", "list", "--porcelain").stdout.splitlines() + [""]:
        if not line:
            if cur:
                trees.append(cur)
            cur = {}
        else:
            k, _, v = line.partition(" ")
            cur[k] = v

    landed_ids = {}
    for n, swt in lanes.items():
        log = gitc(swt, "log", "HEAD", "--since=60.days", "--format=%(trailers:key=Worktree,valueonly)").stdout
        for w in log.split():
            landed_ids.setdefault(w, n)

    def in_swt(swt, wid, branch):
        if wid in landed_ids:
            return True
        return bool(branch) and gitc(swt, "merge-base", "--is-ancestor", branch, "HEAD").returncode == 0

    left = {}
    for tr in trees:
        path = tr.get("worktree", "")
        if "/.claude/worktrees/" not in path:
            continue
        wid = Path(path).name
        branch = tr.get("branch", "").removeprefix("refs/heads/")
        short_id = wid.removeprefix("agent-")
        owners = [n for n, text in ledgers.items() if short_id in text]
        homes = owners or list(lanes)
        if wid in landed_ids:
            landed = landed_ids[wid]
        elif owners:
            landed = None      # an open request in its zone's ledger stays until its squash lands
        else:
            landed = "no zone" if any(in_swt(lanes[n], wid, branch) for n in homes) else None
            # By ancestry alone a just-made worktree is "in" its SWT; it goes only once idle.
            if landed and _last_activity(Path(path)) > time.time() - BUILD_IDLE_HOURS * 3600:
                landed = None
        clean = not gitc(path, "status", "--porcelain").stdout.strip()
        if landed and clean and args.dry_run:
            say_line(f"{landed}: would sweep {wid}")
            continue
        if landed and clean and gitc(str(t.repo), "worktree", "remove", path).returncode == 0:
            if branch:
                gitc(str(t.repo), "branch", "-D", branch)
            say_line(f"{landed}: swept {wid}")
            continue
        left.setdefault(owners[0] if len(owners) == 1 else "", []).append(wid)

    sweep_scratchpads(t, team, args.dry_run)
    sweep_land_tmp(t, args.dry_run)
    sweep_orphan_worktrees(t, team, args.dry_run)
    sweep_landed_worktrees(t, team, args.dry_run)
    sweep_builds_and_units(t, team, args.dry_run)
    sweep_landed_branches(t, team, args.dry_run)
    if not args.dry_run:
        tm_exclude_team(t)
    if args.dry_run:
        for owner, wids in left.items():
            say_line(f"{owner or t.orc_name()}: would report {', '.join(wids)}")
        return
    mark = t.home / "sweep-reported.json"
    reported = load_json(mark, {})
    for owner, wids in left.items():
        new = [w for w in wids if w not in reported.get(owner, [])]
        if not new:
            continue
        if owner:
            post(t, t.lane_channel(owner), IDLE_SENDER, "NOTE", owner,
                 "Request worktrees not yet in the SWT: " + ", ".join(new))
        else:
            post(t, t.general, IDLE_SENDER, "NOTE", t.orc_name(),
                 "Request worktrees that no zone ledger names, and whose work is in no SWT: "
                 + ", ".join(new))
    save_json(mark, {o: sorted(w) for o, w in left.items()})


# ---------------------------------------------------------------- teardown

def wait_for_exit(sid, timeout=15.0):
    """LIFTED idea (wait_for_process_exit): confirm the session is gone
    before its worktree is removed."""
    end = time.time() + timeout
    while time.time() < end:
        if not session_live(sid):
            return True
        time.sleep(0.5)
    return False


def cmd_teardown(t: Team, args):
    team = load_team(t)
    sessions = load_json(t.sessions_file, {})
    worktrees = [w if isinstance(w, dict) else {"path": w, "repo": str(t.repo)}
                 for w in team.get("created_worktrees", [])]
    branches = [b if isinstance(b, dict) else {"name": b, "repo": str(t.repo)}
                for b in team.get("created_branches", [])]
    print(f"codeteam teardown {t.product}")
    print(f"  sessions: {len(sessions)}; worktrees: {len(worktrees)}; "
          f"branches: {', '.join(b['name'] for b in branches)}")
    # CodeGraph roots to unregister: the team's created worktrees (init pinned the standing ones) and anything under
    # workcrews/, where CodeGraph registered request worktrees on its own. Teardown deletes both, and a registered
    # root whose folder is gone would linger in CodeGraph's project list.
    codegraph_scopes = [*(w["path"] for w in worktrees), t.root / "workcrews"]
    if args.dry_run:
        for w in worktrees:
            say_line(f"would remove worktree {w['path']}")
        for b in branches:
            say_line(f"would delete branch {b['name']}")
        say_line(f"would remove {t.home}")
        unregister_codegraph(codegraph_scopes, dry_run=True)
        return
    for n, s in sessions.items():
        sid = s.get("id", "")
        if sid and session_live(sid):
            subprocess.run(["pkill", "-TERM", "-f", sid])
            say_line(f"{n}: stopped" if wait_for_exit(sid) else f"{n}: STILL RUNNING")
    unregister_codegraph(codegraph_scopes)
    for w in worktrees:
        if Path(w["path"]).exists():
            r = git(w["repo"], "worktree", "remove", "--force", w["path"], check=False)
            say_line(f"worktree {Path(w['path']).name}: " +
                     ("removed" if r.returncode == 0 else r.stderr.strip()))
    for b in branches:
        repo, name = b["repo"], b["name"]
        r = git(repo, "branch", "-D", name, check=False)
        git(repo, "config", "--unset", f"branch.{name}.pushRemote", check=False)
        say_line(f"branch {name}: " + ("deleted" if r.returncode == 0 else r.stderr.strip()))
        if git(repo, "ls-remote", "--exit-code", "--heads", "origin", name, check=False).returncode == 0:
            warn(f"origin has a backup of {name}; delete it on GitHub when you no longer want it")
    # Remove only the folders codeteam makes. A team folder can also hold
    # things codeteam did not create (a clone, data folders); those stay.
    if t.team_file.exists():
        # In design/, only the session folders: the base checkout is not codeteam's.
        owned = [t.home, t.root / "workcrews", t.restart_file(),
                 *[t.session_dir(n) for n in t.staff()],
                 *[t.tier_dir(x) for x in t.tiers() if x != "design"],
                 t.tier_dir("design") / "agent-memory",
                 *[t.pin_dir(n) for n in t.pins]]
        for d in owned:
            if d.is_file():
                d.unlink()
            elif d.exists():
                shutil.rmtree(d, ignore_errors=True)
                say_line(f"removed {d}")
        if t.root.exists() and not any(t.root.iterdir()):
            t.root.rmdir()


# ---------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(prog="codeteam", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    def p(name, *extra):
        sp = sub.add_parser(name)
        sp.add_argument("manifest")
        return sp

    sp = p("init")
    sp.add_argument("--lanes", default="")
    sp.add_argument("--all-lanes", action="store_true")
    sp.add_argument("--dry-run", action="store_true")
    sp = p("launch")
    sp.add_argument("targets", nargs="*")
    sp.add_argument("--dry-run", action="store_true")
    sp.add_argument("--here", action="store_true", help="run one session in this window")
    sp.add_argument("--resume", action="store_true", help="resume the old history instead of starting fresh")
    p("status")
    p("trust")
    p("link-guides")
    p("roles")
    sp = p("rotate")
    sp.add_argument("--hours", type=float, default=24)
    sp = p("watch")
    sp.add_argument("name")
    sp.add_argument("--timeout", type=int, default=0)
    sp.add_argument("--from-start", action="store_true")
    sp.add_argument("--now", action="store_true", help="print whatever is waiting and exit")
    sp.add_argument("--also", action="append", default=[],
                    help="also wake on General lines containing this text (repeatable)")
    sp = p("repin")
    sp.add_argument("pin")
    sp.add_argument("--ref", default="")
    sp = p("sleep")
    sp.add_argument("name")
    sp.add_argument("--force", action="store_true")
    p("branch-audit")
    sp = p("compact-now")
    sp.add_argument("session")
    sp.add_argument("transcript", nargs="?", default="")
    sp = p("patrol")
    sp.add_argument("--dry-run", action="store_true")
    sp = p("sweep-accepted")
    sp.add_argument("--lane", default="")
    sp.add_argument("--dry-run", action="store_true")
    sp = p("teardown")
    sp.add_argument("--dry-run", action="store_true")
    sp = p("say")
    for a in ("channel", "sender", "type", "to"):
        sp.add_argument(a)
    sp.add_argument("text", nargs="+")
    sp = p("unit")
    sp.add_argument("lane")
    sp.add_argument("feature")
    sp = p("squash")
    sp.add_argument("lane")
    sp.add_argument("feature")
    sp.add_argument("-m", "--message", required=True)
    sp = p("push-up")
    sp.add_argument("lane")
    sp.add_argument("-f", "--feature", required=True)
    sp.add_argument("-m", "--message", required=True)
    sp.add_argument("--untested", default="", help="push without a test record; the reason goes in the commit as Untested:. It does not skip the walls check")
    sp = p("pull-down")
    sp.add_argument("lane")
    sp.add_argument("-f", "--feature", default="")
    sp = p("backup")
    sp.add_argument("lane")
    sp.add_argument("-f", "--feature", default="")
    p("nudge")
    p("tick")
    sp = p("wake")
    sp.add_argument("--plan", action="store_true", help="print what wake would do, and do nothing")
    p("sweep").add_argument("--dry-run", action="store_true")
    p("sweep-branches").add_argument("--dry-run", action="store_true")
    sp = p("procreg")
    sp.add_argument("name")
    sp.add_argument("--parent", type=int, required=True)
    sp = p("await")
    sp.add_argument("lane")
    sp.add_argument("feature")
    sp = p("register")
    sp.add_argument("-f", "--feature", default="")
    sp.add_argument("--lane", default="")
    sp.add_argument("commits", nargs="*")
    sp = p("ready")
    sp.add_argument("name")
    sp.add_argument("step", choices=["integrate", "promote"])
    sp.add_argument("features", nargs="+")
    sp = p("integrate")
    sp.add_argument("-m", "--message", required=True)
    sp.add_argument("--picks", default="", help="file of exchange commits to take, one per line; "
                    "a named feature with commits left over stays on exchange for a later set")
    sp.add_argument("features", nargs="+")
    sp = p("promote")
    sp.add_argument("-m", "--message", required=True)
    p("discard")
    sp = p("approve")
    sp.add_argument("feature")
    sp = p("retire")
    sp.add_argument("lane")
    sp.add_argument("feature")
    sp = p("accept")
    sp.add_argument("lane")
    sp.add_argument("branch")
    sp.add_argument("-f", "--feature", required=True)
    sp.add_argument("-m", "--message", required=True)
    sp.add_argument("--body", default="")
    sp.add_argument("--staged", action="store_true", help="the squash is already staged")
    sp = p("remove-worktree")
    sp.add_argument("lane")
    sp.add_argument("branch")
    sp.add_argument("--superseded-by", default="", help="a commit on the lane that carries this lead's work in a later "
                    "lead's squash: the branch goes, here and on GitHub")
    sp = p("snapshot")
    sp.add_argument("lane")
    sp.add_argument("ref")
    sp.add_argument("--name", default="")
    sp = p("drop")
    sp.add_argument("lane")
    sp.add_argument("name")

    a = ap.parse_args()
    t = Team(a.manifest)
    # A HALTED file beside the registry stops every cron job for the team, not only wake
    # (2026-10-23): sweep removes worktrees and branches, patrol and tick post and type.
    if a.cmd in ("wake", "tick", "patrol", "sweep", "sweep-accepted", "sweep-branches", "rotate") and \
            not getattr(a, "dry_run", False) and (registry_file(t).parent / "HALTED").exists():
        if a.cmd == "sweep":
            # A halted team's idle build output still goes (2026-11-05: halting one team would have kept 220 GB);
            # nothing else of the sweep runs: no worktree or branch is removed while it is halted.
            sweep_builds_and_units(t, load_team(t), False, builds_only=True)
        return         # a halted team: no cron job acts (a --dry-run only reads, so it still runs)
    # A team running on codeteam v2 has its runtime in herdr: `codeteam2 up` writes team/v2/up and
    # `codeteam2 down` removes it. v1's runtime jobs leave that team alone; its process jobs (sweep,
    # rotate) still run (2026-10-25, a team moving to v2).
    if (t.home / "v2" / "up").exists():
        if a.cmd == "wake":
            if getattr(a, "plan", False):
                print(f"{t.product} runs on codeteam v2: v1's wake stands aside (cron runs codeteam2 ensure-loop)")
                return
            # cron's minute: keep the team's herdr server and v2 loop running (after a crash or a reboot).
            subprocess.run([sys.executable, str(TOOL_DIR / "v2" / "bin" / "codeteam2"), "ensure-loop", t.manifest],
                           timeout=120)
            return
        if a.cmd in ("tick", "patrol"):
            return
        if a.cmd in ("launch", "sleep"):
            sys.exit(f"{t.product} runs on codeteam v2 (herdr): use {TOOL_DIR / 'v2' / 'bin' / 'codeteam2'} "
                     f"{a.cmd} {t.manifest}")
    {"init": cmd_init, "launch": cmd_launch, "status": cmd_status, "say": cmd_say,
     "teardown": cmd_teardown, "push-up": cmd_push_up, "pull-down": cmd_pull_down,
     "integrate": cmd_integrate, "promote": cmd_promote, "discard": cmd_discard,
     "snapshot": cmd_snapshot, "drop": cmd_drop, "sleep": cmd_sleep,
     "repin": cmd_repin, "trust": cmd_trust, "watch": cmd_watch,
     "link-guides": cmd_link_guides, "roles": cmd_roles, "rotate": cmd_rotate, "unit": cmd_unit,
     "squash": cmd_squash, "backup": cmd_backup, "ready": cmd_ready, "register": cmd_register, "nudge": cmd_nudge, "await": cmd_await,
     "tick": cmd_tick, "wake": cmd_wake, "sweep": cmd_sweep, "sweep-accepted": cmd_sweep_accepted, "patrol": cmd_patrol, "compact-now": cmd_compact_now, "branch-audit": cmd_branch_audit, "sweep-branches": cmd_sweep_branches, "procreg": cmd_procreg,
     "approve": cmd_approve, "retire": cmd_retire, "accept": cmd_accept,
     "remove-worktree": cmd_remove_worktree}[a.cmd](t, a)


if __name__ == "__main__":
    main()

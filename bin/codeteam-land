#!/usr/bin/env python3
"""codeteam-land: check and review work orders, land them, validate and promote.

A zone receives other zones' work through integration. Current unit records satisfy the zone unit check;
non-docs-only sets compile, run repo unit tests, then run integration tests combined in the first work order tree
before Stage 3 review. The runner lands one reviewed entry at a time, merging its members in order before moving
landing once. Stage 7 copies the proven base to integration. Stage 7 restarts changed loops and requests runner exits between whole stage jobs when this
program's own checkout is promoted. A pending build-queue restart holds new Stage 2, 5 and local 6 runs while
admitted runs and landing-marked queued or running jobs drain; Stage 2 waits, while Stage 5 and local 6 skip ticks.

  codeteam-land MANIFEST wo-cut ZONE WO          a work order tree from integration's tip (warm build clone)
  codeteam-land MANIFEST wo-pull WO              merge integration into the work order tree (exit 2: conflict)
  codeteam-land MANIFEST land WO [--with WO2 ...] check against integration, then queue the tested set
  codeteam-land MANIFEST queue                   what waits and since when
  codeteam-land MANIFEST wo-hold [WO --because WHY | WO --release]  patrol skips a work order held on purpose
  codeteam-land MANIFEST queue-run [--once]      land oldest unheld entries, one at a time
  codeteam-land MANIFEST recheck-run [--once]    recheck overlapping landings in landing order
  codeteam-land MANIFEST validate-run [--once]   validate the newest landing commit, then run Stage 7 on a pass
  codeteam-land MANIFEST validate-suite          run every zone's and the repo's validation tests
  codeteam-land MANIFEST promote [HASH]          run Stage 7 now; defaults to the newest passing validation commit
  codeteam-land MANIFEST alpha-bisect HASH       find and confirm a bad landing with validation probes and report it
  codeteam-land MANIFEST land-one WO             merge one checked entry now
  codeteam-land MANIFEST land-hold WO | land-next WO
  codeteam-land MANIFEST revert WO               revert a landed work order, as a landing of its own
  codeteam-land MANIFEST install-hook            the reference-transaction hook guarding landing, integration and base

Exit codes: 0 done; 1 command failure; 2 conflict or argument error; 3 check failed or hung; 5 refused.
State: git refs (wo/<zone>/<wo>, refs/landed/<wo>), <root>/land/{queue,reviews,wo}/, landed.log.
"""
import datetime as dt
import fcntl
import fnmatch
import glob
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import threading
import time
import tomllib
from pathlib import Path
from collections.abc import Callable, Iterable, Iterator
from concurrent.futures import ThreadPoolExecutor, as_completed
from contextlib import contextmanager, nullcontext
from functools import cache
from itertools import count

HERE = Path(__file__).resolve().parent
# Prefer this checkout's shared module over one in the working directory.
sys.path.insert(0, str(HERE.parent / "share"))
import codeteam_launchd
import codeteam_tm

# Called from launchd, hooks and loops with a bare PATH: git's hooks need git-lfs, the gate needs make and cargo.
os.environ["PATH"] = ":".join(dict.fromkeys([str(Path.home() / ".cargo" / "bin"), "/opt/homebrew/bin",
                                             *os.environ.get("PATH", "/usr/bin:/bin").split(":"), "/usr/bin", "/bin"]))
# Settings: where team folders live (CODETEAM_WORKSPACE) and the launchd label prefix (CODETEAM_LAUNCHD_PREFIX).
WORKSPACE = Path(os.environ.get("CODETEAM_WORKSPACE") or Path.home() / "codeteam-work")
LAUNCHD_PREFIX = os.environ.get("CODETEAM_LAUNCHD_PREFIX") or "com.codeteam"
TRAILER = "Landed-By: codeteam land-one"
MADE_BY = "Made-By: codeteam-land"
LAND_TOOL_ENV = "CODETEAM_LAND_TOOL"
# Build output a new work order tree is warm-cloned with: only folders lanes build into (zone.mk's WARM_DIRS is
# cargo-target). Never `target`: land/itest's target/ is the landing tool's own cargo output, lanes build into
# cargo-target/, and each clone pinned a 30 GB generation of it (2026-11-12: the disk filled).
WARM_DIRS = ("cargo-target", ".build", "node_modules")
BUILD_OUTPUT_DIRS = ("cargo-target", "target", ".build", "node_modules")
CONFLICT, GATE, REFUSED = 2, 3, 5
NOT_MOVED = "not moved to v5.4: run migrate-v54"


def die(msg, code=REFUSED):
    print(msg, file=sys.stderr)
    sys.exit(code)


def now():
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def run(cwd, *args, check=True, env=None):
    r = subprocess.run(list(args), cwd=cwd, capture_output=True, text=True, env=env)
    if check and r.returncode:
        die(f"{' '.join(args)} failed in {cwd}:\n{r.stdout}{r.stderr}", 1)
    return r


def spawn(cmd, env=None):
    """A notice: started and not waited for (a `codeteam2 say` past its 60 s timeout at high load
    once killed the queue runner)."""
    try:
        subprocess.Popen(cmd, shell=True, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as e:
        print(f"notice not sent ({e}): {cmd[:200]}", file=sys.stderr)


def git(cwd, *args, check=True, env=None):
    """Identify the landing tool to ref hooks, including ref writes in migration commands."""
    return run(cwd, "git", *args, check=check, env=dict(os.environ if env is None else env, **{LAND_TOOL_ENV: "1"}))


def out(cwd, *args):
    return git(cwd, *args).stdout.strip()


# ssh never prompts and never waits forever: the queue runner runs under launchd, where a push to the remote validation
# machine once sat 6 h. The same rule as bin/codeteam.
# Every ssh this tool starts goes through codeteam-own, so macOS judges its local-network access as ssh's own and not
# as the runner's (Homebrew's Python under launchd, which has none: "No route to host" to the remote validation machine).
OWN = str(HERE / "codeteam-own")
_ssh = os.environ.get("GIT_SSH_COMMAND", "")
if "BatchMode=yes" not in _ssh or "timeout" not in _ssh or "codeteam-own" not in _ssh:
    os.environ["GIT_SSH_COMMAND"] = (f"{shlex.quote(OWN)} /usr/bin/timeout 900 ssh -o ConnectTimeout=20 "
                                     "-o ServerAliveInterval=15 -o ServerAliveCountMax=4 -o BatchMode=yes")
if not os.environ.get("SSH_AUTH_SOCK") or "herdr" in os.environ.get("SSH_AUTH_SOCK", ""):
    try:
        _sock = subprocess.run(["launchctl", "getenv", "SSH_AUTH_SOCK"], capture_output=True, text=True,
                               timeout=5).stdout.strip()
        if _sock:
            os.environ["SSH_AUTH_SOCK"] = _sock
    except Exception:
        pass


def save_record(path: Path, record: dict) -> None:
    temporary = path.with_name(f".{path.name}.tmp")
    temporary.write_text(json.dumps(record, indent=1) + "\n")
    temporary.replace(path)


def zone_tool():
    loader = importlib.machinery.SourceFileLoader("zone_tool", str(HERE / "zone-tool"))
    spec = importlib.util.spec_from_loader("zone_tool", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


class Team:
    """What this tool needs from a codeteam manifest: the repo, the integration branch, the zones and [land]."""

    def __init__(self, manifest, create=True):
        self.manifest = Path(manifest).resolve()
        m = tomllib.loads(self.manifest.read_text())
        self.m = m
        self.repo = Path(os.path.expanduser(m["repo"])).resolve()
        # A lab team (mode = "lab": lanes push straight to base) lands on base itself: base is its integration.
        self.lab = m.get("mode") == "lab"
        self.integration = (m.get("land") or {}).get("integration") or (m.get("base", "main") if self.lab
                                                                       else m.get("integration", "integration"))
        self.exchange = m.get("exchange") or (self.integration if self.lab else "exchange")
        name = self.manifest.stem
        self.root = Path(os.path.expanduser(m.get("worktree_root") or str(WORKSPACE / f"team-{name}"))).resolve()
        self.cfg = m.get("land", {})
        self.landing = self.integration if self.lab else self.c("landing", "landing")
        self.dir = self.root / "land"
        for d in ("queue", "reviews", "wo") if create else ():
            (self.dir / d).mkdir(parents=True, exist_ok=True)
        self.zones = self._zones()

    def _zones(self):
        """zone name -> the folders it owns, relative to the repo."""
        zones = {}
        for lane in self.m.get("lanes", []):
            if "glob" in lane:
                for p in sorted(glob.glob(str(self.repo / lane["glob"]))):
                    if os.path.isdir(p):
                        zones[os.path.basename(p)] = [os.path.relpath(p, self.repo)]
                continue
            path = lane.get("path", ".").strip("/") or "."
            name = lane.get("name") or os.path.basename(path)
            owns = [o.strip("/") for o in lane.get("owns", [])]
            # a path lane's owns are its zone too (e.g. a harness lane owns Packages/HarnessKit, a learning lane owns lab)
            zones[name] = owns if path == "." and owns else [path] + [o for o in owns if o != path]
        return zones

    def c(self, key, default):
        return self.cfg.get(key, default)

    def wo_file(self, wo):
        return self.dir / "wo" / f"{wo}.json"

    def wo(self, wo):
        p = self.wo_file(wo)
        if not p.exists():
            die(f"unknown work order {wo}")
        return json.loads(p.read_text())

    def save_wo(self, rec):
        p = self.wo_file(rec["wo"])
        p.write_text(json.dumps(rec, indent=1) + "\n")

    def notify(self, to, kind, text):
        """A message to a session (Kong, a zone's coordinator, the orchestrator). [land].notify is a command
        template with {to}, {kind} and {text}; the default is codeteam2 say."""
        tmpl = self.c("notify", f"{HERE.parent / 'v2' / 'bin' / 'codeteam2'} say {shlex.quote(str(self.manifest))} "
                                "general codeteam {kind} {to} {text}")
        cmd = tmpl.format(to=shlex.quote(to), kind=kind, text=shlex.quote(text))
        spawn(cmd)

    def log(self, row):
        with open(self.dir / "landed.log", "a") as f:
            f.write(json.dumps(row) + "\n")


def v54_unmoved(team: Team) -> bool:
    return not team.lab and git(team.repo, "rev-parse", "-q", "--verify", f"refs/heads/{team.landing}",
                                check=False).returncode != 0


def runner_unmoved(team: Team, command: str) -> bool:
    if not v54_unmoved(team):
        return False
    path = team.dir / f"{command}-not-moved.json"
    printed = json.loads(path.read_text()) if path.exists() else None
    stamp = time.time()
    # Persist per runner so a process restart does not repeat the hourly log line.
    if printed is None or stamp - printed["time"] >= 3600:
        print(NOT_MOVED, file=sys.stderr, flush=True)
        save_record(path, {"time": stamp})
    return True


def move_tip(team: Team) -> str | None:
    if team.lab:
        return None
    path = team.dir / "v54-move.json"
    if path.exists():
        return json.loads(path.read_text())["old_integration"]
    return next((row["M"] for row in read_recheck(team) if row.get("move") is True), None)


def stage_rows(team: Team, rows: list[dict], T: str | None) -> list[dict]:
    return rows if T is None else [row for row in rows if row.get("v54") is True]


# ---------------------------------------------------------------- reach

def changed_files(tree, base, head="HEAD"):
    return [f for f in out(tree, "diff", "--name-only", f"{base}...{head}").splitlines() if f]


def touches_zone(zone_dirs: dict[str, list[str]], files: Iterable[str], zone: str) -> bool:
    return any(d in (".", "") or f == d or f.startswith(d + "/") or fnmatch.fnmatchcase(f, d)
               for f in files for d in zone_dirs.get(zone, []))


def in_zone(team, f, zone):
    """Test ownership, including overlapping whole-repo zones, rather than the first matching zone."""
    return touches_zone(team.zones, [f], zone)


def docs_only(files: list[str], suffixes: Iterable[str]) -> bool:
    return bool(files) and all(f.endswith(tuple(suffixes)) for f in files)


def hang_settings(cfg: dict) -> dict[str, str]:
    return {"CODETEAM_HANG_WINDOW": format(cfg.get("hang_min", 10) * 60, "g"),
            "CODETEAM_HANG_CPU_PCT": format(cfg.get("hang_cpu_pct", 1), "g")}


def units_pass(codes: Iterable[int]) -> bool:
    """Every scheduled unit step needs a passing commit record; no steps need no evidence."""
    return all(code == 0 for code in codes)


def queue_entry(wo: str, tip: str, base: str, zones: Iterable[str], queued: str,
                members: list[tuple[str, str]] | None = None) -> dict:
    entry = {"wos": [wo], "wo": wo, "tip": tip, "base": base, "zones": sorted(zones),
             "queued": queued, "state": "waiting", "review": "pending"}
    if members is not None and len(members) > 1:
        entry.update(wos=[w for w, _ in members], tips=[[w, t] for w, t in members])
    return entry


def entry_members(entry: dict) -> list[tuple[str, str]]:
    return [(w, t) for w, t in entry["tips"]] if "tips" in entry else [(entry["wo"], entry["tip"])]


def units_to_rerun(zone_dirs: dict[str, list[str]], members: list[tuple[str, list[str]]]) -> list[str]:
    zones = []
    for zone, files in members:
        if zone not in zones and touches_zone(zone_dirs, files, zone):
            zones.append(zone)
    return zones


def merge_chain(old: str, members: list[tuple[str, str]], merge_one) -> tuple[list[tuple[str, str]], list[str], str | None]:
    commits = []
    for wo, tip in members:
        commit, files = merge_one(old, wo, tip)
        if commit is None:
            return [], files, wo
        commits.append((wo, commit))
        old = commit
    return commits, [], None


def landing_message(wo: str, zone: str, log_text: str) -> str:
    return f"{wo} ({zone})\n\n{log_text}\n\nWork-Order: {wo}\nZone: {zone}\n{TRAILER}\n"


def overlapping(zone_dirs: dict[str, list[str]], landings: Iterable[tuple[str, list[str]]],
                zones: Iterable[str], doc_suffixes: Iterable[str]) -> list[str]:
    hits = []
    for wo, files in landings:
        code = [f for f in files if not f.endswith(tuple(doc_suffixes))]
        if wo not in hits and any(touches_zone(zone_dirs, code, z) for z in zones):
            hits.append(wo)
    return hits


def recheck_row(M: str, wo: str, overlapping_wos: Iterable[str], zones: Iterable[str], time: str) -> dict:
    return {"time": time, "M": M, "wo": wo, "overlapping": list(overlapping_wos), "zones": sorted(zones)}


def warm_source(team_root: str | Path) -> Path | None:
    source = Path(team_root) / "land" / "itest"
    return source if source.is_dir() else None


def zone_of_file(team, f):
    for z, dirs in team.zones.items():
        if any(d in (".", "") or f == d or f.startswith(d + "/") for d in dirs):
            return z
    return None


def reach(team, tree, files):
    """The zones whose tests the change reaches: the zones that hold a changed file, and every zone whose package
    depends on one of them directly by path (change X and B calls X: test X and B, not A, which
    calls B; zone-tool's scope at depth 1). A zone with no package manifest (scope: the whole tree) is reached by
    every change. A file in no zone's scope (a new top-level file, a script, config) reaches every zone.
    [land] reach = "chain" follows every package through the dependency chain."""
    zt = zone_tool()
    root = Path(tree)
    depth = None if team.c("reach", "direct") == "chain" else 1

    def scope(d):
        """A zone folder's scope. Not in this tree: nothing to test. No manifest at the folder but packages one
        folder down (a Rust-only lib's rust/, an app's rust-perf/ and swift-perf/): the folder and each of
        those packages' scopes. No manifest at all: the whole tree."""
        p = root / d
        if d not in (".", "") and not p.exists():
            return []
        sc = zt.scope_dirs(root, d, depth=depth)
        if sc is not None:
            return sc
        kids = sorted(c.name for c in p.iterdir() if c.is_dir() and ((c / "Package.swift").exists()
                                                                     or (c / "Cargo.toml").exists())) \
            if d not in (".", "") and p.is_dir() else []
        if not kids:
            return ["."]
        return [d] + [x for k in kids for x in (zt.scope_dirs(root, f"{d}/{k}", depth=depth) or [])]
    closures = {z: [s.split("!")[0] for d in dirs for s in scope(d)] for z, dirs in team.zones.items()}
    hit = set()
    # Contract files (spec v5 §4): a schema, file format, config key or wire protocol listed in [land.contracts] with
    # its consumers; a diff touching one runs every consumer's tests, whatever the path reach finds.
    for pat, consumers in (team.cfg.get("contracts") or {}).items():
        if any(f == pat or fnmatch.fnmatch(f, pat) for f in files):
            hit.update(z for z in consumers if z in team.zones)
    for f in files:
        found = False
        for z, cl in closures.items():
            if any(c in (".", "") or f == c or f.startswith(c + "/") for c in cl):
                hit.add(z)
                found = True
        if not found:
            return sorted(z for z, cl in closures.items() if cl)    # not a zone with nothing in this tree
    return sorted(hit)


# ---------------------------------------------------------------- interface changes (A1)

CG = os.environ.get("CODETEAM_CODEGRAPH") or "codegraph"   # the CodeGraph CLI (a test sets a stand-in)
DECL_KINDS = {"function", "method", "struct", "class", "protocol", "trait", "enum", "interface", "type_alias",
              "typealias", "constant", "constructor", "property", "field", "extension", "impl"}
TEST_MARKS = ("/tests/", "/Tests/", "_tests.", "_test.", "Tests.swift", "/test/")


def plus_lines(changed):
    """{path: set of new-side line numbers added or changed} from codegraph blast's `changed`."""
    out_ = {}
    for c in changed:
        out_[c["path"]] = {l["n"] for h in c.get("hunks", []) for l in h.get("lines", []) if l.get("n") and l["sign"] == "+"}
    return out_


def declaration_changed(seed, plus, read):
    """True when a line of the seed's declaration changed: from its first line to the line that opens its body
    (`{`, a trailing `:` or `=`), at most 8 lines. Body-only edits are not interface changes (A1)."""
    try:
        start = int(seed["span"].split("-")[0].lstrip("L"))
    except (KeyError, ValueError):
        return False
    lines = read(seed["path"])
    decl = []
    for n in range(start, min(start + 8, len(lines) + 1)):
        decl.append(n)
        text = lines[n - 1].rstrip()
        if "{" in text or text.endswith(":") or text.endswith("=") or text.endswith(";"):
            break
    return bool(set(decl) & plus.get(seed["path"], set()))


def interface_changes(team, rec):
    """{symbol: [zones outside rec's zone that call it]} for symbols whose declaration changed. Best effort: without
    CodeGraph (or past its time limit) it is empty and the gate alone decides."""
    rec.pop("interface_error", None)
    if not team.c("interface", True) or not shutil.which(CG):
        rec["interface_error"] = "interface check off" if shutil.which(CG) else "no codegraph"
        return {}
    tree = rec["tree"]
    try:
        r = subprocess.run([CG, "blast", "-b", own_base(team, tree), "-f", "json", "-p", tree],
                           capture_output=True, text=True, timeout=int(team.c("interface_timeout_s", 180)))
        blast = json.loads(r.stdout)
    except subprocess.TimeoutExpired:
        rec["interface_error"] = "codegraph blast timed out"
        return {}
    except ValueError:
        rec["interface_error"] = "codegraph blast gave no answer (no index?): " + (r.stderr or r.stdout).strip()[-200:]
        return {}
    plus = plus_lines(blast.get("changed", []))
    cache = {}

    def read(path):
        if path not in cache:
            try:
                cache[path] = (Path(tree) / path).read_text(errors="replace").splitlines()
            except OSError:
                cache[path] = []
        return cache[path]

    found = {}
    for seed in blast.get("seeds", []):
        if seed.get("kind") not in DECL_KINDS or seed.get("wholeFile") or any(m in seed["path"] for m in TEST_MARKS):
            continue
        if not declaration_changed(seed, plus, read):
            continue
        try:
            c = subprocess.run([CG, "callers", seed["name"], "-f", seed["path"], "-p", tree, "-j", "-l", "200"],
                               capture_output=True, text=True, timeout=60)
            paths = set(_paths(json.loads(c.stdout)))
        except (subprocess.TimeoutExpired, ValueError) as ex:
            rec["interface_error"] = f"codegraph callers {seed['name']}: {type(ex).__name__}"
            continue
        zones = sorted({z for z in (zone_of_file(team, x) for x in paths) if z and z != rec["zone"]})
        if zones:
            found[f"{seed['name']} ({seed['path']}:{seed['span']})"] = zones
    return found


def _paths(obj):
    if isinstance(obj, dict):
        for k, v in obj.items():
            if k in ("path", "file", "filePath") and isinstance(v, str):
                yield v
            else:
                yield from _paths(v)
    elif isinstance(obj, list):
        for v in obj:
            yield from _paths(v)


# ---------------------------------------------------------------- the API delta
# A work order's public API change, from its diff and CodeGraph, never from raw text alone: declarations on removed
# lines that no longer exist in the zone are removed (one found elsewhere in the zone moved); a changed declaration
# line of a symbol that still exists is a changed signature; a declaration on an added line that the base lacks is
# added. Nothing here refuses: the delta sets the version bump (docs pass), drives the interface notice, and goes to
# Kong with the review request.

DECL = {
    ".swift": re.compile(r"^\s*(?:@\w+(?:\([^)]*\))?\s+)*(?:public|open)\s+(?:(?:final|static|class|override|mutating|nonmutating|convenience|required|indirect|nonisolated|dynamic|lazy|weak|unowned)\s+)*"
                         r"(func|var|let|class|struct|enum|protocol|typealias|actor|init|subscript|case)\b\s*([A-Za-z_][A-Za-z0-9_]*)?"),
    ".rs": re.compile(r"^\s*pub\s+(?:(?:async|const|unsafe|extern\s+\"[^\"]*\")\s+)*(fn|struct|enum|trait|type|const|static|mod|union)\s+([A-Za-z_][A-Za-z0-9_]*)"),
}


def _decls(lines, ext):
    rx = DECL.get(ext)
    out = []
    for ln in lines:
        m = rx.match(ln) if rx else None
        if m:
            out.append((m.group(1), m.group(2) or m.group(1), ln.strip()))
    return out


def _decl_pattern(kind, name):
    """POSIX ERE for `<kind> <name>` as whole words (git grep -E has no \\b or \\s)."""
    w = "[^A-Za-z0-9_]"
    return f"(^|{w}){kind}[[:space:]]+{re.escape(name)}({w}|$)"


def api_delta(team, rec):
    """{"removed": [...], "changed": [...], "added": [...]} of public declarations in the work order's own zone."""
    tree = rec["tree"]
    base = own_base(team, tree)
    removed, added, changed = [], [], []
    diff = out(tree, "diff", "-U0", f"{base}...HEAD")
    cur, minus, plus = None, {}, {}
    for line in diff.splitlines():
        if line.startswith("+++ "):
            cur = line[6:] if line.startswith("+++ b/") else None
        elif line.startswith("--- "):
            pass
        elif cur and line.startswith("-") and not line.startswith("---"):
            minus.setdefault(cur, []).append(line[1:])
        elif cur and line.startswith("+") and not line.startswith("+++"):
            plus.setdefault(cur, []).append(line[1:])
    zone_dirs = team.zones.get(rec["zone"], ["."])
    in_zone = lambda f: any(d in (".", "") or f.startswith(d + "/") for d in zone_dirs)
    test = lambda f: any(m in f for m in TEST_MARKS)

    def exists_in_zone(kind, name):
        """CodeGraph first (the tree's index, with the lead's edits); grep as the fallback when it cannot answer."""
        if team.c("codegraph", True) and shutil.which(CG):
            try:
                r = subprocess.run([CG, "query", name, "-p", tree, "-j", "-l", "50"], capture_output=True,
                                   text=True, timeout=60)
                hits = [h for h in _paths(json.loads(r.stdout)) if in_zone(h)]
                if r.returncode == 0:
                    return bool(hits)
            except (subprocess.TimeoutExpired, ValueError):
                pass
        r = git(tree, "grep", "-l", "-E", _decl_pattern(kind, name), "--", *zone_dirs, check=False)
        return bool(r.stdout.strip())

    for f in sorted(set(minus) | set(plus)):
        ext = os.path.splitext(f)[1]
        if ext not in DECL or not in_zone(f) or test(f):
            continue
        gone = {(k, n): t for k, n, t in _decls(minus.get(f, []), ext)}
        new = {(k, n): t for k, n, t in _decls(plus.get(f, []), ext)}
        for (k, n), t in gone.items():
            if (k, n) in new:
                if new[(k, n)] != t:
                    changed.append(f"{k} {n} ({f})")
            elif not exists_in_zone(k, n):
                removed.append(f"{k} {n} ({f})")
        for (k, n), t in new.items():
            if (k, n) in gone:
                continue
            base_has = git(tree, "grep", "-q", "-E", _decl_pattern(k, n), base, "--", *zone_dirs,
                           check=False).returncode == 0
            if not base_has:
                added.append(f"{k} {n} ({f})")
    # a declaration removed from one file of the zone and added in another has moved
    key = lambda x: x.split(" (")[0]
    moved = {key(x) for x in removed} & {key(x) for x in added}
    return {"removed": [x for x in removed if key(x) not in moved], "changed": changed,
            "added": [x for x in added if key(x) not in moved]}

# ---------------------------------------------------------------- work order trees

def root_links(team, tree):
    """The manifest's [root_links] beside a tree (e.g. a Package.swift that finds an SDK at ../acme-sdk), as v1
    puts them beside every worktree."""
    parent = Path(tree).parent
    for name, target in (team.m.get("root_links") or {}).items():
        link = parent / name
        if not link.exists() and not link.is_symlink():
            parent.mkdir(parents=True, exist_ok=True)
            link.symlink_to(os.path.expanduser(target))


SKILLS_MARK = "# codeteam: team skills linked into a tracked .claude/skills"


def link_team_skills(tree, skills_home):
    """When the repo tracks its own .claude/skills (codegraph's fork: upstream's add-lang and agent-eval), the team's
    skills cannot be one link over the folder: each is linked into it by name, a name already there is left alone,
    and each link is kept out of git by the repo's info/exclude. A link git would still see (a .gitignore of the
    repo's un-ignores it) is removed again, never left to be committed. Returns (linked, refused) names. Never raises
    (2026-11-09: codegraph's sessions and work order trees had none of the team's skills)."""
    linked, refused = [], []
    try:
        d = Path(tree) / ".claude" / "skills"
        home = Path(skills_home)
        if not d.is_dir() or d.is_symlink() or not home.is_dir():
            return linked, refused
        names = [p.name for p in sorted(home.iterdir()) if p.is_dir() and not p.name.startswith(".")]
        todo = [n for n in names if not (d / n).exists() and not (d / n).is_symlink()]
        if not todo:
            return linked, refused
        gd = subprocess.run(["git", "-C", str(tree), "rev-parse", "--path-format=absolute", "--git-common-dir"],
                            capture_output=True, text=True, timeout=10).stdout.strip()
        if not gd:
            return linked, refused
        ex = Path(gd) / "info" / "exclude"
        ex.parent.mkdir(parents=True, exist_ok=True)
        text = ex.read_text() if ex.exists() else ""
        want = [f"/.claude/skills/{n}" for n in names if f"/.claude/skills/{n}\n" not in text]
        if want:
            if SKILLS_MARK not in text:
                text = text.rstrip("\n") + ("\n" if text.strip() else "") + SKILLS_MARK + "\n"
            ex.write_text(text + "".join(w + "\n" for w in want))
        for n in todo:
            (d / n).symlink_to(home / n)
            r = subprocess.run(["git", "-C", str(tree), "check-ignore", "-q", f".claude/skills/{n}"], timeout=10)
            if r.returncode == 0:
                linked.append(n)
            else:
                (d / n).unlink()
                refused.append(n)
    except (OSError, subprocess.SubprocessError):
        pass
    return linked, refused


def warm_clone(src, dest):
    for d in WARM_DIRS:
        s = Path(src) / d
        if s.is_dir() and not (Path(dest) / d).exists():
            subprocess.run(["cp", "-c", "-R", str(s), str(Path(dest) / d)], capture_output=True)


def cmd_wo_cut(team, a):
    zone, wo = a.zone, a.wo
    if getattr(a, "staff_as_orc", False) and zone not in team.zones:
        zone = "orc"                    # a staff session's work order (designer, Kong): the orchestrator's walls
    if zone not in team.zones and zone != "orc":
        die(f"unknown zone {zone}; zones: {', '.join(sorted(team.zones))}")
    if team.wo_file(wo).exists():
        die(f"work order {wo} exists")
    path = team.root / "wo" / zone / wo
    branch = f"wo/{zone}/{wo}"
    clear_stale_branch(team, branch, wo, path)
    root_links(team, path)
    git(team.repo, "worktree", "add", "-q", "-b", branch, str(path), team.integration)
    source = warm_source(team.root)
    if source is not None:
        warm_clone(source, path)
        lt_mark = Path(out(source, "rev-parse", "--path-format=absolute", "--git-dir")) / "codeteam-prepared"
        if lt_mark.exists():            # its prepared folders came with the clone: same lockfile, same state
            shutil.copy(lt_mark, Path(out(path, "rev-parse", "--path-format=absolute", "--git-dir")) / "codeteam-prepared")
    prepare(team, path)
    # The build output the warm clone and prepare brought stays out of Time Machine; the hourly sweep
    # marks what the tree's builds make later.
    codeteam_tm.exclude(codeteam_tm.build_dirs(path))
    # The record first: a step after it that fails or is killed leaves a work order that can be retired, not a tree
    # nobody knows (the index step once ran past 120 s twice and left two unregistered trees).
    team.save_wo({"wo": wo, "zone": zone, "tree": str(path), "branch": branch, "cut": now(),
                  "base": out(team.repo, "rev-parse", team.integration)})
    seed = HERE / "codeteam-seed-index"
    if seed.exists() and team.c("seed_index", True):
        # The CodeGraph index is copied in the background when it takes more than a moment: wo-cut runs inside Claude
        # Code's WorktreeCreate hook, which gives up on a slow one ('Hook cancelled').
        pr = subprocess.Popen([str(seed), str(path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                              start_new_session=True)
        try:
            pr.wait(timeout=float(team.c("seed_wait_s", 20)))
        except subprocess.TimeoutExpired:
            pass
    _, refused = link_team_skills(path, team.root / "team" / "claude" / "skills")
    if refused:
        print(f"team skills not linked (the repo's .gitignore would show them): {', '.join(refused)}", file=sys.stderr)
    print(path)


def clear_stale_branch(team, branch: str, wo: str, path: Path) -> None:
    """A branch a cut left with no record and no tree (a checkout that died: 2026-11-11, the disk was
    full) holds nothing beyond integration: it is kept as refs/archive/wo/<wo> and removed, so the cut can go on.
    One with commits of its own, or with a tree, is refused by name."""
    tip = git(team.repo, "rev-parse", "-q", "--verify", f"refs/heads/{branch}", check=False).stdout.strip()
    if not tip:
        return
    on_integration = git(team.repo, "merge-base", "--is-ancestor", tip, team.integration, check=False).returncode == 0
    if path.exists() or not on_integration:
        die(f"branch {branch} exists with {'a tree at ' + str(path) if path.exists() else 'commits of its own'} and no "
            f"work order record; retire or rename it first (codeteam-land {team.manifest} wo-retire {wo}).")
    git(team.repo, "update-ref", f"refs/archive/wo/{wo}", tip)
    git(team.repo, "worktree", "prune", check=False)
    git(team.repo, "branch", "-D", branch)
    print(f"{wo}: an earlier cut left branch {branch} with nothing of its own; it is kept as refs/archive/wo/{wo} "
          "and cut again", file=sys.stderr)


def cmd_wo_pull(team, a):
    sys.exit(wo_pull(team, team.wo(a.wo)))


def wo_pull(team, rec):
    tree = rec["tree"]
    if out(tree, "status", "--porcelain", "--untracked-files=no"):
        die(f"{rec['wo']}: the tree has uncommitted changes; commit them first")
    r = git(tree, "merge", "--no-edit", "-q", team.integration, check=False)
    if r.returncode:
        print(f"{rec['wo']}: merging {team.integration} {merge_failure(tree, r)}\n"
              "Resolve it in the work order tree and commit, then queue it again.")
        return CONFLICT
    return 0


# ---------------------------------------------------------------- queue

def entries(team):
    return sorted(p for p in (team.dir / "queue").iterdir() if p.suffix == ".json")


def entry_current(e: dict) -> bool:
    """Check for the fields queue_entry writes after Stage 2 and Stage 3 needs; this checks presence, not values."""
    return all(key in e for key in ("wo", "tip", "base", "zones", "review"))


def set_aside_entry(team: Team, p: Path) -> bool:
    """Try to move an entry to queue-stale; return False if the filesystem operation fails."""
    try:
        stale = team.dir / "queue-stale"
        stale.mkdir(exist_ok=True)
        p.rename(stale / p.name)
        return True
    except OSError:
        return False


def prune_entry(team: Team, p: Path) -> list[str]:
    """Prune one entry; return work orders of an unchecked entry only if it was moved aside."""
    try:
        entry = json.loads(p.read_text())
        wos = entry["wos"]
        if all(team.wo_file(w).exists() for w in wos):
            if entry_current(entry):
                return []
            if set_aside_entry(team, p):
                return wos
            return []
        if all((team.dir / "wo" / f"{w}.landed.json").exists() for w in wos):
            p.unlink(missing_ok=True)
            return []
    except (OSError, ValueError, KeyError, TypeError):
        wos = ["(unreadable entry)"]
    if set_aside_entry(team, p):
        try:
            team.notify(team.c("orchestrator", "orc"), "NOTE",
                        f"A landing queue entry named work orders with no record ({', '.join(map(str, wos))}); it is moved "
                        f"to {team.dir / 'queue-stale' / p.name} and the queue goes on. Queue the work order again with land if it is real.")
        except OSError:
            pass
    return []


def prune_queue(team):
    """Try to remove landed-only entries and set aside entries with missing records or unchecked tips.
    A copy left when land-next renames an entry during landing can otherwise stop queue-run on every pass.
    Try to notify the orchestrator about missing records and send one note for unchecked entries moved aside.
    If an unchecked entry cannot be moved and is the oldest unheld entry, queue-run refuses it on every pass;
    the queue stops behind it until it is moved, held, or corrected."""
    unchecked = []
    for p in entries(team):
        unchecked.extend(prune_entry(team, p))
    if unchecked:
        try:
            team.notify(team.c("orchestrator", "orc"), "NOTE",
                        f"Work orders {', '.join(map(str, unchecked))} must each run `land` again because Stage 2 or Stage 3 "
                        f"has no current record for their entries. The entries were moved to {team.dir / 'queue-stale'}.")
        except Exception:
            pass


def entry_path(team, wo):
    for p in entries(team):
        if wo in json.loads(p.read_text())["wos"]:
            return p
    return None


def check_work_order(team: Team, rec: dict) -> list[str]:
    """Refuse edits outside the zone before spending a build slot or merging integration."""
    if out(rec["tree"], "status", "--porcelain", "--untracked-files=no"):
        die(f"{rec['wo']}: the tree has uncommitted changes; commit them first")
    files = work_order_files(team, rec)
    if not files and not declares_doc_level(team, rec):
        die(f"{rec['wo']}: nothing to land: no change against {team.integration}. A work order that only states a "
            "document's level lands with `Doc-Level: <repo path> <level>` in its own commit.")
    if rec["zone"] == "orc":
        return files
    own_docs = set(zone_docs(team, rec["tree"], rec["zone"]))
    walls = guard_walls(team, rec["zone"])
    outside = [f for f in files if not in_zone(team, f, rec["zone"]) and f not in own_docs
               and not (walls and walls.owns_doc(f))]
    if outside:
        die(f"{rec['wo']}: changes files outside zone {rec['zone']} (walls):\n  " + "\n  ".join(outside) +
            "\nThose go to their zone as a work order of its own.")
    return files


def declares_doc_level(team: Team, rec: dict) -> bool:
    """Its own commits (or a land --doc-level --doc already recorded) state a level for a named document that exists on integration (a
    fix-forward for a missing Doc-Level line). Such a work order changes no file and lands as docs only;
    docs_pass records the level for the next stamp."""
    text = out(rec["tree"], "log", "--no-merges", "--format=%B", f"{team.integration}..HEAD")
    named = [m.group(1) for m in DOC_LEVEL.finditer(text) if m.group(1)]
    named += [x["doc"] for x in rec.get("doc_level", []) if x.get("doc")]
    return any(git(team.repo, "cat-file", "-e", f"{team.integration}:{path}", check=False).returncode == 0
               for path in named)


def work_order_files(team: Team, rec: dict) -> list[str]:
    own = set(review_files(team, review_range(team, out(rec["tree"], "rev-parse", "HEAD"), [])))
    return [file for file in changed_files(rec["tree"], team.integration) if file in own]


def lane_test_key(zone: str, group: str) -> str:
    """The record key of a lane's own test command. A group other than unit adds zone.mk's ` test-group=<group>`
    word (ZONE_TEST_GROUP_KEY), so an integration run is a group record that never counts as unit evidence."""
    return f"lane {zone}" + (f" test-group={group}" if group != "unit" else "")


def unit_step_keys(team: Team, tree: Path, zone: str) -> list[str] | None:
    if lane_rec(team, zone).get("test"):
        return [lane_test_key(zone, "unit")]
    keys = []
    for folder in test_folders(team, tree, zone, "unit"):
        # Ask make for its expanded key, including repo overrides. A stdin makefile works with macOS make 3.81.
        result = subprocess.run(
            ["make", "--no-print-directory", "-s",
             *next((["-f", name] for name in ("GNUmakefile", "makefile", "Makefile") if (tree / name).is_file()), []),
             "-f", "-", f"DIR={folder}", "codeteam-unit-key"], cwd=tree, capture_output=True, text=True,
            input="codeteam-unit-key:\n\t@$(info CODETEAM-UNIT-KEY=$(strip $(ZONE_TEST_ONE_KEY))):\n",
            env=team_env(team, "unit"))
        key = next((line.removeprefix("CODETEAM-UNIT-KEY=") for line in result.stdout.splitlines()
                    if line.startswith("CODETEAM-UNIT-KEY=")), "")
        if result.returncode or not key:
            return None                 # no known key can establish evidence; run the zone's unit steps
        keys.append(key)
    return keys


def commit_record(tree: str | Path, commit: str, key: str) -> int:
    """Ask zone-tool for the newest clean unit evidence at this exact commit and key."""
    return subprocess.run([HERE / "zone-tool", "commit-record", commit, "--key", key],
                          cwd=tree, capture_output=True, text=True).returncode


def current_units(team: Team, tree: Path, zone: str) -> bool:
    keys = unit_step_keys(team, tree, zone)
    if keys is None:
        return False
    commit = out(tree, "rev-parse", "HEAD")
    return units_pass(commit_record(tree, commit, key) for key in keys)


def test_units(team: Team, rec: dict, zone: str | None = None) -> None:
    """The units of zone (default the record's own) in rec's tree; the results are saved in rec, whose zone stays
    its own. A set tests each member's zone in the first member's tree (a copy of the first
    record carrying another member's zone was saved over the first one's record)."""
    if not stage2_steps(team, rec, zone_tests(team, rec["tree"], zone or rec["zone"], "land"), "unit"):
        sys.exit(GATE)


def stage2_record(results: list[dict]) -> list[dict]:
    """A step the machine stopped is recorded by what stopped it, "disk" or "cache", not "fail"."""
    return [{"step": result["name"], "result": result.get("stopped_by") or result["outcome"].lower(),
             "seconds": round(result["seconds"], 1)} for result in results]


# What Stage 2 prints for each infrastructure stop, after the steps it names (stage2_steps).
STOP_NOTICES = {
    "disk": ("DISK: {steps} stopped on a full disk (No space left on device): the machine, not the work order, and "
             "not a test failure. Nothing was queued and there is nothing to fix. Run land again once `df -h` shows "
             "space (Time Machine's hourly snapshot holds deleted files from :00 until its backup ends); if it fails "
             "the same way with space free, it is a test failure."),
    "cache": ("CACHE: {steps} stopped on an error in the machine's shared Swift compile cache: "
              "the machine, not the work order, and not a test failure. Nothing was queued and there is nothing to "
              "fix. Run land again; if it fails the same way twice, tell Orc-Codeteam."),
}


def stage2_steps(team: Team, rec: dict, steps: list[tuple[str, str]], group: str, *, concurrent: bool = True) -> bool:
    """Persist the batch in submission order, including failures, before returning its gate result. Committed files
    the batch changed are restored as committed (restore_build_changes). A step whose output reports a full disk or
    a compile cache error is named as an infrastructure stop; the land still exits 3, as SPEC v5.4 Stage 2 step 7
    says."""
    results = []
    before = changed_tracked(rec["tree"])
    ok, lines = run_steps(rec["tree"], steps, team_env(team, group), concurrent=concurrent, on_result=results.append)
    order = {name: i for i, (name, _) in enumerate(steps)}
    results.sort(key=lambda result: order[result["name"]])
    rec.setdefault("stage2", []).extend(stage2_record(results))
    team.save_wo(rec)
    print("\n".join(lines))
    for kind, notice in STOP_NOTICES.items():
        stopped = [result["name"] for result in results if result.get("stopped_by") == kind]
        if stopped:
            print(notice.format(steps=", ".join(stopped)), flush=True)
    restore_build_changes(rec, before)
    return ok


def changed_tracked(tree: str | Path) -> set[str]:
    """Committed files changed in the tree; none when git cannot read it (the restore must never fail a gate)."""
    if not Path(tree).is_dir():
        return set()
    try:
        r = git(tree, "diff", "--name-only", "HEAD", check=False)
    except OSError:
        return set()
    return set(r.stdout.splitlines()) if r.returncode == 0 else set()


def restore_build_changes(rec: dict, before: set[str]) -> list[str]:
    """Put back committed files a Stage 2 build changed: a cargo build rewrites a stale Cargo.lock, and the change
    then stops `git merge integration` in the tree, or a set's checkout back to its branch (2026-11-12: a
    work order's merge failed with no conflict to act on). Landing takes the commit, never the
    tree, so nothing the build wrote could land; files changed before the batch are left alone."""
    changed = sorted(changed_tracked(rec["tree"]) - before)
    if changed:
        git(rec["tree"], "checkout", "-q", "HEAD", "--", *changed)
        print(f"{rec['wo']}: the build changed {', '.join(changed)}, which the commit holds; restored as committed. "
              f"A build that rewrites a committed file means the file is stale at "
              f"{out(rec['tree'], 'rev-parse', '--short=10', 'HEAD')}: the zone that owns it commits the regenerated one.")
    return changed


def merge_failure(tree: str | Path, result: subprocess.CompletedProcess) -> str:
    """Why a merge in a work order tree failed: its conflicted files, or, when there are none (git refused to start,
    say over a local change), git's own words. An empty 'conflicts in:' list once named nothing."""
    files = out(tree, "diff", "--name-only", "--diff-filter=U")
    if files:
        return f"conflicts in:\n{files}"
    said = "\n".join(f"  {line}" for line in f"{result.stderr or ''}\n{result.stdout or ''}".strip().splitlines()[-12:])
    return f"failed with no conflicted file; git said:\n{said or '  nothing'}"


def make_has_check(returncode: int, stderr: str) -> bool:
    return returncode == 0 or "No rule to make target" not in stderr


def has_zone_check(check_cmd: str, make_check: bool) -> bool:
    return bool(check_cmd) or make_check


def zone_check_steps(zone_dirs: dict[str, list[str]], zones: Iterable[str], zone_tool: str,
                     check_cmd: str) -> list[tuple[str, str]]:
    steps, emitted = [], set()
    for zone in zones:
        for folder in zone_dirs.get(zone, []):
            if folder in emitted:
                continue
            emitted.add(folder)
            # Enable checks despite team_env's test default and pin the command so inherited values cannot select it.
            steps.append((f"compile {zone} ({folder})",
                          f"ZONE_CHECK=1 ZONE_CHECK_CMD={shlex.quote(check_cmd)} "
                          f"{shlex.quote(zone_tool)} check {shlex.quote(folder)}"))
    return steps


def compile_steps(team: Team, tree: str | Path, zones: Iterable[str]) -> list[tuple[str, str]]:
    steps = []
    check = team.c("check", None)
    if check != "":
        check_cmd = os.path.expanduser(str(team.m.get("env", {}).get("ZONE_CHECK_CMD", ""))
                                       .replace("{root}", str(team.root)).replace("{home}", str(team.root / "team")))
        dry = run(tree, "make", "-n", "--no-print-directory", "check", check=False)
        if has_zone_check(check_cmd, make_has_check(dry.returncode, dry.stderr)):
            steps.extend(zone_check_steps(team.zones, zones, str(HERE / "zone-tool"), check_cmd))
        else:
            check = default_check(tree) if check is None else check
            if check:
                steps.append(("type check", check))
    gates = team.c("gates", None)
    if gates is None and run(tree, "make", "-n", "check-gates", check=False).returncode == 0:
        gates = "make --no-print-directory check-gates BASE={integration}"
    if gates:
        steps.append(("repo gates", gates.replace("{integration}", team.integration).replace("{target}", team.integration)))
    return steps


def repo_test_steps(tree: str | Path, folder: str, group: str, cls: str, zone_tool: str) -> list[tuple[str, str]]:
    path = Path(tree) / folder
    if not path.is_dir():
        return []
    scripts = sorted(p.name for p in [*path.glob("*.py"), *path.glob("*.sh")]
                     if p.is_file() and p.name not in ("conftest.py", "__init__.py"))
    pytest_files = {name for name in scripts
                    if fnmatch.fnmatch(name, "test_*.py") or fnmatch.fnmatch(name, "*_test.py")}
    commands = [f"python3 -m pytest -q {shlex.quote(folder)}"] if pytest_files else []
    commands.extend(f"{'python3' if name.endswith('.py') else 'sh'} {shlex.quote(str(Path(folder) / name))}"
                    for name in scripts if name not in pytest_files)
    if not commands:
        return []
    # Keep running after a failure so one folder's record covers every runnable test.
    inner = "rc=0; " + "; ".join(f"{command} || rc=1" for command in commands) + "; exit $rc"
    return [(f"{group} tests ({folder})", f"{shlex.quote(zone_tool)} job submit --class {cls} --wait 0 --key "
             f"{shlex.quote(f'repo {folder} test-group={group}')} -- sh -c {shlex.quote(inner)}")]


def repo_integration_steps(tree: str | Path, folder: str, cls: str, zone_tool: str) -> list[tuple[str, str]]:
    return repo_test_steps(tree, folder, "integration", cls, zone_tool)


def check_integration(team: Team, rec: dict, only_docs: bool, files: list[str] | None = None) -> list[str]:
    """Stage 2: check ruling numbers, compile, then run repo units and integration tests. files: what the check
    reaches from, default the record's own; a set passes its merged files without saving them in the first member's
    record."""
    if dup := duplicate_rulings(rec["tree"]):
        die(f"FAIL numbered entry used twice: {', '.join(dup)}", GATE)
    if only_docs:
        return []
    zones = reach(team, rec["tree"], rec["files"] if files is None else files)
    if not stage2_steps(team, rec, compile_steps(team, rec["tree"], zones), "integration", concurrent=False):
        sys.exit(GATE)
    steps = repo_test_steps(rec["tree"], team.c("unit_tests", "tests/unit"), "unit", "land", str(HERE / "zone-tool"))
    if steps and not stage2_steps(team, rec, steps, "unit"):
        sys.exit(GATE)
    tests = [step for z in zones for step in zone_tests(team, rec["tree"], z, "land", group="integration")]
    tests.extend(repo_integration_steps(rec["tree"], team.c("integration_tests", "tests/integration"),
                                       "land", str(HERE / "zone-tool")))
    if not stage2_steps(team, rec, tests, "integration"):
        sys.exit(GATE)
    return zones


def queue_notices(team: Team, rec: dict, a) -> None:
    rec["interface"] = interface_changes(team, rec)
    try:
        rec["api"] = api_delta(team, rec)
    except Exception as e:               # informational: never stops a landing
        rec["api"] = {"removed": [], "changed": [], "added": [], "error": f"{type(e).__name__}: {e}"}
    told = set(rec.get("interface_told", []))
    for sym, zones in rec["interface"].items():
        for z in zones:
            if f"{sym}|{z}" in told:
                continue                # a retry must not repeat an interface notice
            told.add(f"{sym}|{z}")
            team.notify(f"Coord-{z}", "NOTE", f"Interface change coming from zone {rec['zone']} ({rec['wo']}): {sym}. "
                                              "Do not add callers to the old form; your work continues.")
    rec["interface_told"] = sorted(told)
    tag_wo(team, rec, getattr(a, "feature", None), getattr(a, "fixes", None))
    if getattr(a, "doc_level", None):
        rec.setdefault("doc_level", []).append({"level": a.doc_level, "doc": getattr(a, "doc", None)})


def put_back_set_merge(rec: dict) -> None:
    """Put a tree that a dead land left on its landing set's merge back on its branch, before this land reads it.
    check_combined_members' finally does that when a land ends, SIGTERM and SIGHUP included, but not after SIGKILL, and
    not when the checkout itself fails: in the 09:00 disk-full window it left server's and sync's trees on their
    merges, and the next land of server was refused for its partner's docs file. Called
    only inside stage_admit, which has refused every live land holding this work order, so no live run owns the
    merge. Only a tree whose HEAD is its branch's tip, or merge commits along the first parent on top of it, with no
    tracked change and no merge under way, is put back; any other state is left as it is."""
    tree, branch = rec.get("tree"), rec.get("branch")
    if not tree or not branch or not Path(tree).is_dir():
        return
    if git(tree, "symbolic-ref", "-q", "HEAD", check=False).returncode == 0:
        return                                          # on a branch: the usual case
    tip = git(tree, "rev-parse", "-q", "--verify", f"refs/heads/{branch}", check=False).stdout.strip()
    head = git(tree, "rev-parse", "-q", "--verify", "HEAD", check=False).stdout.strip()
    if not tip or not head:
        return
    if head != tip:
        line = [row.split() for row in
                out(tree, "rev-list", "--first-parent", "--parents", "-n", "100", f"{tip}..{head}").splitlines()]
        if not line or any(len(row) < 3 for row in line) or line[-1][1] != tip:
            return
    if (git(tree, "rev-parse", "-q", "--verify", "MERGE_HEAD", check=False).returncode == 0
            or out(tree, "status", "--porcelain", "--untracked-files=no")):
        return
    git(tree, "checkout", "-q", branch)
    print(f"{rec['wo']}: its tree was left on a landing set's merge ({head[:10]}) by a land no longer running; "
          f"put back on {branch} ({tip[:10]})", flush=True)


def checked_members(team: Team, names: list[str]) -> list[tuple[dict, bool]]:
    if len(set(names)) != len(names):
        die("a work order occurs more than once in the landing set")
    for wo in names:
        if entry_path(team, wo):
            die(f"{wo} is already queued")
    records = [team.wo(wo) for wo in names]
    for rec in records:
        put_back_set_merge(rec)
    stage2 = []
    for rec in records:
        rec["stage2"] = stage2
    members = []
    alone = len(records) == 1           # a set's unit tests run once, on its merged tips
    try:
        for rec in records:
            files = check_work_order(team, rec)     # no files: a Doc-Level declaration only, which tests nothing
            only_docs = not files or docs_only(files, team.c("docs_only_suffixes", [".md"]))
            if alone and not only_docs and not current_units(team, Path(rec["tree"]), rec["zone"]):
                test_units(team, rec)
            members.append((rec, only_docs))
    finally:
        for rec in records:
            team.save_wo(rec)
    return members


def merge_checked_base(team: Team, rec: dict, base: str, only_docs: bool, test: bool = True) -> None:
    before = out(rec["tree"], "rev-parse", "HEAD")
    merged = git(rec["tree"], "merge", "--no-edit", base, check=False)
    if merged.returncode:
        print(f"{rec['wo']}: merging {team.integration} {merge_failure(rec['tree'], merged)}\n"
              "Resolve it and commit, then run land again.")
        sys.exit(CONFLICT)
    if test and not only_docs and touches_zone(team.zones,
            out(rec["tree"], "diff", "--name-only", before, "HEAD").splitlines(), rec["zone"]):
        test_units(team, rec)


def merge_set_tips(tree: str | Path, members: list[tuple[dict, bool]]) -> None:
    git(tree, "checkout", "-q", "--detach", members[0][0]["tip"])
    for rec, _ in members[1:]:
        merged = git(tree, "merge", "--no-edit", rec["tip"], check=False)
        if merged.returncode:
            why = merge_failure(tree, merged)
            git(tree, "merge", "--abort", check=False)      # nothing to abort when git refused to start
            print(f"{rec['wo']}: combining the landing set {why}")
            sys.exit(CONFLICT)


def check_combined_members(team: Team, members: list[tuple[dict, bool]], base: str) -> tuple[list[str], list[str]]:
    first = members[0][0]
    tree = first["tree"]
    is_set = len(members) > 1
    try:
        if is_set:
            merge_set_tips(tree, members)
            # Every member's zone is unit-tested here, once, on the merged tips: halves that build only
            # together (one zone's code, another's Cargo.lock) land as a set.
            for zone in dict.fromkeys(rec["zone"] for rec, docs in members if not docs):
                if not current_units(team, Path(tree), zone):
                    test_units(team, first, zone)
        files = changed_files(tree, own_base(team, tree))
        zones = check_integration(team, first, all(docs for _, docs in members), files=files)
        return zones, reach(team, tree, files)
    finally:
        if is_set:
            git(tree, "checkout", "-q", first["branch"])


def cmd_land(team, a):
    """Stage 2: a lone work order's units in its own tree; for a set, every member's units once on the merged tips.
    Merge integration once, check the combined set and queue its own tips.

    A pending build-queue restart delays admission. All-docs sets skip tests but still check duplicate rulings.
    The first branch keeps only its own work and integration, not the other members' commits.
    SIGTERM or SIGHUP ends it as an exit (status 143 or 129), so the set's first tree goes back to its branch and
    every member's record is saved as its own (a land stopped mid Stage 2 once left the first tree
    detached on the set's merge commits). A land of a work order that a live land of the same
    team already holds is refused before it reads a record or a tree. A tree that a dead
    land left on its set's merge is put back on its branch before it is read (put_back_set_merge).
    """
    if v54_unmoved(team):
        die(NOT_MOVED)
    if a.untested:
        die("there is no --untested: the landing tool tests every landing")
    names = [a.wo, *(a.with_ or [])]
    announced = False
    main = threading.current_thread() is threading.main_thread()   # only the main thread may set a handler
    previous = {s: signal.signal(s, _exit_on_term) for s in (signal.SIGTERM, signal.SIGHUP)} if main else {}
    try:
        while True:
            try:
                with stage_admit("Stage 2", f"check of {', '.join(names)}", holds=(str(team.manifest), names)):
                    check_and_queue(team, a, names)
                return
            except RestartPending:
                if not announced:
                    print(f"waiting for build queue restart: {buildq_dir().parent / 'restart' / 'buildq.json'}",
                          file=sys.stderr, flush=True)
                    announced = True
                drive_buildq_restart(team)
                time.sleep(float(team.c("poll_s", 15)))
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)


def _exit_on_term(signum, frame):
    """SIGTERM or SIGHUP as SystemExit, so the finally blocks of a stopped land still run."""
    print(f"land: stopped ({signal.Signals(signum).name}); restoring the trees and records", file=sys.stderr, flush=True)
    sys.exit(128 + signum)


def check_and_queue(team: Team, a, names: list[str]) -> None:
    members = checked_members(team, names)
    try:
        base = out(team.repo, "rev-parse", team.integration)
        merge_checked_base(team, members[0][0], base, members[0][1], test=len(members) == 1)
        for rec, _ in members:
            rec.update(base=base, tip=out(rec["tree"], "rev-parse", "HEAD"), files=changed_files(rec["tree"], own_base(team, rec["tree"])))
        zones, reached = check_combined_members(team, members, base)
        queued = now()
        for rec, _ in members:
            rec.update(zones=zones, reach=reached, set=names)
            queue_notices(team, rec, a)
    finally:
        for rec, _ in members:
            team.save_wo(rec)
    first = members[0][0]
    entry = queue_entry(a.wo, first["tip"], base, zones, queued, [(rec["wo"], rec["tip"]) for rec, _ in members])
    with Lock(team):
        requests = queue_stage3(team, [rec for rec, _ in members], entry, queued)
    for reviewer, items in requests.items():
        team.notify(reviewer, "REQUEST", stage3_request(team, items))
    print(f"queued {', '.join(names)}; reach: {', '.join(reached)}; Stage 2 passed; review: {entry['review']}")


def cmd_queue(team, a):
    prune_queue(team)
    es = entries(team)
    if not es:
        print("queue empty")
    for p in es:
        e = json.loads(p.read_text())
        print(f"{p.stem}  {'HELD ' if e.get('hold') else ''}{e['queued']}  {'  '.join(e['wos'])}")


def cmd_land_hold(team, a):
    p = entry_path(team, a.wo) or die(f"{a.wo} is not queued")
    e = json.loads(p.read_text())
    e["hold"] = not e.get("hold")
    p.write_text(json.dumps(e, indent=1) + "\n")
    print(f"{a.wo}: {'held' if e['hold'] else 'released'}")


def cmd_land_cancel(team, a):
    """Take a waiting entry out of the queue under the lock, not from under a running landing.
    Its work orders stay unlanded; each member's zone is told."""
    with Lock(team):
        p = entry_path(team, a.wo) or die(f"{a.wo} is not queued")
        e = json.loads(p.read_text())
        p.unlink()
    for w in e["wos"]:
        rec = team.wo(w)
        rec.pop("queued", None)
        team.save_wo(rec)
        team.notify(f"Coord-{rec['zone']}", "NOTE", f"{w} was taken out of the landing queue"
                    + (f": {a.reason}" if a.reason else "") + ". Its tree is as it was; queue it again with land.")
    print(f"cancelled: {', '.join(e['wos'])}")


def cmd_wo_retire(team, a):
    """Close one work order: its tree removed, its branch kept as refs/archive/wo/<wo>, its record kept as
    <wo>.retired.json. Refused while queued, and for a tree with uncommitted changes unless --force."""
    if not team.wo_file(a.wo).exists():
        # A tree with no record (a wo-cut that died before writing it): found by its folder, wo/<zone>/<wo>.
        found = [p for p in (team.root / "wo").glob(f"*/{a.wo}") if p.is_dir()]
        if len(found) != 1:
            die(f"unknown work order {a.wo}")
        team.save_wo({"wo": a.wo, "zone": found[0].parent.name, "tree": str(found[0]),
                      "branch": f"wo/{found[0].parent.name}/{a.wo}", "unregistered": True})
    rec = team.wo(a.wo)
    if entry_path(team, a.wo):
        die(f"{a.wo} is queued: land-cancel it first")
    tree = Path(rec["tree"])
    if tree.is_dir() and not (tree / ".git").exists():      # never became a git worktree: only a folder to remove
        if not a.force:
            die(f"{a.wo}: {tree} is not a git worktree; --force removes the folder")
        shutil.rmtree(tree)
    if tree.is_dir():
        dirty = out(tree, "status", "--porcelain", "--untracked-files=normal")   # a new file never added is work too
        if dirty and not a.force:
            die(f"{a.wo}: uncommitted changes in {tree}; commit them, or --force to drop them:\n{dirty[:800]}")
        merging = Path(out(tree, "rev-parse", "--path-format=absolute", "--git-dir"))
        for f in ("MERGE_HEAD", "REVERT_HEAD", "CHERRY_PICK_HEAD"):
            if (merging / f).exists():
                git(tree, {"MERGE_HEAD": "merge", "REVERT_HEAD": "revert", "CHERRY_PICK_HEAD": "cherry-pick"}[f],
                    "--abort", check=False)
    branch = rec.get("branch") or f"wo/{rec['zone']}/{a.wo}"
    tip = git(team.repo, "rev-parse", "-q", "--verify", f"refs/heads/{branch}", check=False).stdout.strip()
    if tip:
        git(team.repo, "update-ref", f"refs/archive/wo/{a.wo}", tip)
    if tree.is_dir():
        # --force for git only on ours: git's own refusal backs the check up (untracked files were once dropped)
        r = git(team.repo, "worktree", "remove", *(["--force", "--force"] if a.force else []), str(tree), check=False)
        if r.returncode:
            die(f"{a.wo}: git would not remove {tree}: {r.stderr.strip()[:400]}")
    git(team.repo, "worktree", "prune", check=False)
    if tip:
        git(team.repo, "branch", "-D", branch, check=False)
    rec["retired"] = now()
    if a.reason:
        rec["retired_reason"] = a.reason
    team.wo_file(a.wo).with_suffix(".retired.json").write_text(json.dumps(rec, indent=1) + "\n")
    team.wo_file(a.wo).unlink()
    print(f"retired {a.wo}" + (f" (branch kept as refs/archive/wo/{a.wo})" if tip else ""))


def cmd_land_next(team, a):
    if not team.wo_file(a.wo).exists():
        die(f"{a.wo} has landed or has no record: nothing to move")
    p = entry_path(team, a.wo) or die(f"{a.wo} is not queued")
    # Queue order is filename order and stamps start with the year; "0-<decreasing>" sorts first, latest first.
    p.rename(p.with_name(f"0-{10**13 - int(time.time() * 1000):013d}-{a.wo}.json"))
    print(f"{a.wo}: moved to the front")


# ---------------------------------------------------------------- landing

class Lock:
    def __init__(self, team):
        self.f = open(team.dir / "lock", "w")

    def __enter__(self):
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        fcntl.flock(self.f, fcntl.LOCK_UN)


def integration_holders(team):
    """Worktrees on landing or integration; only a lab team's base checkout may hold its single branch."""
    paths, cur = [], None
    refs = {f"branch refs/heads/{team.integration}", f"branch refs/heads/{team.landing}"}
    for line in out(team.repo, "worktree", "list", "--porcelain").splitlines():
        if line.startswith("worktree "):
            cur = line[9:]
        elif line in refs:
            paths.append(cur)
    return paths


def move_landing(team: Team, tip: str, old: str) -> bool:
    """Compare-and-move landing; a lab's checked-out base uses a fast-forward merge."""
    env = dict(os.environ, **{LAND_TOOL_ENV: "1"})
    if team.lab and any(Path(h).resolve() == team.repo for h in integration_holders(team)):
        result = git(team.repo, "merge", "--ff-only", "-q", tip, check=False, env=env)
    else:
        result = git(team.repo, "update-ref", f"refs/heads/{team.landing}", tip, old, check=False, env=env)
    if result.returncode:
        print(f"{team.landing} did not move: {result.stderr.strip()}; the entry stays queued", file=sys.stderr)
    return result.returncode == 0


def prepare(team, tree):
    """[land].prepare (e.g. `npm ci --prefer-offline --no-audit`): run in the tree when [land].prepare_key (a
    lockfile; default package-lock.json) changed since it last ran there, or nothing it makes exists yet."""
    cmd = team.c("prepare", None)
    if not cmd:
        return
    key = Path(tree) / team.c("prepare_key", "package-lock.json")
    import hashlib
    digest = hashlib.sha256(key.read_bytes()).hexdigest() if key.exists() else "none"
    mark = Path(out(tree, "rev-parse", "--path-format=absolute", "--git-dir")) / "codeteam-prepared"
    if mark.exists() and mark.read_text().strip() == digest:
        return
    r = subprocess.run(cmd, shell=True, cwd=tree, capture_output=True, text=True, env=team_env(team))
    if r.returncode:
        die(f"prepare failed in {tree}: {(r.stdout + r.stderr).strip()[-500:]}", 1)
    mark.write_text(digest + "\n")


def duplicate_rulings(tree):
    """Ruling numbers that head two entries of a RULINGS.md (the register is not union-merged, and a number is
    never used twice). An entry is a Markdown heading that starts with its number: '## R-12. ...'."""
    found = []
    for f in Path(tree).glob("**/DECISIONS.md"):       # the union-merged decision logs: '249. **...' entries
        if any(x in f.parts for x in (".git", "node_modules", "target", ".build", "_public")):
            continue
        try:
            nums = re.findall(r"^(\d+)\. \*\*", f.read_text(errors="replace"), re.M)
        except OSError:
            continue
        found += [f"{n} ({f.relative_to(tree)})" for n in sorted({n for n in nums if nums.count(n) > 1}, key=int)]
    for f in Path(tree).glob("**/RULINGS.md"):
        if any(x in f.parts for x in (".git", "node_modules", "target", ".build", "_public")):
            continue
        try:
            nums = re.findall(r"^#+\s*\**R-(\d+)\b", f.read_text(errors="replace"), re.M)
        except OSError:
            continue
        found += [f"R-{n} ({f.relative_to(tree)})" for n in sorted({n for n in nums if nums.count(n) > 1}, key=int)]
    return found


def records_pass(text):
    """True when the step's output names zone-test records and every one of them is a PASS (a gate once
    marked three zones FAIL whose zone-test runs each ended PASS with a record, at load ~100)."""
    recs = re.findall(r"zone-test: (PASS|FAIL) \(exit \d+\); record (\S+\.json)", text)
    if not recs or any(r != "PASS" for r, _ in recs):
        return False
    # Nothing may have failed after the last record (e.g. an `A && B` step whose B died before its record).
    after = text[text.rfind("; record "):].split("\n", 1)[1] if "\n" in text[text.rfind("; record "):] else ""
    if after.strip():
        return False                    # only blank lines may follow the last record
    for _, path in recs:
        try:
            if json.loads(Path(path).read_text()).get("result") != "PASS":
                return False
        except (OSError, ValueError):
            return False
    return True


# What stops a step that is the machine, not its tests, in the order they are judged: a full disk, as each tool
# says it (the C library's words for git, the shell and Swift, Python's [Errno 28], Rust's (os error 28), the
# errno's name), then an error from Xcode's shared compile cache, which a full disk can cause:
# a tagged error ("cannot create CAS filesystem ... [#CompilationCaching]"), a stored result that
# cannot be read back or replaced ("CAS error: unsupported compile result schema found", "failed to update cache: cache
# poisoned for ...").
STOPS = (("disk", re.compile(r"No space left on device|\[Errno 28\]|\(os error 28\)|\bENOSPC\b")),
         ("cache", re.compile(r"error: (?:[^\n]*\[#CompilationCaching\]|failed to update cache: cache poisoned|CAS error:)")))


def stopped_by(outcome: str, text: str) -> str | None:
    """What stopped a step that did not pass, when its output says it was the machine: "disk" or "cache". Only
    Stage 2 reads this (stage2_steps); the outcome itself stays PASS, FAIL or HUNG, which Stages 5 and 6 judge by."""
    if outcome == "PASS":
        return None
    return next((kind for kind, said in STOPS if said.search(text)), None)


def step_outcome(rc: int, text: str) -> str:
    # Nested zone-tool stderr can leak into the output, so use the last recognized HUNG, PASS, FAIL or BROKEN
    # verdict as the outer verdict rather than treating an earlier nested HUNG as decisive.
    last_verdict = None
    for line in text.splitlines():
        verdict = re.match(r"zone-test: (HUNG(?=$|:| \()|(?:PASS|FAIL|BROKEN)(?=$|[ :(]))", line.strip())
        if verdict:
            last_verdict = verdict[1]
    if rc == 124 or last_verdict == "HUNG":
        return "HUNG"
    return "PASS" if rc == 0 or records_pass(text) else "FAIL"


def step_results(tree: str | Path, steps: list[tuple[str, str]], env: dict[str, str], *,
                 concurrent: bool = True, on_result: Callable[[dict], None] | None = None,
                 keep_text: bool = False) -> list[dict]:
    """Run every step, concurrently by default, and time each through its output closing. keep_text keeps each
    step's whole output under "text" (Stage 5 saves a failing step's log from it). A step that did not pass and
    whose output says the machine stopped it carries "stopped_by"."""
    if not steps:
        return []
    procs = ((name, time.time(), subprocess.Popen(cmd, shell=True, cwd=tree, stdout=subprocess.PIPE,
                                                stderr=subprocess.STDOUT, text=True, env=env,
                                                start_new_session=True)) for name, cmd in steps)

    def finish(job):
        name, started, pr = job
        text = pr.communicate()[0] or ""
        seconds = time.time() - started
        outcome = step_outcome(pr.returncode, text)
        result = {"name": name, "outcome": outcome, "seconds": seconds, "tail": text.splitlines()[-30:]}
        if kind := stopped_by(outcome, text):
            result["stopped_by"] = kind
        return result | {"text": text} if keep_text else result

    # Compile batches run serially: zone-tool check saves one guard file per tree with a fixed temp name,
    # so two checks in the same tree race.
    if not concurrent:
        results = []
        for proc in procs:
            try:
                result = finish(proc)
            except BaseException:
                stop_steps([proc])
                raise
            if on_result is not None:
                on_result(result)
            results.append(result)
        return results
    procs = list(procs)
    # A slow first step must not delay reading or timing the other steps.
    with ThreadPoolExecutor(max_workers=len(procs)) as pool:
        futures = [pool.submit(finish, proc) for proc in procs]
        try:
            for future in as_completed(futures):
                if on_result is not None:
                    on_result(future.result())
        except BaseException:
            stop_steps(procs)       # else the pool's shutdown waits for every running step to end
            raise
        return [future.result() for future in futures]


def stop_steps(procs) -> None:
    """Stop the steps still running, each its whole process group (they start in their own sessions), when the run is
    interrupted: a land stopped by SIGTERM or Ctrl-C. A step's queued build job is the build
    queue's and is left to it."""
    for _, _, pr in procs:
        if pr.poll() is None:
            try:
                os.killpg(pr.pid, signal.SIGTERM)
            except OSError:
                pass


def step_lines(result: dict) -> list[str]:
    lines = [f"{result['outcome']} {result['name']} ({result['seconds']:.0f} s)"]
    if result["outcome"] != "PASS":
        lines.extend(f"  | {line}" for line in result["tail"])
    return lines


def run_steps(tree: str | Path, steps: list[tuple[str, str]], env: dict[str, str], *,
              concurrent: bool = True, on_result: Callable[[dict], None] | None = None) -> tuple[bool, list[str]]:
    """Run every step without a time limit, concurrently by default; exit 124 or a final HUNG verdict fails the batch."""
    results = step_results(tree, steps, env, concurrent=concurrent, on_result=on_result)
    return all(result["outcome"] == "PASS" for result in results), [line for result in results for line in step_lines(result)]


def lane_rec(team, zone):
    for lane in team.m.get("lanes", []):
        if (lane.get("name") or os.path.basename(lane.get("path", ""))) == zone:
            return lane
    return {}


def test_folder(tree: str | Path, folder: str, path_lane: bool) -> bool:
    if folder.strip("/") in ("", "."):
        return False                    # a whole-repo lane has no test folder of its own
    p = Path(tree) / folder
    if not p.is_dir():
        return False
    return path_lane or any((p / m).exists() for m in ("Package.swift", "Cargo.toml", "pyproject.toml", "tests", "Tests")) \
        or any(f"/{t}/" in f"/{folder}/" for t in ("tests", "Tests", "__tests__"))


def zone_tests(team, tree, zone, cls, group="unit"):
    """A zone's test steps: its lane's own `test` command when the manifest gives one, run through the build
    queue; otherwise one zone-test-one per folder of the zone that is a test root (a package, a crate, a tests folder,
    or the zone's own path). Owned files and plain folders (Makefile, scripts/, Hooks/) are walls, not tests: the type
    check covers them. (A tooling lane that owned ten such paths once had each run as a test.)"""
    lane = lane_rec(team, zone)
    if lane.get("test"):
        cmd = (f"{HERE / 'zone-tool'} job submit --class {cls} --wait 0 --key {shlex.quote(lane_test_key(zone, group))} -- "
               f"sh -c {shlex.quote(lane['test'])}")
        return [(f"tests {zone} (its lane's test)", cmd)]
    tmpl = team.c("test", "make --no-print-directory zone-test-one DIR={dir} CLASS={cls}")
    steps = []
    for d in test_folders(team, tree, zone, group):
        cmd = tmpl.replace("{dir}", shlex.quote(d)).replace("{zone}", shlex.quote(zone)).replace("{cls}", cls)
        steps.append((f"tests {zone} ({d})", cmd))          # plain replace: templates hold shell braces
    return steps


def test_folders(team: Team, tree: str | Path, zone: str, group: str) -> list[str]:
    lane = lane_rec(team, zone)
    own = lane.get("path", ".").strip("/") or "."
    skip = team.c("skip_tests", []) if group == "unit" else []   # integration folders participate in Stage 2

    def own_path(d):
        # Only the lane's own path is a test root by being its path; an owned folder (e.g. docs/specs/acme-mgr)
        # needs a package or a tests folder like any other.
        return "glob" in lane or (own != "." and d.strip("/") == own)
    return [d for d in team.zones.get(zone, []) if test_folder(tree, d, own_path(d))
            and not any(fnmatch.fnmatch(d.strip("/"), g.strip("/")) for g in skip)]


def team_env(team, group="unit"):
    """The team environment, explicit test group and build-queue hang settings. None leaves the suite to choose its group."""
    # Set and empty defeats make's ?= timeout/cache defaults; a team's explicit [env] flags still take precedence.
    env = dict(os.environ, ZONE_TEST_ONE_FLAGS="", ZONE_TEST_FLAGS="")
    # {root} and {home} as v1 expands them for sessions (an env value of "{root}/acme/current" once reached its
    # gate unexpanded, and 344 tests errored on the literal path)
    explicit = team.m.get("env", {})
    env.update({k: os.path.expanduser(str(v).replace("{root}", str(team.root)).replace("{home}", str(team.root / "team")))
                for k, v in explicit.items()})
    # [land]'s hang_min and hang_cpu_pct replace an inherited value but not one the team's [env] names itself.
    env.update({k: v for k, v in hang_settings(team.cfg).items() if k not in explicit})
    if "PYTHONDONTWRITEBYTECODE" not in explicit:
        # The landing tool's trees outlive a run: a bytecode cache one run writes, a later test that reads the tree
        # finds.
        env["PYTHONDONTWRITEBYTECODE"] = "1"
    if group:
        env["GROUP"] = env["CODETEAM_TEST_GROUP"] = group
    else:
        env.pop("GROUP", None)
        env.pop("CODETEAM_TEST_GROUP", None)
    env.update({"MAKEFILES": str(HERE.parent / "zone" / "zone.mk"), "CODETEAM_HOME": str(HERE.parent),
                "ZONE_JOB_WAIT": "0",           # the gate waits for its queued tests however long (0: no limit)
                "ZONE_CHECK": "0", "CODETEAM_LANDING": "1", "CODETEAM_MANIFEST": str(team.manifest)})
    if "TMPDIR" not in team.m.get("env", {}):     # like an agent's scratchpad: tests may refuse /var/folders
        tmp = team.dir / "tmp"
        if not tmp.is_dir():
            tmp.mkdir(parents=True, exist_ok=True)
            subprocess.run(["tmutil", "addexclusion", str(tmp)], capture_output=True)
        env["TMPDIR"] = f"{tmp}/"
    return env


def default_check(lt):
    p = Path(lt)
    if run(lt, "make", "-n", "check", check=False).returncode == 0:
        return "make --no-print-directory check"
    if (p / "Cargo.toml").exists():
        return "cargo check --workspace --all-targets"
    if (p / "Package.swift").exists():
        return "swift build --build-tests"
    if list(p.glob("**/*.py"))[:1]:
        return f"{HERE / 'py-syntax-check'}"
    return ""


# ---------------------------------------------------------------- review
# Stage 3 reviews work-order commits before landing; Nagatha writes tests in feature rounds after landing.

FINDING_KINDS = ("spec", "architecture", "boundary", "layer", "security", "test", "comment", "other")


def ra(team):
    """Feature review settings and the window for the first-time landing report."""
    c = team.cfg.get("review_after") or {}
    return {"enabled": bool(c.get("enabled", True)), "first_time_days": float(c.get("first_time_days", 7)),
            "feature_wait_hours": float(c.get("feature_wait_hours", 4)), "owners": c.get("owners")}


def owners(team):
    """Feature test writers present on the team; the guard and Perkins review before landing."""
    names = {x.get("name") for x in team.m.get("assistants", [])}
    want = ra(team)["owners"] or ["Nagatha"]
    guard = team.c("kong", team.m.get("guard", "Kong"))
    return [o for o in want if o not in (guard, "Perkins") and o in names]


def safe(name):
    return re.sub(r"[^A-Za-z0-9._-]", "_", name)


def feature_of(rec):
    """A work order's feature; one with no tag is a feature of one."""
    return rec.get("feature") or rec["wo"]


def tag_wo(team, rec, feature, fixes):
    if feature:
        if not re.fullmatch(r"[A-Za-z0-9._-]+", feature):
            die(f"feature name {feature!r}: letters, digits, '.', '_' and '-' only")
        rec["feature"] = feature
        with Lock(team):
            fr = load_feature(team, feature)
            fr["tagged"] = True
            save_feature(team, fr)
    for fid in fixes or []:
        if not find_finding(team, fid):
            die(f"--fixes {fid}: no such finding (codeteam-land {team.manifest} findings)")
        rec["fixes"] = sorted(set(rec.get("fixes", [])) | {fid})


# features: land/features/<feature>.json

def feature_path(team, f):
    return team.dir / "features" / f"{safe(f)}.json"


def load_feature(team, f):
    try:
        return json.loads(feature_path(team, f).read_text())
    except (OSError, ValueError):
        return {"feature": f, "tagged": False, "done": False, "landed": [], "rounds": []}


def save_feature(team, fr):
    p = feature_path(team, fr["feature"])
    p.parent.mkdir(exist_ok=True)
    p.write_text(json.dumps(fr, indent=1) + "\n")


def open_tagged(team, f):
    out_ = []
    for p in (team.dir / "wo").glob("*.json"):
        if p.name.endswith((".landed.json", ".retired.json")):
            continue
        try:
            if json.loads(p.read_text()).get("feature") == f:
                out_.append(p.stem)
        except ValueError:
            pass
    return out_


def unreviewed(fr):
    done = {w for r in fr["rounds"] for w in r["wos"]}
    return [x for x in fr["landed"] if x["wo"] not in done]


def review_records(team: Team) -> dict[str, dict]:
    return {r["wo"]: r for p in sorted((team.dir / "reviews").glob("*.json"))
            for r in [json.loads(p.read_text())] if r.get("stage") == 3}


def read_landing_rows(team: Team) -> list[dict]:
    p = team.dir / "landed.log"
    return [json.loads(line) for line in p.read_text().splitlines() if line.strip()] if p.exists() else []


def set_inner_commits(team: Team) -> set[str]:
    """The landing commits of a --with set's members before its last. Stage 4 merges a set member by member and moves
    landing once, to the last, so only that commit holds the whole set; Stages 6 and 7 never stop at the others
    (Stage 7 once promoted a library's changed API without its app's caller change). A row
    names its set; an older one is read from its work order's landed record."""
    groups: dict[tuple[str, ...], list[str]] = {}
    for row in read_landing_rows(team):
        if not row.get("hash") or not row.get("wos"):
            continue
        members = row.get("set")
        if not members:
            try:
                members = (landed_rec(team, row["wos"][0]) or {}).get("set")
            except (OSError, ValueError):
                members = None
        if members and len(members) > 1:
            groups.setdefault(tuple(sorted(members)), []).append(row["hash"])
    return {commit for commits in groups.values() for commit in commits[:-1]}


LANDED_ARCHIVES = "refs/archive/landing*"      # a copy of landing kept before a history rewrite is landed work too


def landed_refs(team: Team, cwd) -> list[str]:
    """landing, integration and every archived copy of landing: whatever is reachable from them is not a work
    order's own (when landing's messages are rewritten, so trees cut before the rewrite hold the old
    hashes, which only the archive keeps)."""
    archived = []
    try:
        found = git(cwd, "for-each-ref", "--format=%(refname)", LANDED_ARCHIVES, check=False)
        if found.returncode == 0:
            archived = (getattr(found, "stdout", "") or "").split()
    except OSError:                     # no such folder: nothing archived to exclude
        pass
    return [f"refs/heads/{team.landing}", f"refs/heads/{team.integration}", *archived]


def own_base(team: Team, tree, tip: str = "HEAD") -> str:
    """The newest commit the tree shares with landed work: everything after it is the work order's own. A tree cut
    before a team's move holds the old integration (now landing or its archive), and a fix tree may have merged
    landing: both are measured from what they hold, never from today's integration."""
    best = None
    try:
        for ref in landed_refs(team, tree):
            found = git(tree, "merge-base", tip, ref, check=False)
            commit = (getattr(found, "stdout", "") or "").strip()
            if found.returncode or not commit:
                continue
            if best is None or git(tree, "merge-base", "--is-ancestor", best, commit, check=False).returncode == 0:
                best = commit
    except OSError:                     # no tree to read: measure from integration, as before this fix
        return team.integration
    return best or team.integration


def review_range(team: Team, tip: str, seen: list[str]) -> list[str]:
    return out(team.repo, "rev-list", "--no-merges", tip, "--not", *landed_refs(team, team.repo), *seen).splitlines()


def tool_made_reason(rec: dict, messages: list[str]) -> str | None:
    if rec.get("made_by") == "codeteam-land" and all(MADE_BY in message.splitlines() for message in messages):
        return "made by codeteam-land"
    return None


def security_files(patterns: list[str], files: list[str]) -> list[str]:
    return [file for file in files if any(fnmatch.fnmatch(file, pattern) for pattern in patterns)]


def stage3_reviewers(team: Team, files: list[str]) -> list[str]:
    reviewers = [team.c("kong", team.m.get("guard", "Kong"))]
    if any(a.get("name") == "Perkins" for a in team.m.get("assistants", [])) and security_files(team.c("security_paths", []), files):
        reviewers.append("Perkins")
    return list(dict.fromkeys(reviewers))


def review_files(team: Team, commits: list[str]) -> list[str]:
    return list(dict.fromkeys(file for commit in commits for file in
                             out(team.repo, "diff-tree", "--root", "--no-commit-id", "--name-only", "-r", commit).splitlines()))


def stage3_record(team: Team, rec: dict, members: list[dict] | None = None) -> dict:
    p = team.dir / "reviews" / f"{safe(rec['wo'])}.json"
    previous = json.loads(p.read_text()) if p.exists() else {}
    seen = previous.get("seen", {})
    commits = review_range(team, rec["tip"], [])
    made = tool_made_reason(rec, [out(team.repo, "show", "-s", "--format=%B", commit) for commit in commits])
    want = [] if made else stage3_reviewers(team, review_files(team, commits))
    want = list(dict.fromkeys([*want, *(name for name, result in previous.get("reviewers", {}).items() if result == "findings")]))
    ranges = reviewer_ranges(team, rec, previous, want, members)
    for reviewer in ranges:
        seen.setdefault(reviewer, [])
    return {"stage": 3, "wo": rec["wo"], "zone": rec["zone"], "feature": feature_of(rec), "tip": rec["tip"],
            "reviewers": {name: "pending" for name in ranges}, "commits": ranges, "seen": seen,
            "requested": now(), "state": "pending" if ranges else "land"}


def commit_times(team: Team, commits: list[str]) -> dict[str, int]:
    """Each commit's committer time, in seconds."""
    if not commits:
        return {}
    lines = out(team.repo, "show", "-s", "--format=%H %ct", *commits).split()
    return {lines[i]: int(lines[i + 1]) for i in range(0, len(lines) - 1, 2)}


def fix_answered(team: Team, finding: dict, rec: dict, members: list[dict]) -> bool:
    """A work order of the landing set that names the finding with --fixes has its own commit made after the finding.
    A --with partner's commit counts only where the finding's reviewer reviews the partner's files, so the reviewer
    sees the fix (a test fix carried in data's work order, tests/ being data's wall)."""
    try:
        when = dt.datetime.fromisoformat(finding["time"]).timestamp()
    except (KeyError, TypeError, ValueError):
        return False
    for member in members:
        if finding["id"] not in (member.get("fixes") or []):
            continue
        commits = review_range(team, member["tip"], [])
        later = [c for c, t in commit_times(team, commits).items() if t > when]
        if not later:
            continue
        if member["wo"] == rec["wo"]:
            return True
        reviewers = set(stage3_reviewers(team, review_files(team, later)))
        if {finding.get("by"), *finding.get("also", [])} <= reviewers:
            return True
    return False


def reviewer_ranges(team: Team, rec: dict, previous: dict, want: list[str],
                    members: list[dict] | None = None) -> dict[str, list[str]]:
    """Each reviewer's unseen commits of the work order. `members` is its landing set (itself alone by default)."""
    ranges = {}
    for reviewer in want:
        new = review_range(team, rec["tip"], previous.get("seen", {}).get(reviewer, []))
        had_findings = previous.get("reviewers", {}).get(reviewer) == "findings"
        if had_findings and not new:
            # Findings dropped with finding-drop (judged not real) hold nothing: with no finding on this work
            # order still open, it lands as it is.
            found = [f for f in all_findings(team) if rec["wo"] in f.get("wos", []) and f["state"] == "open"]
            if not found:
                continue
            if previous.get("tip") and previous["tip"] != rec["tip"]:
                # Only a merge since the findings (wo-pull brought promoted work that fixes them): the reviewer
                # sees the work order's own commits again at the new tip.
                new = review_range(team, rec["tip"], [])
            if not new:
                # A finding the set claims with --fixes and answered with a later commit holds nothing: the reviewer
                # has seen this work order's commits, and reviews a partner's with the set.
                ids = [f["id"] for f in found if not fix_answered(team, f, rec, members or [rec])]
                if not ids:
                    continue
                die(f"{rec['wo']}: nothing committed since findings by {reviewer}: {', '.join(ids)}. A fix committed "
                    "after a finding, in this work order or a --with partner, counts when land names it with --fixes",
                    GATE)
        if not new:
            continue
        if reviewer == "Perkins" and not had_findings and reviewer not in stage3_reviewers(team, review_files(team, new)):
            continue
        ranges[reviewer] = new
    return ranges


def queue_stage3(team: Team, recs: list[dict], entry: dict, queued: str) -> dict[str, list[dict]]:
    rows = [stage3_record(team, rec, members=recs) for rec in recs]
    if len(recs) > 1:
        # A --with set lands in one step (Stage 4), so a member is judged beside the others' commits: a docs member
        # describing a code member is true at the set's tip, not at landing.
        for rec, row in zip(recs, rows):
            row["with"] = [{"wo": o["wo"], "zone": o["zone"], "tip": o["tip"]} for o in recs if o is not rec]
    requests = {}
    for rec, row in zip(recs, rows):
        rec["queued"] = queued
        team.save_wo(rec)
        (team.dir / "reviews" / f"{safe(rec['wo'])}.json").write_text(json.dumps(row, indent=1) + "\n")
        for reviewer in row["reviewers"]:
            requests.setdefault(reviewer, []).append(dict(row, recipient=reviewer))
    entry["review"] = "pending" if requests else "land"
    (team.dir / "queue" / f"{time.strftime('%Y%m%d-%H%M%S')}-{entry['wo']}.json").write_text(json.dumps(entry, indent=1) + "\n")
    return requests


def stage3_request(team: Team, items: list[dict]) -> str:
    lines = []
    landed = landed_refs(team, team.repo)       # the same exclusions as review_range
    for row in items:
        seen = row["seen"].get(row["recipient"], [])
        command = shlex.join(["git", "-C", str(team.repo), "log", "--no-merges", "-p", row["tip"], "--not",
                              *landed, *seen])
        line = (f"{row['wo']} (zone {row['zone']}, feature {row['feature']}): {command}; "
                f"codeteam-land {team.manifest} reviewed {row['wo']}")
        if row.get("with"):
            others = ", ".join(f"{o['wo']} (zone {o['zone']}, tip {o['tip'][:10]})" for o in row["with"])
            whole = shlex.join(["git", "-C", str(team.repo), "log", "--no-merges", "-p", row["tip"],
                                *(o["tip"] for o in row["with"]), "--not", *landed])
            line += (f". It lands in one step with {others} (land --with): judge what it says about their code at "
                     f"their tips, not at landing. The set's commits together: {whole}. A finding may name any member "
                     f"of the set, with that member's --wo and --zone; `reviewed {row['wo']}` then sends the whole set "
                     "back. A member with no review line of its own here holds its verdict already and takes no "
                     "`reviewed`")
        lines.append(line)
    # Spec v5.4 Stage 3 reviews a work order's own commits. A two-dot diff of its tip against landing also shows, as
    # reverted, whatever landed after the tree's last merge, which the landing merge keeps (2026-11-12:
    # a docs work order bounced for reverting a file it never touched).
    return ("Stage 3 review before landing: " + "; ".join(lines) +
            f". Judge each work order by these commits, its own changes. For a net view use three dots, "
            f"`git diff {team.landing}...<tip>` (from its merge base), never a two-dot diff of the tip against "
            f"{team.landing}: work landed after the tree's last merge shows there as reverted, and landing keeps it."
            f" Findings: codeteam-land {team.manifest} finding <feature> --wo <wo> --zone <zone> "
            "--where <file:line> --severity 1|2|3 --kind <kind> --what <text>. "
            "Then run `reviewed` for each work order in every case: with findings filed it sends them to the zone's "
            "coordinator, with none the work order lands. The lead fixes findings in the same tree and runs land again.")


def stage3_verdict(team: Team, path: Path, row: dict, reviewer: str) -> None:
    def filed(wo: str) -> list[dict]:
        return [f for f in all_findings(team) if reviewer_finding(f, wo, [reviewer])
                and f["state"] != "dropped" and f["time"] >= row["requested"]]
    findings = filed(row["wo"])
    # Findings this reviewer filed on another member of the set during this review (finding_work_orders).
    partners = {o["wo"]: found for o in row.get("with", []) if (found := filed(o["wo"]))}
    row["seen"].setdefault(reviewer, []).append(row["tip"])
    row["reviewers"][reviewer] = "findings" if findings else "pass"
    if findings:
        row["state"] = "findings"
        save_record(path, row)
        send_review_back(team, row, findings, reviewer)
    elif all(value == "pass" for value in row["reviewers"].values()):
        accept_stage3(team, row)
    save_record(path, row)
    for wo, found in partners.items():
        partner_review_back(team, wo, found, reviewer, row["wo"])
    if row["state"] == "land" and not partners:
        release_reviewed_entry(team, row["wo"])
    print(f"{row['wo']}: {row['reviewers'][reviewer]} by {reviewer}; {review_entry_notice(team, row['wo'])}"
          + (f"; the set went back with findings on {', '.join(partners)}" if partners else ""))


def partner_review_back(team: Team, wo: str, findings: list[dict], reviewer: str, via: str) -> None:
    """A set member's findings, filed while the reviewer judged `via`: the member's own record says findings, so its
    next land needs a fix (reviewer_ranges), and the set leaves the queue as for findings on `via` itself."""
    path = team.dir / "reviews" / f"{safe(wo)}.json"
    other = json.loads(path.read_text())
    other["reviewers"][reviewer] = "findings"
    other["state"] = "findings"
    seen = other.setdefault("seen", {}).setdefault(reviewer, [])
    if other["tip"] not in seen:
        seen.append(other["tip"])
    save_record(path, other)
    send_review_back(team, other, findings, reviewer, via=via)


def reviewer_finding(finding: dict, wo: str, reviewers: Iterable[str]) -> bool:
    return wo in finding.get("wos", []) and any(
        finding.get("by") == reviewer or reviewer in finding.get("also", []) for reviewer in reviewers)


def accept_stage3(team: Team, row: dict) -> None:
    row["state"] = "land"
    for finding in list(all_findings(team)):
        if finding["state"] == "open" and "test" not in finding and reviewer_finding(finding, row["wo"], row["seen"]):
            update_finding(team, finding["id"], state="closed", reason="fixed before landing", closed=now())


def release_reviewed_entry(team: Team, wo: str) -> None:
    p = entry_path(team, wo)
    if p is None:
        return
    entry = json.loads(p.read_text())
    records = review_records(team)
    if all(records.get(member, {}).get("state") == "land" for member in entry["wos"]):
        entry["review"] = "land"
        p.write_text(json.dumps(entry, indent=1) + "\n")


def send_review_back(team: Team, row: dict, findings: list[dict], reviewer: str, via: str | None = None) -> None:
    p = entry_path(team, row["wo"])
    wos = json.loads(p.read_text())["wos"] if p else [row["wo"]]
    if p:
        p.unlink()
    for wo in wos:
        rec = team.wo(wo)
        rec.pop("queued", None)
        team.save_wo(rec)
    to = team.c("orchestrator", "orc") if row["zone"] == "orc" else f"Coord-{row['zone']}"
    text = "; ".join(f"{f['id']} {f['where']}: {f['what']}" for f in findings)
    team.notify(to, "REQUEST", f"{row['wo']}: Stage 3 findings by {reviewer}: {text}. "
                + (f"Its --with set went back at the verdict on {via}. " if via else "")
                + "Nothing landed. Fix it in the same tree and run land again.")
    team.log({"time": now(), "wos": wos, "result": "review findings", "findings": [f["id"] for f in findings]})


def after_landing(team, recs):
    """Close named fixes and register feature rounds for test-writing work after landing."""
    for rec in recs:
        for fid in rec.get("fixes") or []:
            update_finding(team, fid, state="closed", fixed_by=rec["wo"], closed=now())
    if not ra(team)["enabled"]:
        return
    for rec in recs:
        if rec.get("made_by") == "codeteam-land":
            continue
        fr = load_feature(team, feature_of(rec))
        fr["landed"].append({"wo": rec["wo"], "zone": rec["zone"], "hash": rec.get("landed_commit"), "time": now(),
                             "review": "before"})
        save_feature(team, fr)
    features_due(team)


def features_due_locked(team: Team, force: str | None = None) -> list:
    with Lock(team):
        return features_due(team, force=force)


def features_due(team, force=None):
    """Start a review round for every feature that is complete: a feature of one at once; a tagged feature when
    feature-done was said and none of its work orders is open, or none is open and its last landing is older than
    feature_wait_hours. One REQUEST per owner for all features started together."""
    if not ra(team)["enabled"]:
        return []
    wait = ra(team)["feature_wait_hours"] * 3600
    started = []
    for p in sorted((team.dir / "features").glob("*.json")):
        try:
            fr = json.loads(p.read_text())
        except ValueError:
            continue
        todo = unreviewed(fr)
        if not todo:
            continue
        if fr.get("tagged") and fr["feature"] != force:
            if open_tagged(team, fr["feature"]):
                continue
            last = max(dt.datetime.fromisoformat(x["time"]).timestamp() for x in todo)
            if not fr.get("done") and time.time() - last < wait:
                continue
        rnd = {"n": len(fr["rounds"]) + 1, "time": now(), "wos": [x["wo"] for x in todo], "reviewed": {}}
        fr["rounds"].append(rnd)
        save_feature(team, fr)
        started.append((fr, rnd, todo))
    if started:
        notify_owners(team, started)
    return started


def notify_owners(team, started):
    m = team.manifest

    def text(sel):
        lines = []
        for fr, rnd, todo in sel:
            wos = "; ".join(f"{x['wo']} (zone {x['zone']}, {str(x['hash'] or '')[:10]}, "
                            f"passed integration check)" for x in todo)
            lines.append(f"feature {fr['feature']} round {rnd['n']}: {wos}; findings file {findings_path(team, fr['feature'])}")
        return (f"Review after landing ({len(sel)} feature{'s' if len(sel) > 1 else ''}): " + " | ".join(lines) +
                f". Diff of one work order: git -C {team.repo} log --no-merges -p <base>..refs/landed/<wo>. "
                "Read the findings file first; to agree with an "
                f"entry: codeteam-land {m} finding <feature> --same-as <id>. New finding: codeteam-land {m} finding <feature> "
                f"--wo <wo> [--wo <wo2>] --zone <zone> --where <file:line> --severity 1|2|3 --kind <kind> --what <text> "
                f"[--belongs <where it belongs>]. When done with a feature: codeteam-land {m} reviewed <feature>.")

    for o in owners(team):
        extra = ""
        if o == "Nagatha":
            extra = (f" Layer check: codeteam-land {m} layers --feature <feature>. Validation results by commit: "
                     f"{team.dir / 'validation-results.jsonl'}.")
        team.notify(o, "REQUEST", text(started) + extra)


# findings: land/findings/<feature>.json, a list of entries

def findings_path(team, f):
    return team.dir / "findings" / f"{safe(f)}.json"


class FindingsLock:
    def __init__(self, team):
        (team.dir / "findings").mkdir(exist_ok=True)
        self.p = team.dir / "findings" / ".lock"

    def __enter__(self):
        self.fd = os.open(self.p, os.O_RDWR | os.O_CREAT, 0o644)
        fcntl.flock(self.fd, fcntl.LOCK_EX)

    def __exit__(self, *a):
        os.close(self.fd)


def load_findings(team, f):
    try:
        return json.loads(findings_path(team, f).read_text())
    except (OSError, ValueError):
        return []


def save_findings(team, f, items):
    p = findings_path(team, f)
    tmp = p.with_name(f".{p.name}.tmp")
    tmp.write_text(json.dumps(items, indent=1) + "\n")
    os.replace(tmp, p)


def find_finding(team, fid):
    f = fid.rsplit("#", 1)[0]
    return next((x for x in load_findings(team, f) if x["id"] == fid), None)


def update_finding(team, fid, **fields):
    f = fid.rsplit("#", 1)[0]
    with FindingsLock(team):
        items = load_findings(team, f)
        for x in items:
            if x["id"] == fid:
                x.update(fields)
        save_findings(team, f, items)


def landed_rec(team, wo):
    p = team.dir / "wo" / f"{wo}.landed.json"
    return json.loads(p.read_text()) if p.exists() else None


def validate_finding(team: Team, a, in_feature: set[str], *, backlog: bool = False) -> None:
    missing = [k for k in ("zone", "where", "severity", "kind", "what") if not getattr(a, k)]
    if not a.wo and not backlog:
        missing.append("wo")
    if missing:
        die("finding needs " + ", ".join(f"--{k}" for k in missing))
    bad = [w for w in a.wo if w not in in_feature]
    if bad:
        die(f"{', '.join(bad)}: not landed work orders of feature {a.feature} ({', '.join(sorted(in_feature))}); "
            "every finding names the work orders it is about")
    if a.zone not in team.zones and a.zone != "orc":
        die(f"unknown zone {a.zone}")


def agree_finding(team: Team, feature: str, fid: str, me: str) -> None:
    with FindingsLock(team):
        items = load_findings(team, feature)
        x = next((x for x in items if x["id"] == fid), None) or die(f"no finding {fid} in {feature}")
        if me != x["by"] and me not in x["also"]:
            x["also"].append(me)
        save_findings(team, feature, items)
    print(f"{fid}: {me} agrees (no new request)")


def notify_finding(team: Team, a, fid: str, me: str) -> None:
    guard = team.c("kong", team.m.get("guard", "Kong"))
    to = team.c("orchestrator", "orc")
    route = f"Route to Coord-{a.zone} as a work order"
    if me == guard:
        to = to if a.zone == "orc" else f"Coord-{a.zone}"
        route = "Route as a work order"
    team.notify(to, "REQUEST",
                f"FIX-FORWARD {fid} | zone {a.zone} | work orders {', '.join(a.wo)} | sev {a.severity} {a.kind} | "
                f"{a.where}: {a.what}" + (f" | belongs: {a.belongs}" if a.belongs else "") +
                f" | from {me}. {route}; it lands with codeteam-land {team.manifest} land <wo> --fixes {fid}. "
                f"Not real: codeteam-land {team.manifest} finding-drop {fid} --reason <why>.")


def cmd_finding(team, a):
    """Store Stage 3 findings silently until verdict; route backlog and feature findings immediately."""
    me = os.environ.get("CODETEAM_SESSION") or die("set CODETEAM_SESSION to your session name")
    in_feature, pending = finding_work_orders(team, a.feature, a.wo or [], me)
    backlog = backlog_finding(team, a, me)
    if not in_feature and not backlog:
        die(f"feature {a.feature} has no work orders under review (codeteam-land {team.manifest} findings)")
    if a.same_as:
        agree_finding(team, a.feature, a.same_as, me)
        return
    validate_finding(team, a, in_feature, backlog=backlog)
    stage3 = bool(a.wo) and all(wo in pending for wo in a.wo)
    with FindingsLock(team):
        items = load_findings(team, a.feature)
        fid = f"{a.feature}#{len(items) + 1}"
        x = {"id": fid, "time": now(), "by": me, "also": [], "feature": a.feature, "wos": a.wo, "zone": a.zone,
             "where": a.where, "severity": a.severity, "kind": a.kind, "what": a.what, "belongs": a.belongs,
             "state": "open", "fixed_by": None, "closed": None, "reason": None}
        items.append(x)
        save_findings(team, a.feature, items)
    if not stage3:
        notify_finding(team, a, fid, me)
    print(fid)


def finding_work_orders(team: Team, feature: str, wos: list[str],
                        me: str | None = None) -> tuple[set[str], dict[str, dict]]:
    in_feature = {item["wo"] for item in load_feature(team, feature)["landed"]}
    in_feature.update(wo for wo in wos if (rec := landed_rec(team, wo)) and feature_of(rec) == feature)
    rows = review_records(team)
    pending = {wo: row for wo, row in rows.items() if row["state"] == "pending" and row.get("feature", wo) == feature}
    if me:
        # A --with set lands in one step, and its Stage 3 request has the set's commits read together. While the filer
        # still owes a verdict on one member, a finding may name any member, and that verdict sends the whole set
        # back (Kong once found a member's classifier wrong, finding refused it, and the set landed).
        for path in entries(team):
            members = json.loads(path.read_text())["wos"]
            if any(rows.get(m, {}).get("state") == "pending" and rows[m]["reviewers"].get(me) == "pending"
                   for m in members):
                pending.update({m: rows[m] for m in members if m in rows and rows[m].get("feature", m) == feature})
    return in_feature | pending.keys(), pending


def backlog_finding(team: Team, a, me: str) -> bool:
    if not a.feature.startswith("v54-backlog-"):
        return False
    zone = a.feature.removeprefix("v54-backlog-")
    p = team.dir / "reviews" / f"backlog-{safe(zone)}.json"
    if not p.exists() or me != team.c("kong", team.m.get("guard", "Kong")):
        return False
    if not a.wo:
        a.wo = []
    if not a.zone:
        a.zone = zone
    return True


def all_findings(team):
    for p in sorted((team.dir / "findings").glob("*.json")):
        try:
            yield from json.loads(p.read_text())
        except ValueError:
            pass


def cmd_findings(team, a):
    items = load_findings(team, a.feature) if a.feature else list(all_findings(team))
    if a.open:
        items = [x for x in items if x["state"] == "open"]
    if a.zone:
        items = [x for x in items if x["zone"] == a.zone]
    if a.json:
        print(json.dumps(items, indent=1))
        return
    for x in items:
        print(f"{x['id']}  {x['state']}  sev {x['severity']} {x['kind']}  zone {x['zone']}  wos {','.join(x['wos'])}  "
              f"by {'+'.join([x['by'], *x['also']])}  {x['where']}: {x['what'][:100]}"
              + (f"  fixed by {x['fixed_by']}" if x.get("fixed_by") else ""))
    if not items:
        print("no findings")


def cmd_finding_drop(team, a):
    find_finding(team, a.id) or die(f"no finding {a.id}")
    update_finding(team, a.id, state="dropped", reason=a.reason, closed=now(),
                   dropped_by=os.environ.get("CODETEAM_SESSION", "?"))
    print(f"{a.id}: dropped")


def cmd_wo_tag(team, a):
    rec = team.wo(a.wo)
    tag_wo(team, rec, a.feature, a.fixes)
    team.save_wo(rec)
    print(f"{a.wo}: feature {feature_of(rec)}" + (f"; fixes {', '.join(rec['fixes'])}" if rec.get("fixes") else ""))


def cmd_wo_hold(team, a):
    """Mark an open work order as held on purpose, with the ruling or reason, so patrol stops calling it stalled
    (2026-11-12: a work order with a major change, kept on its branch until the owner decides, woke the orchestrator
    every patrol round). --release lifts the mark. With no work order:
    list the held ones. The mark changes nothing else: the work order can still be pulled, landed or retired."""
    if not a.wo:
        for f in sorted((team.dir / "wo").glob("*.json")):
            if f.name.endswith((".landed.json", ".retired.json")):
                continue
            try:
                rec = json.loads(f.read_text())
            except (OSError, ValueError):
                continue
            if rec.get("held"):
                print(f"{rec['wo']}  {rec['zone']}  held {rec['held']['at']}: {rec['held']['because']}")
        return
    rec = team.wo(a.wo)
    if a.release:
        if not rec.pop("held", None):
            die(f"{a.wo} is not held", 2)
        team.save_wo(rec)
        print(f"{a.wo}: released; patrol reports it again when it stalls")
        return
    because = (a.because or "").strip() or die("say why with --because (the ruling numbers, or what it waits for)", 2)
    rec["held"] = {"because": because, "at": now()}
    team.save_wo(rec)
    print(f"{a.wo}: held ({because}); patrol skips it until wo-hold {a.wo} --release")


def cmd_feature_done(team, a):
    with Lock(team):
        fr = load_feature(team, a.feature)
        fr["done"] = True
        fr["tagged"] = True
        save_feature(team, fr)
    left = open_tagged(team, a.feature)
    started = [] if left else features_due_locked(team, force=a.feature)
    print(f"feature {a.feature}: done" + (f"; review starts when {', '.join(left)} land" if left else
                                         "; review started" if started else "; nothing landed to review"))


def guard_reviewed(team: Team, name: str, reviewer: str) -> None:
    """Accept a pending Stage 3 verdict, or the guard's per-zone move-over backlog verdict."""
    with Lock(team):
        p = team.dir / "reviews" / f"{safe(name)}.json"
        row = json.loads(p.read_text()) if p.exists() else {}
        if row.get("stage") == 3 and row.get("state") == "pending" and row["reviewers"].get(reviewer) == "pending":
            stage3_verdict(team, p, row, reviewer)
            return
        guard = team.c("kong", team.m.get("guard", "Kong"))
        if reviewer == guard and name.startswith("backlog-") and row.get("state") == "pending" and "to" in row:
            row.update(state="reviewed", reviewed_at=row["to"], by=reviewer, time=now())
            p.write_text(json.dumps(row, indent=1) + "\n")
            print(f"{name}: reviewed at {row['to']} by {reviewer}")
            return
        die(f"{name} is not waiting for a Stage 3 review by {reviewer}")


def guard_ledger(team: Team) -> str | None:
    guard = team.c("kong", team.m.get("guard", "Kong"))
    return team.c("guard_ledger", None) or next(
        (str(d) for d in (team.root / "exchange" / guard / "ledger", team.root / "design" / guard / "ledger") if d.exists()), None)


def review_entry_notice(team: Team, wo: str) -> str:
    ledger = guard_ledger(team)
    if not ledger:
        return "no guard ledger found"
    if Path(os.path.expanduser(ledger), "changelog", f"{wo}.md").exists():
        # The line is published with the documents, so the team's after step judges it (a line naming
        # `docs/_public` failed `make public-docs` and held every stamp).
        after = (team.cfg.get("docs") or {}).get("after")
        return ("your changelog line is the entry when a promotion stamps its documents"
                + (f"; it is published with them and must pass `{after}`" if after else ""))
    return (f"no changelog/{wo}.md in {ledger}: a promotion that stamps its documents uses "
            "the work order's first commit subject")


def cmd_reviewed(team, a):
    """Stage 3 reviewers finish work orders; the guard finishes backlogs; feature owners finish rounds."""
    me = os.environ.get("CODETEAM_SESSION") or die("set CODETEAM_SESSION to your session name")
    p = team.dir / "reviews" / f"{safe(a.feature)}.json"
    row = json.loads(p.read_text()) if p.exists() else {}
    if me == team.c("kong", team.m.get("guard", "Kong")) or (row.get("stage") == 3 and me in row["reviewers"]):
        guard_reviewed(team, a.feature, me)
        return
    if me not in owners(team):
        die(f"{me} is not a feature reviewer")
    with Lock(team):
        fr = load_feature(team, a.feature)
        if not fr["rounds"]:
            die(f"feature {a.feature} has no review round")
        rnd = fr["rounds"][-1]
        rnd["reviewed"][me] = now()
        save_feature(team, fr)
    print(f"feature {a.feature} round {rnd['n']}: reviewed by {me}")


def cmd_first_time(team, a):
    """Report prior recorded gate failures and findings or reverts within N days of landing; otherwise wait N days."""
    days = a.days if a.days is not None else ra(team)["first_time_days"]
    rows = [json.loads(l) for l in (team.dir / "landed.log").read_text().splitlines() if l.strip()]
    finds = list(all_findings(team))
    res = []
    for r in rows:
        if not r.get("hash") or len(r.get("wos", [])) != 1 or r["wos"][0].startswith(("docs-", "revert-")):
            continue
        w = r["wos"][0]
        t = dt.datetime.fromisoformat(r["time"]).timestamp()
        if a.since and r["time"] < a.since:
            continue
        before = [x for x in rows if x.get("wos") == [w] and x.get("result") and x["time"] < r["time"]]
        gate = sum(x["result"] == "the gate failed" for x in before)
        fs = [x["id"] for x in finds if w in x["wos"] and x["state"] != "dropped"
              and dt.datetime.fromisoformat(x["time"]).timestamp() - t <= days * 86400]
        rev = [x for x in rows if x.get("hash") and x.get("wos") == [f"revert-{w}"]
               and dt.datetime.fromisoformat(x["time"]).timestamp() - t <= days * 86400]
        bad = gate or fs or rev
        state = "no" if bad else "pending" if time.time() - t < days * 86400 else "yes"
        res.append({"wo": w, "zone": r.get("zone"), "feature": r.get("feature") or w, "landed": r["time"],
                    "review": r.get("review"), "gate_failures": gate, "findings": fs,
                    "reverted": bool(rev), "first_time": state})
    if a.json:
        print(json.dumps(res, indent=1))
        return
    for x in res:
        print(f"{x['first_time']:7} {x['wo']}  zone {x['zone']}  landed {x['landed'][:16]}  review {x['review']}  "
              f"gate {x['gate_failures']} findings {len(x['findings'])} reverted {x['reverted']}")


SWIFT_PATH_DEP = re.compile(r'\.package\s*\(\s*(?:name:\s*"[^"]*"\s*,\s*)?path:\s*"([^"]+)"')
CARGO_PATH_DEP = re.compile(r'path\s*=\s*"([^"]+)"')


def layer_violations(team, ref):
    """[layers] order (lowest first, folders whose subfolders are packages): every path dependency from a package to
    a package in a higher layer, from Package.swift and Cargo.toml at ref."""
    order = [x.strip("/") for x in (team.m.get("layers") or {}).get("order", [])]
    files = out(team.repo, "ls-tree", "-r", "--name-only", ref).splitlines()
    mans = [f for f in files if f.endswith(("/Package.swift", "/Cargo.toml"))
            and not any(seg in f for seg in ("/.build/", "/checkouts/", "/target/", "/cargo-target/"))]

    def where(path):
        for i, L in enumerate(order):
            if path.startswith(L + "/"):
                rest = path[len(L) + 1:].split("/")
                return i, f"{L}/{rest[0]}"
        return None, None

    found = []
    for mf in mans:
        li, pkg = where(mf)
        if li is None:
            continue
        text = git(team.repo, "show", f"{ref}:{mf}", check=False).stdout
        pat = SWIFT_PATH_DEP if mf.endswith(".swift") else CARGO_PATH_DEP
        for n, line in enumerate(text.splitlines(), 1):
            if line.lstrip().startswith(("//", "#")):
                continue
            for dep in pat.findall(line):
                target = os.path.normpath(os.path.join(os.path.dirname(mf), dep))
                lj, tpkg = where(target)
                if lj is not None and lj > li and tpkg != pkg:
                    found.append({"from": pkg, "from_layer": order[li], "to": tpkg, "to_layer": order[lj],
                                  "manifest": f"{mf}:{n}"})
    return order, found


def cmd_layers(team, a):
    ref = a.ref or team.landing
    order, found = layer_violations(team, ref)
    if a.feature:
        ref, found = feature_layer_changes(team, a.feature, ref, found)
    if not order:
        print(f"no [layers] order in {team.manifest}: nothing to check")
        return
    if a.json:
        print(json.dumps({"ref": out(team.repo, "rev-parse", ref), "order": order, "violations": found}, indent=1))
    else:
        for v in found:
            print(f"LAYER {v['from']} ({v['from_layer']}) depends on {v['to']} ({v['to_layer']}): {v['manifest']}")
        print(f"layers: {len(found)} violation{'s' if len(found) != 1 else ''} at {ref} (order: {' < '.join(order)})")
    sys.exit(1 if found else 0)


def feature_layer_changes(team: Team, feature: str, ref: str, found: list[dict]) -> tuple[str, list[dict]]:
    fr = load_feature(team, feature)
    wos = fr["rounds"][-1]["wos"] if fr["rounds"] else [row["wo"] for row in fr["landed"]]
    hashes = [row["hash"] for row in fr["landed"] if row["wo"] in wos and row.get("hash")]
    if not hashes:
        die(f"feature {feature} has no landed work order with a hash")
    first = min(hashes, key=lambda h: int(out(team.repo, "rev-list", "--count", h)))
    _, before = layer_violations(team, f"{first}^")
    key = lambda violation: (violation["from"], violation["to"], violation["manifest"].rsplit(":", 1)[0])
    old = {key(violation) for violation in before}
    return f"{ref} (new since {first[:10]}^, feature {feature})", [violation for violation in found if key(violation) not in old]


def landing_conflict(team: Team, p: Path, recs: list[dict], files: list[str], conflicting_wo: str,
                     landed_wos: list[str]) -> int:
    """Keep the trees and send the set back; resolution waits for proven integration."""
    p.unlink()
    for rec in recs:
        rec.pop("queued", None)
        team.save_wo(rec)
        bounce = team.dir / "wo" / f"{rec['wo']}.bounce.txt"
        if rec["wo"] == conflicting_wo:
            bounce.write_text("\n".join(files) + "\n")
            text = (f"{rec['wo']} did not land: conflict in {', '.join(files)} with landed work orders "
                    f"{', '.join(landed_wos) or '(none recorded)'}. Do not merge landing: wait until those are promoted, "
                    "then merge integration, resolve in the same work order tree and run land again.")
        else:
            text = (f"{rec['wo']} did not land: the set was sent back because {conflicting_wo} conflicted. "
                    f"Once {conflicting_wo} is resolved, run land again with the set.")
            bounce.write_text(text + "\n")
        team.notify(team.c("orchestrator", "orc") if rec["zone"] == "orc" else f"Coord-{rec['zone']}", "NOTE", text)
    team.log({"time": now(), "wos": [rec["wo"] for rec in recs], "result": "conflict"})
    print(f"{', '.join(rec['wo'] for rec in recs)}: conflict in " + ", ".join(files))
    return CONFLICT


def conflicting_landings(team: Team, base: str, old: str, files: list[str]) -> list[str]:
    return [wo for wo, changed in intervening_landings(team, base, old) if set(changed).intersection(files)]


def intervening_landings(team: Team, base: str, old: str) -> list[tuple[str, list[str]]]:
    """Landings ancestral to landing but absent from the proven Stage 2 base can invalidate its checked zones."""
    p = team.dir / "landed.log"
    found = []
    for line in p.read_text().splitlines() if p.exists() else []:
        row = json.loads(line)
        h = row.get("hash")
        if not h or git(team.repo, "merge-base", "--is-ancestor", h, base, check=False).returncode == 0:
            continue
        if git(team.repo, "merge-base", "--is-ancestor", h, old, check=False).returncode:
            continue
        first, last = row["range"].split("..")
        files = out(team.repo, "diff", "--name-only", first, last).splitlines()
        found.extend((wo, files) for wo in row["wos"])
    return found


def member_bookkeeping(team: Team, rec: dict, row: dict) -> None:
    # A bookkeeping error is recorded, not a reason to undo code that has landed.
    if not (rec.get("made_by") == "codeteam-land" and rec["wo"].startswith("docs-stamp-")):
        try:
            docs_pass(team, row, rec)
        except Exception as ex:
            team.log({"time": now(), "wos": [rec["wo"]], "docs_pass_error": f"{type(ex).__name__}: {ex}"})
    if row["recheck"]:
        try:
            for fid in rec.get("fixes") or []:
                update_finding(team, fid, state="closed", fixed_by=rec["wo"], closed=now())
        except Exception as ex:
            team.log({"time": now(), "after_landing_error": f"{type(ex).__name__}: {ex}"})


def landing_bookkeeping(team: Team, recs: list[dict], rows: list[dict]) -> None:
    for rec, row in zip(recs, rows):
        member_bookkeeping(team, rec, row)
    if not rows[0]["recheck"]:
        try:
            # Register every member before feature completion can start a review round.
            after_landing(team, recs)
        except Exception as ex:
            team.log({"time": now(), "after_landing_error": f"{type(ex).__name__}: {ex}"})


def cleanup_landing(team: Team, rec: dict) -> None:
    for args in (("worktree", "remove", "--force", rec["tree"]), ("branch", "-D", rec["branch"])):
        result = git(team.repo, *args, check=False)
        if result.returncode:
            team.log({"time": now(), "wos": [rec["wo"]], "cleanup_error": " ".join(args),
                      "detail": result.stdout + result.stderr})


def merge_landing_member(team: Team, base: str, old: str, rec: dict, tip: str) -> tuple[str | None, list[str]]:
    merged = git(team.repo, "merge-tree", "--write-tree", "--name-only", old, tip, check=False)
    if merged.returncode == 1:
        # merge-tree separates the tree and conflict paths from its explanatory messages with a blank line.
        return None, merged.stdout.split("\n\n", 1)[0].splitlines()[1:]
    if merged.returncode:
        die(f"merge-tree failed: {merged.stdout}{merged.stderr}", 1)
    env = dict(os.environ, GIT_AUTHOR_NAME="codeteam-land", GIT_COMMITTER_NAME="codeteam-land",
               GIT_AUTHOR_EMAIL="codeteam@local", GIT_COMMITTER_EMAIL="codeteam@local")
    commit = git(team.repo, "commit-tree", merged.stdout.splitlines()[0], "-p", old, "-p", tip, "-m",
                 landing_message(rec["wo"], rec["zone"], out(team.repo, "log", "--format=%h %s",
                                 f"{base}..{tip}")), env=env).stdout.strip()
    return commit, []


def landing_recheck(team: Team, entry: dict, old: str, tip: str) -> bool:
    overlaps = overlapping(team.zones, intervening_landings(team, entry["base"], old), entry["zones"],
                           team.c("docs_only_suffixes", [".md"]))
    if not overlaps:
        return False
    row = recheck_row(tip, entry["wo"], overlaps, entry["zones"], now())
    if len(entry_members(entry)) > 1:
        row["set"] = [wo for wo, _ in entry_members(entry)]
    with open(team.dir / "recheck.jsonl", "a") as f:
        f.write(json.dumps(row) + "\n")
    return True


def record_landing_members(team: Team, entry: dict, old: str, recs: dict[str, dict],
                           commits: list[tuple[str, str]], recheck: bool) -> list[dict]:
    rows = []
    tips = dict(entry_members(entry))
    whole = [wo for wo, _ in entry_members(entry)]
    for wo, commit in commits:
        rec = recs[wo]
        git(team.repo, "update-ref", f"refs/landed/{wo}", tips[wo])
        cleanup_landing(team, rec)
        rec["landed_commit"] = commit
        row = {"time": now(), "wos": [wo], "zone": rec["zone"], "hash": commit, "range": f"{old}..{commit}",
               "base": entry["base"], "zones": entry["zones"], "recheck": recheck, "review": "before", "stage2": rec.get("stage2", []),
               "feature": feature_of(rec), "fixes": rec.get("fixes") or []}
        if len(whole) > 1:
            row["set"] = whole              # only the set's last commit holds all of it
        rec["landed_base"] = entry["base"]
        rec["landed_at"] = row["time"]
        team.save_wo(rec)
        team.wo_file(wo).rename(team.wo_file(wo).with_suffix(".landed.json"))
        team.log(row)
        rows.append(row)
        old = commit
        print(f"landed {wo} at {commit[:10]}")
    return rows


def land_entry(team: Team, p: Path) -> int:
    """Stage 4 under Lock: merge reviewed members, compare-and-move landing once, then record and clean up."""
    entry = json.loads(p.read_text())
    if not entry_current(entry):
        set_aside_entry(team, p)
        print(f"{p.name}: a queue entry without current Stage 2/3 records; "
              f"run land again for {', '.join(map(str, entry.get('wos') or []))}", file=sys.stderr)
        return REFUSED
    if entry["review"] != "land":
        print(f"{entry['wo']}: Stage 3 review is not land", file=sys.stderr)
        return REFUSED
    members = entry_members(entry)
    recs = {wo: team.wo(wo) for wo, _ in members}
    holders = integration_holders(team)
    if holders and (not team.lab or any(Path(h).resolve() != team.repo for h in holders)):
        die(f"landing or integration is checked out in {', '.join(holders)}; only the landing tool moves them")
    old = out(team.repo, "rev-parse", f"refs/heads/{team.landing}")
    commits, files, conflict = merge_chain(old, members,
        lambda cur, wo, tip: merge_landing_member(team, entry["base"], cur, recs[wo], tip))
    if conflict is not None:
        return landing_conflict(team, p, list(recs.values()), files, conflict,
                                conflicting_landings(team, entry["base"], old, files))
    if not move_landing(team, commits[-1][1], old):
        return REFUSED
    p.unlink()                          # landing moved: cleanup errors must not queue these tips again
    recheck = landing_recheck(team, entry, old, commits[-1][1])
    rows = record_landing_members(team, entry, old, recs, commits, recheck)
    landing_bookkeeping(team, list(recs.values()), rows)
    return 0


def tell_owner(team, title, body):
    """A herdr notice for the owner ([land].owner_notify overrides: a command with {title} and {body})."""
    tmpl = team.c("owner_notify", None)
    if tmpl:
        spawn(tmpl.format(title=shlex.quote(title), body=shlex.quote(body)))
        return
    env = dict(os.environ, HERDR_SESSION=team.m.get("v2", {}).get("herdr_session", "codeteam"))
    spawn(" ".join(shlex.quote(x) for x in ["herdr", "notification", "show", title, "--body", body, "--sound", "request"]),
          env=env)


def clean_idle(team):
    """A work order tree with no commit and no edit for [land].idle_hours (6) gets `make zone-clean` once; it builds
    again through the caches when its lead comes back."""
    limit = float(team.c("idle_hours", 6)) * 3600
    for f in (team.dir / "wo").glob("*.json"):
        if f.name.endswith(".landed.json"):
            continue
        rec = json.loads(f.read_text())
        tree = Path(rec["tree"])
        if rec.get("cleaned") or not tree.is_dir():
            continue
        last = float(out(tree, "log", "-1", "--format=%ct") or 0)
        # Newest edit: the files git sees as changed (ignored build output excluded), never a walk of the tree
        # (migrated request trees once took 3 h 20 min to walk and held every landing).
        newest = 0.0
        st = git(tree, "status", "--porcelain", "--untracked-files=all", check=False)
        for line in st.stdout.splitlines()[:5000]:
            try:
                newest = max(newest, (tree / line[3:].split(" -> ")[-1].strip('"')).stat().st_mtime)
            except OSError:
                newest = time.time()
        if time.time() - max(last, newest) > limit and any((tree / d).exists() for d in BUILD_OUTPUT_DIRS):
            env = dict(os.environ, MAKEFILES=str(HERE.parent / "zone" / "zone.mk"), CODETEAM_HOME=str(HERE.parent))
            subprocess.run(["make", "--no-print-directory", "zone-clean"], cwd=tree, env=env, capture_output=True)
            rec["cleaned"] = now()
            team.save_wo(rec)


def halted(team):
    return (team.root / "team" / "HALTED").exists()


def cmd_validate_suite(team: Team, a) -> None:
    """Run zone and repo validation tests at class full, without a separate compile batch."""
    tree = Path.cwd()
    steps = [step for zone in sorted(team.zones)
             for step in zone_tests(team, tree, zone, "full", group="validation")]
    steps.extend(repo_test_steps(tree, team.c("validation_tests", "tests/validation"), "validation", "full",
                                 str(HERE / "zone-tool")))
    window = float(os.environ.get("CODETEAM_HANG_WINDOW", "600"))
    ok = run_with_heartbeat(tree, steps, team_env(team, "validation"), window / 4, threading.Event())
    sys.exit(0 if ok else 1)


def run_with_heartbeat(tree: Path, steps: list[tuple[str, str]], env: dict[str, str], interval: float,
                       stop: threading.Event) -> bool:
    """Run the steps, flushing each one's summary as it ends and a `waiting:` line every interval while any is pending.

    land-check kills the suite when its log stops growing for CODETEAM_HANG_WINDOW and its process tree is idle. A
    step's `zone-tool job submit --wait 0` prints nothing until its job ends, and the job runs in the build queue's
    process tree, not the suite's, so a long queued or running step would look hung without the heartbeat. Its lines
    start with `waiting:` and so never match validation_tests' step pattern."""
    pending = [name for name, _ in steps]
    lock = threading.Lock()

    def finished(result: dict) -> None:
        with lock:
            pending.remove(result["name"])
            print("\n".join(step_lines(result)), flush=True)

    def beat() -> None:
        started = time.monotonic()
        while not stop.wait(interval):
            with lock:
                if not pending:
                    return
                print(f"waiting: {', '.join(pending)} ({time.monotonic() - started:.0f} s)", flush=True)

    heartbeat = threading.Thread(target=beat, daemon=True)
    heartbeat.start()
    try:
        ok, _ = run_steps(tree, steps, env, on_result=finished)
    finally:
        stop.set()
        heartbeat.join()
    return ok


# ---------------------------------------------------------------- the docs pass after landing
# Bookkeeping, never a gate. After landing, record pending document levels and report missing file references in added
# Markdown; promotion stamps versions, dates and changelog entries in a docs-only work order. The zone's SPEC and
# INTERFACE move together; public API removals or changes imply MAJOR, and additions imply MINOR.

FRONT_VERSION = re.compile(r"^version:\s*v?(\d+)(?:\.(\d+))?(?:\.(\d+))?", re.M)
EXTERNAL_MARK = "<!-- external -->"     # on a Markdown line: its file names are not this repository's


def missing_file_refs(lines, tracked, names):
    """File names on these added Markdown lines that name no tracked file. A line with EXTERNAL_MARK is skipped: it
    cites another repository's files or a package's own file list (2026-11-12: a package SPEC
    named another repository's files and a finder package's contents, and each NOTE cost a lane turn)."""
    broken = []
    for line in lines:
        if EXTERNAL_MARK in line.lower():
            continue
        for ref in FILE_REF.findall(line):
            if ref in tracked or (("/" not in ref) and ref in names) or any(t_.endswith("/" + ref) for t_ in tracked):
                continue
            broken.append(ref)
    return broken


FILE_REF = re.compile(r"(?<![\w/.-])((?:[\w.-]+/)*[\w.-]+\.(?:swift|rs|py|ts|js|md|toml|json|ya?ml|sh|c|h|m|mm|sql))(?![\w-])(?::\d+(?:-\d+)?)?")
# (?![\w-]) after the extension: `AuditGate.contentID` is not a file AuditGate.c, nor `Substrate.mutate` Substrate.m,
# nor `[package.metadata.acme-test]` package.metadata.m (every zone documenting Swift API was once told so).
LEVELS = ("patch", "minor", "major")


def _version(text):
    if not text.startswith("---"):
        return None
    head = text.split("\n---", 1)[0]
    m = FRONT_VERSION.search(head)
    return tuple(int(x or 0) for x in m.groups()) if m else None


def _bump(v, level):
    return (v[0] + 1, 0, 0) if level == "major" else (v[0], v[1] + 1, 0) if level == "minor" else (v[0], v[1], v[2] + 1)


def _set_front(text, ver, date):
    head, rest = text.split("\n---", 1)
    head = re.sub(r"^version:.*$", f"version: {'.'.join(map(str, ver))}", head, count=1, flags=re.M)
    head = re.sub(r"^date:.*$", f"date: {date}", head, count=1, flags=re.M) if re.search(r"^date:", head, re.M) \
        else head + f"\ndate: {date}"
    return head + "\n---" + rest


def _add_entry(text, ver, date, entry):
    block = f"### {'.'.join(map(str, ver))} -- {date}\n\n{entry.strip()}\n\n"
    m = re.search(r"^## Changelog[^\n]*\n+", text, re.M)
    if m:
        return text[:m.end()] + block + text[m.end():]
    return text.rstrip("\n") + "\n\n## Changelog\n\n" + block


def guard_walls(team, zone):
    """The zone guard's own walls for a zone (share/claude-hooks/lane_walls.py), so landing and the guard give a
    reference doc to the same zone (a SPEC.md was once one zone's to the guard
    and nobody's to landing). None when they cannot be read. A zone from a manifest glob (`apps/*`) has no lane record
    of its own, so its folder comes from team.zones, as the guard's CODETEAM_ZONE does (with an empty zone, a
    zone-docs.json claim such as INSTALLER -> apps/<app> matched nobody and landing refused the app's own doc)."""
    hooks = str(HERE.parent / "share" / "claude-hooks")
    if hooks not in sys.path:
        sys.path.append(hooks)
    try:
        import lane_walls
        lane = lane_rec(team, zone)
        path = lane.get("path", "") if lane else next(iter(team.zones.get(zone) or []), "")
        return lane_walls.load_walls(lane=zone, zone=path, owns=lane.get("owns") or [],
                                     team_json=team.root / "team" / "team.json", codeteam_home=HERE.parent,
                                     manifest=team.manifest)
    except Exception:
        return None


def zone_docs(team, tree, zone):
    """The zone's SPEC and INTERFACE outside docs/_public (the published copies the repo rebuilds): the guard's
    reference docs for the zone named *_SPEC.md or *_INTERFACE.md, and <ZONE>_SPEC.md / <ZONE>_INTERFACE.md anywhere."""
    walls = guard_walls(team, zone)
    stem = zone.replace("-", "").upper()
    names = {f"{stem}_SPEC.md", f"{stem}_INTERFACE.md"}
    found = []
    for f in out(tree, "ls-files").splitlines():
        if f.startswith("docs/_public/"):
            continue
        b = os.path.basename(f)
        if b in names or (walls and b.endswith(("_SPEC.md", "_INTERFACE.md")) and walls.owns_doc(f)):
            found.append(f)
    return found


DOC_LEVEL = re.compile(r"^Doc-Level:[ \t]*(?:(\S+)[ \t]+)?(major|minor|patch)[ \t]*$", re.M | re.I)


def stated_levels(team, base, tip, rec=None):
    """What a work order says its documents' version level is: `Doc-Level: major|minor|
    patch` in a commit of its own applies to every governed document it changed; `Doc-Level: <repo path> <level>` to
    that document only, and wins over the general line. `land --doc-level` records the same. The highest stated wins.
    Returns ({path: level}, general level or None)."""
    text = out(team.repo, "log", "--no-merges", "--format=%B", f"{base}..{tip}") if base and tip else ""
    stated = [(m.group(1), m.group(2).lower()) for m in DOC_LEVEL.finditer(text)]
    stated += [(x.get("doc"), x["level"]) for x in (rec or {}).get("doc_level", [])]
    per, general = {}, None
    for path, level in stated:
        if path:
            per[path] = max(per.get(path, level), level, key=LEVELS.index)
        else:
            general = max(general or level, level, key=LEVELS.index)
    return per, general


def changelog_path(doc):
    """A document's changelog file: beside it, <STEM>_CHANGELOG.md, one for a zone's SPEC and INTERFACE together.
    Append-only and merged by union (UNION_LOGS), so entries from two sides never clash."""
    d, b = os.path.split(doc)
    return os.path.join(d, re.sub(r"(_SPEC|_INTERFACE)?\.md$", "", b, flags=re.I) + "_CHANGELOG.md")


def section_heads(text):
    """(line index, line) of each `## ` heading outside fenced code blocks (``` or ~~~, closed by a run of the same
    character at least as long), in order."""
    heads, fence = [], None
    for i, line in enumerate(text.splitlines(keepends=True)):
        s = line.lstrip(" ")
        if fence:
            if s.rstrip().startswith(fence) and not s.rstrip().strip(fence[0]):
                fence = None
            continue
        m = re.match(r"(`{3,}|~{3,})", s)
        if m:
            fence = m.group(1)
        elif line.startswith("## "):
            heads.append((i, line))
    return heads


def take_changelog_section(text):
    """(the document without its `## Changelog` section, that section's body or ''). The section is the last
    `## Changelog` heading outside fenced code blocks, up to the next such `## ` heading (a VERSIONING.md's
    example heading inside a code block was taken, and the text after it went with it)."""
    heads = section_heads(text)
    found = [i for i, line in heads if line.startswith("## Changelog") and line.endswith("\n")]
    if not found:
        return text, ""
    lines = text.splitlines(keepends=True)
    start = found[-1]
    nxt = next((i for i, _ in heads if i > start), None)
    end = nxt if nxt is not None else len(lines)
    before = "".join(lines[:start]).rstrip("\n") + "\n"
    return before + ("\n" + "".join(lines[end:]) if nxt is not None else ""), "".join(lines[start + 1:end]).strip()


def tell_dependents(team, rec, landed, docs):
    """After a landing that changed a zone's SPEC or INTERFACE: every zone that depends on it and has no open work
    order (those are told when integration moves at promotion) gets one line in its ledger's reports/dependency-changes.md.
    No message; nothing is woken. Its coordinator reads the file at start-up and empties it."""
    if not docs:
        return
    open_zones = set()
    for f in (team.dir / "wo").glob("*.json"):
        if not f.name.endswith((".landed.json", ".retired.json")):
            try:
                open_zones.add(json.loads(f.read_text()).get("zone"))
            except ValueError:
                pass
    summary = (out(team.repo, "log", "--no-merges", "--format=%s", f"{landed}^..{rec['tip']}").splitlines() or [""])[-1] \
        if rec.get("tip") else ""
    for z in rec.get("reach", []):
        lane = team.root / "workcrews" / z
        if z == rec["zone"] or z in open_zones or not lane.is_dir():
            continue
        f = lane / "ledger" / "reports" / "dependency-changes.md"
        f.parent.mkdir(parents=True, exist_ok=True)
        with open(f, "a") as fh:
            for d in docs:
                fh.write(f"- {dt.date.today().isoformat()} {rec['zone']} changed {d} at {landed[:10]} ({rec['wo']}"
                         f"{': ' + summary if summary else ''}). Diff: git -C {team.repo} show {landed} -- {d}\n")


def docs_pass(team, row, rec):
    """After one landing (the changing lines leave the documents). Nothing is written to the repo
    here: the level each governed document needs is recorded in land/docs-pending.jsonl, and promote stamps versions
    and dates and writes the changelog entries once (stamp_docs). The level is the one the work order states
    (stated_levels); a document whose version the work order set by hand is left to it; otherwise the tool judges:
    MAJOR for removed or changed public declarations and MINOR for added ones on the zone's SPEC and INTERFACE, PATCH
    for a governed document that changed. A zone's SPEC and INTERFACE move together. Also here: dependency changes
    are recorded for dependent zones (tell_dependents), and missing Markdown file references are reported. Returns the row, or None."""
    landed, prev = row["hash"], row["range"].split("..")[0]
    files = [f for f in out(team.repo, "diff", "--name-only", prev, landed).splitlines() if f]
    zd = zone_docs(team, team.repo, rec["zone"])
    try:
        tell_dependents(team, rec, landed, [f for f in zd if f in files])
    except OSError:
        pass
    cfg = team.cfg.get("docs") or {}
    if not cfg.get("enabled"):
        return None
    # broken file references on the Markdown lines it added (file only, no line numbers)
    tracked = out(team.repo, "ls-tree", "-r", "--name-only", landed).splitlines()
    names = {}
    for t_ in tracked:
        names.setdefault(os.path.basename(t_), []).append(t_)
    added = [line[1:] for line in out(team.repo, "diff", "-U0", prev, landed, "--", "*.md").splitlines()
             if line.startswith("+") and not line.startswith("+++")]
    broken = missing_file_refs(added, tracked, names)
    if broken:
        team.notify(f"Coord-{rec['zone']}", "NOTE", f"{rec['wo']} landed with Markdown naming files that do not exist: "
                    f"{', '.join(sorted(set(broken))[:12])}. A file name or path is enough; fix them in your next work order. A name "
                    f"that is not this repository's (another repository's file, one inside a package) is right as written: "
                    f"put {EXTERNAL_MARK} on its line and this check skips the line.")

    def ver(ref, f):
        return _version(git(team.repo, "show", f"{ref}:{f}", check=False).stdout)
    api = rec.get("api") or {}
    level_api = "major" if api.get("removed") or api.get("changed") else "minor" if api.get("added") else None
    per, general = stated_levels(team, prev, rec.get("tip"), rec)
    docs = {}
    for f in files:
        if not f.endswith(".md") or f.startswith("docs/_public/"):
            continue
        old, new = ver(prev, f), ver(landed, f)
        if old and new:                 # governed, and not new with this landing
            docs[f] = per.get(f) or general or ("hand" if old != new else "patch")
    for f, level in per.items():        # a level stated for a document the work order did not change
        if f not in docs and ver(landed, f):
            docs[f] = level
    pair = [f for f in zd if ver(landed, f)]
    if level_api and not any(docs.get(f) == "hand" for f in pair):
        for f in pair:
            if f not in per and not (general and f in docs):
                docs[f] = max(docs.get(f, "patch"), level_api, key=LEVELS.index)
    if any(f in docs for f in pair):    # a zone's SPEC and INTERFACE carry one version: both move, or neither
        lv = [docs[f] for f in pair if docs.get(f) not in (None, "hand")]
        for f in pair:
            docs[f] = max(lv, key=LEVELS.index) if lv else "hand"
    if not docs:
        return None
    own = [x for x in out(team.repo, "log", "--no-merges", "--format=%s", f"{prev}..{rec['tip']}").splitlines() if x.strip()] \
        if rec.get("tip") else []
    api_txt = "; ".join(f"{k.capitalize()}: {', '.join(v)}" for k, v in api.items() if v and k != "error")
    entry = (own[-1] if own else rec["wo"]) + (f" ({api_txt})" if api_txt else "")
    pend = {"time": now(), "wo": rec["wo"], "zone": rec["zone"], "hash": landed, "docs": docs,
            "together": pair if len(pair) > 1 and any(f in docs for f in pair) else [], "entry": entry}
    with open(team.dir / "docs-pending.jsonl", "a") as fh:
        fh.write(json.dumps(pend) + "\n")
    return pend


def stamp_docs(team: Team, h: str, base: str) -> str | None:
    """Submit one durable stamp from proven integration, without waiting for checks, review or landing."""
    if not (team.cfg.get("docs") or {}).get("enabled"):
        return None
    wo = f"docs-stamp-{h[:10]}"
    pf = team.dir / "docs-pending.jsonl"
    pend = [json.loads(line) for line in pf.read_text().splitlines() if line.strip()] if pf.exists() else []
    if resume_stamp(team, wo):
        owed = [row for row in pend if ancestry(team)(row["hash"], h)]
        if owed:
            tip = team.wo(wo)["branch"] if team.wo_file(wo).exists() else f"refs/landed/{wo}"
            settle_stamp(team, pend, owed, out(team.repo, "rev-parse", tip))
        return wo
    base_hash = out(team.repo, "rev-parse", base)
    take = collect_stamps(team, h, base_hash, pend)
    if not take:
        return None
    owe_stamps(team, pend, take)
    tip = commit_stamp(team, wo, h, take, base_hash)
    settle_stamp(team, pend, take, tip)
    if tip is None:
        return None
    spawn(shlex.join([sys.executable, str(Path(__file__).resolve()), str(team.manifest), "land", wo]))
    return wo


class StampFailed(Exception):
    """Why a stamp could not be committed, for the orchestrator's note."""


def owe_stamps(team: Team, pend: list[dict], take: list[dict]) -> None:
    """A late row (a stated level with no pending row) joins land/docs-pending.jsonl before the stamp is tried: after
    this promotion it is below base, and collect_stamps never looks there again (2026-11-11: a stamp
    failed and a work order's level was lost)."""
    late = [row for row in take if row not in pend]
    if late:
        pend.extend(late)
        (team.dir / "docs-pending.jsonl").write_text("".join(json.dumps(row) + "\n" for row in pend))


def commit_stamp(team: Team, wo: str, h: str, take: list[dict], base_hash: str) -> str | None:
    """The stamp commit in a work order of its own. A failure retires that work order (the next promotion cuts a
    fresh one; the rows stay owed) and raises StampFailed with the step's own output."""
    cmd_wo_cut(team, argparse_ns(zone="orc", wo=wo, staff_as_orc=True))
    try:
        return write_stamp_commit(team, wo, h, take, base_hash)
    except BaseException:
        try:
            cmd_wo_retire(team, argparse_ns(wo=wo, force=True, reason="stamp failed"))
        except BaseException:           # the stamp's own failure is the one to report
            pass
        raise


def stamp_step_output(done) -> str:
    text = ((done.stdout or "") + (done.stderr or "")).strip()
    return text[-1500:] if len(text) > 1500 else text


def write_stamp_commit(team: Team, wo: str, h: str, take: list[dict], base_hash: str) -> str | None:
    rec = team.wo(wo)
    rec["made_by"] = "codeteam-land"
    team.save_wo(rec)
    tree = Path(rec["tree"])
    levels, groups = stamp_levels(take)
    targets = document_targets(team, tree, levels, base_hash)
    align_doc_targets(tree, targets, groups)
    logs = write_stamp_documents(tree, take, targets)
    write_stamp_changelogs(team, tree, logs)
    after = (team.cfg.get("docs") or {}).get("after")
    if after:
        # Stage first: an after step that works from tracked files (e.g. a `make public-docs`) must see the
        # changelog files this stamp creates (three new *_CHANGELOG.md had no docs/_public copy).
        git(tree, "add", "-A")
        done = subprocess.run(after, shell=True, cwd=tree, env=team_env(team), capture_output=True, text=True)
        if done.returncode:
            # Its refusal is the cause; the commit hook that would refuse next says less.
            raise StampFailed(f"[land.docs] after `{after}` exited {done.returncode}:\n{stamp_step_output(done)}\n"
                              f"{stamp_sources(team, logs)}")
    git(tree, "add", "-A")
    if not out(tree, "status", "--porcelain"):
        cmd_wo_retire(team, argparse_ns(wo=wo, force=True, reason="nothing to stamp"))
        return None
    env = dict(os.environ, GIT_AUTHOR_NAME="codeteam-land", GIT_COMMITTER_NAME="codeteam-land",
               GIT_AUTHOR_EMAIL="codeteam@local", GIT_COMMITTER_EMAIL="codeteam@local")
    done = git(tree, "commit", "-q", "-m", f"docs: versions, dates and changelog entries for the promotion of {h[:10]} "
               f"({len(take)} work order{'s' if len(take) != 1 else ''})\n\n{MADE_BY}", env=env, check=False)
    if done.returncode:
        raise StampFailed(f"the stamp commit was refused (exit {done.returncode}):\n{stamp_step_output(done)}")
    return out(tree, "rev-parse", "HEAD")


def collect_stamps(team: Team, h: str, base: str, pend: list[dict]) -> list[dict]:
    is_anc = ancestry(team)
    take = [row for row in pend if is_anc(row["hash"], h)]
    seen = {row["wo"] for row in pend}
    stamped = team.dir / "docs-stamped.jsonl"
    if stamped.exists():
        seen.update(json.loads(line)["wo"] for line in stamped.read_text().splitlines() if line.strip())
    for row in read_landing_rows(team):
        if not stamp_owed(row, seen, base, h, is_anc):
            continue
        rec = landed_rec(team, row["wos"][0]) or {}
        if rec.get("made_by") == "codeteam-land":
            continue
        if late := stated_stamp(team, row, rec):
            take.append(late)
    return take


def stamp_owed(row: dict, seen: set[str], base: str, h: str, is_ancestor: Callable[[str, str], bool]) -> bool:
    return bool(row.get("hash") and row.get("wos") and row["wos"][0] not in seen
                and not is_ancestor(row["hash"], base) and is_ancestor(row["hash"], h))


def stated_stamp(team: Team, row: dict, rec: dict) -> dict | None:
    prev = row["range"].split("..")[0]
    docs = stated_stamp_docs(team, row, rec, prev)
    if docs is None:
        return None
    subjects = out(team.repo, "log", "--no-merges", "--format=%s", f"{prev}..{rec['tip']}").splitlines() if rec.get("tip") else []
    zdocs = zone_docs(team, team.repo, row.get("zone", ""))
    wo = row["wos"][0]
    return {"time": row["time"], "wo": wo, "zone": row.get("zone"), "hash": row["hash"], "docs": docs,
            "together": zdocs if any(file in docs for file in zdocs) else [],
            "entry": subjects[-1] if subjects else wo, "late": True}


def stated_stamp_docs(team: Team, row: dict, rec: dict, prev: str) -> dict | None:
    per, general = stated_levels(team, prev, rec.get("tip"), rec)
    if not per and not general:
        return None
    docs = dict(per)
    if general:
        for file in out(team.repo, "diff", "--name-only", prev, row["hash"]).splitlines():
            if file.endswith(".md") and not file.startswith("docs/_public/") and file not in docs \
                    and _version(git(team.repo, "show", f"{row['hash']}:{file}", check=False).stdout):
                docs[file] = general
    return docs


def stamp_levels(take: list[dict]) -> tuple[dict, set[tuple]]:
    levels, groups = {}, set()
    for row in take:
        for file, level in row["docs"].items():
            if level != "hand":
                levels[file] = max(levels.get(file, level), level, key=LEVELS.index)
            levels.setdefault(file, None)
        if len(row.get("together") or []) > 1:
            groups.add(tuple(sorted(row["together"])))
    return levels, groups


def document_targets(team: Team, tree: Path, levels: dict, base: str) -> dict:
    targets = {}
    for file, level in levels.items():
        path = tree / file
        current = _version(path.read_text()) if path.exists() else None
        if not current:
            continue
        before = _version(git(team.repo, "show", f"{base}:{file}", check=False).stdout)
        targets[file] = max(current, _bump(before, level)) if before and level else current
    return targets


def align_doc_targets(tree: Path, targets: dict, groups: set[tuple]) -> None:
    for group in groups:
        versions = {file: _version((tree / file).read_text()) for file in group if (tree / file).exists()}
        top = max([targets.get(file) or version for file, version in versions.items() if version] or [None], default=None)
        for file, version in versions.items():
            if version and top:
                targets[file] = top


def write_stamp_documents(tree: Path, take: list[dict], targets: dict) -> dict:
    logs = {}
    today = dt.date.today().isoformat()
    for file, version in sorted(targets.items()):
        text = (tree / file).read_text()
        if version != _version(text):
            text = _set_front(text, version, today)
        text, section = take_changelog_section(text)
        (tree / file).write_text(text)
        log = logs.setdefault(changelog_path(file), {"moved": [], "version": version, "wos": []})
        log["version"] = max(log["version"], version)
        if section:
            log["moved"].append((file, section))
        for row in take:
            if file in row["docs"] and row not in log["wos"]:
                log["wos"].append(row)
    return logs


def stamp_sources(team: Team, logs: dict) -> str:
    """Where each line a stamp adds to a changelog comes from, for the note when the after step refuses one. The text
    a refusal quotes was written by someone else: 2026-11-12, a line naming `docs/_public` came from
    Kong's changelog entry file, which no record the orchestrator searched held, and every later stamp would fail on
    it."""
    ledger = guard_ledger(team)
    parts = []
    for file, log in sorted(logs.items()):
        src = []
        for row in sorted(log["wos"], key=lambda row: row["time"]):
            path = Path(os.path.expanduser(ledger), "changelog", f"{row['wo']}.md") if ledger else None
            src.append(f"{row['wo']} ({path if path and path.exists() else 'its first commit subject'})")
        src += [f"the changelog section moved from {doc}" for doc, _ in log["moved"]]
        if src:
            parts.append(f"{file} takes {', '.join(src)}")
    return ("Its entries: " + "; ".join(parts) + ". " if parts else "") + \
        "Reword the one the refusal names; the next promotion stamps the owed documents again."


def stamp_entry(ledger: str | None, row: dict) -> str:
    path = Path(os.path.expanduser(ledger), "changelog", f"{row['wo']}.md") if ledger else None
    text = path.read_text().strip() if path and path.exists() else row["entry"]
    return text if text.startswith("- ") else f"- {row['wo']}: {text}"


def write_stamp_changelogs(team: Team, tree: Path, logs: dict) -> None:
    today = dt.date.today().isoformat()
    ledger = guard_ledger(team)
    for file, log in logs.items():
        path = tree / file
        text = path.read_text() if path.exists() else f"# {path.name[:-len('_CHANGELOG.md')]} changelog\n\n" \
            "Append-only: newest at the end. Written at each promotion; never edited by hand.\n"
        for doc, section in log["moved"]:
            text = text.rstrip("\n") + f"\n\n## Earlier entries, moved from {Path(doc).name} on {today}\n\n{section}\n"
        text = text.rstrip("\n") + f"\n\n## {'.'.join(map(str, log['version']))} -- {today}\n\n" \
            + "\n".join(stamp_entry(ledger, row) for row in sorted(log["wos"], key=lambda row: row["time"])) + "\n"
        path.write_text(text)


def settle_stamp(team: Team, pend: list[dict], take: list[dict], tip: str | None) -> None:
    (team.dir / "docs-pending.jsonl").write_text("".join(json.dumps(row) + "\n" for row in pend if row not in take))
    with (team.dir / "docs-stamped.jsonl").open("a") as file:
        for row in take:
            file.write(json.dumps({"wo": row["wo"], "hash": row["hash"], "stamp": tip, "time": now()}) + "\n")


def resume_stamp(team: Team, wo: str) -> bool:
    if team.wo_file(wo).with_suffix(".landed.json").exists():
        return True
    if not team.wo_file(wo).exists():
        return False
    if entry_path(team, wo):
        return True
    rec = team.wo(wo)
    messages = out(team.repo, "log", "--format=%B", rec["branch"], "--not", team.integration)
    if MADE_BY in messages.splitlines():
        spawn(shlex.join([sys.executable, str(Path(__file__).resolve()), str(team.manifest), "land", wo]))
        return True
    cmd_wo_retire(team, argparse_ns(wo=wo, force=True, reason="stamp cut without a stamp commit"))
    return False


# ---------------------------------------------------------------- recheck overlapping landings


def pending_recheck(rows: list[dict]) -> int | None:
    return next((i for i, row in enumerate(rows) if "done" not in row), None)


def read_recheck(team: Team) -> list[dict]:
    path = team.dir / "recheck.jsonl"
    rows = []
    for line in path.read_text().splitlines() if path.exists() else []:
        try:
            rows.append(json.loads(line))
        except ValueError:
            rows.append({"bad": line, "done": "unreadable"})
    return rows


def _mark_recheck_done_unlocked(team: Team, index: int, when: str) -> None:
    """Write completion while the caller holds Lock(team), preserving rows appended by landing."""
    rows = read_recheck(team)
    rows[index]["done"] = when
    path = team.dir / "recheck.jsonl"
    tmp = path.with_name(f".{path.name}.tmp")
    tmp.write_text("".join(json.dumps(row) + "\n" for row in rows))
    os.replace(tmp, path)


def mark_recheck_done(team: Team, index: int, when: str) -> None:
    with Lock(team):
        _mark_recheck_done_unlocked(team, index, when)


class CheckoutFailed(Exception):
    def __init__(self, M: str, error: str) -> None:
        super().__init__(error)
        self.M = M
        self.error = error


def itest_checkout(team: Team, M: str) -> Path:
    tree = team.dir / "itest"
    if tree.exists():
        r = git(tree, "checkout", "-q", "--detach", M, check=False)
        if r.returncode:
            # Restore test-modified files and overwrite obstructions without cleaning away warm build output.
            r = git(tree, "checkout", "-q", "-f", "--detach", M, check=False)
    else:
        r = git(team.repo, "worktree", "add", "--detach", str(tree), M, check=False)
        if r.returncode and "already registered worktree" in (r.stderr or ""):
            # The folder was deleted and git still lists it: -f reuses this path's entry alone.
            r = git(team.repo, "worktree", "add", "-f", "--detach", str(tree), M, check=False)
        if r.returncode == 0:
            codeteam_tm.exclude([tree])     # the landing tool's own tree and its builds: none of it is backed up
    if r.returncode:
        raise CheckoutFailed(M, r.stderr.strip())
    return tree


def recheck_steps(team: Team, tree: Path, zones: Iterable[str]) -> tuple[list, list]:
    # Repo gates compare to the moving integration branch, not this recheck's fixed M.
    zones = list(zones)
    return ([step for step in compile_steps(team, tree, zones) if step[0] != "repo gates"],
            [step for zone in zones for step in zone_tests(team, tree, zone, "land", group="integration")]
            + repo_integration_steps(tree, team.c("integration_tests", "tests/integration"), "land", str(HERE / "zone-tool")))


def integration_result(row: dict, results: list[dict], when: str) -> dict:
    """One recheck's record; a step that did not pass keeps its last lines, its log and its failing tests."""
    return {"time": when, "M": row["M"], "wo": row["wo"], "overlapping": row["overlapping"], "zones": row["zones"],
            "tests": [{"name": result["name"], "result": result["outcome"].lower(),
                       "seconds": round(result["seconds"], 1)}
                      | ({key: result[key] for key in ("failing", "log", "tail") if result.get(key)}
                         if result["outcome"] != "PASS" else {}) for result in results]}


RECHECK_LOGS_KEPT = 60


def keep_recheck_logs(team: Team, M: str, results: list[dict]) -> None:
    """Save each failing step's whole output to land/recheck-logs/ and name its failing tests: zone-tool's records in
    land/itest are per scope and the next recheck overwrites them (2026-11-12: an app's test failure
    reached the finding with no test name and no log). Drops "text" from every result."""
    folder = team.dir / "recheck-logs"
    for result in results:
        text = result.pop("text", None)
        if result["outcome"] == "PASS" or text is None:
            continue
        result["failing"] = failing_test_names(text)[:20]
        try:
            folder.mkdir(exist_ok=True)
            path = folder / f"{M[:10]}-{re.sub(r'[^A-Za-z0-9._-]+', '-', result['name']).strip('-')}.log"
            path.write_text(text)
            result["log"] = str(path)
        except OSError as ex:  # A full disk must not lose the recheck's result.
            result["log_error"] = f"{type(ex).__name__}: {ex}"
    try:
        logs = sorted(folder.glob("*.log"), key=lambda p: p.stat().st_mtime, reverse=True)
        for old in logs[RECHECK_LOGS_KEPT:]:
            old.unlink()
    except OSError:
        pass


def recheck_findings(tests: list[dict], open_fixes: list[dict]) -> dict:
    changes = {"open": [], "add": [], "close": []}
    for test in tests:
        fixes = [fix["id"] for fix in open_fixes if fix["test"] == test["name"]]
        if test["result"] == "pass":
            changes["close"].extend(fixes)
        elif fixes:
            changes["add"].extend(fixes)
        else:
            changes["open"].append(test["name"])
    return {key: list(dict.fromkeys(values)) for key, values in changes.items()}


def landing_fix_note(team: Team, commit: str) -> str:
    """The FIX-FORWARD line for a test failure at a landing commit. The fix
    work order stays cut from integration and merges the failing landing commit when the cause lives only there.
    Stage 4 step 3 ('the coder never merges landing', a Stage 4 conflict rule) was once read as forbidding it.
    own_base keeps Stage 3 on the fix's own commits after such a merge."""
    return (f" If the cause is on {team.landing} and not in integration, merge {commit[:10]} into the fix tree; "
            f"Stage 3 reviews only the fix's own commits.")


def open_recheck_finding(team: Team, row: dict, rec: dict, test: dict, when: str) -> None:
    """Create and route one test finding while the caller holds FindingsLock."""
    feature = feature_of(rec)
    items = load_findings(team, feature)
    fid = f"{feature}#{len(items) + 1}"
    wos = [row["wo"], *row["overlapping"]]
    what = (f"{test['name']} {'hangs' if test['result'] == 'hung' else 'fails'} at M {row['M'][:10]} "
            f"after an overlapping landing; overlapping work orders: {', '.join(row['overlapping'])}")
    if test.get("failing"):
        what += f"; failing tests: {', '.join(test['failing'])}"
    if test.get("log"):
        what += f"; log: {test['log']}"
    items.append({"id": fid, "time": when, "by": "recheck", "also": [], "feature": feature, "wos": wos,
                  "zone": rec["zone"], "where": test["name"], "severity": 2, "kind": "test", "what": what,
                  "belongs": "", "state": "open", "fixed_by": None, "closed": None, "reason": None,
                  "test": test["name"], "Ms": [row["M"]]})
    save_findings(team, feature, items)
    team.notify(team.c("orchestrator", "orc") if rec["zone"] == "orc" else f"Coord-{rec['zone']}", "REQUEST",
                f"FIX-FORWARD {fid} | zone {rec['zone']} | test {test['name']} | M {row['M'][:10]} | "
                f"work orders {', '.join(wos)} | {what}. Route as a work order; it lands with "
                f"codeteam-land {team.manifest} land <wo> --fixes {fid}." + landing_fix_note(team, row["M"]))


def apply_recheck_findings(team: Team, row: dict, rec: dict, tests: list[dict], when: str) -> None:
    # The lookup and creation share the findings lock so another writer cannot allocate the same id.
    with FindingsLock(team):
        changes = recheck_findings(tests, [fix for fix in all_findings(team)
                                          if fix["state"] == "open" and "test" in fix and fix.get("by") != "validation"])
        for name in changes["open"]:
            open_recheck_finding(team, row,
                                 {"wo": "v54-move", "feature": "v54-move", "zone": validation_zone(team, name)}
                                 if row.get("move") else rec,
                                 next(test for test in tests if test["name"] == name), when)
        for fid in changes["add"]:
            if row["M"] not in find_finding(team, fid)["Ms"]:
                feature = fid.rsplit("#", 1)[0]
                items = load_findings(team, feature)
                next(item for item in items if item["id"] == fid)["Ms"].append(row["M"])
                save_findings(team, feature, items)
    # update_finding takes its own lock; do not nest it under FindingsLock.
    # Keep the closing M so Stage 7 can check whether a candidate includes the passing recheck.
    for fid in changes["close"]:
        update_finding(team, fid, state="closed", closed=when, fixed_by=None, closed_at=row["M"],
                       reason=f"passes at M {row['M'][:10]}")


def complete_recheck(team: Team, row: dict, when: str) -> None:
    try:
        with Lock(team):
            _mark_recheck_done_unlocked(team, read_recheck(team).index(row), when)
            if not row.get("move"):
                # Landing already closed --fixes; register the set for Nagatha only once its recheck is settled.
                after_landing(team, [{key: value for key, value in landed_rec(team, wo).items() if key != "fixes"}
                                     for wo in row.get("set") or [row["wo"]]])
    except Exception as ex:
        team.log({"time": now(), "wos": [row["wo"]], "recheck_bookkeeping_error": f"{type(ex).__name__}: {ex}"})


def recheck_checkout_notice(team: Team, row: dict, result: dict) -> bool:
    """Record a recheck's first failed checkout on its row and tell the orchestrator; False when it was told already."""
    with Lock(team):
        rows = read_recheck(team)
        if row not in rows:
            return False
        current = rows[rows.index(row)]
        if "checkout_failed" in current:
            return False
        current["checkout_failed"] = result["time"]
        path = team.dir / "recheck.jsonl"
        temporary = path.with_name(f".{path.name}.tmp")
        temporary.write_text("".join(json.dumps(item) + "\n" for item in rows))
        temporary.replace(path)
    team.notify(team.c("orchestrator", "orc"), "NOTE",
                f"Recheck checkout failed at M {row['M'][:10]} for work orders "
                f"{', '.join(row.get('set') or [row['wo']])}: {' '.join(result['error'].splitlines())}; "
                "the recheck stays pending and is tried again each poll until the checkout works (git's error above "
                "names the cause); Stage 6 waits for it.")
    return True


def recheck_one(team: Team, row: dict) -> dict:
    """Recheck the set at its landing commit, running integration tests only after compilation passes.

    A recheck whose checkout fails stays pending and is tried again; its first failure is recorded and told once
    (a recheck that ran nothing is not done). Move rechecks also stay pending on findings
    errors, so Stage 6 cannot bypass the move's outcome; ordinary rechecks complete on those.
    """
    try:
        tree = itest_checkout(team, row["M"])
    except CheckoutFailed as ex:
        result = integration_result(row, [], now()) | {"checkout": "failed", "error": ex.error,
                                                       "set": row.get("set") or [row["wo"]]}
        if recheck_checkout_notice(team, row, result):
            with (team.dir / "integration-results.jsonl").open("a") as file:
                file.write(json.dumps(result) + "\n")
        return result
    else:
        compile, tests = recheck_steps(team, tree, row["zones"])
        env = team_env(team, "integration")
        results = step_results(tree, compile, env, concurrent=False, keep_text=True)
        if all(result["outcome"] == "PASS" for result in results):
            results.extend(step_results(tree, tests, env, keep_text=True))
        keep_recheck_logs(team, row["M"], results)
        result = integration_result(row, results, now())
    with (team.dir / "integration-results.jsonl").open("a") as file:
        file.write(json.dumps(result) + "\n")
    try:
        apply_recheck_findings(team, row, landed_rec(team, row["wo"]), result["tests"], result["time"])
    except Exception as ex:
        team.log({"time": now(), "wos": [row["wo"]], "recheck_findings_error": f"{type(ex).__name__}: {ex}"})
        if row.get("move"):
            return result
    complete_recheck(team, row, result["time"])
    return result


def run_recheck_tick(team: Team, rec: dict) -> tuple | None:
    try:
        with stage_admit("Stage 5", f"recheck of {rec['wo']} at M {rec['M'][:10]}"):
            started = time.time()
            result = recheck_one(team, rec)
    except RestartPending:
        return None
    if result.get("checkout") == "failed":
        return None                     # pending: the runner sleeps a poll before it tries again
    if rec.get("move") and any(row.get("move") and "done" not in row for row in read_recheck(team)):
        return None
    return started, lambda: f"Stage 5 recheck of {rec['wo']} at M {rec['M'][:10]}"


def recheck_ready(team: Team) -> dict | None:
    if halted(team) or runner_unmoved(team, "recheck-run"):
        return None
    rows = read_recheck(team)
    index = pending_recheck(rows)
    return rows[index] if index is not None else None


def cmd_recheck_run(team: Team, a) -> None:
    with (team.dir / "recheck-run.lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("a recheck runner is already running")
            return
        while True:
            if runner_restart(team, "recheck-run"):
                return
            job = None
            rec = recheck_ready(team)
            if rec is not None:
                if runner_restart(team, "recheck-run"):
                    return
                job = run_recheck_tick(team, rec)
            if runner_restart(team, "recheck-run", job):
                return
            if a.once:
                return
            if job is None:
                time.sleep(int(team.c("poll_s", 15)))


def queue_maintenance(team: Team, once: bool, last_house: float, last_clean: float) -> tuple[float, float]:
    if once or time.time() - last_house > 60:
        last_house = time.time()
        prune_queue(team)
        try:
            features_due_locked(team)
        except Exception as ex:
            print(f"features_due: {type(ex).__name__}: {ex}", file=sys.stderr, flush=True)
    if not once and time.time() - last_clean > 3600:
        last_clean = time.time()
        clean_idle(team)
    return last_house, last_clean


def advance_queue(team: Team) -> bool:
    """Land at most one ready entry under Lock, retaining its identity for the runner's restart notice."""
    prune_queue(team)
    with Lock(team):
        if (team.dir / "restart" / "queue-run.json").exists():
            return False
        ready = next((p for p in entries(team) if not (e := json.loads(p.read_text())).get("hold")
                      and e.get("review") == "land"), None)
        if ready is None:
            return False
        rec = json.loads(ready.read_text())
        # land_entry consumes the queue file, so retain its contents until the boundary check.
        team._restart_job = (time.time(), lambda: f"Stage 4 landing of {rec['wo']}")
        return land_entry(team, ready) != REFUSED


def queue_idle_poll(team: Team) -> float | None:
    if halted(team):
        return 30
    if runner_unmoved(team, "queue-run"):
        return int(team.c("poll_s", 15))
    return None


def cmd_queue_run(team, a):
    last_house = last_clean = 0
    while True:
        drive_buildq_restart(team)
        if runner_restart(team, "queue-run"):
            return
        pause = queue_idle_poll(team)
        if pause is not None:
            if a.once:
                return
            time.sleep(pause)
            continue
        last_house, last_clean = queue_maintenance(team, a.once, last_house, last_clean)
        if runner_restart(team, "queue-run"):
            return
        team._restart_job = None
        advanced = advance_queue(team)
        if runner_restart(team, "queue-run", team._restart_job):
            return
        if a.once:
            return
        if advanced:
            continue
        time.sleep(int(team.c("poll_s", 15)))


def cmd_land_one(team, a):
    if v54_unmoved(team):
        die(NOT_MOVED)
    with Lock(team):
        prune_queue(team)
        p = entry_path(team, a.wo) or die(f"{a.wo} is not queued")
        res = land_entry(team, p)
    sys.exit(res)


def revert_args(parents: list[str]) -> list[str]:
    return ["revert", *(["-m", "1"] if len(parents) == 2 else []), "--no-edit"]


def cmd_revert(team, a):
    rows = [json.loads(l) for l in (team.dir / "landed.log").read_text().splitlines() if l.strip()]
    row = next((r for r in reversed(rows) if a.wo in r.get("wos", []) and r.get("hash")), None) or \
        die(f"{a.wo} has not landed")
    if git(team.repo, "merge-base", "--is-ancestor", row["hash"], team.integration, check=False).returncode:
        die(f"{a.wo} is not promoted: it cannot be reverted from a tree cut from integration")
    # Inspect before cutting the tree: a squash landing needs no mainline, a two-parent merge needs parent 1.
    args = revert_args(out(team.repo, "rev-list", "--parents", "-n1", row["hash"]).split()[1:])
    rwo = f"revert-{a.wo}"
    cmd_wo_cut(team, argparse_ns(zone=row.get("zone", "orc"), wo=rwo))
    rec = team.wo(rwo)
    env = dict(os.environ, GIT_AUTHOR_NAME="codeteam-land", GIT_COMMITTER_NAME="codeteam-land",
               GIT_AUTHOR_EMAIL="codeteam@local", GIT_COMMITTER_EMAIL="codeteam@local")
    git(rec["tree"], *args, row["hash"], env=env)
    git(rec["tree"], "commit", "--amend", "-q", "-m",
        out(rec["tree"], "log", "-1", "--format=%B") + "\n\n" + MADE_BY, env=env)
    rec["made_by"] = "codeteam-land"
    team.save_wo(rec)
    cmd_land(team, argparse_ns(wo=rwo, with_=[], untested=False))


def argparse_ns(**kw):
    import types
    return types.SimpleNamespace(**kw)


# ---------------------------------------------------------------- Stage 6 validation in a permanent clone
#
# [land.remote] host, path, suite and toolchain select a remote tier; [land.validate] selects a local tier.
# Push the commit into refs/codeteam/check/<first 12 hash characters> and run land-check there. Stage 6 records per-test outcomes
# in validation-results.jsonl; migrate check keeps its own results.jsonl rows.

REMOTE_CHECK = r"""#!/bin/sh
# codeteam land-check (installed by codeteam-land alpha-install): validation on one landing hash.
# usage: land-check <hash> <suite command> <toolchain-fingerprint-command> <expected fingerprint>
h=$1; suite=$2; fp_cmd=$3; want=$4
# Slow-compile survey: Swift warns for each function or expression over the limit, in the log.
[ -f "$HOME/land-slow.xcconfig" ] && export XCODE_XCCONFIG_FILE="$HOME/land-slow.xcconfig"
# ssh runs this with a bare PATH: rustup's toolchain first (it shadows Homebrew's rust), then Homebrew.
export PATH="$HOME/.cargo/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
got=$(sh -c "$fp_cmd" 2>&1 | shasum | cut -c1-16)
if [ "$got" != "$want" ]; then
  printf '{"hash":"%s","result":"toolchain","detail":"toolchain differs from the main Mac (%s != %s): %s"}\n' \
    "$h" "$got" "$want" "$(sh -c "$fp_cmd" 2>&1 | tr '\n"' ' _' | cut -c1-300)"
  exit 2
fi
keep=""; for k in $LAND_KEEP; do keep="$keep -e $k"; done     # untracked inputs a suite needs (model weights)
build="-e cargo-target -e target -e .build -e .codegraph -e node_modules"    # warm build output, kept
# Python's bytecode caches are ignored files, which `git clean -fd` keeps, so a test that reads the tree saw the last
# run's: they go at each checkout, outside the kept folders, and the suite writes none.
export PYTHONDONTWRITEBYTECODE=1
git checkout -q -f --detach "$h" && git clean -q -fd $build $keep &&
  git clean -q -fdx $build -e DerivedData $keep -- ':(glob)**/__pycache__/' ':(glob)**/*.pyc' || {
  printf '{"hash":"%s","result":"error","detail":"checkout failed"}\n' "$h"; exit 2; }
t0=$(date +%s)
mkdir -p "$HOME/land-check-logs"
log="$HOME/land-check-logs/$h.log"
hung=$(mktemp)
sh -c "$suite" > "$log" 2>&1 & pid=$!
python3 - "$pid" "$log" "$hung" <<'PY' &
import collections
import os
import signal
import subprocess
import sys
import time

pid = int(sys.argv[1])
window = float(os.environ.get("CODETEAM_HANG_WINDOW", "600"))
pct = float(os.environ.get("CODETEAM_HANG_CPU_PCT", "1"))

def snapshot():
    rows = {}
    for line in subprocess.check_output(["ps", "-axo", "pid=,ppid=,time="], text=True).splitlines():
        child, parent, cpu = line.split()
        days, sep, clock = cpu.rpartition("-")
        seconds = 0.0
        for part in (clock if sep else cpu).split(":"):
            seconds = seconds * 60 + float(part)
        rows[int(child)] = (int(parent), seconds + (int(days) * 86400 if sep else 0))
    tree = {pid}
    while True:
        children = {child for child, (parent, _) in rows.items() if parent in tree}
        if children <= tree:
            return {child: rows[child][1] for child in tree if child in rows}
        tree.update(children)

last_cpu = snapshot()
total = sum(last_cpu.values())
started = changed = time.monotonic()
size = os.path.getsize(sys.argv[2])
samples = collections.deque([(started, total)])
while pid in last_cpu:
    time.sleep(15)
    cpu = snapshot()
    if pid not in cpu:
        break
    total += sum(max(0, seconds - last_cpu.get(child, 0)) for child, seconds in cpu.items())
    last_cpu = cpu
    tick = time.monotonic()
    grown = os.path.getsize(sys.argv[2])
    if grown != size:
        size, changed = grown, tick
    samples.append((tick, total))
    while len(samples) > 1 and samples[1][0] <= tick - window:
        samples.popleft()
    elapsed = tick - samples[0][0]
    if tick - changed < window or elapsed < window or total - samples[0][1] >= elapsed * pct / 100:
        continue
    # Mark before killing so the waiting shell can distinguish a hang from another failure.
    with open(sys.argv[3], "w") as mark:
        mark.write("hung")
    for child in [child for child in cpu if child != pid] + [pid]:
        try:
            os.kill(child, signal.SIGKILL)
        except ProcessLookupError:
            pass
    break
PY
watcher=$!
wait "$pid"; rc=$?
kill "$watcher" 2>/dev/null
wait "$watcher" 2>/dev/null
tail_=$(tail -60 "$log" | tr '\n"\\' '|_/' | tr -d '\000-\037' | cut -c1-6000)
if [ -s "$hung" ]; then r=hung; elif [ $rc -eq 0 ]; then r=pass; else r=fail; fi
printf '{"hash":"%s","result":"%s","seconds":%s,"tail":"%s"}\n' "$h" "$r" "$(( $(date +%s) - t0 ))" "$tail_"
rm -f "$hung"
"""


def alpha_cfg(team):
    """The validation tier: [land.remote] remotely or [land.validate] locally, defaulting to a local validation suite
    at the build queue's full class."""
    a = team.cfg.get("remote") or team.cfg.get("validate") or {}
    if not a and "land" in team.m:
        # Keep validation separate from the work order and recheck trees so later landings cannot change its inputs.
        a = {"local": True, "path": str(team.dir / "validate"), "toolchain": ["true"], "steps": True,
             "suite": f"{shlex.quote(sys.executable)} {shlex.quote(str(Path(__file__).resolve()))} "
                      f"{shlex.quote(str(team.manifest))} validate-suite"}
    if a.get("local") and not a.get("host"):
        a = {**a, "host": "local"}
    if a.get("local") and a.get("path"):
        a = {**a, "path": os.path.expanduser(a["path"])}
    if not a.get("host") or not a.get("path") or not a.get("suite"):
        return None
    return a


def toolchain_cmd(a):
    return "; ".join(a.get("toolchain", ["xcodebuild -version", "rustc --version", "python3 --version"]))


def toolchain_fp(a):
    # The same PATH order land-check uses on the remote machine: rustup's toolchain, then Homebrew.
    path = f"{Path.home() / '.cargo' / 'bin'}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    # One stream, stderr into stdout, as land-check hashes `sh -c "$fp_cmd" 2>&1` (stdout then stderr
    # never matched a tool that writes to both, such as swift --version).
    r = subprocess.run(["sh", "-c", toolchain_cmd(a)], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                       env=dict(os.environ, PATH=path + ":" + os.environ.get("PATH", "")))
    import hashlib
    return hashlib.sha1(r.stdout).hexdigest()[:16]


def ssh(a, cmd, timeout=None, input=None):
    """One command on the validation machine. The time limit is /usr/bin/timeout's, inside codeteam-own, so ssh itself is
    ended at the limit; the caller's own limit, a little longer, is only a backstop."""
    limit = ["/usr/bin/timeout", str(int(timeout))] if timeout else []
    return subprocess.run([OWN, *limit, "ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=20", "-o",
                           "ServerAliveInterval=30", a["host"], cmd], capture_output=True, text=True, input=input,
                          timeout=timeout + 60 if timeout else None)


def land_check_digest() -> str:
    # Hash the script itself: a hand-bumped version can be forgotten when its argument contract changes.
    return hashlib.sha256(REMOTE_CHECK.encode()).hexdigest()


def installed_land_check_digest(a: dict) -> str:
    if a.get("local"):
        try:
            return hashlib.sha256(Path(a["path"], ".git", "land-check").read_bytes()).hexdigest()
        except FileNotFoundError:
            return ""
    return ssh(a, "shasum -a 256 ~/bin/land-check 2>/dev/null | cut -c1-64", timeout=60).stdout.strip()


def install_land_check(team: Team, a: dict) -> str | None:
    try:
        if a.get("local"):                           # a clone on this machine (teams without a remote machine)
            if not Path(a["path"], ".git").exists():
                r = git(team.repo, "clone", "-q", "--shared", "--no-checkout", str(team.repo), a["path"], check=False)
                if r.returncode:
                    return r.stderr.strip()
                codeteam_tm.exclude([Path(a["path"])])    # the validation clone and its builds
            root_links(team, a["path"])
            tmp = Path(a["path"], ".git", "land-check.new")  # rename so a running shell keeps reading its copy
            tmp.write_text(REMOTE_CHECK)
            os.replace(tmp, Path(a["path"], ".git", "land-check"))
            return None
        r = ssh(a, f"mkdir -p ~/bin && cat > ~/bin/land-check.new && chmod +x ~/bin/land-check.new && "
                   f"mv ~/bin/land-check.new ~/bin/land-check && cd {a['path']} && git rev-parse --git-dir",
                timeout=60, input=REMOTE_CHECK)
        if r.returncode:
            return r.stderr.strip()
        ms = int(a.get("slow_ms", 0))
        conf = (f"OTHER_SWIFT_FLAGS = $(inherited) -Xfrontend -warn-long-function-bodies={ms} "
                f"-Xfrontend -warn-long-expression-type-checking={ms}\n") if ms else ""
        ssh(a, "cat > ~/land-slow.xcconfig.new && mv ~/land-slow.xcconfig.new ~/land-slow.xcconfig" if ms
            else "rm -f ~/land-slow.xcconfig", timeout=60, input=conf)
        return None
    except (OSError, SystemExit, subprocess.TimeoutExpired) as ex:
        return str(ex)


def ensure_land_check(team: Team, a: dict) -> str | None:
    try:
        if installed_land_check_digest(a) == land_check_digest():
            return None
    except (Exception, SystemExit):
        pass                                        # an unreadable installed copy also needs reinstalling
    error = install_land_check(team, a)
    if error is None:
        return None
    return (f"Installed land-check is stale (differs from this codeteam-land's) and could not be reinstalled: "
            f"{error!r}. Manual fix: codeteam-land {team.manifest} alpha-install")


def cmd_alpha_install(team, args):
    a = alpha_cfg(team) or die("no [land.remote] host, path and suite in the manifest")
    error = install_land_check(team, a)
    if error is not None:
        die(f"alpha-install failed: {error}")
    if a.get("local"):
        print(f"installed land-check in {a['path']}")
        return
    print(f"installed ~/bin/land-check on {a['host']}; clone {a['path']} ok")


def clone_shell_path(path: str) -> str:
    # Remote manifests use ~/...; quote the suffix without suppressing the remote home's expansion.
    return '"$HOME"/' + shlex.quote(path[2:]) if path.startswith("~/") else shlex.quote(path)


def run_land_check(team: Team, a: dict, h: str, group: str) -> dict:
    """Run the installed land-check and decode its final result line."""
    suite = a["suite"].replace("{zones}", " ".join(shlex.quote(d) for ds in team.zones.values() for d in ds))
    keep = " ".join(a.get("keep", []))
    # ssh does not inherit the local team environment: pass the hang rule and selected group explicitly.
    settings = " ".join(f"{key}={shlex.quote(value)}" for key, value in hang_settings(team.cfg).items())
    # GROUP as well as CODETEAM_TEST_GROUP, as Stage 2 sets both: a repo Makefile's test-one reads GROUP (e.g.
    # TEST_GROUP=${GROUP:-unit}), so without it Stage 6 ran a product's unit tests.
    cmd = (f"cd {clone_shell_path(a['path'])} && LAND_KEEP={shlex.quote(keep)} GROUP={shlex.quote(group)} "
           f"CODETEAM_TEST_GROUP={shlex.quote(group)} "
           f"{'' if a.get('local') else settings + ' '}~/bin/land-check {h} {shlex.quote(suite)} "
           f"{shlex.quote(toolchain_cmd(a))} {toolchain_fp(a)}")
    if a.get("local"):
        cmd = cmd.replace("~/bin/land-check", "sh .git/land-check", 1)
        # Validation measures performance: serialize local suites so they do not compete with one another.
        lockf = HERE.parent / "run" / "validation-local.lock"
        lockf.parent.mkdir(parents=True, exist_ok=True)
        with open(lockf, "a") as lk:
            fcntl.flock(lk, fcntl.LOCK_EX)
            r = subprocess.run(cmd, shell=True, capture_output=True, text=True,
                               env=dict(team_env(team, group=None), **a.get("remote_env", {})))
    else:
        r = ssh(a, cmd)
    line = (r.stdout.strip().splitlines() or [""])[-1]
    return json.loads(line, strict=False) if line.startswith("{") else {"hash": h, "result": "error",
                                                              "detail": (r.stdout + r.stderr)[-300:]
                                                              or ("ssh timed out" if r.returncode == 124 else "")}


def check_at(team: Team, a: dict, h: str, group: str, before: Callable | None = None) -> dict:
    """Push h, ensure land-check is current, then run the tier; the caller owns recording the result."""
    # Only install_land_check makes a local tier's clone: install first when it is missing, or the push below fails
    # on every run and the clone is never made.
    if a.get("local") and not Path(a["path"], ".git").exists() and (detail := ensure_land_check(team, a)) is not None:
        return {"hash": h, "result": "toolchain", "detail": detail, "time": now()}
    dest = a["path"] if a.get("local") else f"{a['host']}:{a['path']}"
    # --no-verify: a transport to codeteam's own check clone, not a push of the product (its pre-push gates and LFS
    # upload are for GitHub).
    push = git(team.repo, "push", "-q", "--force", "--no-verify", dest, f"{h}:refs/codeteam/check/{h[:12]}", check=False)
    if push.returncode:
        res = {"hash": h, "result": "error", "detail": f"push to {a['host']} failed: {push.stderr.strip()[:300]}"}
    elif (detail := ensure_land_check(team, a)) is not None:
        res = {"hash": h, "result": "toolchain", "detail": detail}
    else:
        disk = before(team, a) if before else None
        res = run_land_check(team, a, h, group)
        if disk is not None:
            res["disk"] = disk
    return res | {"time": now()}


def alpha_check(team: Team, a: dict, h: str) -> dict:
    """Migrate's check uses the validation tier but appends only its own results.jsonl row."""
    res = check_at(team, a, h, "validation")
    with (team.dir / "results.jsonl").open("a") as file:
        file.write(json.dumps(res) + "\n")
    return res


SLOW_RE = re.compile(r"^(?P<path>[^:\s]+\.swift):(?P<line>\d+):(?P<col>\d+): warning: (?P<what>.+?) took (?P<ms>\d+)ms to type-check")


def slow_site(path, line, what):
    """A site's identity from one survey to the next: a named function by file and name (an edit above it moves its
    line); an expression or a closure by file, line and text."""
    return (path, what) if "'" in what else (path, line, what)


def slow_new(rows, prev_rows, reported, changed, seen=frozenset()):
    """The sites new to the code: over the line now, and either in a file the work landed
    since the last survey changed and never over the line in any survey before, or over the line in two surveys
    running and never reported. A run type-checks only what it rebuilds, so a site can be missing from one survey and
    back in the next with the same time (one test function
    measured 869 ms both times); that is not new code. changed: the files changed since the last survey, or None when that
    is not known. seen: every site over the line in any survey so far."""
    prev = {slow_site(*r[:3]) for r in prev_rows}
    new = []
    for r in rows:
        site = slow_site(*r[:3])
        if changed is not None and r[0] in changed:
            fresh = site not in prev and site not in seen
        else:
            fresh = site in prev and site not in reported
        if fresh:
            new.append(r)
    return new


def slow_previous(team, h):
    """(last survey's commit or None, its rows, the sites already reported, every site seen over the line) from
    <team>/land/slow-compile.json. The first format was a bare list of rows: its commit is the last validation that
    could have surveyed, and every site in it counts as reported and seen, so the first survey under the new rule names
    only what is new to the code."""
    p = team.dir / "slow-compile.json"
    data = json.loads(p.read_text()) if p.exists() else {}
    if isinstance(data, list):
        prev = next((row["commit"] for row in reversed(validation_rows(team))
                     if row.get("result") in ("pass", "fail") and row.get("commit") != h), None)
        sites = {slow_site(*r[:3]) for r in data}
        return prev, data, sites, set(sites)
    rows = data.get("rows", [])
    reported = {tuple(x) for x in data.get("reported", [])}
    seen = {tuple(x) for x in data.get("seen", [])} | {slow_site(*r[:3]) for r in rows} | reported
    return data.get("commit"), rows, reported, seen


def slow_changed(team, prev, h):
    if not prev:
        return None
    r = git(team.repo, "diff", "--name-only", prev, h, check=False)
    return set(r.stdout.split()) if r.returncode == 0 else None


def slow_report(team, a, h):
    """The slow-compile survey of one validation run on the remote machine: every Swift function or expression over [land.remote]
    slow_ms, from the run's log; written to <team>/land/slow-compile.md (worst first, one row per site) and, when
    sites are new to the code (slow_new), a NOTE to the orchestrator. Code to review for compile speed, not failures."""
    r = ssh(a, f"grep -h 'ms to type-check' ~/land-check-logs/{h}.log 2>/dev/null | sort -u", timeout=300)
    sites = {}
    root = a["path"].rstrip("/").replace("~", "")
    for line in r.stdout.splitlines():
        m = SLOW_RE.match(line.strip())
        if not m:
            continue
        path = m["path"]
        for cut in ("/^src/", f"/landing/{team.repo.stem}/", root + "/"):
            if cut in path:
                path = path.split(cut, 1)[1]
                break
        key = (path, int(m["line"]), m["what"])
        sites[key] = max(sites.get(key, 0), int(m["ms"]))
    prev, prev_rows, reported, seen = slow_previous(team, h)
    rows = sorted(([*k, v] for k, v in sites.items()), key=lambda x: -x[3])
    new = slow_new(rows, prev_rows, reported, slow_changed(team, prev, h), seen)
    reported |= {slow_site(*r[:3]) for r in new}
    seen |= {slow_site(*r[:3]) for r in rows}
    (team.dir / "slow-compile.json").write_text(json.dumps({
        "commit": h, "rows": rows, "reported": sorted(map(list, reported), key=str),
        "seen": sorted(map(list, seen), key=str)}) + "\n")

    def table(rs):
        return ["| ms | Zone | Where | What |", "|---|---|---|---|"] + [
            f"| {ms} | {zone_of_file(team, path) or '-'} | `{path}:{ln}` | {what} |" for path, ln, what, ms in rs]
    lines = [f"# Slow to compile: Swift code over {a.get('slow_ms')} ms to type-check",
             f"", f"Validation of landing {h[:10]} on the remote machine, {now()}. Review these for compile speed; "
             "they are not failures.", ""]
    if new:
        lines += [f"## New to the code ({len(new)})", "", "In a file changed since the last survey"
                  + (f" ({prev[:10]})" if prev else "") + " and not over the line in it, or over the line in two "
                  "surveys running for the first time.", "", *table(new), "", f"## All ({len(rows)})", ""]
    (team.dir / "slow-compile.md").write_text("\n".join(lines + table(rows)) + "\n")
    if new:
        top = "; ".join(f"{p}:{l} {w} {m}ms" for p, l, w, m in new[:5])
        team.notify(team.c("orchestrator", "orc"), "NOTE",
                    f"Slow-compile survey (remote validation {h[:10]}): {len(new)} Swift site(s) new to the code "
                    f"over {a.get('slow_ms')} ms to type-check (in a file changed since the last survey, or over in "
                    f"two surveys running), {len(rows)} in all. Worst new: {top}. Report: "
                    f"{team.dir / 'slow-compile.md'}. Route each to its zone as review work when it suits.")


def validation_rows(team: Team) -> list[dict]:
    path = team.dir / "validation-results.jsonl"
    return [json.loads(line) for line in path.read_text().splitlines() if line.strip()] if path.exists() else []


def last_validated(rows: list[dict]) -> str | None:
    return next((row["commit"] for row in reversed(rows) if row["result"] in ("pass", "fail", "hung")), None)


def stage6_target(team: Team) -> str | None:
    # Migration holds this lock through the move record, refs and recheck line; read them as one snapshot.
    with Lock(team):
        T = move_tip(team)
        rows = read_recheck(team)
        commits = out(team.repo, "rev-list", "--first-parent", team.landing).splitlines()
        move = next((row for row in rows if row.get("move") is True), None)
        if T is not None and (move is None or "done" not in move):
            return None
        try:
            return rechecked_commit(commits, [row["M"] for row in rows if "done" not in row], T, ancestry(team),
                                    set_inner_commits(team))
        except PromotionRefused as ex:
            # Undecidable ancestry holds validation; raised, it would end the runner and launchd would loop it.
            print(f"Stage 6 holds: {ex}", file=sys.stderr, flush=True)
            return None


def rechecked_commit(commits: list[str], pending: list[str], T: str | None,
                     is_ancestor: Callable[[str, str], bool], inner: set[str] = frozenset()) -> str | None:
    """The newest landing commit with no pending recheck at or before it; never one inside a --with set."""
    for C in commits:
        if T is not None and not is_ancestor(T, C):
            break
        if C not in inner and not any(is_ancestor(M, C) for M in pending):
            return C
        if C == T:
            break
    return None


def validate_due(rows: list[dict], target: str | None, now_ts: float, retry_s: float) -> bool:
    if target is None or target == last_validated(rows):
        return False
    latest = next((row for row in reversed(rows) if row["commit"] == target), None)
    return not (latest and latest["result"] in ("error", "toolchain")
                and now_ts - dt.datetime.fromisoformat(latest["time"]).timestamp() < retry_s)


def validation_tests(res: dict, steps_log: str | None, open_names: list[str]) -> list[dict]:
    suite = {"name": "suite", "result": res["result"], "seconds": res.get("seconds")}
    if steps_log is not None:
        tests = [{"name": match[2], "result": match[1].lower(), "seconds": float(match[3])}
                 for line in steps_log.splitlines()
                 if (match := re.fullmatch(r"(PASS|FAIL|HUNG) (.+) \((\d+) s\)", line))]
        if res["result"] in ("fail", "hung") and not any(test["result"] == res["result"] for test in tests):
            tests.append(suite)
        return tests
    return team_validation_tests(res, open_names)


def team_validation_tests(res: dict, open_names: list[str]) -> list[dict]:
    """A team's suite names failing zones or modules; a pass also clears its open test names."""
    suite = {"name": "suite", "result": res["result"], "seconds": res.get("seconds")}
    if res["result"] == "pass":
        return [suite, *({"name": name, "result": "pass", "seconds": None} for name in open_names)]
    failed = re.findall(r"(?:^|[|\n])\s*FAILED (?:ZONES|MODULES):([^|\n]*)", res.get("tail", ""))
    if res["result"] in ("fail", "hung") and failed:
        names = list(dict.fromkeys(failed[-1].split()))
        tests = [{"name": name, "result": "fail", "seconds": None} for name in names]
        tests.extend({"name": name, "result": "pass", "seconds": None} for name in open_names if name not in names)
        if res["result"] == "hung":
            tests.append(suite)
        return tests
    return [suite]


def validation_zone(team: Team, name: str) -> str:
    if name in team.zones:
        return name
    if match := re.fullmatch(r"tests (.+) \(.+\)", name):
        return match[1]
    if name == "suite" or name == team.c("validation_tests", "tests/validation") or name.startswith("validation tests ("):
        return "orc"
    if zone := zone_of_file(team, name):
        return zone
    return zone_of_file(team, name.replace(".", "/") + ".py") or "orc"


def open_validation_finding(team: Team, C: str, test: dict, when: str) -> None:
    """Allocate and route one failure while the caller holds FindingsLock."""
    items = load_findings(team, "validation")
    fid = f"validation#{len(items) + 1}"
    zone = validation_zone(team, test["name"])
    what = f"{test['name']} {'hangs' if test['result'] == 'hung' else 'fails'} in validation at C {C[:10]}"
    if test.get("failing"):
        what += f"; failing tests: {', '.join(test['failing'])}"
    items.append({"id": fid, "time": when, "by": "validation", "also": [], "feature": "validation", "wos": [],
                  "zone": zone, "where": test["name"], "severity": 2, "kind": "test", "what": what,
                  "belongs": "", "state": "open", "fixed_by": None, "closed": None, "reason": None,
                  "test": test["name"], "commits": [C]})
    save_findings(team, "validation", items)
    team.notify(team.c("orchestrator", "orc") if zone == "orc" else f"Coord-{zone}", "REQUEST",
                f"FIX-FORWARD {fid} | zone {zone} | test {test['name']} | C {C[:10]} | {what}. "
                f"Route as a work order; it lands with codeteam-land {team.manifest} land <wo> --fixes {fid}."
                + landing_fix_note(team, C))


def apply_validation_findings(team: Team, C: str, tests: list[dict], when: str) -> None:
    with FindingsLock(team):
        changes = recheck_findings(tests, [fix for fix in all_findings(team)
                                          if fix["state"] == "open" and fix.get("by") == "validation"])
        for name in changes["open"]:
            open_validation_finding(team, C, next(test for test in tests if test["name"] == name), when)
        for fid in changes["add"]:
            feature = fid.rsplit("#", 1)[0]
            items = load_findings(team, feature)
            commits = next(item for item in items if item["id"] == fid)["commits"]
            if C not in commits:
                commits.append(C)
                save_findings(team, feature, items)
    # update_finding acquires its own lock. Record C so Stage 7 can recognize
    # that this passing run closes the finding on C itself.
    for fid in changes["close"]:
        update_finding(team, fid, state="closed", closed=when, fixed_by=None, closed_at=C,
                       reason=f"passes in validation at C {C[:10]}")


# Above a 35 GiB disk stop some tools use, with room for one validation build's growth.
DISK_FLOOR_GIB = 60


def df_free_gib(text: str) -> float | None:
    for line in text.splitlines()[1:]:
        columns = line.split()
        if len(columns) >= 6:
            try:
                return int(columns[3]) / (1024 * 1024)
            except ValueError:
                return None
    return None


def floor_clean_command(path: str, keep: list[str]) -> str:
    # A negated ignore rule makes a kept folder not-ignored, so -X leaves it. An exclude pathspec (":!path") does not:
    # git clean -d removes an ignored folder whole (2026-11-11: a model's weights went).
    keeps = " ".join(f"-e {shlex.quote('!/' + entry.strip('/'))}" for entry in [".codegraph", *keep])
    return f"cd {clone_shell_path(path)} && git clean -q -f -d -X {keeps} -- ."


def disk_check(team: Team, a: dict) -> dict:
    df = ssh(a, f"df -Pk {clone_shell_path(a['path'])}")
    free = df_free_gib(df.stdout)
    if df.returncode or free is None:
        return {"error": df.stderr.strip() or "unreadable df output"}
    floor = a.get("disk_floor_gib", DISK_FLOOR_GIB)
    disk = {"free_gib": free, "floor_gib": floor, "cleaned": False}
    if free >= floor:
        return disk
    clean = ssh(a, floor_clean_command(a["path"], a.get("keep", [])))
    if clean.returncode:
        return disk | {"error": clean.stderr.strip() or "disk-floor clean failed"}
    disk["cleaned"] = True
    df = ssh(a, f"df -Pk {clone_shell_path(a['path'])}")
    after = df_free_gib(df.stdout)
    if df.returncode or after is None:
        return disk | {"error": df.stderr.strip() or "unreadable df output after cleaning"}
    return disk | {"free_after_gib": after}


FAILURE_LINES = r"FAILED (ZONES|MODULES):|^test .* FAILED$"


def remote_failure_lines(a: dict, C: str) -> str:
    """The failing zones and tests from the validation machine's whole log for C: the result keeps only the log's
    tail, which may hold neither (two Rust failures were once recorded as 'suite')."""
    try:
        r = ssh(a, f"grep -hE {shlex.quote(FAILURE_LINES)} ~/land-check-logs/{C}.log 2>/dev/null | tail -400",
                timeout=120)
    except (OSError, subprocess.SubprocessError):
        return ""
    return r.stdout if r.returncode in (0, 1) else ""


FAILING_TEST_LINES = (
    re.compile(r"^test (\S+) \.\.\. FAILED$"),                              # Rust (cargo test, nextest's libtest)
    re.compile(r"Test Case '-\[(\S+) (\S+)\]' failed \("),                  # XCTest
    re.compile(r"Test case '([^']+)' failed"),                              # xcodebuild's per-case line
    re.compile(r"FAILED (\S+::\S+)"),                                       # pytest's summary
)
SWIFT_TESTING_FAILED = re.compile(r"(?:^|\s)Test (.+?) failed after [\d.]+ seconds")


def failing_test_names(text: str) -> list[str]:
    """The failing tests a test log names, in order, once each: Rust, XCTest, pytest, and Swift tests from xcodebuild's
    'Failing tests:' list or, when a log has none, Swift Testing's 'Test x failed after' lines (whose glyph prefix
    differs between swift test and xcodebuild)."""
    names, listed, swift = [], [], []
    in_list = False
    for line in text.splitlines():
        stripped = line.strip()
        if in_list:
            if stripped and line[:1].isspace():
                listed.append(stripped)
                continue
            in_list = False
        if stripped == "Failing tests:":
            in_list = True
            continue
        for pattern in FAILING_TEST_LINES:
            if m := pattern.search(stripped):
                names.append(".".join(m.groups()))
                break
        else:
            if (m := SWIFT_TESTING_FAILED.search(stripped)) and not m[1].startswith("run with "):
                swift.append(m[1])
    return list(dict.fromkeys(names + (listed or swift)))


def validation_test_rows(team: Team, a: dict, C: str, res: dict) -> list[dict]:
    if res["result"] not in ("pass", "fail", "hung"):
        return []
    steps_log = None
    if a.get("local") and a.get("steps"):
        log = Path.home() / "land-check-logs" / f"{C}.log"
        steps_log = log.read_text() if log.exists() else ""
    failing = []
    if not a.get("local") and res["result"] in ("fail", "hung"):
        lines = remote_failure_lines(a, C)
        res = dict(res, tail=res.get("tail", "") + "\n" + lines)
        failing = failing_test_names(lines)[:20]
    tests = validation_tests(res, steps_log,
                             list(dict.fromkeys(fix["test"] for fix in all_findings(team)
                                                if fix["state"] == "open" and fix.get("by") == "validation")))
    for test in tests:
        if failing and test["result"] in ("fail", "hung"):
            test["failing"] = failing
    return tests


def validate_one(team: Team, a: dict, C: str) -> dict:
    res = check_at(team, a, C, "validation", disk_check if not a.get("local") else None)
    if not a.get("local") and int(a.get("slow_ms", 0)) and res["result"] in ("pass", "fail"):
        try:
            slow_report(team, a, C)
        except Exception as ex:  # A survey must not lose the validation result.
            res["slow_report_error"] = f"{type(ex).__name__}: {ex}"
    tests = validation_test_rows(team, a, C, res)
    row = {"time": res["time"], "commit": C, "result": res["result"], "seconds": res.get("seconds"), "tests": tests}
    row.update({key: res[key] for key in ("detail", "disk", "slow_report_error") if key in res})
    if not team.lab:
        row["v54"] = True
    with (team.dir / "validation-results.jsonl").open("a") as file:
        file.write(json.dumps(row) + "\n")
    if res["result"] in ("error", "toolchain"):
        msg = f"validation could not run on {C[:10]}: {res.get('detail', res['result'])}"
        team.notify(team.c("orchestrator", "orc"), "NOTE", msg)
        tell_owner(team, f"codeteam {team.manifest.stem}: validation check not run", msg)
    else:
        apply_validation_findings(team, C, tests, row["time"])
    return row


def promote_validated(team: Team, C: str, row: dict) -> None:
    if not stage6_passed([row], C):
        return
    try:
        stage7(team, C)
    except PromotionRefused as ex:
        print(f"Stage 7 refused at {C[:10]}: {ex}", file=sys.stderr)


def run_validation_tick(team: Team, tier: dict, C: str) -> tuple[dict | None, tuple | None]:
    try:
        with (stage_admit("Stage 6", f"validation at {C[:10]}") if tier.get("local") else nullcontext()):
            job = (time.time(), lambda: f"Stage 6 validation at {C[:10]}")
            row = validate_one(team, tier, C)
    except RestartPending:
        return None, None
    # A promotion's docs stamp may need Stage 2 admission, so release Stage 6 first.
    promote_validated(team, C, row)
    return row, job


def due_validation(team: Team) -> tuple[dict, str] | None:
    if halted(team) or runner_unmoved(team, "validate-run"):
        return None
    C = stage6_target(team)
    tier = alpha_cfg(team)
    rows = stage_rows(team, validation_rows(team), move_tip(team))
    if tier and validate_due(rows, C, time.time(), float(team.c("validate_retry_min", 60)) * 60):
        return tier, C
    return None


def cmd_validate_run(team: Team, a) -> dict | None:
    with (team.dir / "validate-run.lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("a validation runner is already running")
            return None
        while True:
            drive_buildq_restart(team)
            if runner_restart(team, "validate-run"):
                return None
            row = None
            job = None
            due = due_validation(team)
            if due is not None:
                if runner_restart(team, "validate-run"):
                    return None
                row, job = run_validation_tick(team, *due)
            if runner_restart(team, "validate-run", job):
                return row
            if a.once:
                return row
            time.sleep(float(team.c("validate_poll_s", 60)))


def results(team):
    p = team.dir / "results.jsonl"
    return [json.loads(l) for l in p.read_text().splitlines() if l.strip()] if p.exists() else []


def stage6_passed(rows: list[dict], C: str) -> bool:
    row = next((row for row in reversed(rows) if row["commit"] == C), None)
    return row is not None and row["result"] == "pass" and all(test["result"] == "pass" for test in row["tests"])


def landed_hashes(team: Team) -> dict[str, str]:
    """Map every member of a landed set to its landing commit."""
    path = team.dir / "landed.log"
    rows = [json.loads(line) for line in path.read_text().splitlines() if line.strip()] if path.exists() else []
    return {wo: row["hash"] for row in rows if row.get("hash") for wo in row["wos"]}


def landings(team: Team) -> list[tuple[str, str, str | None]]:
    """Landed work orders in landing order: [(hash, wo, zone)]."""
    p = team.dir / "landed.log"
    rows = [json.loads(line) for line in p.read_text().splitlines() if line.strip()] if p.exists() else []
    return [(row["hash"], row["wos"][0], row.get("zone")) for row in rows if row.get("hash")]


def bisect_landing(team: Team, a: dict, hashes: list[str], good: set[str], bad: str) -> int:
    if bad not in hashes:
        die(f"{bad} is not a landing")
    hi = hashes.index(bad)
    lo = max((i for i, h in enumerate(hashes[:hi]) if h in good), default=-1)
    cand = list(range(lo + 1, hi + 1))  # The culprit is after the last pass and at or before bad.
    while len(cand) > 1:
        mid = cand[len(cand) // 2 - 1]
        res = check_at(team, a, hashes[mid], "validation")
        if res["result"] == "pass":
            cand = [i for i in cand if i > mid]
        elif res["result"] == "fail":
            cand = [i for i in cand if i <= mid]
        else:
            die(f"bisect stopped: {res.get('detail')}", 1)
    return cand[0]


def cmd_alpha_bisect(team: Team, args) -> None:
    """Probe validation without recording Stage 6 runs; report the first bad landing after confirming it.

    A bisect is run by hand and reverts nothing (SPEC-branch-flow-v5.1, alpha-bisect and revert)."""
    a = alpha_cfg(team) or die("no validation tier")
    seq = landings(team)
    hashes = [h for h, _, _ in seq]
    rows = validation_rows(team)
    good = {row["commit"] for row in rows if stage6_passed(rows, row["commit"])}
    index = bisect_landing(team, a, hashes, good, args.hash)
    h, wo, zone = seq[index]
    parent = hashes[index - 1] if index > 0 else out(team.repo, "rev-parse", f"{h}^")
    docs = tuple(team.c("docs_only_suffixes", [".md"]))
    files = out(team.repo, "diff", "--name-only", f"{h}^", h).split()
    orc = team.c("orchestrator", "orc")
    if files and all(f.endswith(docs) for f in files):
        team.notify(orc, "NOTE", f"validation bisect stopped at {wo} ({h[:10]}), a docs-only landing: not blamed and "
                                 "not reverted. The failure is older or flaky; the next landing's run tells.")
        return
    again = check_at(team, a, h, "validation")
    if again["result"] == "pass":
        team.notify(orc, "NOTE", f"validation bisect: {wo} ({h[:10]}) passed when run again: flaky, not reverted.")
        return
    if parent not in good:
        before = check_at(team, a, parent, "validation")
        if before["result"] != "pass":
            team.notify(orc, "NOTE", f"validation bisect: {h[:10]}'s parent {parent[:10]} fails too: the failure is "
                                     f"older than {wo}, which is not reverted.")
            return
    team.notify(orc, "NOTE", f"validation bisect: {wo} (landed at {h[:10]}, zone {zone}) broke the validation suite.")
    team.notify(f"Coord-{zone}", "NOTE", f"validation bisect: {wo} (landed at {h[:10]}) broke landing's "
                                         "validation suite.")
    print(f"culprit: {wo} at {h[:10]} (zone {zone})")


class PromotionRefused(Exception):
    """A Stage 7 refusal reason for the runner to log or the CLI to report."""


def closing_commit(finding: dict, landed: dict[str, str]) -> str | None:
    # A named fix must resolve to its landing; a missing landing is not proof of closure in C.
    if finding.get("fixed_by"):
        return landed.get(finding["fixed_by"])
    if finding.get("closed_at"):
        return finding["closed_at"]
    if match := re.match(r"passes (?:in validation at C|at M) ([0-9a-fA-F]+)\b", finding.get("reason") or ""):
        return match[1]
    return None


def ancestry(team: Team) -> Callable[[str, str], bool]:
    # Cache repeated comparisons within this gate; an indeterminate git result must not admit a candidate.
    @cache
    def is_ancestor(a: str, b: str) -> bool:
        result = git(team.repo, "merge-base", "--is-ancestor", a, b, check=False)
        if result.returncode not in (0, 1):
            raise PromotionRefused(f"cannot determine git ancestry of {a} and {b} (exit {result.returncode})")
        return result.returncode == 0

    return is_ancestor


def promotion_stamp(team: Team, h: str, base: str) -> None:
    """Queue a later stamp; a stamp failure is reported without holding the proven promotion."""
    try:
        stamp = stamp_docs(team, h, base)
    except (SystemExit, Exception) as ex:
        why = str(ex) if isinstance(ex, StampFailed) else f"{type(ex).__name__}: {ex} (the reason is in validate-run.log)"
        message = f"Document stamp failed for {h}: {why}\nPromoted without a stamp; its documents stay owed to the next one."
        print(message, file=sys.stderr)
        team.notify(team.c("orchestrator", "orc"), "NOTE", " | ".join(x.strip() for x in message.splitlines() if x.strip()))
        return
    if stamp:
        print(f"Document stamp {stamp} queued for landing; it reaches base with a later promotion.", file=sys.stderr)


def stage7(team: Team, C: str) -> str:
    """Persist promotion intent before moving refs; replay all effects before deleting that intent."""
    with Lock(team):
        path = team.dir / "promote.json"
        if path.exists():
            record = json.loads(path.read_text())
        else:
            check_promotion(team, C)
            old_integration = out(team.repo, "rev-parse", team.integration)
            current_base = out(team.repo, "rev-parse", team.m.get("base", "main"))
            if current_base == old_integration and (C == current_base or ancestry(team)(C, current_base)):
                return current_base
            record = {"C": C, "old_integration": old_integration, "time": now()}
            save_record(path, record)
        finish_promotion(team, record)
        path.unlink()
        return record["C"]


def check_promotion(team: Team, C: str) -> None:
    T = move_tip(team)
    if T is not None and C != T and not ancestry(team)(T, C):
        raise PromotionRefused(f"{C} is before the v5.4 move-over tip {T}")
    if C in set_inner_commits(team):
        raise PromotionRefused(f"{C[:10]} is inside a --with set's landing; only the set's last commit holds all of it")
    if not stage6_passed(stage_rows(team, validation_rows(team), T), C):
        raise PromotionRefused(f"{C} has no passing Stage 6 validation; every test must pass")
    if blocked := unfixed_failures(C, all_findings(team), landed_hashes(team), ancestry(team)):
        raise PromotionRefused(f"{C} has test failures not fixed at or before it: {', '.join(blocked)}")
    if not ancestry(team)(C, team.landing):
        raise PromotionRefused(f"{C[:10]} is not on {team.landing}")
    if not team.lab and (holders := integration_holders(team)):
        raise PromotionRefused("landing or integration is checked out in " + ", ".join(holders))
    if out(team.repo, "rev-parse", "--abbrev-ref", "HEAD") != team.m.get("base", "main"):
        raise PromotionRefused(f"the base checkout {team.repo} is not on {team.m.get('base', 'main')}")


def finish_promotion(team: Team, record: dict) -> None:
    C, old = record["C"], record["old_integration"]
    base = team.m.get("base", "main")
    if out(team.repo, "rev-parse", "--abbrev-ref", "HEAD") != base:
        raise PromotionRefused(f"the base checkout {team.repo} is not on {base}")
    if not ancestry(team)(C, base):
        result = git(team.repo, "merge", "--ff-only", "-q", C, check=False,
                     env=dict(os.environ, **{LAND_TOOL_ENV: "1"}))
        if result.returncode:
            raise PromotionRefused(f"the base checkout {team.repo} could not move to {C[:10]}: "
                                   f"{(result.stderr or result.stdout).strip()[-400:]}")
    sync_integration(team)
    team.log({"time": now(), "promote": C, "to": base})
    promoted_notices(team, old, C)
    after_promote(team, old, C)
    promotion_stamp(team, C, old)
    print(f"promoted {C[:10]} to {base}")


def sync_integration(team: Team) -> bool:
    base = out(team.repo, "rev-parse", team.m.get("base", "main"))
    old = out(team.repo, "rev-parse", team.integration)
    if old == base:
        return False
    if not team.lab and (holders := integration_holders(team)):
        raise PromotionRefused("landing or integration is checked out in " + ", ".join(holders))
    if not ancestry(team)(old, base):
        raise PromotionRefused(f"{team.integration} is not an ancestor of base; refusing to overwrite it")
    result = git(team.repo, "update-ref", f"refs/heads/{team.integration}", base, old, check=False,
                 env=dict(os.environ, **{LAND_TOOL_ENV: "1"}))
    if result.returncode:
        raise PromotionRefused(f"could not sync {team.integration} to base: {result.stderr.strip()}")
    return True


def unfixed_failures(C: str, findings: Iterable[dict], landed: dict[str, str],
                     is_ancestor: Callable[[str, str], bool]) -> list[str]:
    blocked = []
    for finding in findings:
        if "test" not in finding:
            continue
        if finding["state"] == "dropped":
            continue                    # a dropped finding holds nothing; its reason stays on record
        if not any(commit == C or is_ancestor(commit, C) for commit in finding.get("Ms", []) + finding.get("commits", [])):
            continue
        closing = closing_commit(finding, landed)
        if finding["state"] != "closed" or closing is None or not (closing == C or is_ancestor(closing, C)):
            blocked.append(finding["id"])
    return blocked


def promotion_target(team: Team) -> str | None:
    T = move_tip(team)
    rows = stage_rows(team, validation_rows(team), T)
    is_ancestor = ancestry(team)
    findings, landed, inner = list(all_findings(team)), landed_hashes(team), set_inner_commits(team)
    return next((row["commit"] for row in reversed(rows)
                 if row["commit"] not in inner and (T is None or row["commit"] == T or is_ancestor(T, row["commit"]))
                 and stage6_passed(rows, row["commit"]) and is_ancestor(row["commit"], team.landing)
                 and not unfixed_failures(row["commit"], findings, landed, is_ancestor)), None)


class RestartPending(Exception):
    pass


_stage_sequence = count()


def buildq_dir() -> Path:
    return Path(os.environ.get("CODETEAM_QUEUE_DIR") or HERE.parent / "run" / "queue")


@contextmanager
def restart_lock(qdir: Path) -> Iterator[Path]:
    rdir = qdir.parent / "restart"
    rdir.mkdir(parents=True, exist_ok=True)
    with (rdir / ".lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield rdir


@contextmanager
def stage_admit(stage: str, name: str, qdir: Path | None = None,
                holds: tuple[str, list[str]] | None = None) -> Iterator[None]:
    """Admit a stage run unless a build queue restart is pending. holds=(team key, work orders): the run works in those
    work orders' trees and records, so it is refused while a live run of the same team holds any of them (a second land of a work order mid Stage 2 read the set's merge in its tree and was refused for
    another member's files)."""
    with restart_lock(qdir if qdir is not None else buildq_dir()) as rdir:
        if (rdir / "buildq.json").exists():
            raise RestartPending
        stages = rdir / "stages"
        stages.mkdir(exist_ok=True)
        row = {"stage": stage, "name": name, "pid": os.getpid(), "started": now()}
        if holds:
            for other in stage_holders(rdir, *holds):
                wo = next(w for w in holds[1] if w in other["wos"])
                die(f"{wo}: a land of it is already running (pid {other['pid']}, {other['stage']} {other['name']}, "
                    f"since {other['started']}). Its tree stays on that run's merge until it ends: wait for its result, "
                    f"or stop it with `kill -TERM {other['pid']}` (never -9), which puts the tree back on its branch.")
            row.update(team=holds[0], wos=list(holds[1]))
        path = stages / f"{os.getpid()}-{next(_stage_sequence)}.json"
        path.write_text(json.dumps(row) + "\n")
    # Admission protects the whole run; the flock protects only its check-and-write.
    try:
        yield
    finally:
        path.unlink(missing_ok=True)


def stage_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def stage_wos(row: dict) -> list[str]:
    """The work orders a stage record holds: its wos, or, for a land recorded by an older version (no team, no wos), the names
    in its Stage 2 name "check of a, b" (the next land puts a set merge back, so such a land must hold too)."""
    if "wos" in row:
        return row["wos"]
    name = row.get("name", "")
    return name.removeprefix("check of ").split(", ") if row.get("stage") == "Stage 2" and name.startswith("check of ") \
        else []


def stage_holders(rdir: Path, team_key: str, wos: list[str], alive: Callable[[int], bool] = stage_alive) -> list[dict]:
    """The live admissions of other processes for team_key that hold any of wos; a dead one is skipped and left for
    live_stages to remove. A record from an older version has no team and counts for every team."""
    held = []
    for path in sorted((rdir / "stages").glob("*.json")):
        try:
            row = json.loads(path.read_text())
        except FileNotFoundError:
            continue                    # A stage may finish during the scan.
        if (row.get("team", team_key) == team_key and row["pid"] != os.getpid() and set(stage_wos(row)) & set(wos)
                and alive(row["pid"])):
            held.append(row)
    return held


def live_stages(rdir: Path, alive: Callable[[int], bool] = stage_alive) -> list[str]:
    live = []
    for path in sorted((rdir / "stages").glob("*.json")):
        try:
            row = json.loads(path.read_text())
        except FileNotFoundError:
            continue                    # A stage may finish during the scan.
        if alive(row["pid"]):
            live.append(f"{row['stage']} {row['name']}")
        else:
            path.unlink(missing_ok=True)
    return live


def landing_jobs_running(qdir: Path) -> list[str]:
    jobs = []
    for path in sorted(qdir.glob("*.json")):
        if path.name.startswith("."):
            continue
        try:
            row = json.loads(path.read_text())
        except FileNotFoundError:
            continue                    # The queue may retire a finished job during the scan.
        if row.get("state") in ("queued", "running") and row.get("env", {}).get("CODETEAM_LANDING") == "1":
            jobs.append(f"{row['ticket']} ({row['key']})")
    return jobs


def save_buildq_restart(rdir: Path, request: dict) -> None:
    temporary = rdir / "buildq.tmp"
    temporary.write_text(json.dumps(request) + "\n")
    temporary.replace(rdir / "buildq.json")


def request_buildq_restart(qdir: Path, tip: str, files: list[str]) -> None:
    with restart_lock(qdir) as rdir:
        save_buildq_restart(rdir, {"requested": now(), "requested_ts": time.time(), "tip": tip,
                                  "files": files, "waited": []})


def buildq_restart_step(team: Team, qdir: Path | None = None, kickstart: Callable | None = None,
                       alive: Callable[[int], bool] = stage_alive) -> bool:
    qdir = qdir if qdir is not None else buildq_dir()
    if not (qdir.parent / "restart" / "buildq.json").exists():
        return False
    with restart_lock(qdir) as rdir:
        path = rdir / "buildq.json"
        if not path.exists():
            return False
        request = json.loads(path.read_text())
        live = live_stages(rdir, alive) + landing_jobs_running(qdir)
        request["waited"] = list(dict.fromkeys([*request["waited"], *live]))
        save_buildq_restart(rdir, request)
        if live:
            return False
        try:
            if kickstart is None:
                subprocess.run(["launchctl", "kickstart", "-k", f"gui/{os.getuid()}/{LAUNCHD_PREFIX}.codeteam-buildq"], check=True)
            else:
                kickstart()
        except (OSError, subprocess.CalledProcessError) as ex:
            msg = f"Could not restart {LAUNCHD_PREFIX}.codeteam-buildq at {request['tip'][:10]}: {ex}; restart it by hand"
        else:
            waited = (f"waited for: {', '.join(request['waited'])}" if request["waited"] else
                      "it had no Stage 2, 5 or 6 job running")
            msg = f"Restarted {LAUNCHD_PREFIX}.codeteam-buildq for {team.m.get('base', 'main')} {request['tip'][:10]}; {waited}"
        try:
            team.notify(team.c("orchestrator", "orc"), "NOTE", msg)
        finally:
            path.unlink()
        return True


def drive_buildq_restart(team: Team) -> None:
    if not own_checkout(team):
        return
    try:
        buildq_restart_step(team)
    except Exception as ex:
        print(f"buildq_restart_step: {type(ex).__name__}: {ex}", file=sys.stderr, flush=True)


def restart_targets(files: Iterable[str]) -> dict[str, bool]:
    files = set(files)
    return {"loops": bool(files & {"bin/codeteam", "share/codeteam_launchd.py"}) or
                     any(path.startswith(("v2/codeteam2/", "v2/bin/")) for path in files),
            "runners": bool(files & {"bin/codeteam-land", "share/codeteam_launchd.py"}),
            "buildq": bool(files & {"bin/codeteam-buildq", "share/codeteam_hang.py"})}


def own_checkout(team: Team) -> bool:
    return team.repo.resolve() == HERE.parent.resolve()


def loop_processes() -> dict[Path, list[int]]:
    """Group codeteam2 run process IDs by resolved manifest path; session processes and shell parents do not match."""
    processes = {}
    pattern = re.compile(r"\s*(\d+)\s+(?:(?:\S*/)?[Pp]ython[\d.]*(?:\s+-\S+)*\s+)?"
                         r"(?:\S*/)?codeteam2\s+run\s+(.+?)\s*")
    listing = subprocess.run(["ps", "-axo", "pid=,command="], capture_output=True, text=True, check=True)
    for line in listing.stdout.splitlines():
        if match := pattern.fullmatch(line):
            manifest = Path(match[2]).expanduser().resolve()
            processes.setdefault(manifest, []).append(int(match[1]))
    return processes


def wait_loop_exit(target: Team) -> bool:
    lock_path = (target.root if "worktree_root" in target.m else
                 WORKSPACE / f"{target.m['product']}-team") / "team" / "v2" / "run.lock"
    if not lock_path.exists():
        return True
    # Promotion has already moved the base; a stuck loop must not hold up all other restarts.
    deadline = time.monotonic() + 30
    with lock_path.open("a") as lock:
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                fcntl.flock(lock, fcntl.LOCK_UN)
                return True
            except BlockingIOError:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    return False
                time.sleep(min(0.1, remaining))


def restart_loops(teams: list[Team], tip: str, processes: dict[Path, list[int]]) -> None:
    for target in teams:
        pids = processes.get(target.manifest, [])
        if not pids:
            continue
        for pid in pids:
            try:
                os.kill(pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
        if not wait_loop_exit(target):
            msg = f"Could not restart codeteam2 loop for {target.manifest.stem} at {tip[:10]}: run.lock still held after 30 s."
            print(msg, file=sys.stderr)
            target.notify(target.c("orchestrator", "orc"), "NOTE", msg)
            continue
        try:
            subprocess.run([str(HERE.parent / "v2" / "bin" / "codeteam2"), "ensure-loop", str(target.manifest)], check=True)
        except (subprocess.CalledProcessError, OSError) as ex:
            msg = f"Could not restart codeteam2 loop for {target.manifest.stem} at {tip[:10]}: ensure-loop failed: {ex}"
            print(msg, file=sys.stderr)
            target.notify(target.c("orchestrator", "orc"), "NOTE", msg)
            continue
        target.notify(target.c("orchestrator", "orc"), "NOTE",
                      f"Restarted codeteam2 loop for {target.manifest.stem} at {tip[:10]}; no session ended.")


def request_runner_restarts(teams: list[Team], tip: str) -> None:
    request = {"requested": now(), "requested_ts": time.time(), "tip": tip}
    for target in teams:
        if "land" not in target.m:
            continue
        directory = target.dir / "restart"
        for _, command, plist, _ in service_jobs(target):
            if not plist.exists():
                continue
            directory.mkdir(parents=True, exist_ok=True)
            path = directory / f"{command}.json"
            # Readers see a whole request even when they finish a job during this write.
            temporary = path.with_suffix(".tmp")
            temporary.write_text(json.dumps(request) + "\n")
            temporary.replace(path)


def after_promote(team: Team, old: str, new: str) -> None:
    if not own_checkout(team):
        return
    files = out(team.repo, "diff", "--name-only", old, new).splitlines()
    targets = restart_targets(files)
    teams = [Team(path, create=False) for path in sorted((HERE.parent / "teams").glob("*.toml"))]
    if targets["runners"]:
        request_runner_restarts(teams, new)
    if targets["loops"]:
        # The base has already moved: a failed process listing is reported, never raised past the promote.
        try:
            processes = loop_processes()
        except (subprocess.CalledProcessError, OSError) as ex:
            msg = f"codeteam2 loops not restarted at {new[:10]}: listing the processes with ps failed: {ex}"
            print(msg, file=sys.stderr)
            team.notify(team.c("orchestrator", "orc"), "NOTE", msg)
        else:
            # No matching team loops could mean the listing missed running loops; ask for a manual check.
            if not any(processes.get(t.manifest) for t in teams):
                msg = (f"codeteam2 loops not restarted at {new[:10]}: ps listed no codeteam2 run loop for any team; "
                       "check the loops and restart them by hand")
                print(msg, file=sys.stderr)
                team.notify(team.c("orchestrator", "orc"), "NOTE", msg)
            restart_loops(teams, new, processes)
    if targets["buildq"]:
        request_buildq_restart(buildq_dir(), new, [path for path in files
                                                 if path in ("bin/codeteam-buildq", "share/codeteam_hang.py")])


def runner_restart(team: Team, command: str, job: tuple[float, Callable[[], str]] | None = None) -> bool:
    """At a whole-stage boundary, consume a request and let launchd's KeepAlive load the new program. The line goes to
    the runner's own log (<land>/<command>.log), not to the orchestrator: a routine restart asks nothing of it, and
    the watchdog reports a runner that does not come back (three NOTEs to every team for each
    move of codeteam's main, labelled with the team's base as if its own main had moved)."""
    path = team.dir / "restart" / f"{command}.json"
    if not path.exists():
        return False
    request = json.loads(path.read_text())
    waited = job[1]() if job is not None and job[0] < request["requested_ts"] else "it had no job running"
    runner = {"queue-run": "land", "recheck-run": "recheck", "validate-run": "validate"}[command]
    print(f"{now()} restarting {LAUNCHD_PREFIX}.codeteam-{runner}.{team.manifest.stem}: codeteam's landing tool changed "
          f"(codeteam {request['tip'][:10]}); waited for: {waited}", flush=True)
    path.unlink()
    return True


def promoted_notices(team: Team, old: str, new: str) -> None:
    files = out(team.repo, "diff", "--name-only", old, new).splitlines()
    is_ancestor = ancestry(team)
    wos = [wo for row in read_landing_rows(team) if row.get("hash") and is_ancestor(row["hash"], new)
           and not is_ancestor(row["hash"], old) for wo in row.get("wos", [])]
    for to, zones in promotion_coordinators(team, files).items():
        team.notify(to, "NOTE", f"Promoted {new} ({', '.join(wos) or 'no recorded work orders'}) to base and integration; "
                    f"changes your zones: {', '.join(zones)}; merge integration at your next stopping point.")
    msg = f"{team.m.get('base', 'main')} promoted to {new[:10]} (Stage 6 passed at {new[:10]})."
    team.notify(team.c("orchestrator", "orc"), "PUSHED", msg)
    for assistant in team.m.get("assistants") or []:
        if (assistant.get("role") or assistant.get("name") or "").lower() == "backporter":
            team.notify(assistant.get("name"), "PUSHED", msg + " Ship it: your EE checks on the new tip, then push it to GitHub.")


def promotion_coordinators(team: Team, files: list[str]) -> dict[str, list[str]]:
    reached = set(reach(team, team.repo, files)) if files else set()
    if files:
        reached.add("orc")
    open_zones = {json.loads(path.read_text())["zone"] for path in (team.dir / "wo").glob("*.json")
                  if not path.name.endswith((".landed.json", ".retired.json"))}
    coordinators = {}
    for zone in sorted(open_zones & reached):
        to = team.c("orchestrator", "orc") if zone == "orc" else f"Coord-{zone}"
        coordinators.setdefault(to, []).append(zone)
    return coordinators


def cmd_promote(team: Team, args) -> str:
    """Finish an interrupted promotion, or promote the requested or newest eligible validated landing."""
    try:
        pending = team.dir / "promote.json"
        if not pending.exists() and v54_unmoved(team):
            die(NOT_MOVED)
        C = json.loads(pending.read_text())["C"] if pending.exists() else args.hash or promotion_target(team)
        if C is None:
            raise PromotionRefused("nothing has passing Stage 6 validation with failures fixed at or before it")
        return stage7(team, C)
    except PromotionRefused as ex:
        die(str(ex))


def cmd_migrate_v54(team: Team, a) -> None:
    if team.lab:
        die("migrate-v54 is not for lab teams")
    if holders := integration_holders(team):
        die("landing or integration is checked out in " + ", ".join(holders))
    path = team.dir / "v54-move.json"
    with Lock(team):
        if path.exists():
            record = json.loads(path.read_text())
        else:
            if (team.dir / "promote.json").exists():
                die(f"finish the interrupted promotion first: codeteam-land {team.manifest} promote")
            if git(team.repo, "rev-parse", "-q", "--verify", f"refs/heads/{team.landing}", check=False).returncode == 0:
                die(f"{team.landing} already exists and was not created by migrate-v54")
            record = {"old_integration": out(team.repo, "rev-parse", team.integration),
                      "base": out(team.repo, "rev-parse", team.m.get("base", "main")), "started": now(), "done": []}
            save_record(path, record)
        migrate_v54_steps(team, path, record)
    print("migrate-v54 complete; recorded steps are settled")


def migrate_v54_steps(team: Team, path: Path, record: dict) -> None:
    old, base = record["old_integration"], record["base"]
    env = dict(os.environ, **{LAND_TOOL_ENV: "1"})
    landing = git(team.repo, "rev-parse", "-q", "--verify", f"refs/heads/{team.landing}", check=False)
    if landing.returncode:
        git(team.repo, "update-ref", f"refs/heads/{team.landing}", old, "", env=env)
    elif landing.stdout.strip() != old:
        die(f"{team.landing} moved from the recorded move-over hash {old}")
    move_done(path, record, "landing")
    cmd_install_hook(team, argparse_ns())
    move_done(path, record, "hook")
    if out(team.repo, "rev-parse", team.integration) != base:
        adopt = Path(out(team.repo, "rev-parse", "--path-format=absolute", "--git-common-dir")) / "codeteam-adopt"
        adopt.write_text(base + "\n")
        try:
            git(team.repo, "update-ref", f"refs/heads/{team.integration}", base, old, env=env)
        finally:
            adopt.unlink(missing_ok=True)
    move_done(path, record, "integration")
    if not any(row.get("move") for row in read_recheck(team)):
        with (team.dir / "recheck.jsonl").open("a") as file:
            file.write(json.dumps(recheck_row(old, "v54-move", [], team.zones, now()) | {"move": True}) + "\n")
    move_done(path, record, "recheck")
    move_backlog(team, base, old)
    move_done(path, record, "backlog")


def move_done(path: Path, record: dict, step: str) -> None:
    if step not in record["done"]:
        record["done"].append(step)
        save_record(path, record)


def move_backlog(team: Team, base: str, old: str) -> None:
    files = out(team.repo, "diff", "--name-only", base, old).splitlines()
    pending = []
    for zone in sorted(team.zones):
        if not touches_zone(team.zones, files, zone):
            continue
        path = team.dir / "reviews" / f"backlog-{safe(zone)}.json"
        if not path.exists():
            save_record(path, {"zone": zone, "from": base, "to": old, "state": "pending", "requested": None})
        row = json.loads(path.read_text())
        if row.get("requested") is None:
            pending.append((path, row))
    if not pending:
        return
    commands = [f"zone {row['zone']}: " + shlex.join(["git", "-C", str(team.repo), "log", "--no-merges", "-p",
                f"{row['from']}..{row['to']}", "--", *team.zones[row["zone"]]]) +
                f"; codeteam-land {team.manifest} finding v54-backlog-{row['zone']} --zone {row['zone']} "
                "--where <file:line> --severity 1|2|3 --kind <kind> --what <text>; "
                f"codeteam-land {team.manifest} reviewed backlog-{row['zone']}" for _, row in pending]
    team.notify(team.c("kong", team.m.get("guard", "Kong")), "REQUEST", "v5.4 backlog review per zone: " + "; ".join(commands))
    for path, row in pending:
        row["requested"] = now()
        save_record(path, row)


# ---------------------------------------------------------------- moving a v2 team over (spec §11)

def v2_layout(team):
    """What a v2 team has: the exchange branch, the lane branches, and every worktree sorted by its v2 role."""
    ex = team.exchange
    prefix = team.m.get("lane_branch_prefix", "lane/")
    wts, cur = [], {}
    for line in out(team.repo, "worktree", "list", "--porcelain").splitlines() + [""]:
        if not line:
            if cur:
                wts.append(cur)
            cur = {}
        elif line.startswith("worktree "):
            cur["path"] = line[9:]
        elif line.startswith("branch "):
            cur["branch"] = line[7:].replace("refs/heads/", "", 1)
    root = str(team.root) + "/"
    kinds = {"exchange": [], "integration": [], "lane": [], "request": [], "other": []}
    for w in wts:
        if Path(w["path"]).resolve() == team.repo:
            kinds["other"].append(w)             # the base checkout: never retired
            continue
        rel = w["path"][len(root):] if w["path"].startswith(root) else None
        b = w.get("branch", "")
        if b == ex:
            kinds["exchange"].append(w)
        elif b == team.integration:
            kinds["integration"].append(w)
        elif b.startswith(prefix) and rel and rel.startswith("workcrews/"):
            kinds["lane"].append(w)
        elif rel and ("/requests/" in rel or (rel.startswith("workcrews/") and b.startswith("unit/"))):
            w["zone"] = rel.split("/")[1]       # a lead's request worktree, or a v1 unit worktree
            kinds["request"].append(w)
        elif rel and (rel.startswith("land/") or rel.startswith("wo/")):
            continue
        else:
            kinds["other"].append(w)
    lanes = [b[len(prefix):] for b in out(team.repo, "for-each-ref", "--format=%(refname:short)",
                                           f"refs/heads/{prefix}").splitlines() if b]
    return ex, prefix, kinds, lanes


def unpushed(team, ex, branch):
    """Files a v2 lane branch changes that are not on exchange: the lane's diff since its last merge with exchange
    (push-up squashed its earlier commits onto exchange and merged exchange back, so those are not counted)."""
    base = out(team.repo, "merge-base", ex, branch)
    return [f for f in out(team.repo, "diff", "--name-only", base, branch).splitlines() if f]


REVERT_SUBJECT = re.compile(r"^revert\((?P<zone>[^)]+)\): take (?P<sha>[0-9a-f]{7,40}) off exchange")


def exchange_reverts(team, ex):
    """[(revert sha, zone, reverted sha)] for the commits on exchange, not on integration before adopt (or anywhere
    on exchange's first-parent line after it), that took unfinished work off exchange before the move (default
    subject `revert(<zone>): take <sha> off exchange ...`; [land] revert_pattern overrides)."""
    rx = re.compile(team.c("revert_pattern", REVERT_SUBJECT.pattern))
    out_ = []
    for line in out(team.repo, "log", "--first-parent", "--format=%H %s", ex, "-n", "400").splitlines():
        sha, subj = line.split(" ", 1)
        m = rx.match(subj)
        if m:
            out_.append((sha, m["zone"], m["sha"]))
    return out_


def archive_stashes(team):
    """Every stash (the repository's one stash list, shared by its worktrees) kept as refs/archive/v2/stash/<n>
    before anything is retired: nothing in progress is lost. The stash list itself is left."""
    n = 0
    for i, sha in enumerate(out(team.repo, "stash", "list", "--format=%H").splitlines()):
        git(team.repo, "update-ref", f"refs/archive/v2/stash/{i}", sha)
        n += 1
    return n


def cmd_migrate(team, a):
    ex, prefix, kinds, lanes = v2_layout(team)
    common = Path(out(team.repo, "rev-parse", "--path-format=absolute", "--git-common-dir"))
    ex_tip = out(team.repo, "rev-parse", ex)
    if a.step == "plan":
        it = out(team.repo, "rev-parse", team.integration)
        green = [r for r in results(team) if r["hash"] == ex_tip]
        print(f"exchange {ex} at {ex_tip[:10]}; integration at {it[:10]}; "
              f"{out(team.repo, 'rev-list', '--count', f'{team.integration}..{ex}')} commits on exchange not on integration; "
              f"{out(team.repo, 'rev-list', '--count', f'{ex}..{team.integration}')} on integration not on exchange")
        print(f"step 2 (validation tier on exchange's tip): {green[-1]['result'] if green else 'not run'}")
        for c in dict.fromkeys(out(team.repo, "rev-list", "--no-merges", f"{ex}..{team.integration}").split() +
                               out(team.repo, "rev-list", "--no-merges", f"{ex}..{team.m.get('base', 'main')}").split()):
            print(f"  on integration or base, not on exchange (put it on exchange before adopt): "
                  f"{out(team.repo, 'log', '-1', '--format=%h %s', c)}")
        print(f"\nlanes with finished, unpushed work (step 4: each becomes a work order tree):")
        n = 0
        for lane in lanes:
            files = unpushed(team, ex, prefix + lane)
            if files:
                n += 1
                print(f"  {lane}: {len(files)} file(s)")
        print(f"  ({n} of {len(lanes)} lanes)")
        print(f"\nrequest worktrees (step 5: registered as work orders in progress): {len(kinds['request'])}")
        dirty = [w for w in kinds["request"] if out(w["path"], "status", "--porcelain", "--untracked-files=no")]
        print(f"  with uncommitted changes: {len(dirty)}")
        print(f"\nretired at step 6: {len(kinds['lane'])} standing lane worktrees, {len(kinds['exchange'])} exchange, "
              f"{len(kinds['integration'])} integration worktree(s); their branches kept under refs/archive/v2/")
        dl = [w for w in kinds["lane"] + kinds["exchange"] + kinds["integration"]
              if out(w["path"], "status", "--porcelain", "--untracked-files=no")]
        for w in dl:
            print(f"  has uncommitted changes (a human decides): {w['path']}")
        rv = exchange_reverts(team, ex)
        print(f"\nunfinished work reverted off exchange, back as work orders (reverts step): {len(rv)}")
        for sha, zone, orig in rv:
            print(f"  {zone}: {orig[:10]} (reverted in {sha[:10]})")
        stashes = [l for l in out(team.repo, "stash", "list", "--format=%gd").splitlines() if l]
        print(f"\nstashes kept as archived branches at retire: {len(stashes)}")
        if kinds["other"]:
            print(f"\nleft alone ({len(kinds['other'])}): " + ", ".join(w["path"] for w in kinds["other"][:8]))
        return
    if a.step == "check":
        r = alpha_check(team, alpha_cfg(team) or die("no [land.remote] in the manifest"), ex_tip)
        print(json.dumps(r))
        sys.exit(0 if r["result"] == "pass" else 1)
    if a.step == "adopt":
        if a.force_unchecked and os.environ.get("CODETEAM_LAND_DRYRUN") != "1":
            die("--force-unchecked is for the throwaway dry run only (CODETEAM_LAND_DRYRUN=1)")
        known = None
        docs_sfx = tuple(team.c("docs_only_suffixes", [".md"]))

        def docs_since_pass():      # the gate's own rule: a docs-only change runs no build and no tests
            for r in reversed(results(team)):
                if r["result"] == "pass" and r["hash"] != ex_tip and \
                        git(team.repo, "merge-base", "--is-ancestor", r["hash"], ex_tip, check=False).returncode == 0:
                    files = out(team.repo, "diff", "--name-only", r["hash"], ex_tip).split()
                    if files and all(f.endswith(docs_sfx) for f in files):
                        return r["hash"]
            return None
        if not (a.force_unchecked or any(r["hash"] == ex_tip and r["result"] == "pass" for r in results(team))
                or docs_since_pass()):
            red = next((r for r in reversed(results(team)) if r["hash"] == ex_tip and r["result"] == "fail"), None)
            failing = sorted(set(re.findall(r"FAILED ZONES:([^|]*)", (red or {}).get("tail", ""))[-1].split())) \
                if red and "FAILED ZONES:" in red.get("tail", "") else []
            log = Path.home() / "land-check-logs" / f"{ex_tip}.log"
            if red and not failing and log.exists():     # a suite with no zone summary (codegraph's vitest): its test files
                plain = re.sub(r"\x1b\[[0-9;]*m", "", log.read_text(errors="replace"))
                failing = sorted(set(re.findall(r"FAIL\s+(?:\w+\s+)?(\S+?\.(?:test|spec)\.[cm]?[jt]sx?)\b", plain)))
            allowed = set(a.known_failing or [])
            if not (red and failing and allowed and set(failing) <= allowed):
                die(f"exchange's tip {ex_tip[:10]} has no passing validation-tier run (migrate check)"
                    + (f"; failing: {' '.join(failing)}" if failing else "")
                    + ("; --known-failing must name every failing zone" if allowed else "") + "; it is not adopted")
            known = failing                          # the owner's named exception: adopted red, never marked green
        base_ref = team.m.get("base", "main")
        behind = list(dict.fromkeys(out(team.repo, "rev-list", "--no-merges", f"{ex}..{team.integration}").split() +
                                    out(team.repo, "rev-list", "--no-merges", f"{ex}..{base_ref}").split()))
        ex_tree = out(team.repo, "rev-parse", f"{ex}^{{tree}}")

        def already_on_exchange(c):   # merging it into exchange changes nothing
            r = git(team.repo, "merge-tree", "--write-tree", ex, c, check=False)
            return r.returncode == 0 and r.stdout.split()[0] == ex_tree
        lost = [c for c in behind if not already_on_exchange(c)]
        if lost:
            die(f"integration or {base_ref} has {len(lost)} commit(s) exchange lacks; adopting would drop them:\n  " +
                "\n  ".join(out(team.repo, "log", "-1", "--format=%h %s", c) for c in lost) +
                f"\nPut them on {ex} first (cherry-pick in the exchange worktree), then check and adopt.")
        if kinds["integration"]:
            die("integration is checked out in " + ", ".join(w["path"] for w in kinds["integration"]) +
                ": retire that worktree first (migrate retire --only integration)")
        (common / "codeteam-adopt").write_text(ex_tip + "\n")
        try:
            git(team.repo, "update-ref", f"refs/heads/{team.integration}", ex_tip)
        finally:
            (common / "codeteam-adopt").unlink(missing_ok=True)
        if not a.force_unchecked and not known:
            with open(team.dir / "green", "a") as f:
                f.write(ex_tip + "\n")
        team.log({"time": now(), "adopt": ex_tip, "from": ex, "checked": not a.force_unchecked,
                  "known_failing": known, "reason": a.reason})
        if known:
            print(f"adopted with known failures (promote waits for a passing Stage 6 run): {' '.join(known)}")
        print(f"integration is now {ex}'s tip {ex_tip[:10]}")
        return
    if a.step == "lanes":
        bad = []
        for lane in lanes:
            if not unpushed(team, ex, prefix + lane):
                continue
            wo = f"v2-{lane.replace('/', '-')}"
            if team.wo_file(wo).exists():
                continue
            zone = lane if lane in team.zones else "orc"
            cmd_wo_cut(team, argparse_ns(zone=zone, wo=wo))
            rec = team.wo(wo)
            r = git(rec["tree"], "merge", "--no-edit", "-q", f"{prefix}{lane}", check=False)
            if r.returncode:
                bad.append(f"{wo}: conflicts in {', '.join(out(rec['tree'], 'diff', '--name-only', '--diff-filter=U').split())}")
        for b in bad:
            print(b)
        sys.exit(REFUSED if bad else 0)
    if a.step == "requests":
        n = done = 0
        for w in kinds["request"]:
            wo = Path(w["path"]).name
            if team.wo_file(wo).exists() or not w.get("branch"):
                continue
            if not unpushed(team, team.integration, w["branch"]) and \
                    not out(w["path"], "status", "--porcelain", "--untracked-files=no"):
                done += 1                    # its work is already on integration: retired, not registered
                continue
            team.save_wo({"wo": wo, "zone": w["zone"], "tree": w["path"], "branch": w["branch"], "cut": now(),
                          "migrated": "v2 request worktree", "base": out(w["path"], "merge-base", "HEAD", team.integration)})
            n += 1
        print(f"registered {n} request worktree(s) as work orders; each pulls from {team.integration} (wo-pull); "
              f"{done} already on {team.integration} (retired at the retire step)")
        return
    if a.step == "reverts":
        bad, n = [], 0
        for sha, zone, orig in exchange_reverts(team, ex):
            wo = f"v2-reland-{zone}-{orig[:8]}"
            if team.wo_file(wo).exists() or team.wo_file(wo).with_suffix(".landed.json").exists():
                continue
            cmd_wo_cut(team, argparse_ns(zone=zone if zone in team.zones else "orc", wo=wo, staff_as_orc=True))
            rec = team.wo(wo)
            env = dict(os.environ, GIT_AUTHOR_NAME="codeteam-land", GIT_COMMITTER_NAME="codeteam-land",
                       GIT_AUTHOR_EMAIL="codeteam@local", GIT_COMMITTER_EMAIL="codeteam@local")
            r = git(rec["tree"], "revert", "--no-edit", sha, check=False, env=env)
            if r.returncode:
                bad.append(f"{wo}: re-applying {orig[:10]} conflicts; the tree is left mid-revert for its lead")
            else:
                n += 1
            team.notify(f"Coord-{zone}", "NOTE", f"{wo}: the work taken off exchange before the v5 move ({orig[:10]}) "
                        f"is back in a work order tree, {rec['tree']}, unfinished as it was. Finish it there and land it "
                        f"(codeteam-land land {wo}).")
        print(f"{n} reverted item(s) back as work orders in progress")
        for b in bad:
            print(b)
        sys.exit(REFUSED if bad else 0)
    if a.step == "retire":
        n = archive_stashes(team)
        if n:
            print(f"kept {n} stash(es) as refs/archive/v2/stash/<n>")
        only = set(a.only or ["lane", "exchange", "integration", "done"])
        kinds["done"] = [w for w in kinds["request"] if w.get("branch") and not team.wo_file(Path(w["path"]).name).exists()
                         and not unpushed(team, team.integration, w["branch"])]
        left = []
        for kind in ("lane", "exchange", "integration", "done"):
            if kind not in only:
                continue
            for w in kinds[kind]:
                if out(w["path"], "status", "--porcelain", "--untracked-files=no"):
                    left.append(w["path"])
                    continue
                git(team.repo, "worktree", "remove", "--force", w["path"], check=False)
        for b in [ex, *[prefix + l for l in lanes]]:
            git(team.repo, "update-ref", f"refs/archive/v2/{b}", b, check=False)
        for p in left:
            print(f"kept (uncommitted changes; a human decides): {p}")
        print("retired; branches archived under refs/archive/v2/")
        sys.exit(REFUSED if left else 0)


# ---------------------------------------------------------------- the standing queue and recheck runners (launchd)

def plist_path(team):
    return Path.home() / "Library" / "LaunchAgents" / f"{LAUNCHD_PREFIX}.codeteam-land.{team.manifest.stem}.plist"


def service_jobs(team: Team) -> list[tuple[str, str, Path, Path]]:
    return [(f"{prefix}.{team.manifest.stem}", subcommand,
             plist_path(team).with_name(f"{prefix}.{team.manifest.stem}.plist"), team.dir / f"{subcommand}.log")
            for prefix, subcommand in ((f"{LAUNCHD_PREFIX}.codeteam-land", "queue-run"),
                                       (f"{LAUNCHD_PREFIX}.codeteam-recheck", "recheck-run"),
                                       (f"{LAUNCHD_PREFIX}.codeteam-validate", "validate-run"))]


def service_plist(team: Team, label: str, subcommand: str, log: Path) -> str:
    return f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>{label}</string>
  <key>ProgramArguments</key><array>
    <string>{sys.executable}</string><string>{Path(__file__).resolve()}</string>
    <string>{team.manifest}</string><string>{subcommand}</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>{Path.home() / '.cargo' / 'bin'}:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>{log}</string>
  <key>StandardErrorPath</key><string>{log}</string>
</dict></plist>
"""


def launchd_reinstall(label: str, plist: Path, uid: int, run=None, sleep=None,
                      wait_s: float = 20.0, poll_s: float = 0.2, retry_s: float = 2.0) -> str | None:
    return codeteam_launchd.reinstall(label, plist, uid, run=run, sleep=sleep, wait_s=wait_s, poll_s=poll_s, retry_s=retry_s).reason


def cmd_service(team: Team, a) -> None:
    """Install, remove or report the queue-run, recheck-run and validate-run launchd jobs.

    Install polls after each bootout and continues after reported failures, naming them and exiting non-zero.
    All restart on exit and idle while the team is halted; Stage 7 restart requests exit between whole stage jobs.
    """
    uid = os.getuid()
    failed = []
    for label, subcommand, path, log in service_jobs(team):
        if a.action == "install":
            path.write_text(service_plist(team, label, subcommand, log))
            reason = launchd_reinstall(label, path, uid)
            if reason:
                print(f"{label} not installed: {reason}", file=sys.stderr)
                failed.append(label)
                continue
            print(f"installed {label}: {subcommand} for {team.manifest.stem}, log {log}")
        elif a.action == "remove":
            subprocess.run(["launchctl", "bootout", f"gui/{uid}/{label}"], capture_output=True)
            path.unlink(missing_ok=True)
            print(f"removed {label}")
        else:
            r = subprocess.run(["launchctl", "print", f"gui/{uid}/{label}"], capture_output=True, text=True)
            state = next((l.strip() for l in r.stdout.splitlines() if l.strip().startswith("state =")), "not loaded")
            print(f"{label}: {state}{' (team halted: idle)' if halted(team) else ''}")
    if failed:
        die(f"service install: {len(failed)} job(s) not installed: {', '.join(failed)}", 1)

# ---------------------------------------------------------------- the hook

HOOK = r'''#!/bin/sh
# codeteam-land: landing holds reviewed work; integration copies the proven base.
# For non-lab teams, the tool marker guards against manual moves; it is not authentication. The config hook
# (hook.codeteam-land.*) runs even where a repo sets core.hooksPath. It checks prepared
# ref transactions in every worktree and ignores transactions without a guarded ref.
[ "$1" = "prepared" ] || exit 0
input=$(cat)
case "$input" in GUARD_CASE) ;; *) exit 0;; esac
echo "$input" | while read -r old new ref; do
  case " GUARDED " in *" $ref "*) ;; *) continue;; esac
  case "$new" in 0000000000000000000000000000000000000000)
    # git pack-refs (auto gc) deletes the loose ref after writing it into packed-refs: the ref itself stays.
    # Only git's own packing, and only when packed-refs holds the ref at the same value.
    case "$(ps -o args= -p $PPID 2>/dev/null)" in
      "git pack-refs"*|*"/git pack-refs"*|"git gc"*|*"/git gc"*|"git maintenance"*|*"/git maintenance"*)
        grep -qs "^$old $ref\$" "$(git rev-parse --git-common-dir)/packed-refs" && continue;; esac
    ;; esac
  # Ref packing also writes a copy at the same hash; a no-op changes no guarded branch.
  [ "$(git rev-parse -q --verify "$ref")" = "$new" ] && continue
  TOOL_RULE
  case "$new" in 0000000000000000000000000000000000000000)
    echo "$ref cannot be deleted" >&2; exit 1;; esac
  # A caller that gives no expected old value shows zeros here: read the ref itself (not yet moved in "prepared").
  case "$old" in 0000000000000000000000000000000000000000)
    old=$(git rev-parse -q --verify "$ref") || continue;; esac
  adopt="$(git rev-parse --git-common-dir)/codeteam-adopt"
  [ -f "$adopt" ] && [ "$(cat "$adopt")" = "$new" ] && continue      # codeteam-land migrate adopt (spec §11 step 3)
  git merge-base --is-ancestor "$old" "$new" || {
    echo "refused: $ref only moves forward, by a landing (spec v5)." >&2; exit 1; }
  MOVE_RULE
  for c in $(git rev-list --first-parent "$old..$new"); do
    git log -1 --format=%B "$c" | grep -qx "Landed-By: codeteam land-one" && continue
    case " ALLOWED " in *" $(git log -1 --format=%cn "$c") "*) continue;; esac
    echo "refused: $c is not a landing. $ref changes only through codeteam-land (spec v5)." >&2; exit 1
  done
done
'''


def hook_move_rule(team: Team) -> str:
    landing, integration = f"refs/heads/{team.landing}", f"refs/heads/{team.integration}"
    if team.lab:
        return f'case "$ref" in {integration}) ;; *) git merge-base --is-ancestor "$new" "{integration}" && continue;; esac'
    base = f"refs/heads/{team.m.get('base', 'main')}"
    return (f'case "$ref" in {landing}) ;; {integration})\n'
            f'    [ "$new" = "$(git rev-parse {shlex.quote(base)})" ] && continue\n'
            '    echo "refused: integration must copy base" >&2; exit 1;; *)\n'
            f'    git merge-base --is-ancestor "$new" "{landing}" && continue\n'
            '    echo "refused: base must be on landing" >&2; exit 1;; esac')


def guarded_refs(team):
    refs = [f"refs/heads/{team.landing}", f"refs/heads/{team.integration}"]
    if team.c("guard_base", True):
        refs.append(f"refs/heads/{team.m.get('base', 'main')}")
    return list(dict.fromkeys(refs))


UNION_LOGS = ("DECISIONS.md", "CHANGELOG.md", "*_CHANGELOG.md")   # not RULINGS.md (a duplicate ruling number must clash)
UNION_MARK = "# codeteam: append-only logs merge by union"
UNION_END = "# codeteam: end of append-only logs"


def union_family(pattern: str) -> str:
    """The append-only log family a path pattern names, by its last component: CHANGELOG, DECISIONS, or ""."""
    name = pattern.rstrip("/").rsplit("/", 1)[-1].upper()
    return next((fam for fam in ("CHANGELOG", "DECISIONS") if fam in name), "")


def product_union_families(team) -> set[str]:
    """The log families the product's own tracked .gitattributes (on integration, else the base) gives a merge
    attribute. The product decides how those merge; codeteam's info/attributes, which outranks .gitattributes, leaves
    them alone (one product keeps its root release notes, generated plugin log and per-document
    changelogs out of union, and codeteam's CHANGELOG.md and *_CHANGELOG.md lines overrode that in every worktree)."""
    for ref in (team.integration, team.m.get("base", "main")):
        r = git(team.repo, "show", f"{ref}:.gitattributes", check=False)
        if r.returncode == 0:
            break
    else:
        return set()
    out = set()
    for line in (r.stdout or "").splitlines():
        words = line.split()
        if len(words) < 2 or words[0].startswith("#"):
            continue
        if any(w.lstrip("-!") == "merge" or w.startswith("merge=") for w in words[1:]):
            out.add(union_family(words[0]))
    return out - {""}


def install_union_logs(common, decided=frozenset()):
    """Append-only logs merge by union in every worktree (info/ is shared), so two work orders that each add an entry
    never clash (a shared decisions log once bounced six landings in a morning). The block is rewritten
    each time, so a change to UNION_LOGS reaches teams that have the old list. A family in `decided` (the product's
    own .gitattributes sets its merge, product_union_families) is left out of the block."""
    f = common / "info" / "attributes"
    f.parent.mkdir(parents=True, exist_ok=True)
    ours = {f"{p} merge=union" for p in (*UNION_LOGS, "RULINGS.md")}   # every pattern codeteam ever wrote
    lines = (f.read_text() if f.exists() else "").splitlines()
    keep, inside = [], False
    for line in lines:
        if line.startswith(UNION_MARK):
            inside = True
            continue
        if line.startswith(UNION_END):
            inside = False
            continue
        if inside and line in ours:
            continue                    # codeteam's own line: rewritten below; anything else in the file stays
        inside = inside and line in ours
        keep.append(line)
    f.write_text("".join(x + "\n" for x in keep) + UNION_MARK + ", so two work orders adding entries never clash\n"
                 + "".join(f"{p} merge=union\n" for p in UNION_LOGS if union_family(p) not in decided)
                 + UNION_END + "\n")


def cmd_install_hook(team, a):
    common = Path(out(team.repo, "rev-parse", "--path-format=absolute", "--git-common-dir"))
    install_union_logs(common, product_union_families(team))
    h = common / "codeteam-land-guard"
    refs = guarded_refs(team)
    allowed = " ".join(team.c("allow_committers", []))
    text = (HOOK.replace("GUARD_CASE", "|".join(f"*{r}*" for r in refs))
            .replace("GUARDED", " ".join(refs)).replace("ALLOWED", allowed)
            .replace("TOOL_RULE", "" if team.lab else
                     f'[ "${{{LAND_TOOL_ENV}}}" = "1" ] || {{ echo "refused: only codeteam-land moves $ref" >&2; exit 1; }}')
            .replace("MOVE_RULE", hook_move_rule(team)))
    h.write_text(text)
    h.chmod(0o755)
    git(team.repo, "config", "--local", "hook.codeteam-land.event", "reference-transaction")
    git(team.repo, "config", "--local", "hook.codeteam-land.command", str(h))
    old = common / "hooks" / "reference-transaction"
    if old.exists() and "codeteam-land" in old.read_text():
        old.unlink()                                  # the first version's file hook
    print(f"installed {h} (config hook) guarding {', '.join(refs)}" + (f"; direct commits allowed for: {allowed}" if allowed else ""))


# ---------------------------------------------------------------- main

def main(argv):
    import argparse
    ap = argparse.ArgumentParser(prog="codeteam-land")
    ap.add_argument("manifest")
    sp = ap.add_subparsers(dest="cmd", required=True)
    p = sp.add_parser("wo-cut"); p.add_argument("zone"); p.add_argument("wo")
    p.add_argument("--staff-as-orc", action="store_true")
    p = sp.add_parser("wo-pull"); p.add_argument("wo")
    p = sp.add_parser("land"); p.add_argument("wo"); p.add_argument("--with", dest="with_", action="extend", nargs="+")
    p.add_argument("--feature"); p.add_argument("--fixes", action="append")
    p.add_argument("--doc-level", dest="doc_level", choices=LEVELS, help="the version level of the documents it changes")
    p.add_argument("--doc", help="with --doc-level: that document only (a repo path)")
    p.add_argument("--untested", action="store_true")
    sp.add_parser("queue")
    p = sp.add_parser("queue-run"); p.add_argument("--once", action="store_true")
    p = sp.add_parser("recheck-run"); p.add_argument("--once", action="store_true")
    p = sp.add_parser("validate-run"); p.add_argument("--once", action="store_true")
    p = sp.add_parser("land-one"); p.add_argument("wo")
    p = sp.add_parser("land-hold"); p.add_argument("wo")
    p = sp.add_parser("land-next"); p.add_argument("wo")
    p = sp.add_parser("wo-tag"); p.add_argument("wo"); p.add_argument("--feature"); p.add_argument("--fixes", action="append")
    p = sp.add_parser("feature-done"); p.add_argument("feature")
    p = sp.add_parser("finding"); p.add_argument("feature"); p.add_argument("--wo", action="append")
    p.add_argument("--zone"); p.add_argument("--where"); p.add_argument("--severity", type=int, choices=(1, 2, 3))
    p.add_argument("--kind", choices=FINDING_KINDS); p.add_argument("--what"); p.add_argument("--belongs", default="")
    p.add_argument("--same-as", dest="same_as")
    p = sp.add_parser("findings"); p.add_argument("feature", nargs="?"); p.add_argument("--open", action="store_true")
    p.add_argument("--zone")
    p.add_argument("--json", action="store_true")
    p = sp.add_parser("finding-drop"); p.add_argument("id"); p.add_argument("--reason", required=True)
    p = sp.add_parser("reviewed"); p.add_argument("feature")
    p = sp.add_parser("first-time"); p.add_argument("--days", type=float); p.add_argument("--json", action="store_true")
    p.add_argument("--since")
    p = sp.add_parser("layers"); p.add_argument("--ref"); p.add_argument("--json", action="store_true")
    p.add_argument("--feature", help="only the violations the feature's latest round introduced")
    p = sp.add_parser("land-cancel"); p.add_argument("wo"); p.add_argument("--reason", default=None)
    p = sp.add_parser("wo-retire"); p.add_argument("wo"); p.add_argument("--force", action="store_true")
    p.add_argument("--reason", default=None)
    p = sp.add_parser("wo-hold"); p.add_argument("wo", nargs="?"); p.add_argument("--because")
    p.add_argument("--release", action="store_true")
    p = sp.add_parser("revert"); p.add_argument("wo")
    sp.add_parser("install-hook")
    sp.add_parser("alpha-install")
    p = sp.add_parser("alpha-bisect"); p.add_argument("hash")
    p = sp.add_parser("promote"); p.add_argument("hash", nargs="?")
    p = sp.add_parser("service"); p.add_argument("action", choices=("install", "remove", "status"))
    sp.add_parser("validate-suite")
    sp.add_parser("migrate-v54")
    p = sp.add_parser("migrate"); p.add_argument("step", choices=("plan", "check", "adopt", "lanes", "requests", "reverts",
                                                                   "retire"))
    p.add_argument("--only", nargs="+", choices=("lane", "exchange", "integration", "done"))
    p.add_argument("--force-unchecked", action="store_true")
    p.add_argument("--known-failing", nargs="+", help="adopt: zones the owner accepts as red at the move (each gets a work order)")
    p.add_argument("--reason", default=None)
    a = ap.parse_args(argv)
    team = Team(a.manifest, create=not (a.cmd == "migrate" and a.step == "plan"))

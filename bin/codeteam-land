     "queue-run": cmd_queue_run, "recheck-run": cmd_recheck_run, "land-one": cmd_land_one, "land-hold": cmd_land_hold, "land-next": cmd_land_next, "wo-tag": cmd_wo_tag, "feature-done": cmd_feature_done,
     "finding": cmd_finding, "findings": cmd_findings, "finding-drop": cmd_finding_drop, "reviewed": cmd_reviewed,
     "first-time": cmd_first_time, "layers": cmd_layers,
     "land-cancel": cmd_land_cancel, "wo-retire": cmd_wo_retire, "wo-hold": cmd_wo_hold,
     "revert": cmd_revert, "install-hook": cmd_install_hook, "alpha-install": cmd_alpha_install,
     "alpha-bisect": cmd_alpha_bisect,
     "validate-run": cmd_validate_run, "promote": cmd_promote, "migrate": cmd_migrate, "service": cmd_service,
     "validate-suite": cmd_validate_suite, "migrate-v54": cmd_migrate_v54}[a.cmd](team, a)


if __name__ == "__main__":
    main(sys.argv[1:])

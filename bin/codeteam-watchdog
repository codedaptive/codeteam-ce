#!/usr/bin/env python3
"""codeteam-watchdog: outside every loop, so a dead or stuck loop is seen (a loop once hung 4 h at an
ssh prompt and the patrol, which runs inside the loop, saw nothing). Run by launchd every 5 minutes
(`codeteam-watchdog install`, which polls after bootout before reinstalling and exits non-zero on failure).
For each team that is up (team/v2/up, no team/v2/down, no team/HALTED): a loop heartbeat
older than 10 minutes, or a landing queue, recheck or validation runner that launchd shows as not running, is told
to the owner once per episode (a herdr notice); a runner that is down is also told to the team's orchestrator (a NOTE with
launchd's state and last exit code, at most once per runner in 6 hours); and a missing loop is started again
(codeteam2 ensure-loop)."""
import json
import os
import plistlib
import re
import shlex
import signal
import subprocess
import sys
import time
import tomllib
from pathlib import Path

HERE = Path(__file__).resolve().parent
# Prefer this checkout's shared module over one in the working directory.
sys.path.insert(0, str(HERE.parent / "share"))
import codeteam_launchd
from codeteam_order_trees import order_trees
from codeteam_prune_reused import prune_reused_trees
from codeteam_runner_down import runner_down_note
from codeteam_stale_target import sweep_stale_targets

TEAMS = HERE.parent / "teams"
WORKSPACE = Path(os.environ.get("CODETEAM_WORKSPACE") or Path.home() / "codeteam-work")   # every team-<x> folder
STATE = HERE.parent / "run" / "watchdog.json"
STALE_S = 600
# A runner that is down is also told to the team's orchestrator, at most once per runner in this many seconds: a runner
# that exits at start and is restarted by launchd shows as running in some passes, and each pass that sees it down
# again opens a new episode.
TELL_ORC_S = 6 * 3600
RUNNER_JOBS = {"landing": "land", "recheck": "recheck", "validation": "validate"}
# Disk (the disk once reached 99% full: work order trees held 18-28 GB of build output each, and
# a gate died with "No space left on device"). Below DISK_MIN_GB free, the build output of work order trees idle
# DISK_IDLE_S is removed, oldest first; it is rebuilt (through sccache and the compile caches) when its lead returns.
DISK_MIN_GB = 150
DISK_IDLE_S = 1800
BUILD_DIRS = ("target", "cargo-target", ".build", "DerivedData")
LAUNCHD_PREFIX = os.environ.get("CODETEAM_LAUNCHD_PREFIX") or "com.codeteam"
OWNER = os.environ.get("CODETEAM_OWNER") or "Owner"
# Below this, the landing tool's own long-lived clones lose their idle build output too (2026-11-13: one team's
# land/validate/target held 50 GiB and land/itest/target 23 GiB while the disk filled for the third time that day).
# Stages 5 and 6 reuse that warm output, and new work order trees copy it from land/itest, so the clones are
# cleared only below the deck's 50 GiB red line, not at DISK_MIN_GB.
LAND_DISK_MIN_GB = 50 * 2 ** 30 / 1e9
LAND_STAGES = {"Stage 5": "itest", "Stage 6": "validate"}
# Disk emergency: a standing permission. Below EMERGENCY_GB free, without asking: Time Machine's local snapshots are
# deleted (each holds every file deleted since it was taken; the disk once filled under three of them in a morning),
# the shared compile cache's generations other than the newest go, and sccache's oldest entries beyond its cap go.
# All of it is rebuildable and nobody's work; nothing else is touched. Each time something goes, one line to the owner.
EMERGENCY_GB = 20
COMPILE_CACHE = Path(os.environ.get("CODETEAM_SWIFT_CAS") or Path.home() / "Library" / "Developer"
                     / "codeteam-compilation-cache") / "builtin"
SCCACHE_DIR = Path.home() / "Library" / "Caches" / "Mozilla.sccache"
SCCACHE_CONFIG = Path.home() / "Library" / "Application Support" / "Mozilla.sccache" / "config"
SNAPSHOT_DATE = re.compile(r"\d{4}-\d{2}-\d{2}-\d{6}")
GENERATION = re.compile(r"v(\d+)\.(\d+)")
LABEL = f"{LAUNCHD_PREFIX}.codeteam-watchdog"
LAUNCH_AGENTS = Path.home() / "Library" / "LaunchAgents"


def notify(title, body):
    env = dict(os.environ, HERDR_SESSION="codeteam")
    subprocess.Popen(["/opt/homebrew/bin/herdr", "notification", "show", title, "--body", body, "--sound", "request"],
                     env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def runs(job):
    """The job's process is alive and is still its tool (the build queue runner's own check, codeteam-buildq): a job
    file outlives its process, and the pid may since belong to something else."""
    if not alive(job.get("pid")) or not job.get("tool"):
        return False
    r = subprocess.run(["ps", "-ww", "-o", "command=", "-p", str(int(job["pid"]))], capture_output=True, text=True)
    return job["tool"] in r.stdout


def sweep_queue(q=None):
    """The build queue's duplicates and orphans (four repeats of one
    cargo check were once seen in a morning, 30 minutes apart). A queued build job whose own process is gone is cancelled
    (zone-tool job cancel); of the same build running more than once in one tree, all but the newest are stopped.
    Test jobs are left alone: an identical one is joined at submit, and its record answers the next run. Returns the
    lines it logged."""
    q = Path(q or os.environ.get("CODETEAM_QUEUE_DIR") or HERE.parent / "run" / "queue")
    jobs = []
    for f in q.glob("*.json"):
        try:  # the build queue prunes finished jobs' files, so a listed file can be gone by now
            if time.time() - f.stat().st_mtime > 86400:
                continue
            j = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if j.get("kind") == "slot" and j.get("state") in ("queued", "running"):
            jobs.append(j)
    done = []
    for j in jobs:
        if j["state"] == "queued" and not alive(j.get("pid")):
            r = subprocess.run([str(HERE / "zone-tool"), "job", "cancel", j["ticket"]], capture_output=True, text=True,
                               env=dict(os.environ, CODETEAM_QUEUE_DIR=str(q)))
            if "cancelled" in r.stdout:
                done.append(f"cancelled {j['ticket']}: queued {' '.join(j.get('command') or [])} whose process is gone "
                            f"({j.get('worktree')})")
    same = {}
    for j in jobs:
        if j["state"] == "running" and runs(j):
            same.setdefault((j.get("worktree"), tuple(j.get("command") or [])), []).append(j)
    for (wt, cmd), group in same.items():
        group.sort(key=lambda x: x.get("submitted") or 0)
        for j in group[:-1]:
            try:
                os.kill(int(j["pid"]), signal.SIGTERM)
                done.append(f"stopped {j['ticket']}: {' '.join(cmd)} also running as {group[-1]['ticket']} in {wt}")
            except (OSError, ValueError):
                pass
    for line in done:
        print(f"{time.strftime('%Y-%m-%d %H:%M:%S')} queue: {line}", flush=True)
    if len(done) > 3:
        notify("codeteam watchdog: build queue", f"{len(done)} duplicate or orphaned build jobs removed; see run/watchdog.log")
    return done


def warm_held(lock):
    """True while someone holds the flock on a warm lock file."""
    import fcntl
    try:
        fd = os.open(str(lock), os.O_RDONLY)
    except OSError:
        return False
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return False
    except OSError:
        return True
    finally:
        os.close(fd)


def free_gb(path=None):
    st = os.statvfs(str(path or Path.home()))
    return st.f_bavail * st.f_frsize / 1e9


def last_active(tree, dirs):
    """The newest of: the last commit, the index (git add, checkout), the files git sees as changed (as the idle sweep's
    check), and each build folder and its top entries (a build writes there). Never a walk of the tree. A held warm
    lock (the worktree hook's detached warm build) counts as now."""
    times = []
    st = subprocess.run(["git", "-C", str(tree), "status", "--porcelain", "--untracked-files=all"], capture_output=True,
                        text=True)
    for line in st.stdout.splitlines()[:5000]:
        try:
            times.append((tree / line[3:].split(" -> ")[-1].strip('"')).stat().st_mtime)
        except OSError:
            pass
    r = subprocess.run(["git", "-C", str(tree), "log", "-1", "--format=%ct"], capture_output=True, text=True)
    if r.stdout.strip():
        times.append(float(r.stdout.strip()))
    gd = subprocess.run(["git", "-C", str(tree), "rev-parse", "--path-format=absolute", "--git-dir"],
                        capture_output=True, text=True).stdout.strip()
    for p in [Path(gd) / "index"] if gd else []:
        try:
            times.append(p.stat().st_mtime)
        except OSError:
            pass
    if gd and warm_held(Path(gd) / "codeteam-warm.lock"):
        times.append(time.time())
    for d in dirs:
        for p in [d, *list(d.iterdir())[:200]]:
            try:
                times.append(p.lstat().st_mtime)
            except OSError:
                pass
    return max(times or [0])


def manifests(teams=None, workspace=None):
    """Every team's manifest: production's teams/*.toml, then, for a team marked up (team-<x>/team/v2/up) with none
    there, the one in its own clone (team-<x>/design/*/teams/<x>.toml). One team keeps its manifest there: its loop once died when the
    disk filled and stayed down for three and a half hours, because only teams/*.toml were checked."""
    found = sorted(Path(teams or TEAMS).glob("*.toml"))
    named = {m.stem for m in found}
    for up in sorted(Path(workspace or WORKSPACE).glob("team-*/team/v2/up")):
        folder = up.parents[2]
        name = folder.name.removeprefix("team-")
        if name not in named:
            found += sorted(folder.glob(f"design/*/teams/{name}.toml"))[:1]
    return found


def runs_from(stem, agents=None):
    """(checkout, manifest) when the team's landing runner runs another checkout's tool: its launchd land job names
    that checkout's bin/codeteam-land and the team's manifest there. None when it runs this checkout's tool, or has no
    such job. A team whose loop and runners another checkout runs (a v5.5 checkout, say) must never have them
    reinstalled from this one, so this watchdog starts its dead loop with that checkout's codeteam2 on that manifest,
    and leaves its landing clones alone: their Stage 5 and 6 records are that checkout's."""
    try:
        with open(Path(agents or LAUNCH_AGENTS) / f"{LAUNCHD_PREFIX}.codeteam-land.{stem}.plist", "rb") as f:
            args = [str(a) for a in plistlib.load(f).get("ProgramArguments", [])]
    except Exception:                   # no job, or one that does not read as a plist: this checkout's, as before
        return None
    land = next((Path(a) for a in args if Path(a).name == "codeteam-land"), None)
    manifest = next((Path(a) for a in args if a.endswith(".toml")), None)
    if land is None or manifest is None or land.resolve().parent.parent == HERE.parent:
        return None
    return land.parent.parent, manifest


def queued_trees(q):
    """The work order trees with a queued or running build in the build queue at q."""
    busy = set()
    for f in Path(q).glob("*.json"):
        try:
            j = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if j.get("state") in ("queued", "running") and j.get("worktree"):
            busy.add(os.path.realpath(j["worktree"]))
    return busy


def land_clones(cfg, root):
    """{"itest": path, "validate": path}: the landing tool's long-lived clones of a team with [land]. Stage 5 rechecks
    in land/itest. Stage 6 has a clone here unless it validates on another machine ([land.remote], or a
    [land.validate] that is not local), as codeteam-land's validation tier says."""
    land = cfg.get("land")
    if not isinstance(land, dict):
        return {}
    clones = {"itest": root / "land" / "itest"}
    tier = land.get("remote") or land.get("validate") or {}
    if not tier:
        clones["validate"] = root / "land" / "validate"
    elif tier.get("local") and tier.get("path"):
        clones["validate"] = Path(os.path.expanduser(tier["path"]))
    return clones


def command_of(pid):
    r = subprocess.run(["ps", "-ww", "-o", "command=", "-p", str(int(pid))], capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else None


def busy_land_clones(stages, command=None):
    """{(manifest, "itest" | "validate")} for each live Stage 5 or 6 run, read from the landing tool's stage records
    (run/restart/stages; codeteam-land stage_admit). A record holds its runner's pid, and the runner's command line
    names its team's manifest. When that command cannot be read, the record holds that clone of every team ("*")."""
    command = command or command_of
    busy = set()
    for f in Path(stages).glob("*.json"):
        try:
            row = json.loads(f.read_text())
            kind, pid = LAND_STAGES.get(row.get("stage")), int(row["pid"])
        except (OSError, ValueError, KeyError, TypeError):
            continue
        if kind is None or not alive(pid):
            continue
        said = command(pid)
        if said is None:
            busy.add(("*", kind))
            continue
        busy |= {(os.path.realpath(os.path.expanduser(word)), kind) for word in said.split() if word.endswith(".toml")}
    return busy


def sweep_disk(teams=None, q=None, min_gb=None, idle_s=None, free=None, land_min_gb=None, workspace=None, agents=None):
    """When free disk is below min_gb: the build output of every work order tree with no queued or running build and
    nothing touched for idle_s is moved to its team's .trash and removed in the background, oldest tree first. Below
    land_min_gb, the landing tool's own clones (land_clones) are swept the same way, except one a live Stage 5 or 6
    run holds (busy_land_clones). A team whose runners run another checkout's tool (runs_from) has its builds read from
    that checkout's queue too, and its landing clones are left alone. Returns the lines it logged."""
    min_gb = float(os.environ.get("CODETEAM_DISK_MIN_GB", DISK_MIN_GB)) if min_gb is None else min_gb
    land_min_gb = LAND_DISK_MIN_GB if land_min_gb is None else land_min_gb
    idle_s = DISK_IDLE_S if idle_s is None else idle_s
    have = (free or free_gb)()
    if have >= min_gb:
        return []
    q = Path(q or os.environ.get("CODETEAM_QUEUE_DIR") or HERE.parent / "run" / "queue")
    land_busy = busy_land_clones(q.parent / "restart" / "stages") if have < land_min_gb else set()
    busy = queued_trees(q)
    found = []
    for m in manifests(teams, workspace):
        elsewhere = runs_from(m.stem, agents)
        try:
            cfg = tomllib.loads(m.read_text())
        except (OSError, ValueError):
            continue
        root = Path(os.path.expanduser(cfg.get("worktree_root") or str(WORKSPACE / f"team-{m.stem}")))
        if elsewhere:
            busy |= queued_trees(elsewhere[0] / "run" / "queue")
        trees = set()
        if have < land_min_gb and not elsewhere:
            trees |= {clone for kind, clone in land_clones(cfg, root).items()
                      if not {(os.path.realpath(m), kind), ("*", kind)} & land_busy}
        trees |= order_trees(root)
        for tree in sorted(trees):
            dirs = [tree / d for d in BUILD_DIRS if (tree / d).is_dir() and not (tree / d).is_symlink()]
            if not dirs or os.path.realpath(tree) in busy:
                continue
            last = last_active(tree, dirs)
            if time.time() - last >= idle_s:
                found.append((last, root, tree, dirs))
    done = []
    for last, root, tree, dirs in sorted(found, key=lambda x: x[0]):
        trash = root / ".trash"
        trash.mkdir(exist_ok=True)
        for d in dirs:
            dest = trash / f"{time.strftime('%Y%m%d-%H%M%S')}-{tree.name}-{d.name.lstrip('.')}"
            try:
                d.rename(dest)
            except OSError:
                continue
            done.append(f"removed {d} (idle {(time.time() - last) / 3600:.1f} h)")
    for root in {x[1] for x in found}:
        if (root / ".trash").is_dir():
            subprocess.Popen(["sh", "-c", f"rm -rf {shlex.quote(str(root / '.trash'))}/*"], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
    stamp = time.strftime('%Y-%m-%d %H:%M:%S')
    for line in done:
        print(f"{stamp} disk ({have:.0f} GB free): {line}", flush=True)
    if have < min_gb / 3:
        notify("codeteam watchdog: disk", f"{have:.0f} GB free; {len(done)} idle build folders removed")
    return done


def snapshot_dates(run=subprocess.run):
    """The dates of Time Machine's local snapshots (tmutil listlocalsnapshotdates), oldest first."""
    r = run(["tmutil", "listlocalsnapshotdates", "/"], capture_output=True, text=True)
    return sorted(x.strip() for x in (r.stdout or "").splitlines() if SNAPSHOT_DATE.fullmatch(x.strip()))


def old_generations(cache=None):
    """The compile cache's generation folders (v<major>.<minor>) other than the newest by version. Files (its lock,
    v1.validation) and folders by any other name are never returned."""
    root = Path(cache or COMPILE_CACHE)
    found = []
    for p in root.iterdir() if root.is_dir() else ():
        m = GENERATION.fullmatch(p.name)
        if m and p.is_dir() and not p.is_symlink():
            found.append(((int(m[1]), int(m[2])), p))
    return [p for _, p in sorted(found)[:-1]]


def size_bytes(text):
    """An sccache size ("80G", "512M", "1T" or plain bytes) in bytes; sccache's K, M, G and T are binary."""
    m = re.fullmatch(r"\s*(\d+)\s*([KMGT]?)\s*", str(text or ""))
    return int(m[1]) * 1024 ** " KMGT".index(m[2] or " ") if m else None


def sccache_cap(teams=None, workspace=None, config=None):
    """sccache's cap in bytes: the smallest SCCACHE_CACHE_SIZE a team's [env] sets (e.g. 80G for the one
    machine-wide cache; the server takes it from the environment of the build that starts it), else the config
    file's [cache.disk] size; None when neither says."""
    sizes = []
    for m in manifests(teams, workspace):
        try:
            env = tomllib.loads(m.read_text()).get("env") or {}
        except (OSError, ValueError):
            continue
        n = size_bytes(env.get("SCCACHE_CACHE_SIZE"))
        if n:
            sizes.append(n)
    if sizes:
        return min(sizes)
    try:
        return int(tomllib.loads(Path(config or SCCACHE_CONFIG).read_text())["cache"]["disk"]["size"])
    except (OSError, ValueError, KeyError, TypeError):
        return None


def trim_sccache(cap, cache=None):
    """Removes sccache's files, oldest modification first, until its folder holds no more than cap bytes. Returns
    (files removed, bytes freed)."""
    files, total = [], 0
    for folder, _, names in os.walk(cache or SCCACHE_DIR):
        for name in names:
            path = os.path.join(folder, name)
            try:
                st = os.lstat(path)
            except OSError:
                continue
            files.append((st.st_mtime, st.st_size, path))
            total += st.st_size
    removed = freed = 0
    for _, size, path in sorted(files):
        if total - freed <= cap:
            break
        try:
            os.unlink(path)
        except OSError:
            continue
        removed += 1
        freed += size
    return removed, freed


def tell_owner(text):
    """One line to the owner on codeteam's General when this checkout runs a codeteam team (teams/codeteam.toml):
    kept in its log and shown as a herdr notice, costing no session a turn (codeteam2 say to the user). Without one,
    a herdr notice."""
    manifest = TEAMS / "codeteam.toml"
    if not manifest.exists():
        notify("codeteam watchdog: disk emergency", text[:300])
        return
    subprocess.run([str(HERE.parent / "v2" / "bin" / "codeteam2"), "say", str(manifest), "general",
                    "Orc-Codeteam", "NOTE", OWNER, text], capture_output=True, text=True, timeout=60)


def disk_emergency(free=None, run=subprocess.run, cache=None, sccache=None, cap=None, trash=None,
                   spawn=subprocess.Popen, say=None, teams=None, workspace=None):
    """Below EMERGENCY_GB free (a standing permission): deletes Time Machine's local snapshots,
    moves the compile cache's old generations to a trash folder beside the cache and removes them in the background,
    and trims sccache to its cap. Tells the owner in one line when anything went. Returns the lines it logged."""
    have = (free or free_gb)()
    if have >= EMERGENCY_GB:
        return []
    done, failed = [], []
    for date in snapshot_dates(run):
        r = run(["tmutil", "deletelocalsnapshots", date], capture_output=True, text=True)
        if r.returncode:
            failed.append(f"Time Machine snapshot {date} not deleted: {(r.stderr or r.stdout or '').strip()[:200]}")
        else:
            done.append(f"deleted Time Machine local snapshot {date}")
    old = old_generations(cache)
    if old:
        trash_dir = Path(trash or Path(cache or COMPILE_CACHE).parent.parent / ".codeteam-trash")
        trash_dir.mkdir(exist_ok=True)
        moved = []
        for p in old:
            try:
                p.rename(trash_dir / f"{time.strftime('%Y%m%d-%H%M%S')}-{p.name}")
            except OSError as e:
                failed.append(f"compile cache {p.name} not removed: {e}")
                continue
            moved.append(p.name)
        if moved:
            spawn(["sh", "-c", f"rm -rf {shlex.quote(str(trash_dir))}/*"], stdout=subprocess.DEVNULL,
                  stderr=subprocess.DEVNULL, start_new_session=True)
            done.append(f"removing compile cache generation {', '.join(moved)} (the newest stays)")
    cap = sccache_cap(teams, workspace) if cap is None else cap
    if cap:
        n, freed = trim_sccache(cap, sccache)
        if n:
            done.append(f"removed sccache's {n} oldest files ({freed / 1e9:.1f} GB) beyond its {cap / 2 ** 30:.0f} GiB "
                        "cap")
    stamp = time.strftime('%Y-%m-%d %H:%M:%S')
    for line in done + failed:
        print(f"{stamp} disk emergency ({have:.0f} GB free): {line}", flush=True)
    if done:
        (say or tell_owner)(f"watchdog, {have:.0f} GB free (below {EMERGENCY_GB}; the standing disk emergency rule): "
                            f"{'; '.join(done + failed)}.")
    elif failed:
        notify("codeteam watchdog: disk emergency", "; ".join(failed)[:300])
    return done + failed


def runner_problems(stem: str, run=subprocess.run, uid: int | None = None) -> list[str]:
    uid = os.getuid() if uid is None else uid
    problems = []
    for runner, problem in (("land", "landing queue runner not running"),
                            ("recheck", "recheck runner not running"),
                            ("validate", "validation runner not running")):
        r = run(["launchctl", "print", f"gui/{uid}/{LAUNCHD_PREFIX}.codeteam-{runner}.{stem}"],
                capture_output=True, text=True)
        if r.returncode or "state = running" not in r.stdout:
            problems.append(problem)
    return problems


def check():
    """One pass: the build queue sweep, the disk emergency, the disk floor, the stale target sweep (a
    <tree>/target beside cargo-target in a CODETEAM_CARGO_TARGET=1 team, at any free space), the prune of old cargo
    copies and incremental folders in idle landing clones (prune_reused_trees, at any free space), then each team's
    loop and landing runners. Each part runs even when one before it fails, and the failure is logged when the log
    can be written: on a full disk the state file cannot be written, and the floor after it must still run."""
    q = Path(os.environ.get("CODETEAM_QUEUE_DIR") or HERE.parent / "run" / "queue")
    for name, part in (("sweep_queue", sweep_queue), ("disk_emergency", disk_emergency), ("sweep_disk", sweep_disk),
                       ("sweep_stale_targets", lambda: sweep_stale_targets(
                           manifests(), q, queued_trees, runs_from, free_gb(), quiet_s=DISK_IDLE_S)),
                       ("prune_reused_trees", lambda: prune_reused_trees(
                           manifests(), q, queued_trees, runs_from, land_clones, busy_land_clones)),
                       ("check_teams", check_teams)):
        try:
            part()
        except Exception as e:
            try:
                print(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {name} failed: {type(e).__name__}: {e}", flush=True)
            except OSError:
                pass                    # the log is on the full disk too


def check_teams():
    """Each running team's loop heartbeat and landing runners; a problem is notified once, when it starts."""
    try:
        state = json.loads(STATE.read_text())
    except (OSError, ValueError):
        state = {}
    now, seen = time.time(), {}
    told = state.get("told") if isinstance(state.get("told"), dict) else {}
    told = {k: t for k, t in told.items() if now - t < TELL_ORC_S}
    for m in manifests():
        checkout, manifest = runs_from(m.stem) or (HERE.parent, m)
        try:
            cfg = tomllib.loads(manifest.read_text())
        except (OSError, ValueError):
            continue
        root = Path(os.path.expanduser(cfg.get("worktree_root") or str(WORKSPACE / f"team-{m.stem}")))
        v2 = root / "team" / "v2"
        if not (v2 / "up").exists() or (v2 / "down").exists() or (root / "team" / "HALTED").exists():
            continue
        problems = []
        hb = v2 / "heartbeat"
        age = now - hb.stat().st_mtime if hb.exists() else None
        if age is None or age > STALE_S:
            problems.append(f"loop heartbeat {'missing' if age is None else f'{age / 60:.0f} min old'}")
            subprocess.run([str(checkout / "v2" / "bin" / "codeteam2"), "ensure-loop", str(manifest)],
                           capture_output=True, timeout=120, env=dict(os.environ, HERDR_SESSION="codeteam"))
        if (cfg.get("land") or {}).get("enabled"):
            problems.extend(runner_problems(m.stem))
        for p in problems:
            key = f"{m.stem}: {p.split(' ')[0]} {p.split(' ')[1]}"
            seen[key] = state.get(key, now)
            if key not in state:
                notify(f"codeteam watchdog: {m.stem}", p)
                print(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {m.stem}: {p}", flush=True)
                if p.split(" ")[0] in RUNNER_JOBS and key not in told:
                    told[key] = now
                    tell_orchestrator(checkout, manifest, root, m.stem, p)
    if told:
        seen["told"] = told
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(seen))


def tell_orchestrator(checkout, manifest, root, stem, problem, run=None, popen=None):
    """One NOTE to the team's orchestrator about a runner that is down, through the codeteam2 of the checkout
    the team runs (sprocket's is a v5.5 checkout's); started and not waited for. The note carries what launchd says."""
    run, popen = run or subprocess.run, popen or subprocess.Popen
    job = f"gui/{os.getuid()}/com.codeteam.codeteam-{RUNNER_JOBS[problem.split(' ')[0]]}.{stem}"
    try:
        printed = run(["launchctl", "print", job], capture_output=True, text=True, timeout=30).stdout
    except (OSError, subprocess.SubprocessError):
        printed = ""
    popen([str(Path(checkout) / "v2" / "bin" / "codeteam2"), "say", str(manifest), "general", "codeteam", "NOTE", "orc",
           runner_down_note(problem, printed, root, manifest)], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
          stderr=subprocess.DEVNULL, start_new_session=True)


def launchd_reinstall(label: str, plist: Path, uid: int, run=None, sleep=None,
                      wait_s: float = 20.0, poll_s: float = 0.2, retry_s: float = 2.0) -> str | None:
    return codeteam_launchd.reinstall(label, plist, uid, run=run, sleep=sleep, wait_s=wait_s, poll_s=poll_s, retry_s=retry_s).reason


def install():
    plist = Path.home() / "Library" / "LaunchAgents" / f"{LABEL}.plist"
    log = HERE.parent / "run" / "watchdog.log"
    plist.write_text(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>{LABEL}</string>
<key>ProgramArguments</key><array><string>{Path(__file__).resolve()}</string></array>
<key>StartInterval</key><integer>300</integer>
<key>RunAtLoad</key><true/>
<key>ProcessType</key><string>Interactive</string>
<key>StandardOutPath</key><string>{log}</string><key>StandardErrorPath</key><string>{log}</string>
<key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
</dict></plist>
""")
    reason = launchd_reinstall(LABEL, plist, os.getuid())
    if reason is not None:
        print(f"{LABEL} not installed: {reason}", file=sys.stderr)
        sys.exit(1)
    print(f"installed {LABEL}")


if __name__ == "__main__":
    install() if sys.argv[1:] == ["install"] else check()

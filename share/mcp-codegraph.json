{
  "mcpServers": {
    "codegraph": {
      "command": "codegraph",
      "args": ["serve", "--mcp"],
      "env": {
        "CODEGRAPH_MCP_TOOLS": "explore,node,search,callers,callees,impact,grep,blast,orphans,suspects",
        "CODEGRAPH_QUERY_POOL_SIZE": "0",
        "DO_NOT_TRACK": "1"
      }
    }
  }
}

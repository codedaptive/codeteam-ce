#!/usr/bin/env python3
"""codeteam v2 entry point. `codeteam2 plugin ...` is the herdr plugin's layer; everything else is the core."""
import os
import sys
from pathlib import Path

if sys.version_info < (3, 11):
    # `python3` can be macOS's 3.9 (cron's PATH, or a parent that put /usr/bin first: v1's module does).
    # Re-run this file under a current Python. Without this, loading v1 as a library under 3.9 makes v1
    # re-run *its own* file with codeteam2's arguments (restart test, 2026-10-26: `ensure-loop` ran as v1).
    import shutil
    for cand in (os.environ.get("CODETEAM_PYTHON", ""), "python3", os.path.expanduser("~/.local/bin/python3"),
                 "python3.15", "python3.14", "python3.13", "python3.12", "python3.11"):
        exe = shutil.which(cand) or (cand if Path(cand).is_file() else None)
        if exe and os.path.realpath(exe) != os.path.realpath(sys.executable):
            import subprocess
            if subprocess.run([exe, "-c", "import sys; sys.exit(sys.version_info < (3, 11))"]).returncode == 0:
                os.execv(exe, [exe, str(Path(__file__).resolve()), *sys.argv[1:]])
    sys.exit("codeteam2 needs Python 3.11+ (tomllib), and none was found")

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

if len(sys.argv) > 1 and sys.argv[1] == "plugin":
    from codeteam2.plugin import main  # noqa: E402
    sys.exit(main(sys.argv[2:]))
else:
    from codeteam2.cli import main  # noqa: E402
    main()
